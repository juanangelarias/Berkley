@using James.Shared.Constants
@inject NavigationManager Navigation
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <p>Determining session state, please wait...</p>
                </Authorizing>
                <NotAuthorized>
                    <h1>Sorry</h1>
                    <p>
                        You're not authorized to reach this page. You need to
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                                      Text="Log in" Click="BeginLogin" />
                    </p>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
@code
{
    private async Task BeginLogin()
    {
        //Force load is required so that the login is processed on the server
        Navigation.NavigateTo(JamesConstants.LOG_IN_PATH + "?redirectUri=" + Navigation.Page(), true);
    }
}