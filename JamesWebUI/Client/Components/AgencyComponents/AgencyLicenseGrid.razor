@using Blazorise
@using Blazorise.DeepCloner
@using JustifyContent = Radzen.JustifyContent
@using Orientation = Radzen.Orientation
@using ImagingDocumentCategory = James.Shared.Imaging.ImagingDocumentCategory
@using IconStyle = Radzen.IconStyle

@inherits JamesGridLayoutComponentBase<AgencyLicense>

@inject NavigationManager NavigationManager
@inject TooltipService TooltipService
@inject IDataAccess DataAccess

<Theme/>

<RadzenDataGrid TItem="AgencyLicense" @ref="@Grid" Data="@AgencyLicenses" ColumnWidth="125px"
                Style="border-radius: 10px; height: 400px;" EmptyText="No records to display" @bind-Settings="@GridSettings" AllowColumnReorder="true"
                GridLines="DataGridGridLines.Vertical" AllowSorting="true" Density="Density.Compact"
                SelectionMode="DataGridSelectionMode.Multiple" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                AllowColumnPicking="true" AllowGrouping="true" AllowColumnResize="true" RowUpdate="UpdateLicenseRow"
                EditMode="DataGridEditMode.Single" RowCreate="@OnLicenseCreate" IsLoading="@IsLoading" 
                Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <AuthorizeView Policy="InRoleCanAddAgencyLicense">
                <RadzenButton Icon="add" Text="New License" Variant="Variant.Text" Click="@InsertLicenseRow"
                              Disabled="@(_isEditMode)"/>
            </AuthorizeView>
            <BsgExportGridToButton IsLoading="@IsLoading" ExportGrid="ExportGrid" ExportFormat="DefaultExportFormat"/>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                         Style="margin-left: 10rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="margin-left: 3rem">
                    <RadzenButton Icon="settings" Click="SaveGridSettings"
                                  MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                                  Visible="@UserSettingsChanged" Disabled="@(_isEditMode)"/>
                    <RadzenButton Icon="reset_settings" Click="ClearGridSettings"
                                  MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                                  Visible="@UserSettingsLoaded" Disabled="@(_isEditMode)"/>
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Status" Filterable="true" Property="IsActive"
                              MinWidth="10px" TextAlign="TextAlign.Center" Width="150px">
            <Template Context="license">
                @{
                    if (license.IsActive)
                    {
                        <JamesStatusIcon IconStyle="IconStyle.Success"/>
                    }
                    else
                    {
                        <JamesStatusIcon IconStyle="IconStyle.Danger"/>
                    }
                }
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="@license.IsActive"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        @if (AgentsLicenses)
        {
            <RadzenDataGridColumn TItem="AgencyLicense" Title="Agent" Filterable="true" MinWidth="10px" Width="200px">
                <Template Context="license">
                    <RadzenText Text="@license.Agent?.IdNavigation.FullName"/>
                </Template>
                <EditTemplate Context="license">
                    <RadzenDropDown TValue="Agent" Data="AgencyAgents" Style="width:95%" Name="CmbAgent"
                                    TextProperty="IdNavigation.FullName" @bind-Value="@license.Agent"/>
                    <RadzenRequiredValidator Text="Agent is required" Component="CmbAgent"/>
                </EditTemplate>
            </RadzenDataGridColumn>
        }
        <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Type="typeof(IEnumerable<string>)"
                              Filterable="true" FilterProperty="State" Property="State" Width="150px"
                              FilterOperator="FilterOperator.Contains" MinWidth="10px" TextAlign="TextAlign.Center">
            <Template Context="license">
                <RadzenText Text="@license.State"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="string" Data="AllStates" @bind-Value="@license.State" Name="State"
                                TextProperty="Name" ValueProperty="Code" Style="width:95%"/>
                <RadzenRequiredValidator Text="State is required" Component="State" Popup="true"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" MinWidth="10px" Property="AppointingState"
                              TextAlign="TextAlign.Center" Width="170px">
            <Template Context="license">
                <RadzenCheckBox Value="license.AppointingState" ReadOnly="true"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="license.AppointingState"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="License No." Property="LicenseNumber" MinWidth="10px"
                              Width="160px">
            <Template Context="license">
                <RadzenText Text="@license.LicenseNumber"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="license.LicenseNumber" Style="width:95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" MinWidth="10px" Property="IsResident"
                              TextAlign="TextAlign.Center" Width="170px">
            <Template Context="license">
                <RadzenRow JustifyContent="JustifyContent.Center">
                    <RadzenCheckBox TValue="bool" Value="license.IsResident" ReadOnly="true"/>
                </RadzenRow>
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox TValue="bool" @bind-Value="license.IsResident"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer" Filterable="true" Property="Insurer"
                              MinWidth="10px" Width="350px">
            <Template Context="license">
                <RadzenText Text="@license.Insurer.IdNavigation.FullName"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="Insurer" Data="AllInsurers" Style="width:95%" Name="CmbInsurer"
                                TextProperty="IdNavigation.FullName" @bind-Value="@license.Insurer"/>
                <RadzenRequiredValidator Text="Insurer is required" Component="CmbInsurer" Popup="true"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Appointment" Property="Appointment" MinWidth="10px"
                              Width="170px">
            <Template Context="license">
                <RadzenText Text="@license.Appointment?.ToString("MM/dd/yyyy")"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Appointment"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Termination" Property="Termination" MinWidth="10px"
                              Width="170px">
            <Template Context="license">
                <RadzenText Text="@license.Termination?.ToString("MM/dd/yyyy")"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Termination"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Comments" Property="Comments" MinWidth="10px" Width="300px"
                              Filterable="true">
            <Template Context="license">
                <RadzenText Text="@license.Comments"/>
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="@license.Comments"  Style="width:95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="75px" MinWidth="75px" TItem="AgencyLicense" Filterable="false" Sortable="false"
                              TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right"
                              Resizable="false">
            <Template Context="license">
                <AuthorizeView Policy="InRoleCanEditAgencyLicense">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" 
                                  Size="ButtonSize.Small" Click="@(_ => EditLicenseRow(license))" 
                                  @onclick:stopPropagation="true" Disabled="@(_isEditMode)"/>
                </AuthorizeView>
                <AuthorizeView Policy="InRoleCanDeleteAgencyLicense">
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Icon="delete"
                                  Variant="Variant.Flat"
                                  Shade="Shade.Lighter"
                                  Size="ButtonSize.Small"
                                  class="my-1 ms-1"
                                  Click="@(_ => DeleteLicenseRow(license))"
                                  @onclick:stopPropagation="true" Disabled="@(_isEditMode)">
                    </RadzenButton>
                </AuthorizeView>
            </Template>
            <EditTemplate Context="license">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                  Size="ButtonSize.Small" Click="@(_ => SaveLicenseRow(license))"/>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => CancelLicenseEdit(license))"/>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
    [Parameter, EditorRequired] public required bool AgentsLicenses { get; set; }
    
    private List<AgencyLicense> AgencyLicenses { get; set; } = [];
    private AgencyLicense? _originalAgencyLicense;
    private bool _isEditMode;
    private static List<Insurer> AllInsurers { get; set; } = [];
    private static List<State> AllStates { get; set; } = [];
    private List<Agent> AgencyAgents { get; set; } = [];
    
    #region Loaders

    #region LicensesLoad

    private IDataAccessResult<List<AgencyLicense>> _licenses = null!;

    private LoadItem AgencyLicensesLoad => AddEventNotify(new LoadItem<List<AgencyLicense>>
    {
        Key = LicensesKey(),
        AsyncLoadTask = async () => _licenses = await DataAccess.GetAgencyLicenses(Agency.Id, AgentsLicenses),
        CacheLoadTask = cache => _licenses = new DataAccessResult<List<AgencyLicense>>
        {
            Data = (List<AgencyLicense>)cache!
        },
        ResultVariable = () => _licenses,
        AfterLoad = () =>
        {
            AgencyLicenses = _licenses.Data!;
        }
    }, AgentsLicenses ? "agents licenses" : "agency licenses");

    #endregion
    
    private string LicensesKey()
    {
        var type = AgentsLicenses ? "agents" : "agency";
        var key = $"{CacheKeys.AgencyLicenses(Agency.Id.ToString())}_{type}";
        return key;
    }

    #region StatesLoad

    private IDataAccessResult<List<State>> _states = null!;

    private LoadItem StatesLoad => AddEventNotify(new LoadItem<List<State>>
    {
        Key = "States",
        AsyncLoadTask = async () => _states = await DataAccess.GetAllStates(),
        CacheLoadTask = cache => _states = new DataAccessResult<List<State>>
        {
            Data = (List<State>)cache!
        },
        ResultVariable = () => _states,
        AfterLoad = () =>
        {
            if (_states.Success)
                AllStates = _states.Data!;
        }
    }, "states");

    #endregion

    #region InsuresLoad

    private IDataAccessResult<List<Insurer>> _insurers = null!;

    private LoadItem InsurersLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = "Insurers",
        AsyncLoadTask = async () => _insurers = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurers = new DataAccessResult<List<Insurer>>
        {
            Data = (List<Insurer>)cache!
        },
        ResultVariable = () => _insurers,
        AfterLoad = () =>
        {
            if (_insurers.Success)
                AllInsurers = _insurers.Data!;
        }
    }, "insurers");

    #endregion

    #region Agents Load

    private IDataAccessResult<List<AgencyAgentDto>> _agentsResult = null!;

    private LoadItem AgentsLoad => AddEventNotify(new LoadItem<List<AgencyAgentDto>>
    {
        Key = CacheKeys.AgencyAgents(Agency.AgencyNumber),
        AsyncLoadTask = async () => _agentsResult = await DataAccess.GetAgencyAgents(Agency.Id),
        CacheLoadTask = cache => _agentsResult = new DataAccessResult<List<AgencyAgentDto>>
        {
            Data = (List<AgencyAgentDto>)cache!
        },
        ResultVariable = () => _agentsResult,
        AfterLoad = () =>
        {
            AgencyAgents = _agentsResult.Data?
                               .Select(s => new Agent
                               {
                                   Id = s.AgentId,
                                   IdNavigation = new()
                                   {
                                       FullName = s.FullName
                                   }
                               })
                               .ToList()
                           ?? [];
        }
    }, "agents");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var type = AgentsLicenses ? "Agents" : "Agency";
        GridSettingsKey = $"AgencyLicensesGrid-{type}";

        await LoadData();
    }

    private async Task LoadData()
    {
        if (Agency.Id == Guid.Empty)
            return;

        await ShowLoading();
        
        List<LoadItem> loadItems =
        [
            StatesLoad,
            InsurersLoad,
            AgencyLicensesLoad
        ];
        
        if(AgentsLicenses)
            loadItems.Add(AgentsLoad);

        await DataAccess.ParallelGetCacheOrDataAsync(loadItems.ToArray());
        
        await GetGridSettings();
    }

    private async Task LoadLicenses()
    {
        await DataAccess.GetCacheOrLoadDataAsync(AgencyLicensesLoad);
    }

    private async Task InsertLicenseRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        await ShowLoading();

        var agent = AgentsLicenses
            ? new Agent
            {
                IdNavigation = new()
                {
                    FullName = ""
                }
            }
            : null;
        
        var newLicense = new AgencyLicense
        {
            Id = Guid.Empty,
            IsActive = false,
            IsResident = false,
            AppointingState = false,
            AgencyId = Agency.Id,
            Agency = Agency,
            Agent = agent,
            Insurer = new()
            {
                Id = Guid.Empty,
                IdNavigation = new()
                {
                    FullName = ""
                }
            }
        };
        
        _isEditMode = true;

        await Grid.InsertRow(newLicense);
    }

    private async Task EditLicenseRow(AgencyLicense license)
    {
        _isEditMode = true;
        _originalAgencyLicense = license.DeepClone();

        await ShowLoading();
        await Grid.EditRow(license);
    }

    private async Task DeleteLicenseRow(AgencyLicense license)
    {
        var deleteConfirmed = await DialogService.Confirm("Are you sure?",
            "Agency License Deletion",
            new() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (deleteConfirmed == false)
            return;

        await ShowLoading();
        var result = await DataAccess.DeleteLicense(license.Id);

        if (result.Success)
        {
            var toDelete = AgencyLicenses.FirstOrDefault(f => f.Id == license.Id);
            if (toDelete != null)
            {
                AgencyLicenses.Remove(toDelete);
                await DataAccess.UpdateCacheAsync(LicensesKey(), AgencyLicenses);
            }

            await Grid.Reload();

            await LoadLicenses();
            _isEditMode = false;
        }
        else
            await HandleError("Error deleting License", result.Errors);
    }

    private async Task SaveLicenseRow(AgencyLicense license)
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Update/Insert is done in those methods.

        if (!ValidateLicenseFields(license))
            return;

        var task = Grid.UpdateRow(license);
        await ShowLoading(task);
        
        _originalAgencyLicense = null;
        _isEditMode = false;
    }

    private bool ValidateLicenseFields(AgencyLicense license)
    {
        var flag = true;
        if (string.IsNullOrWhiteSpace(license.State))
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "State has not been defined. Please correct and try again.",
                Duration = 2000
            });
            flag = false;
        }

        if (license.Insurer.Id == Guid.Empty)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Insurer has not been defined. Please correct and try again.",
                Duration = 2000
            });
            flag = false;
        }

        return flag;
    }

    private async Task OnLicenseCreate(AgencyLicense license)
    {
        license.Id = Guid.NewGuid();

        //This is where we handle row inserts.
        
        var result = await DataAccess.CreateLicense(
            license.Id,
            Agency.Id,
            AgentsLicenses ? license.Agent?.Id : null,
            license.AppointingState,
            license.Comments,
            license.Appointment,
            license.Expiration,
            license.Termination,
            license.Insurer.Id,
            license.IsResident,
            license.LicenseNumber,
            license.State,
            license.IsActive
        );

        if (!result.Success)
            await HandleError("Error creating License", result.Errors);
        else
        {
            license.InsurerId = license.Insurer.Id;
            AgencyLicenses.Add(license);

            await DataAccess.UpdateCacheAsync(LicensesKey(), AgencyLicenses);
        }
    }

    private async Task CancelLicenseEdit(AgencyLicense license)
    {
        var lic = AgencyLicenses.FirstOrDefault(f => f.Id == license.Id);
        if(lic != null)
        {
            lic.State = _originalAgencyLicense!.State;
            lic.AppointingState = _originalAgencyLicense!.AppointingState;
            lic.LicenseNumber = _originalAgencyLicense!.LicenseNumber;
            lic.IsResident = _originalAgencyLicense!.IsResident;
            lic.Appointment = _originalAgencyLicense!.Appointment;
            lic.Termination = _originalAgencyLicense!.Termination;
            lic.Comments = _originalAgencyLicense!.Comments;
            lic.InsurerId = _originalAgencyLicense!.InsurerId;
            lic.IsActive = _originalAgencyLicense!.IsActive;
            lic.Insurer = AllInsurers.FirstOrDefault(f=>f.Id == lic.InsurerId)!;
        }
        _originalAgencyLicense = null;
        _isEditMode = false;
        
        await ShowLoading();
        Grid.CancelEditRow(license);
    }

    private async Task UpdateLicenseRow(AgencyLicense license)
    {
        //This is where we handle row Updates.
        var result = await DataAccess.SetAgencyLicense(license.Id,
            Agency.Id,
            license.AgentId,
            license.AppointingState,
            license.Comments,
            license.Appointment,
            license.Expiration,
            license.Termination,
            license.InsurerId,
            license.IsResident,
            license.LicenseNumber,
            license.State,
            license.IsActive
        );

        if (!result.Success)
            await HandleError("Error Setting Agency License", result.Errors);
        else
            await DataAccess.UpdateCacheAsync(LicensesKey(), AgencyLicenses);
    }

    private async Task CertificateUploaded(Guid? certificateId, Guid licenseId)
    {
        //Set the document link
        var saveResult = await DataAccess.SetAgencyLicenseDocumentLink(licenseId, certificateId);
        if (saveResult.Success)
            NotifySuccessfulSave("License certificate");
        else
            NotifySaveError(saveResult.Errors, "license certificate");
    }

    private void LogUploadError(string message, AgencyLicense license)
    {
        LoggingService.LogError("Upload failed",
            "Uploading a file to imaging returned an error",
            "Imaging",
            data: new()
            {
                { "Error Message", message },
                { "AgencyNumber", license.Agency.AgencyNumber },
                { "License Id", license.Id.ToString() }
            });
        NotifySaveError([message], "license certificate");
    }

    private async Task ExportGrid(ExportFormat format)
    {
        if (format != DefaultExportFormat)
        {
            DefaultExportFormat = format;
            await SaveGridSettings();
        }

        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Insurer", "Insurer.IdNavigation.FullName", "Insurer");
        substitutions.AddSubstitution("IsActive", "IsActive", "Is_Active");
        substitutions.AddSubstitution("IsResident", "IsResident", "Is_Resident");
        substitutions.AddSubstitution("AppointingState", "AppointingState", "Appointing_State");
        substitutions.AddSubstitution("State", "State", "State");
        substitutions.AddSubstitution("LicenseNumber", "LicenseNumber", "License_Number");
        substitutions.AddSubstitution("Appointment", "Appointment", "Appointment");
        substitutions.AddSubstitution("Termination", "Termination", "Termination");

        NavigationManager.NavigateTo(ExportDataGridUrl(Grid,
                $"/export/AgencyLicenses/{Agency.Id}/{AgentsLicenses}", format, substitutions),
            true);
    }

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }
}
