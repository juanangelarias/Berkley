@page "/Agency"

@using System.Globalization
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject AccountClient AccountClient

<Theme />


<PageTitle>Agency Profile</PageTitle>

<RadzenLayout>
    <RadzenHeader>

    </RadzenHeader>
    <RadzenBody>
        <RadzenRow Gap="1" RowGap="1" JustifyContent="JustifyContent.Right">
            <RadzenColumn Style="vertical-align: middle" Size="1">
                <RadzenLabel Text="Search by:" Component="txtSearch"  ></RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox Placeholder="Agency/Producer No." Name="txtSearch" Style="width: 100%"/>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenTextBox Placeholder="Name" Style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn Style="vertical-align: middle">
                <RadzenButton Icon="search" Size="ButtonSize.Small" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Create New Agency" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow></RadzenRow>
        <RadzenRow RowGap="1" >
            <RadzenColumn Size="1"/>
            <RadzenStack Orientation="Orientation.Horizontal">
                <UseGetAllStates Context="stateData">
                    <ChildContent>
                        <RadzenDropDown @rendermode="@InteractiveWebAssembly" Placeholder="States"
                                        Multiple="true" Chips="true" SelectAllText="Select All"
                                        TValue="IGetAllStates_AllStates" Data="stateData.AllStates"
                                        TextProperty="Name" ValueProperty="Code">
                        </RadzenDropDown>
                    </ChildContent>
                    <ErrorContent>
                        Something went wrong...<br />
                    </ErrorContent>
                    <LoadingContent>
                        <RadzenDropDown Placeholder="Loading..." TValue="IGetAllStates_AllStates"/>
                    </LoadingContent>
                </UseGetAllStates>
                <RadzenDropDown @rendermode="@InteractiveWebAssembly" TValue="string"/>
                <RadzenDropDown @rendermode="@InteractiveWebAssembly" Placeholder="Branch" TValue="string" Data="@dropDownValues" />
                <RadzenDropDown @rendermode="@InteractiveWebAssembly" Placeholder="Status" TValue="string" />
            </RadzenStack>
        </RadzenRow>
    </RadzenBody>
</RadzenLayout>


@code {
    string[] dropDownValues = { "Test1", "Test2", "Test3" };

    //DropDown Data
    private IReadOnlyList<IGetAllStates_AllStates> states;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeService.Initialize(NavigationManager);
    }

}

