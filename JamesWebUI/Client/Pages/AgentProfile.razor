@page "/Agents"
@using System.Diagnostics
@using James.Shared

@inherits JamesLayoutComponentBase

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess
@inject ILoggingService _logging
@attribute [Authorize]

<Theme />

<PageTitle>BasisTNG - Agent Maintenance</PageTitle>
<RenderModeBackground></RenderModeBackground>

<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" class="rz-shadow-7">
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="Agent Maintenance" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <AgentSearch @bind-SelectedAgentId="@AgentId" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Create New Agent" />
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel>
        <RadzenStack Orientation="Orientation.Vertical">

            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="General Info">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenFormField Text="First Name" AllowFloatingLabel="false">
                                <RadzenTextBox Value="@AgentToDisplay?.IdNavigation?.GivenName" />
                            </RadzenFormField>
                            <RadzenFormField Text="MI" AllowFloatingLabel="false">
                                <RadzenTextBox Value="@AgentToDisplay?.IdNavigation?.MiddleInitial" />
                            </RadzenFormField>
                            <RadzenFormField Text="Last Name" AllowFloatingLabel="false">
                                <RadzenTextBox Value="@AgentToDisplay?.IdNavigation?.FamilyName" />
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Contact Info">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="Address">
                                    <LegalEntityAddressManager LegalEntityId="@AgentToDisplay.Id" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Phone">
                                    <LegalEntityPhoneNumberManager LegalEntityId="@AgentToDisplay.Id" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Email">

                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                        
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFieldset Text="Licenses">
                <RadzenRow>
                    <RadzenColumn>
                        <AgentLicenseGrid AgentId="@AgentToDisplay.Id" />
@*                         <RadzenDataGrid Data="@AgentToDisplay?.AgencyLicenses" TItem="AgencyLicense" Density="Density.Compact"
                                        Style="height:500px; border-radius:15px;"  AllowVirtualization="true"
                                        AllowFiltering="true" AllowColumnPicking="true" AllowGrouping="true">
                            <HeaderTemplate>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                    <RadzenButton Icon="add" Text="New License" Variant="Variant.Text" />

                                </RadzenStack>
                            </HeaderTemplate>
                            <Columns>
                                <RadzenDataGridColumn TItem="AgencyLicense" Title="License #" Width="125px">
                                    <Template Context="license">
                                        <RadzenText Text="@license?.LicenseNumber" />
                                    </Template>

                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Width="100px">
                                    <Template Context="license">
                                        <RadzenText Text="@license?.State" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" Width="125px">
                                    <Template Context="license">
                                        <RadzenCheckBox Value="@license?.IsResident" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" Width="125px">
                                    <Template Context="license">
                                        <RadzenCheckBox Value="@license?.AppointingState" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer">
                                    <Template Context="license">
                                        <RadzenText Text="@license?.Insurer?.IdNavigation?.FullName" />
