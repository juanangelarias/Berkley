@inherits JamesLayoutComponentBase
@inject IDataAccess DataAccess

<RadzenDataGrid TItem="Bond" @ref="@_obligeePrimaryBondsGrid" Data="ObligeeBonds" EmptyText="No records to display."
                AllowColumnPicking="true" AllowFiltering="true" AllowSorting="true" AllowGrouping="true"
                FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Density="Density.Compact" Style="border-radius: 10px;height:400px;" IsLoading="@IsLoading">
    <HeaderTemplate>
        <RadzenButton Text="Export XLS" Icon="grid_on" Click="@(_ => Export("excel"))"/>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Title="Status" Property="Status" Width="125px" Type="typeof(List<string>)"
                              Filterable="true" FilterValue="@_statusFilter" FilterProperty="Status" FilterOperator="FilterOperator.Contains">
            <Template Context="bond">
                @{
                    if (bond.Status.Trim() == "Open")
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success" />
                        </RadzenStack>

                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger" />
                        </RadzenStack>
                    }
                }
            </Template>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_statusFilter" Change="StatusFilterChange" id="statusFilterDropDown"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@ObligeeBonds.Select(b => b.Status).Distinct().ToList()">

                </RadzenDropDown>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Bond No." Property="BondNumber" />
        <RadzenDataGridColumn Title="Company Name" Property="AccountNumNavigation.IdNavigation.FullName" />
        <RadzenDataGridColumn Title="Branch" />
        <RadzenDataGridColumn Title="SAA" Property="SfaaclassCode" Filterable="false" />
        <RadzenDataGridColumn Title="Type" Property="BondType.BondType" Width="150px"
                              FilterValue="_bondTypeFilter" FilterProperty="BondType.BondType" FilterOperator="FilterOperator.Contains" Type="typeof(List<string>)">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_bondTypeFilter" Change="BondTypeFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@ObligeeBonds.Select(b=>b.BondType?.BondType).Distinct().ToList()" />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Begin Date" Property="Effective" FormatString="{0:d}" />
        <RadzenDataGridColumn Title="End Date" Property="Expiration" FormatString="{0:d}" />
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid ObligeeId { get; set; }
    [Parameter] public ObligeeBondTypes BondTypesToDisplay { get; set; } = ObligeeBondTypes.Primary;

    private List<Bond> ObligeeBonds { get; set; } = [];
    private bool IsLoading { get; set; }
    private RadzenDataGrid<Bond> _obligeePrimaryBondsGrid = null!;

    private List<string>? _statusFilter;
    private List<string>? _bondTypeFilter;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadObligeeBonds();
    }

    private async Task LoadObligeeBonds()
    {
        IDataAccessResult<List<Bond>> result = null!;

        var loadItem = AddEventNotify(new LoadItem
        {
            Key = $"ObligeeBonds{ObligeeId}",
            AsyncLoadTask = BondTypesToDisplay == ObligeeBondTypes.Primary
                ? async () => result = await DataAccess.GetObligeePrimaryBonds(ObligeeId)
                : async () => result = await DataAccess.GetObligeeSecondaryBonds(ObligeeId),
            CacheLoadTask = cache => result = new DataAccessResult<List<Bond>>
            {
                Data = (List<Bond>)cache!
            },
            ResultVariable = () => result,
            AfterLoad = async void () =>
            {
                if (result.Success)
                    ObligeeBonds = result.Data!;
                else
                    await HandleError("Error loading Obligee bonds", result.Errors);
            }
        }, $"ObligeeBonds {ObligeeId}");

        await DataCache.GetCacheOrLoadDataAsync(loadItem);
    }

    protected async Task ShowLoading()
    {
        IsLoading = true;

        await Task.Yield();

        IsLoading = false;
    }

    private async Task StatusFilterChange()
    {
        await ShowLoading();

        if (_statusFilter != null && !_statusFilter.Any())
        {
            _statusFilter = null;
        }
        await _obligeePrimaryBondsGrid.Reload();
    }
    
    private async Task BondTypeFilterChange()
    {
        await ShowLoading();

        if (_bondTypeFilter != null && !_bondTypeFilter.Any())
        {
            _bondTypeFilter = null;
        }
        await _obligeePrimaryBondsGrid.Reload();
    }

    private void Export(string type)
    {
        
    }
    
    public enum ObligeeBondTypes
    {
        Primary,
        Secondary
    }
}
