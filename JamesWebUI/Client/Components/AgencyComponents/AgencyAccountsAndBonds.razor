@using Blazorise.Animate;

@inherits SlidingComponent

<Theme />

<RadzenTabs Change="@HandleChangeDirection" TabPosition="TabPosition.Top" >
    <Tabs>
        <RadzenTabsItem Text="Accounts">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyAccountsGrid Agency="@Agency" />
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Bonds">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyBondsGrid Agency="@Agency" />
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Bond Record History">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyBondRecordHistory AgencyId="@Agency.Id"/>
            </Animate>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
}
