@typeparam T where T : System.Numerics.INumber<T>

@inject TooltipService tooltipService
@inject NotificationService NotificationService

<RadzenRow>
    <RadzenColumn Size="4">
        <RadzenText Text="Minimum" />
    </RadzenColumn>
    <RadzenColumn Size="4">
        <RadzenText Text="Maximum" />
    </RadzenColumn>
    <RadzenColumn Size="4">
        <RadzenText Text=@ValueHeaderText />
    </RadzenColumn>
</RadzenRow>
@{
    var tierCount = Values?.Count ?? 0;
}
@if (tierCount == 0)
{
    <RadzenText Text="No rates entered" Style=@(EditMode&&ShowValidations?"color:red":"") />
}
else
{
    System.Diagnostics.Debug.Assert(Values != null, nameof(Values) + " != null");
    @for (var i = 0; i < tierCount - 1; i++)
    {
        var index = i;
        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenText Text=@Values[index].Minimum.ToString() />
            </RadzenColumn>
            <RadzenColumn Size="4">
                @if (EditMode)
                {
                    <RadzenNumeric TValue="int?" @bind-Value=@Values[index].Maximum
                                   Placeholder="Maximum" ShowUpDown="false"
                                   Min="@(index>0? Values[index-1].Maximum+1:2)" Max="@(Values[index+1].Maximum-1)"
                                   Change=@(_=>SetMinimums()) />
                }
                else
                {
                    <RadzenText Text=@Values[index]?.Maximum?.ToString() />
                }
            </RadzenColumn>
            <RadzenColumn Size="4">
                @if (EditMode)
                {
                    <RadzenNumeric TValue="T" @bind-Value=@Values[index].Value
                                   Placeholder=@ValuePlaceholder ShowUpDown="false"
                                   Min=@((decimal)Convert.ChangeType( ValueMinimum, typeof(decimal)))
                                   Max=@((decimal)Convert.ChangeType( ValueMaximum, typeof(decimal))) />
                }
                else
                {
                    <RadzenText Text=@Values[index].Value.ToString() />
                }
            </RadzenColumn>
        </RadzenRow>
    }
    <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenText Text=@Values[tierCount-1].Minimum.ToString() />
        </RadzenColumn>
        <RadzenColumn Size="4">
            @if (EditMode)
            {
                <RadzenNumeric TValue="int?" @bind-Value=@Values[tierCount-1].Maximum
                               Placeholder="Unlimited" ShowUpDown="false"
                               Min="@(tierCount>1? Values[tierCount-2].Maximum+1:2)"
                               Change=@(_=>SetMinimums())
                               MouseEnter="@(args => ShowTooltip(args))" />
            }
            else
            {
                <RadzenText Text=@(Values[tierCount-1].Maximum?.ToString()??"Unlimited") />
            }
        </RadzenColumn>
        <RadzenColumn Size="@(EditMode?2:4)">
            @if (EditMode)
            {
                <RadzenNumeric TValue="T" @bind-Value=@Values[tierCount-1].Value
                               Placeholder=@ValuePlaceholder ShowUpDown="false"
                               Min=@((decimal)Convert.ChangeType( ValueMinimum, typeof(decimal)))
                               Max=@((decimal)Convert.ChangeType( ValueMaximum, typeof(decimal))) />
            }
            else
            {
                <RadzenText Text=@Values[tierCount-1].Value.ToString() />
            }
        </RadzenColumn>
        @if (EditMode)
        {
            <RadzenColumn Size="2 ">
                <RadzenButton Text="Delete Tier" Icon="remove_circle_outline" Click=@RemoveTier></RadzenButton>
            </RadzenColumn>
        }
    </RadzenRow>
}
@if (EditMode)
{
    <RadzenRow>
        <RadzenButton Text="Add rate tier" Icon="add_circle_outline" Click=@AddTier />
    </RadzenRow>
}

@code {
    private List<ITieredValue<T>>? _values;
    private bool _editMode;

    [Parameter]
    public List<ITieredValue<T>>? Values
    {
        get => _values;
        set => _values = value?.OrderBy(v => v.Minimum).ToList();
    }

    [Parameter]
    public bool EditMode
    {
        get => _editMode;
        set
        {
            // ReSharper disable once AssignmentInConditionalExpression
            if (_editMode = value && null != Values)
                //Minimums need to be set initially to fix any initial bad data.
                //TODO: Send notification if minimums were changed here.
            if (SetMinimums())
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "Invalid range minimums have been automatically fixed.",
                        Duration = 5000,
                        CloseOnClick = true
                    });

        }
    }

    [Parameter] public string ValuePlaceholder { get; set; } = "";
    [Parameter] public string ValueHeaderText { get; set; } = "";
    [Parameter] public T ValueMinimum { get; set; } = (T)Convert.ChangeType(0, typeof(T));
    [Parameter] public T ValueMaximum { get; set; } = (T)Convert.ChangeType(100, typeof(T));
    [Parameter] public bool ShowValidations { get; set; }
    [Parameter, EditorRequired] public required Func<ITieredValue<T>> CreationFunction { get; set; }

    public bool IsValid()
    {
        if (null == Values) return false;
        if (!Values.Any()) return false;
        var prevMax = 0;
        foreach (var tieredValue in Values)
        {
            if (tieredValue.Minimum != prevMax + 1) return false;
            prevMax = tieredValue.Maximum ?? -1;
        }
        return true;
    }

    void ShowTooltip(ElementReference element) => tooltipService.Open(element, "Clear value for unlimited.");

    void RemoveTier()
    {
        Values!.RemoveAt(Values.Count - 1);
        StateHasChanged();
    }

    void AddTier()
    {
        Values ??= [];
        Values.Add(CreationFunction());
    }

    private bool SetMinimums()
    {
        var previousMax = 0;
        Values ??= [];
        var minFixed = false;
        foreach (var tieredValue in Values)
        {
            if (tieredValue.Minimum != previousMax + 1)
            {
                tieredValue.Minimum = previousMax + 1;
                minFixed = true;
            }
            previousMax = tieredValue.Maximum ?? int.MaxValue;
        }
        if (minFixed)
            StateHasChanged();
        return minFixed;
    }

}
