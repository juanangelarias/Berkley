@page "/UserInfo"
@using James.Shared.Model
@using System.Diagnostics
@using James.Shared
@using James.Shared.Imaging
@inject HttpClient Http
@* @attribute [Authorize] *@
@inject ILoggingService _logging;
<h3>User Info</h3>
<hr/>
<VirtualFileSimpleUpload Title="POA Form Upload" DocumentCategory="ImagingDocumentCategory.Agency" />
<hr />
<table>
    <tr>
        <td>Username</td>
        <td>@SiteUserInfo?.Username</td>
    </tr>
    <tr>
        <td>FirstName</td>
        <td>@SiteUserInfo?.FirstName</td>
    </tr>
    <tr>
        <td>LastName</td>
        <td>@SiteUserInfo?.LastName</td>
    </tr>
    <tr>
        <td>FullName</td>
        <td>@SiteUserInfo?.FullName</td>
    </tr>
    <tr>
        <td>Initials</td>
        <td>@SiteUserInfo?.Initials</td>
    </tr>
    <tr>
        <td>Title</td>
        <td>@SiteUserInfo?.Title</td>
    </tr>
    <tr>
        <td>IsUnderwriter</td>
        <td>@(SiteUserInfo?.IsUnderwriter == true ? "True" : "false")</td>
    </tr>
    <tr>
        <td>IsHomeOfficeApprover</td>
        <td>@(SiteUserInfo?.IsHomeOfficeApprover == true ? "True" : "false")</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>@SiteUserInfo?.Email</td>
    </tr>
    <tr>
        <td style="vertical-align: top">AD Groups</td>
        <td>
            @if (null != SiteUserInfo && SiteUserInfo.ActiveDirectoryGroups.Length > 0)
            {
                <table>
                    @foreach (var group in SiteUserInfo.ActiveDirectoryGroups)
                    {
                        <tr><td>@group</td></tr>
                    }
                </table>
            }
        </td>
    </tr>
    //TODO:Remove after testing
    <tr>
        <td>
            <RadzenButton Text="Send Debug Message" Click='() => _logging.LogDebug("Sent by button")'></RadzenButton>
        </td>
    </tr>
    <tr>
        <td>
            <RadzenButton Text="Send Information Message" Click='() => _logging.LogInformation("Sent by button2")'></RadzenButton>
        </td>
    </tr>
    <tr>
        <td>
            <RadzenButton Text="Send Warning Message" Click='() => _logging.LogWarning("Sent by button3")'></RadzenButton>
        </td>
    </tr>
    <tr>
        <td>
            <RadzenButton Text="Send Error Message" Click='() => _logging.LogError("Sent by button4")'></RadzenButton>
        </td>
    </tr>
</table>


