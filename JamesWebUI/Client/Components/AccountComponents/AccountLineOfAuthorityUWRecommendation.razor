@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenDataGrid TItem="UnderwriterRecommendation" Data="@Recommendations">
    <HeaderTemplate>
        <AuthorizeView Policy="InRoleCanAddUnderwritingRecommendation">
            <RadzenButton Icon="add" Text="New Recommendation" Variant="Variant.Text" Click="@InsertRow"/>
        </AuthorizeView>
    </HeaderTemplate>
    <Template Context="recommendation">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0">
            <RadzenRow>
                <RadzenText Text="@recommendation.Description" TextStyle="TextStyle.Subtitle1"/>
            </RadzenRow>
            <RadzenRow>
                <RadzenText Text="@recommendation.Comments" Style="width: 100%" TextStyle="TextStyle.Body1" 
                            class="rz-text-wrap"/>
            </RadzenRow>
        </RadzenStack>
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="UW" TItem="UnderwriterRecommendation" 
                              Property="UnderwriterRecommendation.PostedByNavigation.FullName"/>
        <RadzenDataGridColumn Title="Posted on" Property="@nameof(UnderwriterRecommendation.Created)"
                              FormatString="{0:d}" Width="100px"/>
        <RadzenDataGridColumn Title="Description" Property="@nameof(UnderwriterRecommendation.Description)"/>
        <RadzenDataGridColumn Width="85px" MinWidth="85px" TItem="UnderwriterRecommendation" Filterable="false" 
                              Sortable="false" TextAlign="TextAlign.Right" Frozen="true" 
                              FrozenPosition="FrozenColumnPosition.Right" Resizable="false">
            <Template Context="recommendation">
                <AuthorizeView Policy="InRoleCanUpdateUnderwritingRecommendation">
                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Flat"
                                  Size="ButtonSize.Small"
                                  Click="@(_ => EditRow(recommendation))"
                                  @onclick:stopPropagation="true"/>
                </AuthorizeView>
                <AuthorizeView Policy="InRoleCanDeleteUnderwritingRecommendation">
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Icon="delete"
                                  Variant="Variant.Flat"
                                  Shade="Shade.Lighter"
                                  Size="ButtonSize.Small"
                                  class="my-1 ms-1"
                                  Click="@(_ => DeleteRow(recommendation))"
                                  @onclick:stopPropagation="true">
                    </RadzenButton>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public string AccountNum { get; set; }

    private List<UnderwriterRecommendation> Recommendations { get; set; } = [];
    private List<JamesLookup> _underwritersLookup = [];

    #region Loaders

    #region Underwriters

    private IDataAccessResult<List<Underwriter>> _underwritersResult = null!;

    private LoadItem UnderwritersLoad => AddEventNotify(new LoadItem<List<Underwriter>>
    {
        Key = CacheKeys.Underwriters,
        AsyncLoadTask = async () => _underwritersResult = await DataAccess.GetUnderwriters(),
        CacheLoadTask = cache => _underwritersResult = new DataAccessResult<List<Underwriter>>
        {
            Data = (List<Underwriter>)cache!
        },
        ResultVariable = () => _underwritersResult,
        AfterLoad = () =>
        {
            _underwritersLookup = _underwritersResult.Data!
                .Select(s => new JamesLookup
                {
                    Id = s.Id,
                    Code = s.IdNavigation.Initials,
                    Name = s.IdNavigation.FullName,
                })
                .ToList();
        }
    }, "underwriters");

    #endregion

    #region Recommendations Load

    private IDataAccessResult<List<UnderwriterRecommendation>> _recommendationsResult = null!;

    private LoadItem RecommendationsLoad => AddEventNotify(new LoadItem<List<UnderwriterRecommendation>>
    {
        Key = CacheKeys.UnderwriterRecommendation(AccountNum),
        AsyncLoadTask = async () => _recommendationsResult = await DataAccess.GetUnderwriterRecommendationByAccount(AccountNum),
        CacheLoadTask = cache => _recommendationsResult = new DataAccessResult<List<UnderwriterRecommendation>>
        {
            Data = (List<UnderwriterRecommendation>)cache!
        },
        ResultVariable = () => _recommendationsResult,
        AfterLoad = () =>
        {
            Recommendations = _recommendationsResult.Data!;
        }
    }, "underwriters recommendations");

    #endregion

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadUnderwriters();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadRecommendations();
    }

    private async Task LoadRecommendations()
    {
        await ShowLoading();
        await DataAccess.GetCacheOrLoadDataAsync(RecommendationsLoad);
    }

    private async Task LoadUnderwriters()
    {
        await ShowLoading();
        await DataAccess.GetCacheOrLoadDataAsync(UnderwritersLoad);
    }

    private async Task InsertRow()
    {
        var parameters = new Dictionary<string, object>
        {
            { "Underwriters", _underwritersLookup },
            {
                "Recommendation", new UnderwriterRecommendation
                {
                    Id = Guid.NewGuid(),
                    AccountNum = AccountNum,
                    Created = DateTime.Now,
                    Comments = string.Empty,
                    Description = string.Empty,
                }
            }
        };

        var dialogResponse = await DialogService.OpenAsync<AccountEditUnderwriterRecommendation>(
            "Create an Underwriter Recommendation", parameters, GetDialogOptions());
        
        if(dialogResponse == null)
            return;

        var newRecommendation = (UnderwriterRecommendation)dialogResponse;
        var response = await DataAccess.SetUnderwriterRecommendation(newRecommendation.Id, newRecommendation.AccountNum,
            newRecommendation.PostedBy, newRecommendation.Comments!, newRecommendation.Description!);

        if (!response.Success)
        {
            NotifySaveError(response.Errors, "underwriter recommendation");
            return;
        }

        newRecommendation.PostedByNavigation = new UserProfile
        {
            Id = newRecommendation.PostedBy,
            FullName = _underwritersLookup
                .FirstOrDefault(f => f.Id == newRecommendation.PostedBy)?
                .Name ?? string.Empty
        };
        
        NotifySuccessfulSave("underwriter recommendation");
        Recommendations.Add(newRecommendation);
        Recommendations = Recommendations
            .OrderByDescending(o => o.Created)
            .ToList();
        
        UpdateCache();
    }

    private async Task EditRow(UnderwriterRecommendation recommendation)
    {
        var parameters = new Dictionary<string, object>
        {
            { "Underwriters", _underwritersLookup },
            { "Recommendation", recommendation }
        };

        var dialogResponse = await DialogService.OpenAsync<AccountEditUnderwriterRecommendation>(
            "Update Underwriter Recommendation", parameters, GetDialogOptions());
        
        if(dialogResponse == null)
            return;
        
        var updatedRecommendation = (UnderwriterRecommendation)dialogResponse;
        var response = await DataAccess.SetUnderwriterRecommendation(updatedRecommendation.Id, 
            updatedRecommendation.AccountNum, updatedRecommendation.PostedBy, updatedRecommendation.Comments!, 
            updatedRecommendation.Description!);

        if (!response.Success)
        {
            NotifySaveError(response.Errors, "underwriter recommendation");
            return;
        }
        
        NotifySuccessfulSave("underwriter recommendation");
        Recommendations.Remove(recommendation);
        Recommendations.Add(updatedRecommendation);
        Recommendations = Recommendations
            .OrderByDescending(o => o.Created)
            .ToList();
        
        UpdateCache(); 
    }

    private async Task DeleteRow(UnderwriterRecommendation recommendation)
    {
        var response = await DataAccess.DeleteUnderwriterRecommendation(recommendation.Id);
        
        if (!response.Success)
            NotifySaveError(response.Errors, "underwriter recommendation");
        else
            NotifyDeleteSuccessful("underwriter recommendation");

        var toDelete = Recommendations
            .FirstOrDefault(f => f.Id == recommendation.Id);
        
        if(toDelete != null)
        {
            Recommendations.Remove(toDelete);
            UpdateCache();  
        }
    }

    private DialogOptions GetDialogOptions()
    {
        return new DialogOptions
        {
            Draggable = true,
            Resizable = false,
            CloseDialogOnEsc = true,
            ShowClose = true,
            CloseDialogOnOverlayClick = false
        };
    }

    private void UpdateCache()
    {
        DataAccess.UpdateCache(CacheKeys.UnderwriterRecommendation(AccountNum), Recommendations);
    }
}