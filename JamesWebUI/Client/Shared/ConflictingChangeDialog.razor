@using James.Shared
@using Radzen.Blazor
@inherits LayoutComponentBase

@page "/Shared/ConflictingChangeDialog"

<h3>
    <RadzenText> Another user saved changes that conflict with your current changes.</RadzenText>
</h3>
<RadzenText>
    Which data do you want to keep?
</RadzenText>
@* TODO: Add ? icon to give more information *@

<RadzenRow>
    <RadzenColumn>
        <RadzenText>Property</RadzenText>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenText>Keep which? (Your change|Their Change)</RadzenText>
    </RadzenColumn>
</RadzenRow>
@foreach (var conflict in _resolvers)
{
    <RadzenRow>
        <RadzenColumn>
            <RadzenText Text="@conflict.Key" />
        </RadzenColumn>
        <RadzenColumn>
            <RadzenSelectBar @ref=@ResolveEditor Value="@conflict.TargetValue" TValue="object">
                <RadzenSelectBarItem Value="@conflict.SourceValue" Text="@conflict.SourceValue.ToString()" />
                <RadzenSelectBarItem Value="@conflict.TargetValue" Text="@conflict.TargetValue.ToString()" />
            </RadzenSelectBar>
        </RadzenColumn>
    </RadzenRow>
}
<RadzenRow>&nbsp;</RadzenRow>
<RadzenRow>
    <RadzenColumn>
        <RadzenButton Text="Ok" Click="@OkClicked"></RadzenButton>
    </RadzenColumn>
</RadzenRow>
@code {
  
}
