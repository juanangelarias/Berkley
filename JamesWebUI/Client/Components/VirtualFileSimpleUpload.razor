@using System.ComponentModel.DataAnnotations
@using James.Shared.Imaging
@using FileNetP8SoapService
@using James.Data.Imaging
@* @inject TooltipService TooltipService *@

<RadzenTemplateForm TItem="string" Submit=@StartUpload>
    <RadzenPanel Variant="Variant.Outlined">
        <h3>@Title</h3>
        <RadzenPanel Visible=@(!linkingToExisting)>
            <RadzenRow Gap="0rem" RowGap="0rem" class="rz-m-0 rz-m-md-12">
                <RadzenColumn Size="9">
                    <RadzenUpload id="ddUpload" @ref="uploadDD"
                                  ChooseText="Drag and drop here or click to choose document"
                                  Auto="false" Multiple="false" Url="upload/multiple"
                                  InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})"
                                  Change=@UploadFileChanged
                                  Progress=@(args => OnProgress(args, "Drag and drop file to upload")) Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Link to existing document" Click=@ToggleWorkflow />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="0rem" RowGap="0rem" class="rz-m-0 rz-m-md-12">
                <RadzenFormField Text="Name" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox Name="tbFileName" @ref="tbFilename" @bind-Value=@currentFileName Style="width:100%" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="tbFileName" Text="Name is required." />
                        <RadzenRegexValidator Text="Must be a filename without path"
                                              Pattern="[\\/]" />
                        <RadzenCustomValidator Text="Must be a valid filename"
                                               Validator="@(()=>ClientBusinessLogic.Validators.ValidateFileName(currentFileName))" />
                        <RadzenCustomValidator Text="File extension is not allowed by BTS"
                                               Validator="@(()=>!ClientBusinessLogic.Validators.ValidateFileName(currentFileName)|| SharedBusinessLogic.ImagingBusinessLogic.IsValidImagingFileName(currentFileName))" />
                    </Helper>
                </RadzenFormField>
            </RadzenRow>
            <RadzenRow Visible="@(progress>0)">
                <RadzenColumn Size="12">
                    <RadzenProgressBar Value=@progress />
                    <RadzenText ref="@uploadedBytes" />
                    <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Cancel" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenButton Text="Upload" Disabled="@fileSelected"
                                  ButtonType="ButtonType.Submit" class="rz-mt-4" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
        <RadzenPanel Visible=@linkingToExisting>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Upload a new document" Click=@ToggleWorkflow />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    @*UNDONE: Pull real data*@
                    <RadzenDataList TItem="document" Data=@FakeDocList>
                        <Template Context="doc">
                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenText Text=@doc.contentList[0].fileName/>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenText Text=@doc.EntryDate().ToShortDateString()/>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenButton Variant="Variant.Text" Text="Link" Click=@(() => LinkExistingAndClose(doc.guid))/>
                                </RadzenColumn>
                            </RadzenRow>
                        </Template>
                    </RadzenDataList>
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
    </RadzenPanel>
</RadzenTemplateForm>
@* ReSharper disable CSharpWarnings::CS8618 *@
@* ReSharper disable InconsistentNaming *@
@code {
    RadzenUpload uploadDD;
    RadzenTextBox tbFilename;
    RadzenText uploadedBytes;
    [Parameter] public string Title { get; set; } = "UploadFile";
    [Parameter] public Action<Guid>? UploadAction { get; set; }
    [Required]
    [Parameter] public ImagingDocumentCategory DocumentCategory { get; set; }
    [Required]
    [Parameter] public string DocumentType { get; set; }
    [Parameter] public Guid DocumentId { get; set; } = new Guid();

    document[] FakeDocList =
    [
        new()
        {
            guid = new Guid().ToString(), documentClass = "BSG_AGENCY",
            contentList =
            [
                new() { fileName = "FakeDoc.pdf" }
            ],
            properties = [
                new(){name = ImagingAccessBase.ScanDate, displayName = ImagingAccessBase.ScanDate},
                new(){name=ImagingAccessBase.EntryDate, displayName = ImagingAccessBase.EntryDate, dateValue = new DateTime(2024,1,1,8,53,0)}
            ]
        },
    new()
        {
            guid = new Guid().ToString(), documentClass = "BSG_AGENCY",
            contentList =
            [
                new() { fileName = "FakeDoc.docx" }
            ],
            properties = [
                new(){name = ImagingAccessBase.ScanDate, displayName = ImagingAccessBase.ScanDate},
                new(){name=ImagingAccessBase.EntryDate, displayName = ImagingAccessBase.EntryDate, dateValue = new DateTime(2023, 3,1,9,53,0)}
            ]
        },
    new()
        {
            guid = new Guid().ToString(), documentClass = "BSG_AGENCY",
            contentList =
            [
                new() { fileName = "FakeSpreadsheet.xlsx" }
            ],
            properties = [
                new(){name = ImagingAccessBase.ScanDate, displayName = ImagingAccessBase.ScanDate},
                new(){name=ImagingAccessBase.EntryDate, displayName = ImagingAccessBase.EntryDate, dateValue = new DateTime(2022,5,4,14,14,0) }
            ]
        }
    ];

    string currentFileName;
    FileInfo? currentFile;
    bool fileSelected;
    bool linkingToExisting;
    int progress;
    //void ShowTooltip(ElementReference elementReference, TooltipOptions options = null!) => TooltipService.Open(elementReference, "Name as it will be saved in Virtual File", options);

    void OnProgress(UploadProgressArgs args, string name)
    {
        progress = args.Progress;
        uploadedBytes.Text = $"({args.Loaded.ToScreenBytes()}/{args.Total.ToScreenBytes()})";
        if (progress == 100)
        {
            //TODO: Auto-close pop-up, possibly after a success animation
        }
    }

    private void LinkExistingAndClose(string guid)
    {
        //TODO: handle invalid guid strings
        UploadAction?.Invoke(DocumentId);
        //TODO: Autoclose
    }

    private void UploadFileChanged(UploadChangeEventArgs args)
    {
        var file = args.Files.SingleOrDefault();
        if (null == file)
        {
            currentFileName = string.Empty;
            if (currentFile != file)
            {
                currentFile = file;
                StateHasChanged();
            }

            return;
        }

        if (string.IsNullOrWhiteSpace(currentFileName) || null != currentFile)
            //Should allow user to type the file name and then select the file without wiping out what they typed.
            currentFileName = file.Name;
        else
            //Keep the name the user has already inputted, but make sure it's file extension matches the selected file.
            currentFileName = Path.ChangeExtension(currentFileName, Path.GetExtension(file.Name));
        currentFile = file;
        StateHasChanged();
    }

    private void StartUpload()
    {
        if (null == currentFile) return;
        //TODO:Exit if values aren't valid
        uploadDD.Url = $"ImagingRepository/UploadDocument/{DocumentType}/{(int)DocumentCategory}?filename={currentFileName};documentId={DocumentId}";
        uploadDD.Upload();
        //TODO:Handle imaging upload failure
        UploadAction?.Invoke(DocumentId);
        //TODO: Autoclose
    }

    // private void LinkExisting()
    // {
    //     throw new NotImplementedException();
    // }

    private void ToggleWorkflow()
    {
        linkingToExisting = !linkingToExisting;
        //TODO:Animate the transition if time allows
    }

}
@* ReSharper restore InconsistentNaming *@
@* ReSharper restore CSharpWarnings::CS8618 *@
