@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager


@inject IDataAccess DataAccess

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
    <RadzenText Text="Search Account: " Style="margin-right: 0;" />
    <RadzenAutoComplete @ref="@AutoComplete" MinLength="3" Style="width: 60%;" 
                        Variant="Variant.Text" SelectedItemChanged="@ResultSelected"
                        Placeholder="Account Name, Account No." Data="@SearchResults" LoadData="SearchAccount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Template Context="account">
            <RadzenStack Orientation="Orientation.Horizontal" Style="width:70%;">
                <RadzenIcon Icon="person"/>
                <RadzenText Text="@account.AccountNum" Style="width: 20%;"/>
                <RadzenText Text="@account.IdNavigation.FullName" Style="width: 70%;"/>
            </RadzenStack>
        </Template>
    </RadzenAutoComplete>
    <RadzenIcon Icon="search" Style="margin-left: -5px;"/>
    <RadzenButton Text="Create New Account" Click="CreateNewAccount" Icon="add" Style="margin-left: 15px;"/>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public EventCallback<string> SetAccount { get; set; }
    [Parameter, EditorRequired] public EventCallback CreateNewAccount { get; set; }
    
    private List<Account> SearchResults { get; set; } = new List<Account>();
    private Account SelectedAccount { get; set; } = new Account();
    private RadzenAutoComplete AutoComplete { get; set; } = null!;


    private async Task SearchAccount(LoadDataArgs args)
    {
        var result = await DataAccess.SearchAccounts(args.Filter);

        if (result.Errors.Any())
        {
            //TODO: Error Handling
        }
        else
        {
            SearchResults = result.Data!;
        }
    }

    private void ResultSelected(dynamic args)
    {
        var account = (Account?)args;
        if (account == null) 
            return;
        
        NavigationManager.NavigateTo("/Account/" + ((Account)AutoComplete.Value).AccountNum);
        AutoComplete.Value = "";
    }
}