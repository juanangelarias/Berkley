<RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
    <RadzenTabs TabPosition="TabPosition.Top">
        <Tabs>
            <RadzenTabsItem Text="Agency">
                <AccountAgency Account="@Account"/>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Addresses">
                <AccountAddresses Account="@Account"/>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>


@code {
    [Parameter, EditorRequired] public required Account Account { get; set; }
}