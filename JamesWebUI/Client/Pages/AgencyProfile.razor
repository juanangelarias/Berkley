@page "/Agency/{Id}"

@using System.Security.Claims
@using James.Shared

@inherits LayoutComponentBase

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@*@inject JamesClient JamesClient  TODO:Remove after debugging *@
@inject IDataAccess _dataAccess
@inject ILoggingService _logging
@attribute [Authorize]

<Theme />

<PageTitle>Agency Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>
<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" Collapsed="SummaryView">
        <FooterTemplate>
            <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                <RadzenButton Icon="expand_less" Variant="Variant.Text" Click="@(() => SummaryView = !SummaryView)" />
            </RadzenStack>
        </FooterTemplate>
        <SummaryTemplate>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                    <RadzenButton Icon="expand_more" Variant="Variant.Text" Click="@(() => SummaryView = !SummaryView)" />
                </RadzenStack>
            </RadzenRow>
        </SummaryTemplate>
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenRow>
                                <RadzenColumn Size="3">
                                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="3">
                                    <RadzenFormField Text="Parent No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.ParentNavigation?.AgencyIdNavigation?.AgencyNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="Parent" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.ParentNavigation?.FullName" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenFormField Text="Tax ID" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@Username" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Approved Date" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="NPN" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@agencyToDisplay?.NationalProducerNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <br />
                            </RadzenRow>
                            <RadzenRow Gap="2">
                                <RadzenColumn Size="12">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@agencyToDisplay.W9"
                                                            Text="W-9" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success"
                                                            Text="Need 1099" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@agencyToDisplay.Nasbp"
                                                            Text="NASBP" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenTabs>
                        <Tabs>
                            <RadzenTabsItem Text="Main">
                                <AddressDisplay AddressId="@mainAddress.Id" />
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Billing">
                                <AddressDisplay AddressId="@billingAddress.Id" />
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Errors & Omissions Coverage">
                                <RadzenStack Orientation="Orientation.Vertical">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Carrier">
                                        <RadzenText Text="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Carrier" />
                                    </RadzenFormField>
                                    <RadzenFormField AllowFloatingLabel="false" Text="Exp Date">
                                        <RadzenText Text="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Expiration.ToShortDateString()" />
                                    </RadzenFormField>
                                    <RadzenFormField AllowFloatingLabel="false" Text="Limit">
                                        <RadzenText Text="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.CoverageLimit.ToString("c0")" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px">
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="General Info">
                    <AgencyGeneralInfoGrids agencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Contacts">
                    <AgencyContactsGrid AgencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Inventory">
                    <AgencyInventoryGrid AgencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Accounts and Bonds">
                    <AgencyAccountsAndBonds agencyToDisplay="@agencyToDisplay" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Commission Rates">
                    <AgencyCommissionRates AgencyId="@agencyToDisplay.Id" AgencyStatus="@agencyToDisplay?.Status" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Virtual File">
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenPanel>
</RadzenStack>

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private string Username = "";
    public Notification[]? notifications;
    List<string> blankList = new List<string>();
    private bool contactsGridView = false;
    private Agency agencyToDisplay = new Agency();
    private Address mainAddress = new Address();
    private Address billingAddress = new Address();
    private bool SummaryView = false;
    IDisposable? session;
    RadzenDataGrid<AgencyLicense>? licenseGrid;

    private bool mainAddressEditMode { get; set; } = false;
    private bool billingAddressEditMode { get; set; } = false;



    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();


        if (authenticationState != null)
        {
            var state = await authenticationState;

            Username = state.User.FindFirst("nickname")?.Value ?? string.Empty;
        }
        //TODO: Remove after testing
        _logging.LogInformation("AgencyProfile initialized for AgencyId: " + Id, data: new Dictionary<string, string> { { "username", Username } });
        // session = JamesClient.AddressModified.Watch().Subscribe(a =>
        //     {
        //         ShowNotification(new NotificationMessage
        //             {
        //                 Severity = NotificationSeverity.Info,
        //                 Detail = "Information on this page has been changed by another user.",
        //                 Duration = 4000
        //             });
        //     });
        session = _dataAccess.AddressModified(a =>
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Detail = "Information on this page has been changed by another user.",
                Duration = 4000
            });
        });

        ThemeService.Initialize(NavigationManager);

        notifications = new Notification[]{
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 1234567"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 2345678"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 3456789"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 4567890"}
    };
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var result = await _dataAccess.GetAgencyByAgencyNumber(Id);
        if (result.Success)
        {
            agencyToDisplay = result.Data; //ThisToThat.ToEntityType<Agency>(result.Data.AgencyByAgencyNumber);

            mainAddress = agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address ?? new Address();
            billingAddress = agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Billing")?.Address ?? new Address();
        }
        else
        {
            _logging.LogWarning("GetAgencyByAgencyNumber returned error(s)", string.Join("\r\n", result.Errors), "GraphQl");
        }
    }

    private void ToggleMainAddressEditMode()
    {
        mainAddressEditMode = !mainAddressEditMode;
    }
    private void ToggleBillingAddressEditMode()
    {
        billingAddressEditMode = !billingAddressEditMode;
    }
    async Task SubmitAddressChange(Address newAddress)
    {
        await _dataAccess.SetAddress(newAddress);

    }
    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
    async Task AddressChangeDetected(Address result)
    {
        var data = result;
    }
    private async Task CanChange(StepsCanChangeEventArgs args)
    {
        return;
    }
}
