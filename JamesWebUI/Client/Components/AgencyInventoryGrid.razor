@using System.ComponentModel.DataAnnotations

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess

<Theme />
<RenderModeBackground />

<RadzenDataGrid TItem="AgencyInventory" @ref="@InventoryGrid" Data="@AgencyInventories"
                Style="border-radius: 10px; height: 400px;" Density="Density.Compact" EmptyText="No records to display"
                AllowSorting="true" AllowGrouping="true" EditMode="DataGridEditMode.Single" AllowColumnPicking="true"
                AllowFiltering="true" FilterMode="FilterMode.Simple" SelectionMode="DataGridSelectionMode.Single"
                RowUpdate="UpdateInventoryRow" RowCreate="CreateInventoryRow"
                IsLoading="@IsLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New Record" Variant="Variant.Text" Click="@InsertInventoryRow" />
            <RadzenButton Text="Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.Excel))" Disabled="@IsLoading" />
            <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.CSV))" Disabled="@IsLoading" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Date Sent" Property="Sent" FormatString="{0:d}"
                              Filterable="false" SortOrder="SortOrder.Descending" Width="200px">
            <Template Context="inventory">
                <RadzenText Text="@(inventory.Sent?.ToShortDateString())" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDatePicker TValue="DateTime?" ShowTime="false" @bind-Value="@inventory.Sent" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Doc Type" Property="DocumentType">
            <Template Context="inventory">
                <RadzenText Text="@inventory.DocumentType" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDropDown TValue="string" TextProperty="DocumentType" ValueProperty="DocumentType" @bind-Value="@inventory.DocumentType" Data="AllDocTypes" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Quantity" Property="Quantity"
                              Filterable="false" Width="125px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Quantity.ToString()" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenNumeric @bind-Value="@inventory.Quantity" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Sent To" Property="Addressee">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Addressee" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Addressee" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Address" Property="Address.Address1">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.Address1" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address!.Address1" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Address2" Property="Address.Address2"
                              Visible="false">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.Address2" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address!.Address2" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Address3" Property="Address.Address3"
                              Visible="false">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.Address3" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address!.Address3" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="City" Property="Address.City"
                              Width="150px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.City" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address!.City" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="State" Property="Address.StateCode"
                              Width="150px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.StateCode" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDropDown TValue="string" @ref="StateDropDown" Data="AllStates" @bind-Value="@inventory.Address!.StateCode"
                                TextProperty="Name" ValueProperty="Code" Style="width:95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Zip Code" Property="Address.PostalCode"
                              Visible="false">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address?.PostalCode" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address!.PostalCode" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="75px" TItem="AgencyInventory" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="inventory">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => EditInventoryRow(inventory))" @onclick:stopPropagation="true">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => DeleteInventoryRow(inventory))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="inventory">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => SaveInventoryRow(inventory))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => CancelInventoryEdit(inventory))">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => DeleteInventoryRow(inventory))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
   
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter, Required] public Guid AgencyId { get; set; }

    private RadzenDataGrid<AgencyInventory> InventoryGrid { get; set; } = null!;
    private List<AgencyInventory> AgencyInventories { get; set; } = [];
    private List<AgencyInventory> InventoriesToInsert { get; set; } = [];
    private List<AgencyInventory> InventoriesToUpdate { get; set; } = [];
    private bool IsLoading { get; set; }

    //TODO: Implement an AllUsers list.
    private List<State> AllStates { get; set; } = [];
    private List<InventoryDocumentDm> AllDocTypes { get; set; } = [];
    private RadzenDropDown<string> StateDropDown { get; set; } = null!;
    
    private IDataAccessResult<List<AgencyInventory>> _inventoryResult = null!;
    private IDataAccessResult<List<State>> _states = null!;
    private IDataAccessResult<List<InventoryDocumentDm>> _docTypes = null!;

    private LoadItem InventoryLoad => AddEventNotify(new LoadItem
    {
        Key = $"Inventory{AgencyId}",
        AsyncLoadTask = async () => _inventoryResult = await DataAccess.GetAgencyInventory(AgencyId),
        CacheLoadTask = cache => _inventoryResult = new DataAccessResult<List<AgencyInventory>>
        {
            Data = (List<AgencyInventory>)cache!
        },
        ResultVariable = () => _inventoryResult,
        AfterLoad = () => { AgencyInventories = _inventoryResult.Data!; }
    }, "agency inventory");

    private LoadItem StatesLoad => AddEventNotify(new LoadItem
    {
        Key = "States",
        AsyncLoadTask = async () => _states = await DataAccess.GetAllStates(),
        CacheLoadTask = cache => _states = new DataAccessResult<List<State>>
        {
            Data = (List<State>)cache!
        },
        ResultVariable = () => _states,
        AfterLoad = () =>
        {
            AllStates = _states.Data!;
        }
    }, "states");

    private LoadItem DocumentsLoad => AddEventNotify(new LoadItem
    {
        Key = "DocumentTypes",
        AsyncLoadTask = async () => _docTypes = await DataAccess.GetAllInventoryDocTypes(),
        CacheLoadTask = cache => _docTypes = new DataAccessResult<List<InventoryDocumentDm>>
        {
            Data = (List<InventoryDocumentDm>)cache!
        },
        ResultVariable = () => _docTypes,
        AfterLoad = () =>
        {
            AllDocTypes = _docTypes.Data!;
        }
    }, "document types");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await ShowLoading();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (AgencyId == Guid.Empty)
            return;

        await DataCache.ParallelGetCacheOrDataAsync(StatesLoad, DocumentsLoad, InventoryLoad);
    }

    void Reset()
    {
        InventoriesToInsert.Clear();
        InventoriesToUpdate.Clear();
    }

    void Reset(AgencyInventory inventory)
    {
        InventoriesToInsert.Remove(inventory);
        InventoriesToUpdate.Remove(inventory);
    }

    private async Task LoadInventory()
    {
        await ShowLoading();

        await DataCache.GetCacheOrLoadDataAsync(InventoryLoad);
    }

    private async Task EditInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        Reset();
        InventoriesToUpdate.Add(inventory);
        await InventoryGrid.EditRow(inventory);
    }

    private async Task DeleteInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        Reset(inventory);
        var result = await DataAccess.DeleteAgencyInventory(inventory.Id);

        if (result.Success)
        {
            NotifySuccessfulSave("Agency Inventory Deleted");
            await LoadInventory();
        }
        else
        {
            NotifySaveError(result.Errors, "Agency Inventory deletion");
        }
    }

    private async Task SaveInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        await InventoryGrid.UpdateRow(inventory);
        await LoadInventory();
    }

    private async Task CancelInventoryEdit(AgencyInventory inventory)
    {
        await ShowLoading();
        Reset(inventory);
        InventoryGrid.CancelEditRow(inventory);
        await LoadInventory();
    }

    private async Task InsertInventoryRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        await ShowLoading();
        var newInventory = new AgencyInventory()
        {
            Id = Guid.NewGuid(),
            Address = new Address() { Id = Guid.NewGuid() }
        };
        InventoriesToInsert.Add(newInventory);
        await InventoryGrid.InsertRow(newInventory);
    }

    private async Task UpdateInventoryRow(AgencyInventory inventory)
    {
        Reset(inventory);
        //This is where the actual update is handled.
        var result = await DataAccess.SetAgencyInventory(inventory.Id,
            inventory.Sent,
            inventory.Quantity,
            inventory.DocumentType,
            inventory.Addressee,
            inventory.Address!.Id,
            inventory.Address.Address1,
            inventory.Address.Address2,
            inventory.Address.Address3,
            inventory.Address.City,
            inventory.Address.StateCode,
            inventory.Address.PostalCode);

        if (result.Success)
        {
            NotifySuccessfulSave("agency inventory");
        }
        else
        {
            NotifySaveError(result.Errors, "agency inventory");
        }
    }

    private async Task CreateInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        var result = await DataAccess.CreateAgencyInventory(inventory.Id, AgencyId, Convert.ToDateTime(inventory.Sent),
            Convert.ToInt32(inventory.Quantity), inventory.DocumentType, inventory.Addressee ?? "",
            inventory.Address?.Address1 ?? "", inventory.Address?.Address2 ?? "", inventory.Address?.Address3 ?? "",
            inventory.Address?.City ?? "", inventory.Address?.StateCode ?? "", inventory.Address?.PostalCode ?? "",
            inventory.Approver);

        if (result.Success)
        {
            InventoriesToInsert.Remove(inventory);
            NotifySuccessfulSave("agency inventory");
        }
        else
        {
            NotifySaveError(result.Errors, "agency inventory");
        }
    }

    protected async Task ShowLoading()
    {
        IsLoading = true;

        await Task.Yield();

        IsLoading = false;
    }

    private void ExportLicenseGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Sent", title: "Date Sent");
        substitutions.AddSubstitution("DocumentType", title: "Doc Type");
        substitutions.AddSubstitution("Addressee", title: "Sent To");
        substitutions.AddSubstitution("Address.Address1", title: "Address1");
        substitutions.AddSubstitution("Address.Address2", title: "Address2");
        substitutions.AddSubstitution("Address.Address3", title: "Address3");
        substitutions.AddSubstitution("Address.City", title: "City");
        substitutions.AddSubstitution("Address.StateCode", title: "State");
        substitutions.AddSubstitution("Address.PostalCode", title: "Zip Code");
        NavigationManager.NavigateTo(ExportDataGridUrl(InventoryGrid,
                $"/export/AgencyInventory/{AgencyId}", format, substitutions),
            true);
    }
}
