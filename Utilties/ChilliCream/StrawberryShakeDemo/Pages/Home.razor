<UseGetAccountByAccountNumber Context="result1" Strategy="ExecutionStrategy.CacheAndNetwork" AccountNum="1001">
    <ChildContent>
        @* <p>At least I'm trying</p>
        @if (null != result1)
        {
            <li>Result 1 type is @result1.GetType()</li>
            <li>result 1 returned something!</li>
        } *@
        @if (null != result1?.Account)
        {
            <ul>
                <li>@result1?.Account?.IdNavigation.FullName (@result1.Account.IdNavigation.LegalEntityAddresses[0].Address.City)</li>
            </ul>
        }
        else
        {
            <p>No data found :(</p>
        }
    </ChildContent>
    <ErrorContent>
        Something went wrong ...<br />
        <ul>
            @if (null != webResult?.Errors)
            {
                @foreach (var error in @webResult.Errors!)
                {
                    <li>@error.Message</li>
                }
            }
            else if (null != _exception)
            {
                <li>Exception: @_exception</li>
            }
            else
            {
                <li>No errors returned</li>
            }
        </ul>

    </ErrorContent>
    <LoadingContent>
        Loading ...
    </LoadingContent>
</UseGetAccountByAccountNumber>
