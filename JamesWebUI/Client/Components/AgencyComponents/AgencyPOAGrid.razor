@using SharedBusinessLogic
@using James.Shared.Imaging

@inherits JamesGridLayoutComponentBase<PowerOfAttorney>

@inject NavigationManager NavigationManager
@inject TooltipService TooltipService
@inject IDataAccess DataAccess

<Theme/>

<RadzenDataGrid @ref="Grid" TItem="PowerOfAttorney" Data="PowerOfAttorneys" GridLines="DataGridGridLines.Vertical"
                AllowFiltering="true" FilterMode="FilterMode.Advanced" Style="height: 400px; border-radius: 10px;"
                AllowColumnResize="true" AllowSorting="true" AllowGrouping="true" AllowColumnPicking="true"
                Density="Density.Compact" RowCreate="@OnPoaCreate" RowUpdate="@UpdatePoaRow"
                EditMode="DataGridEditMode.Single" IsLoading="@IsLoading" Sort="@ShowLoading" Page="@ShowLoading"
                Group="@ShowLoading" Filter="@ShowLoading" ColumnWidth="150px" AllowColumnReorder="true"
                @bind-Settings="@GridSettings">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <AuthorizeView Policy="InRoleCanAddAgencyPOA">
                <RadzenButton Icon="add" Text="New POA" Variant="Variant.Text" Click="@InsertPOARow"
                              Visible="@(ActiveOnly)"/>
            </AuthorizeView>
            <BsgExportGridToButton IsLoading="@IsLoading" ExportGrid="ExportGrid" ExportFormat="DefaultExportFormat"/>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="margin-left: 3rem">
                <RadzenButton Icon="settings" Click="SaveGridSettings"
                              MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                              Visible="@UserSettingsChanged"/>
                <RadzenButton Icon="reset_settings" Click="ClearGridSettings"
                              MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                              Visible="@UserSettingsLoaded"/>
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="poa">
        <RadzenDataList TItem="PowerOfAttorneyDocumentStatus" Data="poa.PowerOfAttorneyDocumentStatuses"
                        Density="Density.Compact" Style="max-height:400px; overflow:auto; width:100%" WrapItems="false"
                        AllowPaging="false">
            <Template Context="poaDocStatus">
                <PowerOfAttorneyDocumentStatusCard PoaDocumentStatus="@poaDocStatus" DocTypes="@DocTypes"/>
            </Template>
        </RadzenDataList>
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="Status" Property="Status" Type="typeof(string)"
                              FilterValue="@_statusFilter" FilterProperty="Status" Width="150px" MinWidth="150px"
                              FilterOperator="FilterOperator.Contains" LogicalFilterOperator="LogicalFilterOperator.Or">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_statusFilter" AllowClear="true" Style="width:95%"
                                Multiple="true" TValue="List<string>" Data="@AllStatuses"/>
            </FilterTemplate>
            <EditTemplate Context="poa">
                <RadzenDropDown TValue="string" @bind-Value="poa.Status" Data="@AllStatuses" Style="width: 95%"/>
            </EditTemplate>
            <Template Context="poa">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.2rem">
                    @{
                        switch (poa.Status)
                        {
                            case "Active":
                                <JamesStatusIcon IconStyle="IconStyle.Success"/>
                                break;
                            case "In Process":
                                <JamesStatusIcon IconStyle="IconStyle.Warning"/>
                                break;
                            case "Terminated":
                                <JamesStatusIcon IconStyle="IconStyle.Danger"/>
                                break;
                        }
                    }
                    <RadzenText Text="@poa.Status"/>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PowerOfAttorney" Title="Writing Company" Property="Insurer" Width="350px"
                              MinWidth="350px" FilterProperty="Insurer.IdNavigation.FullName"
                              FilterOperator="FilterOperator.Contains" LogicalFilterOperator="LogicalFilterOperator.Or">
            <Template Context="poa">
                <RadzenText Text="@poa.Insurer.IdNavigation.FullName"/>
            </Template>
            <EditTemplate Context="poa">
                <RadzenDropDown TValue="Insurer" Data="AllInsurers" Style="width:95%" Name="CmbInsurer"
                                TextProperty="IdNavigation.FullName" @bind-Value="@poa.Insurer"/>
                <RadzenRequiredValidator Text="Insurer is required" Component="CmbInsurer" Popup="true"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Limit" Property="Limit" FormatString="{0:c0}" Filterable="false" Width="175px"
                              MinWidth="175px">
            <EditTemplate Context="poa">
                <RadzenNumeric @bind-Value="poa.Limit" Format="c0" Style="width: 95%" ShowUpDown="false"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Ref No." Property="ReferenceNumber" Width="150px" MinWidth="150px">
            <EditTemplate Context="poa">
                <RadzenTextBox @bind-Value="poa.ReferenceNumber" Style="width: 95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="First Issue Date" Property="FirstIssued" Width="200px"
                              MinWidth="200px" TextAlign="TextAlign.Center">
            <Template Context="poa">
                <RadzenText Text="@($"{poa.FirstIssued:MM/dd/yyyy}")" TextStyle="TextStyle.Body2"/>
            </Template>
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.FirstIssued" Style="width: 95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Current POA Date" Property="CurrentIssued" SortOrder="SortOrder.Descending"
                              Width="240px" MinWidth="240px" TextAlign="TextAlign.Center">
            <EditTemplate Context="poa">
                <RadzenText Text="@($"{poa.CurrentIssued:MM/dd/yyyy}")" TextStyle="TextStyle.Body2"/>
            </EditTemplate>
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.CurrentIssued" Style="width: 95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="POA Document" Width="150px" MinWidth="150px" Filterable="false">
            <Template Context="poa">
                <InlineImagingDocument DocumentShortName="POA Document"
                                       DocumentCategory="ImagingDocumentCategory.Agency"
                                       DocumentId="@poa.ImagingId"
                                       DocumentType="@($"AG{poa.Insurer.ToWritingCompany()}POA")"
                                       ImagingId="@poa.Agency.AgencyNumber"
                                       AllowUploads=@(null != poa.Insurer.ToWritingCompany())
                                       UploadAction=@(async void (guid) => await PoaDocumentUploaded(guid, poa.Id))
                                       UploadErrorAction=@(msg => LogUploadError(msg, poa))/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="PowerOfAttorney"
                              Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="75px"
                              MinWidth="80px" Pickable="false" Visible="@(ActiveOnly)" >
            <Template Context="poa">
                <AuthorizeView Policy="InRoleCanEditAgencyPOA">
                    <RadzenButton Variant="Variant.Flat"
                                  Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(_ => EditPoaRow(poa))"
                                  @onclick:stopPropagation="true"/>
                </AuthorizeView>
                <AuthorizeView Policy="InRoleCanDeleteAgencyPOA">
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Icon="delete"
                                  Variant="Variant.Flat"
                                  Shade="Shade.Lighter"
                                  Size="ButtonSize.Small"
                                  class="my-1 ms-1"
                                  Click="@(_ => DeletePoaRow(poa))"
                                  @onclick:stopPropagation="true"/>
                </AuthorizeView>
            </Template>
            <EditTemplate Context="poa">
                <RadzenButton Icon="check"
                              ButtonStyle="ButtonStyle.Success"
                              Variant="Variant.Flat"
                              Size="ButtonSize.Small"
                              Click="@(_ => SavePoaRow(poa))"/>
                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Flat"
                              ButtonSize="ButtonSize.Small"
                              class="my-1 ms-1"
                              Click="@(_ => CancelPoaEdit(poa))"/>
                <RadzenButton Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Flat"
                              Shade="Shade.Lighter"
                              Size="ButtonSize.Small"
                              class="my-1 ms-1"
                              Click="@(_ => DeletePoaRow(poa))"/>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>

@code
{
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
    [Parameter, EditorRequired] public required bool ActiveOnly { get; set; }

    private List<PowerOfAttorney> PowerOfAttorneys { get; set; } = [];

    private List<Insurer> AllInsurers { get; set; } = [];
    private List<PowerOfAttorneyStatusDm> AllStatuses { get; set; } = [];
    private List<PowerOfAttorneyDocumentNameDm>? DocTypes { get; set; }

    private List<string>? _statusFilter;

    #region Loaders

    #region POAs

    private IDataAccessResult<List<PowerOfAttorney>> _poas = null!;

    private LoadItem AgencyPoasLoad => AddEventNotify(new LoadItem<List<PowerOfAttorney>>
    {
        Key = AgencyPOAKey(),
        AsyncLoadTask = async () => _poas = await DataAccess.GetAgencyPoas(Agency.Id, ActiveOnly),
        CacheLoadTask = cache => _poas = new DataAccessResult<List<PowerOfAttorney>>
        {
            Data = (List<PowerOfAttorney>)cache!
        },
        ResultVariable = () => _poas,
        AfterLoad = () => { PowerOfAttorneys = _poas.Data!; }
    }, "agency POAs");

    #endregion

    private string AgencyPOAKey()
    {
        var type = ActiveOnly ? "Active" : "Terminated";
        var key = $"AgencyPOAs{Agency.Id}-{type}";
        return key;
    }

    #region Insurers

    private IDataAccessResult<List<Insurer>> _insurers = null!;

    private LoadItem InsurersLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = "Insurers",
        AsyncLoadTask = async () => _insurers = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurers = new DataAccessResult<List<Insurer>>
        {
            Data = (List<Insurer>)cache!
        },
        ResultVariable = () => _insurers,
        AfterLoad = () =>
        {
            if (_insurers.Success)
                AllInsurers = _insurers.Data!;
        }
    }, "insurers");

    #endregion

    #region Statuses

    private IDataAccessResult<List<PowerOfAttorneyStatusDm>> _statuses = null!;

    private LoadItem StatusesLoad => AddEventNotify(new LoadItem<List<PowerOfAttorneyStatusDm>>
    {
        Key = "Statuses",
        AsyncLoadTask = async () => _statuses = await DataAccess.GetAllPoaStatuses(),
        CacheLoadTask = cache => _statuses = new DataAccessResult<List<PowerOfAttorneyStatusDm>>
        {
            Data = (List<PowerOfAttorneyStatusDm>)cache!
        },
        ResultVariable = () => _statuses,
        AfterLoad = void () =>
        {
            AllStatuses = _statuses.Data!;
        }
    }, "statuses");

    #endregion

    #region POA Documents

    private IDataAccessResult<List<PowerOfAttorneyDocumentNameDm>> _poADocumentsResult = null!;

    private LoadItem PoADocumentsLoad => AddEventNotify(new LoadItem<List<PowerOfAttorneyDocumentNameDm>>
    {
        Key = "POADocumentName",
        AsyncLoadTask = async () => _poADocumentsResult = await DataAccess.GetPoaDocumentNames(),
        CacheLoadTask = cache => _poADocumentsResult = new DataAccessResult<List<PowerOfAttorneyDocumentNameDm>>
        {
            Data = (List<PowerOfAttorneyDocumentNameDm>)cache!
        },
        ResultVariable = () => _poADocumentsResult,
        AfterLoad = () =>
        {
            DocTypes = _poADocumentsResult.Data!.Select(ThisToThat.ToEntityType<PowerOfAttorneyDocumentNameDm>).ToList();
        }
    }, "POA documents");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var type = ActiveOnly ? "Active" : "Terminated";
        GridSettingsKey = $"AgencyPOAGrid-{type}";

        await ShowLoading();

        await GetGridSettings();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Agency.Id == Guid.Empty)
            return;

        await DataAccess.ParallelGetCacheOrDataAsync(AgencyPoasLoad, InsurersLoad, StatusesLoad, PoADocumentsLoad);
    }

    private async Task LoadPOAs()
    {
        await DataAccess.GetCacheOrLoadDataAsync(AgencyPoasLoad);
    }

    private async Task SavePoaRow(PowerOfAttorney powerOfAttorney)
    {
        if (!ValidatePoaFields(powerOfAttorney))
            return;

        await ShowLoading();
        await Grid.UpdateRow(powerOfAttorney);
        await LoadPOAs();
    }

    private async Task InsertPOARow()
    {
        await ShowLoading();
        var newPoa = new PowerOfAttorney
        {
            Id = Guid.NewGuid(),
            AgencyId = Agency.Id,
            Agency = Agency,
            Insurer = new Insurer
            {
                IdNavigation = new LegalEntity
                {
                    FullName = ""
                }
            }
        };

        await Grid.InsertRow(newPoa);
    }

    //Enable row edit mode for a POA record.
    private async Task EditPoaRow(PowerOfAttorney poaToEdit)
    {
        if (poaToEdit.AgencyId == Guid.Empty)
            poaToEdit.AgencyId = Agency.Id;

        await ShowLoading();
        await Grid.EditRow(poaToEdit);
    }

    //Save changes to a POA row, disable edit mode for that row.
    private async Task UpdatePoaRow(PowerOfAttorney? poaToUpdate)
    {
        if (poaToUpdate == null || !ValidatePoaFields(poaToUpdate))
            return;

        await ShowLoading();

        var result = await DataAccess.SetPowerOfAttorney(poaToUpdate.Id,
            poaToUpdate.Insurer.Id,
            poaToUpdate.Limit,
            poaToUpdate.ReferenceNumber,
            poaToUpdate.FirstIssued,
            poaToUpdate.CurrentIssued,
            poaToUpdate.Comments,
            poaToUpdate.Status);

        if (result.Success)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Changes saved successfully.", Duration = 5000 });
            await Grid.Reload();
        }
        else
        {
            LoggingService.LogError("Could not link document to POA.", string.Join("; ", result.Errors));
        }

        await DataAccess.UpdateCacheAsync(AgencyPOAKey(), PowerOfAttorneys);
    }

    private async Task OnPoaCreate(PowerOfAttorney powerOfAttorney)
    {
        if (!ValidatePoaFields(powerOfAttorney))
            return;

        var result = await DataAccess.CreateAgencyPOA(powerOfAttorney.Id,
            powerOfAttorney.Insurer.Id,
            Agency.Id,
            Convert.ToInt32(powerOfAttorney.Limit),
            powerOfAttorney.ReferenceNumber,
            powerOfAttorney.FirstIssued,
            powerOfAttorney.CurrentIssued,
            powerOfAttorney.Comments,
            powerOfAttorney.Status);

        if (result.Success)
        {
            powerOfAttorney.InsurerId = powerOfAttorney.Insurer.Id;
            PowerOfAttorneys.Add(powerOfAttorney);
            await DataAccess.UpdateCacheAsync(AgencyPOAKey(), PowerOfAttorneys);
        }
        else
            NotifySaveError(result.Errors, "Agency POA");
    }

    private bool ValidatePoaFields(PowerOfAttorney poa)
    {
        var errors = Validators.ValidatePoaFields(poa);

        foreach (var error in errors)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = error,
                Duration = 2000
            });
        }

        return errors.Count == 0;
    }

    private async Task DeletePoaRow(PowerOfAttorney powerOfAttorney)
    {
        var deleteConfirmed = await DialogService.Confirm("Are you sure?",
            "Agency POA Deletion", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

        if (deleteConfirmed == false)
            return;

        await ShowLoading();
        var result = await DataAccess.DeleteAgencyPOA(powerOfAttorney.Id);
        if (result.Success)
        {
            var toDelete = PowerOfAttorneys.FirstOrDefault(f => f.Id == powerOfAttorney.Id);
            if (toDelete != null)
            {
                PowerOfAttorneys.Remove(toDelete);
                await DataAccess.UpdateCacheAsync(AgencyPOAKey(), PowerOfAttorneys);
            }

            NotifyDeleteSuccessful("agency POA deleted");
            await Grid.Reload();
        }
        else
            NotifyDeleteError(result.Errors, "agency POA deletion");
    }

    private async Task CancelPoaEdit(PowerOfAttorney poa)
    {
        await ShowLoading();

        Grid.CancelEditRow(poa);
    }

    private async Task PoaDocumentUploaded(Guid? documentId, Guid poaId)
    {
        var saveResult = await DataAccess.SetPowerOfAttorneyDocumentLink(poaId, documentId);
        if (saveResult.Success)
            NotifySuccessfulSave("POA document");
        else
            NotifySaveError(saveResult.Errors, "POA document");
    }

    private void LogUploadError(string message, PowerOfAttorney poa)
    {
        LoggingService.LogError("Upload failed",
            "Uploading a file to imaging returned an error",
            "Imaging",
            data: new Dictionary<string, string>
            {
                { "Error Message", message },
                { "AgencyNumber", poa.Agency.AgencyNumber },
                { "Poa Id", poa.Id.ToString() }
            });
    }

    private void ExportGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Status", "Status", "Status");
        substitutions.AddSubstitution("Insurer", "Insurer.IdNavigation.FullName", "Writing Company");
        substitutions.AddSubstitution("ReferenceNumber", "ReferenceNumber", "Reference Number");
        substitutions.AddSubstitution("FirstIssued", "FirstIssued", "First Issued");
        substitutions.AddSubstitution("CurrentIssued", "CurrentIssued", "Current Issued");
        substitutions.AddSubstitution("Limit", "Limit", "Limit");
        NavigationManager.NavigateTo(ExportDataGridUrl(Grid,
                $"/export/AgencyPOAs/{Agency.Id}/{ActiveOnly}", format, substitutions),
            true);
    }

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }

}
