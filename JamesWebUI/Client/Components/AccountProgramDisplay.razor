@using James.Shared
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager


@inject IDataAccess DataAccess

<RadzenRow>
    <RadzenText Text="Account Program" />
</RadzenRow>
<RadzenRow>
    <RadzenDataGrid @ref="@programGrid" TItem="AccountProgram" Data="ProgramsToDisplay"
                    Style="border-radius: 15px; --rz-grid-header-background-color: grey;" 
                    RowUpdate="UpdateProgramRow" IsLoading="@isLoading">
            <Template Context="program">
            <RadzenDataGrid Data="program?.AccountProgramStatusHistories" TItem="AccountProgramStatusHistory" Style="border-radius: 15px;">
                <Columns>
                    <RadzenDataGridColumn Title="Old Status" Property="OldStatus" />
                    <RadzenDataGridColumn Title="New Status" Property="NewStatus" />
                    <RadzenDataGridColumn Title="Old Single" Property="OldSingle" />
                    <RadzenDataGridColumn Title="New Single" Property="NewSingle" />
                    <RadzenDataGridColumn Title="Old Aggregate" Property="OldAggregate" />
                    <RadzenDataGridColumn Title="New Aggregate" Property="NewAggregate" />
                    <RadzenDataGridColumn Title="Change Date" Property="StatusDate" FormatString="{0:d}" />
                </Columns>
            </RadzenDataGrid>

        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Status"
                Property="Status.Description">
                <Template Context="program">
                    @{
                        if (program?.Status?.Description == "APPROVED")
                        {
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success" />
                        }
                        else
                        {
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger" />
                        }
                    }
                </Template>    
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Effective"
                                  Property="Effective" FormatString="{0:d}">
                <Template Context="program">
                    <RadzenText Text="@program.Effective.ToShortDateString()" />
                </Template>
                <EditTemplate Context="program">
                    <RadzenDatePicker ShowTime="false" DateFormat="MM/dd/yyyy" @bind-Value="@program.Effective" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Expiration"
                                  Property="Expiration" FormatString="{0:d}">
                <Template Context="program">
                    <RadzenText Text="@program.Expiration.ToShortDateString()" />
                </Template>
                <EditTemplate Context="program">
                    <RadzenDatePicker ShowTime="false" DateFormat="MM/dd/yyyy" @bind-Value="@program.Expiration" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Single"
                                  Property="Single" FormatString="{0:c0}">
                <Template Context="program">
                    <RadzenText Text="@program.Single.ToString("c0")" />
                </Template>
                <EditTemplate Context="program">
                    <RadzenNumeric @bind-Value="@program.Single" Format="c0" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Aggregate"
                                  Property="Aggregate" FormatString="{0:c0}">
                <Template Context="program">
                    <RadzenText Text="@program.Aggregate.ToString("c0")" />
                </Template>
                <EditTemplate Context="program">
                    <RadzenNumeric @bind-Value="@program.Aggregate" Format="c0"  />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AccountProgram" Title="Edit">
                <Template Context="program">
                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Click="@((args) => EditProgramRow(program))" />
                </Template>
                <EditTemplate Context="program">
                    <RadzenButton Icon="save" Variant="Variant.Text" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@((args) => SaveProgramRow(program))" />
                    <RadzenButton Icon="close" Variant="Variant.Text" Size="ButtonSize.Small" Click="@((args) => CancelProgramEdit(program))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
        <LoadingTemplate>
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </LoadingTemplate>
    </RadzenDataGrid>
</RadzenRow>

@code {
    [Parameter] public string AccountNumber { get; set; }
    private List<AccountProgram> ProgramsToDisplay { get; set; } = new List<AccountProgram>();
    private RadzenDataGrid<AccountProgram> programGrid { get; set; }

    private List<AccountProgram> programsToInsert = new List<AccountProgram>();
    private List<AccountProgram> programsToUpdate = new List<AccountProgram>();

    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadPrograms();
        StateHasChanged();
    }

    private async Task LoadPrograms()
    {
        if (string.IsNullOrWhiteSpace(AccountNumber))
            return;

        IDataAccessResult<List<AccountProgram>> result = null!;

        var loadItem = AddEventNotify(new LoadItem
        {
            Key = $"AccountProgramDisplay{AccountNumber}",
            AsyncLoadTask = async () => result = await DataAccess.GetAccountProgramHistory(AccountNumber),
            CacheLoadTask = cache => result = new DataAccessResult<List<AccountProgram>>
            {
                Data = (List<AccountProgram>)cache!
            },
            ResultVariable = () => result
        });

        await DataCache.GetCacheOrLoadDataAsync(loadItem);

        if (result.Success)
            ProgramsToDisplay = result.Data!;
        else
            await HandleLoadError("Failed to load Account Programs: No Response", result.Errors);
    }

    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
    void Reset()
    {
        programsToInsert.Clear();
        programsToUpdate.Clear();
    }

    void Reset(AccountProgram program)
    {
        programsToInsert.Remove(program);
        programsToUpdate.Remove(program);
    }
    async Task EditProgramRow(AccountProgram program)
    {
        await ShowLoading();
        Reset();
        programsToUpdate.Add(program);
        await programGrid.EditRow(program);
    }
    async Task SaveProgramRow(AccountProgram program)
    {
        await ShowLoading();
        await programGrid.UpdateRow(program);
        await LoadPrograms();
    }
    async Task UpdateProgramRow(AccountProgram program)
    {
        await ShowLoading();
        Reset(program);
        //This is where we handle row Updates.
        var result = await DataAccess.SetAccountProgram(program.Id, program.Effective, program.Expiration, program.Single, program.Aggregate, program.Comments,
            program.StatusId);

        if (result.Errors.Any())
        {
            LoggingService.LogError("Error saving account program changes", result.Errors.ToString());
            NotificationService.Notify(new NotificationMessage
                {
                    Detail = "Error saving account program.",
                    Duration = 4000,
                    Severity = NotificationSeverity.Error
                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Detail = "Changes saved successfully.",
                    Duration = 4000,
                    Severity = NotificationSeverity.Success
                });
        }
    }
    async Task CancelProgramEdit(AccountProgram program)
    {
        await ShowLoading();
        Reset(program);
        programGrid.CancelEditRow(program);
        await LoadPrograms();
    }
    async Task SaveLicenseRow(AccountProgram program)
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Update/Insert is done in those methods.
        await ShowLoading();
        await programGrid.UpdateRow(program);
        StateHasChanged();
    }
}
