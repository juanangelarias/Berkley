@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="4">
            <JamesFormField Text="Tax ID" AllowFloatingLabel="false" Style="width: 90%;">
                <ChildContent> @*TODO: Once encryption is figured out replace these values*@
                    <RadzenTextBox Value="Not Implemented" Disabled="true" Style="color: black;" Visible="@_showTaxId"/>
                    <RadzenPassword Value="Not Implemented" Disabled="@(true)" Style="color: black;"
                                    Visible="@(!_showTaxId)"/>
                </ChildContent>
                <End>
                    <AuthorizeView Policy="InRoleCanSeeAccountTaxId">
                        <RadzenButton Icon="@(_showTaxId ? "visibility" : "visibility_off")" Variant="Variant.Text"
                                      Size="ButtonSize.Small" Click="@(() => _showTaxId = !_showTaxId)"/>
                    </AuthorizeView>
                </End>
            </JamesFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenText Text="Agreement and Indemnitors" TextStyle="TextStyle.DisplayH6" class="rz-mt-2"/>
    </RadzenRow>
    <RadzenRow>
        <RadzenDataGrid TItem="IndemnityDto" Data="@_indemnitors" @ref="@_grid" AllowAlternatingRows="true"
                        AllowFiltering="true" EditMode="DataGridEditMode.Single" AllowSorting="true">
            <HeaderTemplate>
                <RadzenButton Icon="add" Text="New Agreement / Indemnitor" Variant="Variant.Text"
                              Size="ButtonSize.Small" Click="@AddIndemnitor"/>
            </HeaderTemplate>
            <Template Context="indemnity">
                <RadzenDataGrid TItem="IndemnityDetailDto" Data="indemnity.Details">
                    <Columns>
                        <RadzenDataGridColumn Title="Indemnitor" Property="@nameof(IndemnityDetailDto.FullName)"
                                              Width="10rem"/>
                        <RadzenDataGridColumn Title="Net Liquid Assets" Width="10rem" TextAlign="TextAlign.Right"
                                              Property="@nameof(IndemnityDetailDto.NetLiquidAssets)">
                            <Template Context="ind">
                                <RadzenText Text="@($"{ind.NetLiquidAssets:c0}")" TextStyle="TextStyle.Body2"
                                            TextAlign="TextAlign.Right"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Net Worth" Property="@nameof(IndemnityDetailDto.NetWorth)"
                                              Width="10rem" TextAlign="TextAlign.Right">
                            <Template Context="ind">
                                <RadzenText Text="@($"{ind.NetWorth:c0}")" TextStyle="TextStyle.Body2"
                                            TextAlign="TextAlign.Right"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Indemnity Amount"
                                              Property="@nameof(IndemnityDetailDto.IndemnityAmount)"
                                              Width="12rem" TextAlign="TextAlign.Right">
                            <Template Context="ind">
                                <RadzenText Text="@($"{ind.IndemnityAmount:c0}")" TextStyle="TextStyle.Body2"
                                            TextAlign="TextAlign.Right"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Spouse Indemnitor" Width="9rem" TextAlign="TextAlign.Center"
                                              Property="@nameof(IndemnityDetailDto.SpouseIndemnitor)">
                            <Template Context="det">
                                <RadzenText Text="@(det.SpouseIndemnitor ? "Yes" : "No")" TextStyle="TextStyle.Body2"
                                            TextAlign="TextAlign.Center"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Tax Id" Property="@nameof(IndemnityDetailDto.EncryptSpouseTaxId)"
                                              Width="10rem">
                            <Template>
                                <RadzenText Text="*********" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Signatory" Property="@nameof(IndemnityDetailDto.Signatory)"
                                              Width="8rem"/>
                        <RadzenDataGridColumn Title="Title" Property="@nameof(IndemnityDetailDto.Title)"
                                              Width="10rem"/>
                        <RadzenDataGridColumn Title="Execution Date" Width="10rem"
                                              Property="@nameof(IndemnityDetailDto.ExecutionDate)"/>
                    </Columns>
                </RadzenDataGrid>
            </Template>
            <Columns>
                <RadzenDataGridColumn Title="Agreement Date" Property="@nameof(Indemnitor.AgreementDate)" Width="14rem">
                    <Template Context="indemnity">
                        <RadzenText Text="@indemnity.AgreementDate.ToString("MM/dd/yyyy")"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Type" Property="@nameof(Indemnitor.AgreementType)" Width="8rem">
                    <Template Context="indemnity">
                        <RadzenText Text="@(indemnity.AgreementType ?? "")"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Signed Document" Width="14rem" Filterable="false" Sortable="false">
                    <Template Context="indemnity">
                        <RadzenButton Icon="picture_as_pdf" Text="Download" ButtonStyle="ButtonStyle.Info"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="DownloadIndemnitorDocument"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="DocuSign" Filterable="false" Sortable="false">
                    <Template Context="indemnity">
                        @*This field does not exist in the database*@
                        <RadzenCheckBox TValue="bool" Value="true"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="order" Filterable="false" Sortable="false" TextAlign="TextAlign.Right"
                                      Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="9rem"
                                      Resizable="false">
                    <Template Context="indemnity">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1"
                                      Click="@(_ => EditRow(indemnity))" @onclick:stopPropagation="true"/>
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1"
                                      Click="@(_ => DeleteRow(indemnity))" @onclick:stopPropagation="true"/>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public Account Account { get; set; }

    private RadzenDataGrid<IndemnityDto> _grid = null!;
    private List<IndemnityDto> _indemnitors = [];
    private List<AgreementTypeDm> _agreementTypes = [];
    private bool _showTaxId;

    #region Loaders

    #region Indemnities Load

    private IDataAccessResult<List<IndemnityDto>> _indemnitorsResult = null!;

    private LoadItem IndemnitorsLoad => AddEventNotify(new LoadItem<List<IndemnityDto>>
    {
        Key = CacheKeys.AccountIndemnitors(Account.AccountNum),
        AsyncLoadTask = async () => _indemnitorsResult = await DataAccess.GetIndemnitorsByAccount(Account.AccountNum),
        CacheLoadTask = cache => _indemnitorsResult = new DataAccessResult<List<IndemnityDto>>
        {
            Data = (List<IndemnityDto>)cache!
        },
        ResultVariable = () => _indemnitorsResult,
        AfterLoad = () => { _indemnitors = _indemnitorsResult.Data!; }
    }, "indemnitors");

    #endregion

    #region Agreement Types Load

    private IDataAccessResult<List<AgreementTypeDm>> _agreementTypesResult = null!;

    private LoadItem AgreementTypesLoad => AddEventNotify(new LoadItem<List<AgreementTypeDm>>
    {
        Key = CacheKeys.AgreementTypes,
        AsyncLoadTask = async () => _agreementTypesResult = await DataAccess.GetAgreementTypes(),
        CacheLoadTask = cache => _agreementTypesResult = new DataAccessResult<List<AgreementTypeDm>>
        {
            Data = (List<AgreementTypeDm>)cache!
        },
        ResultVariable = () => _agreementTypesResult,
        AfterLoad = () => { _agreementTypes = _agreementTypesResult.Data!; }
    }, "agreement Types");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await ShowLoading();

        await DataAccess.ParallelGetCacheOrDataAsync(IndemnitorsLoad, AgreementTypesLoad);
    }

    private async Task AddIndemnitor()
    {
        var newIndemnity = await ShowDialog(null);

        if (newIndemnity == null)
            return;

        await _grid.InsertRow(newIndemnity);
        await _grid.Reload();

        await DataAccess.UpdateCacheAsync(CacheKeys.AccountIndemnitors(Account.AccountNum), _indemnitors);
    }

    private async Task EditRow(IndemnityDto indemnity)
    {
        var editedIndemnity = await ShowDialog(indemnity);

        if (editedIndemnity == null)
            return;

        var index = _indemnitors.IndexOf(indemnity);
        if (index < 0)
            return;

        _indemnitors[index] = editedIndemnity;

        await DataAccess.UpdateCacheAsync(CacheKeys.AccountIndemnitors(Account.AccountNum), _indemnitors);

        await _grid.Reload();
    }

    private async Task<IndemnityDto?> ShowDialog(IndemnityDto? indemnity)
    {
        indemnity ??= new() { AccountNum = Account.AccountNum, Details = [] };

        var parameters = new Dictionary<string, object?>
        {
            { "Indemnity", indemnity },
            { "AgreementTypes", _agreementTypes }
        };
        var options = new DialogOptions()
        {
            Resizable = false,
            Draggable = true,
            CloseDialogOnEsc = false,
            CloseDialogOnOverlayClick = false,
            ShowClose = false,
            Width = "80rem"
        };

        var response = await DialogService.OpenAsync<AccountIndemnityEditDialog>("Indemnity", parameters, options);
        if (response == null)
            return null;

        return response as IndemnityDto;
    }

    private async Task DeleteRow(IndemnityDto indemnity)
    {
        var ids = indemnity.Details.Select(x => x.Id).ToList();
        await DataAccess.DeleteIndemnitorRange(ids);

        var index = _indemnitors.IndexOf(indemnity);
        if (index < 0)
            return;

        _indemnitors.RemoveAt(index);
        await _grid.Reload();
    }

    private async Task DownloadIndemnitorDocument()
    {
        RenderFragment msg = @<div class="alert alert-warning">
                                 <p>Indemnitor document download is not implemented yet.</p>
                             </div>;
        await DialogService.Alert(msg, "Indemnitor Document Download");
    }

}