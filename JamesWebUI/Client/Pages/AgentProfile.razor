                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenStack>
    </RadzenPanel>
</RadzenStack>

@code {
    private Guid _agentId;
    [Parameter]
    public Guid AgentId
    {
        get => _agentId;
        set
        {
            if (_agentId == value) return;
            _agentId = value;
            LoadAgent();
        }
    }
    private Agent AgentToDisplay { get; set; } = new Agent()
        {
            IdNavigation = new LegalEntity()
        };


    private RadzenDropDown<Guid> dropSelectInsurer { get; set; }
    private List<Insurer> allInsurers { get; set; } = new List<Insurer>();


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        BusyDialog();
        await LoadAgent();
        await LoadSelectInsurerDropDown();
        DialogService.Close();
    }
    private async Task LoadAgent()
    {
        BusyDialog();
        if (Guid.Empty != AgentId)
        {
            var result = await DataAccess.GetAgent((Guid)AgentId);

            if (result.Errors.Any() && null != result.Data)
            {
                LoggingService.LogError("Error when loading agent.", result.Errors.ToString());
                NotificationService.Notify(new NotificationMessage
                    {
                        Detail = "Error loading agent.",
                        Duration = 4000,
                        Severity = NotificationSeverity.Error
                    });
            }
            else
            {
                AgentToDisplay = result.Data;
                StateHasChanged();
            }
        }

        DialogService.Close();

    }
    private async Task LoadSelectInsurerDropDown()
    {
        allInsurers = await GetInsurers();
    }
    private async Task<List<Insurer>> GetInsurers()
    {
        var result = await DataAccess.GetAllInsurers();
        if (result.Success == false)
        {
            LoggingService.LogError("Error getting insurers in Agency Contract Grid", result.Errors.ToString());
        }

        Debug.Assert(result.Data != null, "result.Data != null");
        return result.Data.OrderBy(i => i.IdNavigation.FullName).ToList();
    }

    void BusyDialog()
    {
        DialogService.Open("", ds =>
        @<RadzenStack AlignItems="AlignItems.Center" Gap="2rem" class="rz-p-12">
            <RadzenText TextStyle="TextStyle.H6">Loading, please wait...</RadzenText>
        </RadzenStack>, new DialogOptions() { ShowTitle = false, Style = "min-height:auto;min-width:auto;width:auto", CloseDialogOnEsc = false });
    }
}