@using Blazorise.Animate;

@inherits SlidingComponent

<Theme/>

<PositionSavingTabs Change="@HandleChangeDirection" TabControlName="AgGenInfoGrids" TabPosition="TabPosition.Top">
    <Tabs>
        <PositionSavingTabsItem Text="Agency Licenses" TabName="Licenses">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenStack Orientation="Orientation.Vertical">
                    <RadzenRow>
                        <RadzenText Text="Agency Licenses" Style="font-weight: bold;"/>
                    </RadzenRow>
                    <RadzenRow>
                        <AgencyLicenseGrid Agency="Agency" AgentsLicenses="false"/>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenText Text="Agents Licenses" Style="font-weight: bold; margin-top: 1rem;"/>
                    </RadzenRow>
                    <RadzenRow>
                        <AgencyLicenseGrid Agency="Agency" AgentsLicenses="true"/>
                    </RadzenRow>
                </RadzenStack>
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="POAs" TabName="POAs">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenRow>
                    <RadzenText Text="Active POAs" Style="font-weight: bold;"/>
                </RadzenRow>
                <RadzenRow>
                    <AgencyPOAGrid Agency="Agency" ActiveOnly="true"/>
                </RadzenRow>
                <RadzenRow>
                    <RadzenText Text="Terminated POAs" Style="font-weight: bold; margin-top: 1rem;"/>
                </RadzenRow>
                <RadzenRow>
                    <AgencyPOAGrid Agency="Agency" ActiveOnly="false"/>
                </RadzenRow>
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="Locations" TabName="Locations">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyLocationsGrid AgencyId="Agency.Id" NotResumed="true"/>
            </Animate>
        </PositionSavingTabsItem>
    </Tabs>
</PositionSavingTabs>

@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
}
