@using JamesWebUI.Client.Model

@inject IAccountState AccountState
@inject TooltipService TooltipService

@inherits JamesLayoutComponentBase

<Theme/>

<RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                              Click="@ToggleEditMode" Disabled="@(_isEditMode)"/>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" Visible="@(!_isEditMode)">
                <RadzenColumn Size="3">
                    <BsgFormField Text="Agency No.">
                        <RadzenTextBox @bind-Value="@_agencyNumber"
                                       Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="9">
                    <BsgFormField Text="Agency">
                        <RadzenTextBox @bind-Value="@_agencyName"
                                       Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.Start" Visible="@(_isEditMode)">
                <BsgFormField Text="Agency">
                    <RadzenDropDown Data="@AccountState.AllAgencies" AllowFiltering="true" AllowClear="true"
                                    Multiple="false" Change="AgencyChanged"
                                    TextProperty="@nameof(AgencyDto.FullName)"
                                    @bind-Value="@_agency" Name="Agency"/>
                    <RadzenRequiredValidator Text="The agency is required." Component="Agency"/>
                </BsgFormField>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="5">
                    <BsgFormField Text="City">
                        <RadzenTextBox @bind-Value="@_city" Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <BsgFormField Text="State">
                        <RadzenTextBox @bind-Value="@_stateCode" Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="5">
                    <BsgFormField Text="Status">
                        <Start>
                            <RadzenIcon Icon="fiber_manual_record"
                                        IconStyle="@AccountState.AccountStatusStyle"/>
                        </Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@_status" Disabled="true" Style="color: black;"/>
                        </ChildContent>
                    </BsgFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <BsgFormField Text="Agency Email">
                    <RadzenTextBox @bind-Value="@_agencyEmail" Disabled="true" Style="color: black;"/>
                </BsgFormField>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" Visible="@(!_isEditMode)">
                <RadzenColumn Size="6">
                    <BsgFormField Text="Agent">
                        <RadzenTextBox @bind-Value="@_agentName" Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <BsgFormField Text="Agent Email">
                        <RadzenTextBox @bind-Value="@_agentEmail" Disabled="true" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenButton Icon="add" Text="Add" Size="ButtonSize.Small" ImageAlternateText="Add Agent"
                                  MouseEnter="@(args => ShowTooltipAddAgent(args))"
                                  Click="OnRequestAgent"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End" Visible="@(_isEditMode)">
                <BsgFormField Text="Agent">
                    <RadzenDropDown Data="AccountState.AgencyAgentsLookup" AllowFiltering="true" AllowClear="true"
                                    TextProperty="@nameof(BsgLookup.Name)"
                                    ValueProperty="@nameof(BsgLookup.Id)" @bind-Value="@_agentId" Change="OnAgentChanged"/>
                </BsgFormField>
            </RadzenRow>
            <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End" Visible="@(_isEditMode)">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Cancel" Icon="cancel" Click="@CancelEdit" ButtonType="ButtonType.Reset"
                                  ButtonStyle="ButtonStyle.Secondary"/>
                    <RadzenButton Text="Save" Icon="save" Click="@SaveEdit" ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" Disabled="@(!Changed)"/>
                </RadzenStack>
            </RadzenRow>
        </RadzenStack>
    </RadzenColumn>
</RadzenCard>

@code {
    private bool _isEditMode;
    private AgencyDto? _agency;
    private Agent? _agent;
    private string _agencyNumber = "";
    private Guid? _agencyId;
    private string _agencyName = "";
    private string _city = "";
    private string _stateCode = "";
    private string _status = "";
    private string _agencyEmail = "";
    private Guid? _agentId;
    private string _agentName = "";
    private string _agentEmail = "";

    private bool Changed => _agent?.Id != _agentId ||
                            _agency?.Id != _agencyId;

    protected override void OnParametersSet()
    {
        if(AccountState.Account == null || string.IsNullOrEmpty(AccountState.Account.AccountNum))
            return;
        
        SetDisplayFields();
    }
    
    private void SetDisplayFields()
    {
        _agency = AccountState.Account?.AgencyNumberNavigation == null
            ? null
            : new AgencyDto
            {
                Id = AccountState.Account?.AgencyNumberNavigation?.Id ?? Guid.Empty,
                AgencyNumber = AccountState.Account?.AgencyNumberNavigation?.AgencyNumber ?? "",
                FullName = AccountState.Account?.AgencyNumberNavigation?.IdNavigation.FullName ?? ""
            };
        _agencyId = _agency?.Id;
        _agencyNumber = _agency?.AgencyNumber ?? "";
        _agencyName = AccountState.Account?.AgencyNumberNavigation?.IdNavigation.FullName ?? "";
        _agencyEmail = AccountState.Agency?.IdNavigation.LegalEntityEmails
            .FirstOrDefault(f => f.Type.ToLower() == "main")?
            .EmailAddress ?? "";
        _city = AccountState.Account?.AgencyNumberNavigation?.IdNavigation.GetMainAddress()?.City ?? "";
        _stateCode = AccountState.Account?.AgencyNumberNavigation?.IdNavigation.GetMainAddress()?.StateCode ?? "";
        _status = AccountState.Account?.AgencyNumberNavigation?.AgencyStatusLogs
            .OrderByDescending(o => o.Effective)
            .FirstOrDefault()?
            .NewStatus ?? "";
        
        _agent = AccountState.Account?.Agent;
        _agentId = _agent?.Id;
        _agentName = _agent?.IdNavigation.FullName ?? "";
        _agentEmail = _agent?.IdNavigation.LegalEntityEmails
            .FirstOrDefault(f => f.Type.ToLower() == "main")?
            .EmailAddress ?? "";
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
    }

    private void ShowTooltipAddAgent(ElementReference element, TooltipOptions? options = null)
    {
        options ??= new()
        {
            Position = TooltipPosition.Bottom
        };

        TooltipService.Open(element, "Request for a new agent", options);
    }

    private async Task OnRequestAgent(MouseEventArgs arg)
    {
        var dialogOptions = new DialogOptions
        {
            Draggable = true,
            Resizable = false,
            CloseDialogOnEsc = true,
            ShowClose = true,
            Width = "500px",
            Height = "400px"
        };

        var dialogParameters = new Dictionary<string, object>
        {
            { "AgencyName", _agencyName },
            { "AgencyNumber", _agencyNumber }
        };

        await DialogService.OpenAsync<AccountNewAgent>("Request for a new Agent", dialogParameters, dialogOptions);
    }

    private async Task AgencyChanged(object obj)
    {
        var agency = (AgencyDto)obj;
        
        var updatedAgency = await AccountState.AgencyChanged(agency.AgencyNumber);
        
        _agencyId = updatedAgency?.Id;
        _agencyNumber = updatedAgency?.AgencyNumber ?? "";
        _agencyName = updatedAgency?.IdNavigation.FullName ?? "";
        _city = updatedAgency?.IdNavigation.GetMainAddress()?.City ?? "";
        _stateCode = updatedAgency?.IdNavigation.GetMainAddress()?.StateCode ?? "";
        _status = updatedAgency?.Status ?? "";
        
        _agent = null;
        
        StateHasChanged();
        
        NotifySuccessfulSave("Agency Changed");
    }
    
    private void OnAgentChanged(object obj)
    {
        NotifySuccessfulSave("Agent Changed");
    }
    
    private void CancelEdit()
    {
        SetDisplayFields();
        _isEditMode = false;
    }

    private async Task SaveEdit()
    {
        // ToDo Proceed to Save
        
        NotifySuccessfulSave("Agency and Agent successfully updated");
    }
}