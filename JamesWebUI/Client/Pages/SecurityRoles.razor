@page "/SecurityRoles"
@page "/Admin/SecurityRoles"
@using System.Diagnostics
@using Blazored.LocalStorage
@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess
@inject ILocalStorageService LocalStorageService
@attribute [Authorize]

<Theme />
<PageTitle>Admin - Security Roles</PageTitle>
<RenderModeBackground></RenderModeBackground>

<RadzenPanel Style="border-radius: 20px;" class="rz-shadow-7">
    <RadzenText TextStyle="TextStyle.DisplayH3">Security Roles</RadzenText>
    <RadzenRow>
        <RadzenColumn><RadzenButton Text="Add role" Icon="add" /></RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenDataGrid Data="@_securityRoles" TItem="SecurityRole" AllowRowSelectOnRowClick="true"
                            AllowAlternatingRows="true" AllowColumnResize="true"
                            SelectionMode="DataGridSelectionMode.Single"
                            ValueChanged="@SelectedRoleChanged">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(SecurityRole.Role)"
                                          Title="Role" Width="160px" />
                    <RadzenDataGridColumn Property="@nameof(SecurityRole.Description)"
                                          Title="Description" />
                    <RadzenDataGridColumn Property="@nameof(SecurityRole.Ord)"
                                          Title="Order" Width="80px">
                        <Template Context="data">
                            <RadzenStack Orientation="Orientation.Horizontal">
                                <RadzenButton Icon="arrow_drop_up" Size="ButtonSize.Small" 
                                              Click="@(() => MoveUp(data))" />
                                <RadzenButton Icon="arrow_drop_down" Size="ButtonSize.Small" 
                                              Click="@(() => MoveDown(data))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenRow><RadzenText Text="Role Members" /></RadzenRow>
            <RadzenRow><RadzenButton Icon="add" Text="Add Member" Disabled="@(_currentSecurityRole==null)" Click="AddMembersToRole" /></RadzenRow>
            <RadzenRow>
                <RadzenDataGrid Data="@_securityRoleMembers">
                    <Columns>
                        <RadzenDataGridColumn Width="50px">
                            <Template Context="principal">
                                @* TODO: Get final icons from Stephanie *@
                                @if (principal.IsRole)
                                {
                                    <RadzenIcon Icon="diversity_3" />
                                }
                                else
                                {
                                    <RadzenIcon Icon="person_apron" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Name" Property="@nameof(SecurityRoleMember.Name)" />

                    </Columns>
                </RadzenDataGrid>
            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
</RadzenPanel>
@code {
    List<SecurityRole> _securityRoles = null!;
    private IDataAccessResult<List<SecurityRole>> _loadSecurityRolesResult;
    private LoadItem RolesLoadItem => AddEventNotify(
        new()
        {
            Key = "SecRoles",
            AsyncLoadTask = async () => _loadSecurityRolesResult = await DataAccess.GetAllSecurityRoles(),
            CacheLoadTask = cache => _loadSecurityRolesResult = new DataAccessResult<List<SecurityRole>> { Data = (List<SecurityRole>)cache! },
            ResultVariable = () => _loadSecurityRolesResult,
            AfterLoad = () =>
            {
                Debug.Assert(_loadSecurityRolesResult.Data != null, "_loadSecurityRolesResult.Data != null");
                //Add after load code here
                _securityRoles = _loadSecurityRolesResult.Data;
                //Save to local storage asynchronously and don't wait for the save to finish
                Task.Factory.StartNew(data =>
                    LocalStorageService.SetItemAsyncWithExpiry("SecRoles", TimeSpan.FromDays(1), data), _loadSecurityRolesResult.Data);
            },
            LocalStorageCacheLoadTask = async () => await LocalStorageService.GetItemAsyncWithExpiry<List<SecurityRole>>("SecRoles")
        }, "security roles");

    List<SecurityRoleMember> _securityRoleMembers = null!;
    SecurityRole? _currentSecurityRole = null;

    private IDataAccessResult<List<SecurityRoleMember>> _loadMembersResult = null!;
    private LoadItem MembersLoadItem(string role) => AddEventNotify(
        new()
        {
            Key = $"RlMbr{role}",
            //TODO:Add actual data called when created
            AsyncLoadTask = async () => _loadMembersResult = await DataAccess.GetSecurityRoleMembers(role),
            //await Task.FromResult<IDataAccessResult<List<SecurityRoleMember>>>(new DataAccessResult<List<SecurityRoleMember>>()),//DataAccess.GetMyData(),
            CacheLoadTask = cache => _loadMembersResult = new DataAccessResult<List<SecurityRoleMember>> { Data = (List<SecurityRoleMember>)cache! },
            CacheDuration = TimeSpan.FromMinutes(2),
            ResultVariable = () => _loadMembersResult,
            AfterLoad = () =>
            {
                Debug.Assert(_loadMembersResult.Data != null, "_loadMembersResult.Data != null");
                _securityRoleMembers = _loadMembersResult.Data;
                //Save to local storage asynchronously and don't wait for the save to finish
                Task.Factory.StartNew(data =>
                    LocalStorageService.SetItemAsyncWithExpiry($"RlMbr{role}", TimeSpan.FromMinutes(2), data), _loadMembersResult.Data);
            },
            LocalStorageCacheLoadTask = async () => await LocalStorageService.GetItemAsyncWithExpiry<List<SecurityRoleMember>>($"RlMbr{role}")
        }, "role members");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await DataCache.GetCacheOrLoadDataAsync(RolesLoadItem);
    }

    private async Task SelectedRoleChanged(IList<SecurityRole> selectedRoles)
    {
        var newRole = selectedRoles.FirstOrDefault();
        if (newRole == _currentSecurityRole) return;
        _currentSecurityRole = newRole;
        _securityRoleMembers?.Clear();
        if (null == _currentSecurityRole)
            return;
        await DataCache.GetCacheOrLoadDataAsync(MembersLoadItem(_currentSecurityRole.Role));

    }
    
    private async Task AddMembersToRole()
    {
        if (null == _currentSecurityRole) return;
        var result = await DialogService.OpenAsync<AddSecurityRoleMember>("Add members", new Dictionary<string, object>(){{"Role", _currentSecurityRole.Role}});
        // if(result = )
    }

    private async Task MoveUp(SecurityRole data)
    {
        throw new NotImplementedException();
    }

    private async Task MoveDown(SecurityRole data)
    {
        throw new NotImplementedException();
    }

}
