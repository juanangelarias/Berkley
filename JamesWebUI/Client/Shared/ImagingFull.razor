@using System.Diagnostics
@using ClientBusinessLogic
@using James.Shared
@using James.Shared.Imaging
@inherits JamesLayoutComponentBase
@inject IDataAccess DataAccess
<RadzenStack>
    <RadzenUpload id="ddUpload" @ref="@_uploadDD"
                  ChooseText="Drag and drop documents here or click to choose document to upload"
                  Auto="false" Multiple="false" Url=@($"ImagingRepository/UploadDocument/{_details.DocumentType}/{(int)DocumentCategory}/{ImagingId}?filename={_details.FileName}")
                  InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})"
                  Change=@UploadFileChanged
                  Error=@UploadErrorHandler
                  Complete=@UploadComplete
                  Icon="upload_file"
                  Style="width: 100%" />
    <RadzenTemplateForm TItem="ImagingDocumentDetails" Data="_details"
                        Visible="@(_waitingForFileSelection==false)"
                        Submit="@((args) =>StartUpload(args))">
        <RadzenRow Gap="0rem" RowGap="0rem" class="rz-m-0 rz-m-md-12">
            <RadzenFormField Text="Name" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:100%">
                <ChildContent>
                    <RadzenTextBox Name="tbFileName" @ref="_tbFilename" @bind-Value=@_details.FileName Style="width:100%" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="_tbFileName" Text="Name is required." />
                    <RadzenRegexValidator Component="tbFileName" Text="Must be a filename without path"
                                          Pattern="^[^\\/]+$" />
                    <RadzenCustomValidator Component="tbFileName" Text="Must be a valid filename"
                                           Validator="@(()=>ClientBusinessLogic.Validators.ValidateFileName(_details.FileName))" />
                    <RadzenCustomValidator Component="tbFileName" Text="File extension is not allowed by BTS"
                                           Validator="@(()=>!ClientBusinessLogic.Validators.ValidateFileName(_details.FileName)||
                                                            SharedBusinessLogic.ImagingBusinessLogic.IsValidImagingFileName(_details.FileName))" />
                </Helper>
            </RadzenFormField>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenButton Text="Upload" Disabled="@_waitingForFileSelection"
                              class="rz-mt-4"
                              ButtonType="ButtonType.Submit" />
            </RadzenColumn>
        </RadzenRow>>
    </RadzenTemplateForm>
    <RadzenPanel>
        <RadzenDataList TItem="ImagingTabTypeDocuments" Data="@_currentTabTypeDocuments" IsLoading="_docsLoading">
            <Template Context="tab">
                <RadzenPanel Collapsed="true" AllowCollapse="true"
                             Text="@tab.TabName">
                    <RadzenDataList TItem="ImagingTypeDocuments" Data="@tab.TypeDocuments" WrapItems="true">
                        <Template Context="documents">
                            <RadzenPanel Collapsed="true" AllowCollapse="true"
                                         Text="@documents?.Type.Description">
                                <RadzenStack>
                                    <div class="rz-p-12 rz-text-align-center">
                                        <RadzenCheckBox TriState="false" Name="cbThumbnails" Value="false" Disabled="true" />
                                        <RadzenLabel Text="View Thumbnails" Component="cbThumbnails" class="rz-ms-2" />
                                    </div>
                                    <RadzenDataList TItem="ImagingDocument" Data="@documents.Documents" WrapItems="true">
                                        <Template Context="doc">
                                            <RadzenButton Variant="Variant.Outlined">
                                                <RadzenRow>
                                                    <RadzenColumn><RadzenIcon Icon="description" /></RadzenColumn>
                                                    <RadzenColumn><RadzenText Text=@doc?.Description /></RadzenColumn>
                                                    <RadzenColumn><RadzenText Text=@doc?.Filename /></RadzenColumn>
                                                    <RadzenColumn><RadzenText Text=@doc?.EntryDate.ToShortDateString() /></RadzenColumn>
                                                </RadzenRow>
                                            </RadzenButton>
                                        </Template>
                                    </RadzenDataList>
                                </RadzenStack>
                            </RadzenPanel>
                        </Template>
                    </RadzenDataList>
                </RadzenPanel>
            </Template>
        </RadzenDataList>
    </RadzenPanel>
</RadzenStack>


