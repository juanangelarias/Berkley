@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenCard >
    <RadzenRow>
        <RadzenColumn>
            <RadzenText Text="@ObligeeToDisplay.ObligeeNum" />
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter] public Guid ObligeeId { get; set; }
    
    private Obligee ObligeeToDisplay { get; set; } = null!;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadObligee();
    }    
    private async Task LoadObligee()
    {
        IDataAccessResult<Obligee?> obligeeResult = null!;
        var loadItem = AddEventNotify(new LoadItem
        {
            Key = $"Obligee{ObligeeId}",
            AsyncLoadTask = async () => obligeeResult = await DataAccess.GetObligeeById(ObligeeId),
            CacheLoadTask = cache => obligeeResult = new DataAccessResult<Obligee?> { Data = (Obligee)cache! },
            ResultVariable = () => obligeeResult,
            AfterLoad = async void () =>
            {
                if (obligeeResult.Success)
                    ObligeeToDisplay = obligeeResult.Data!;
                else
                    await HandleLoadError("Error loading Obligee", obligeeResult.Errors);
            }
        });

        await DataCache.GetCacheOrLoadDataAsync(loadItem);
    }
}
