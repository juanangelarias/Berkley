@inherits JamesGridLayoutComponentBase<AgencyBondDto>

@inject TooltipService TooltipService
@inject IDataAccess DataAccess

<Theme/>

<RadzenDataGrid TItem="AgencyBondDto" @ref="@Grid" Data="@_agencyBonds" Count="@_count" LoadData="@LoadAgencyBonds"
                AllowVirtualization="true" @bind-Settings="@GridSettings" AllowColumnReorder="true"
                Density="Density.Compact" Style="height: 400px; border-radius: 10px;" AllowColumnResize="true"
                AllowColumnPicking="true">

    @*AllowGrouping="true" AllowSorting="true" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading" 
                Sort="@ShowLoading"
                GridLines="DataGridGridLines.Vertical" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" IsLoading="@IsLoading"> *@

    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Icon="settings" Click="SaveGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                          Visible="@UserSettingsChanged"/>
            <RadzenButton Icon="reset_settings" Click="ClearGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                          Visible="@UserSettingsLoaded"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyBondDto" Filterable="true" FilterValue="@_statusFilter"
                              FilterProperty="Status"
                              FilterOperator="FilterOperator.Contains" Resizable="true"
                              Title="Status" Property="Status" Width="125px" Type="typeof(List<string>)">
            <Template Context="bond">
                @{
                    if (bond.Status.Trim() == "Open")
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <JamesStatusIcon IconStyle="IconStyle.Success"/>
                            <RadzenText Text="@bond.Status"/>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <JamesStatusIcon IconStyle="IconStyle.Danger"/>
                            <RadzenText Text="@bond.Status"/>
                        </RadzenStack>
                    }
                }
            </Template>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_statusFilter" @ref="StatusFilterDropDown" Change="StatusFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.Select(b => b.Status).Distinct().ToList()"/>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Bond No." Property="BondNumber" Width="125px"
                              Resizable="true">
            <Template Context="bond">
                <RadzenLink Text="@bond.BondNumber" Path=@($"bond/{bond.BondNumber}") Style="--rz-grid-cell-font-size: 0.9rem"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Account No." Property="AccountNum" Width="130px"
                              Resizable="true">
            <Template Context="bond">
                <RadzenLink Text="@bond.AccountNum" Path=@($"account/{bond.AccountNum}") Style="--rz-grid-cell-font-size: 0.9rem"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Account Name" Property="AccountName" Width="200px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Bond Type" Property="BondType" Width="130px"
                              FilterValue="_bondTypeFilter" FilterProperty="BondType" Resizable="true"
                              FilterOperator="FilterOperator.Contains" Type="typeof(List<string>)">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_bondTypeFilter" @ref="BondTypeFilterDropDown"
                                Change="BondTypeFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.Select(b => b.BondType).Distinct().ToList()"/>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Begin Date" Property="BeginDate" FormatString="{0:d}"
                              Width="150px" Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="End Date" Property="EndDate" FormatString="{0:d}"
                              Width="150px" SortOrder="SortOrder.Descending" Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Amount" Property="Amount" FormatString="{0:C0}"
                              Width="125px" SortOrder="SortOrder.Descending" Resizable="true"
                              TextAlign="TextAlign.Center">
            <Template Context="bond">
                <RadzenText Text="@bond.Amount.ToString("C0")" TextAlign="TextAlign.Right"
                            Style="--rz-grid-cell-font-size: 0.9rem"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="UW" Property="UnderWriterName" Width="175px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Branch" Property="Branch" Width="100px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Class Code" Property="SicCode" Width="125px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Obligee" Property="ObligeeName" Width="200px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyBondDto" Title="Class" Property="BondClass" Resizable="true"
                              Filterable="true" FilterValue="@_classFilter" FilterProperty="BondClass"
                              FilterOperator="FilterOperator.Contains" Type="typeof(List<string>)"
                              FormatString="{0:d}" Width="180px">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_classFilter" @ref="ClassFilterDropDown" Change="ClassFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.OrderBy(b => b.BondClass).Select(b => b.BondClass).Distinct().ToList()">
                </RadzenDropDown>
            </FilterTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        No Records to Display
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
    [Parameter] public string? AccountNum { get; set; }

    // ***
    //
    // ToDo: We need to add filters and orders to the virtualization!!!
    //
    // ***

    private List<AgencyBondDto> _agencyBonds = [];
    private List<string>? _statusFilter;
    private List<string>? _classFilter;
    private List<string>? _bondTypeFilter;

    private int _skip;
    private int _take;
    private int _count = 1000;
    private string? _lastFilter;

    private RadzenDropDown<List<string>> StatusFilterDropDown { get; set; } = new();
    private RadzenDropDown<List<string>> ClassFilterDropDown { get; set; } = new();
    private RadzenDropDown<List<string>> BondTypeFilterDropDown { get; set; } = new();

    #region Loaders

    #region AgencyBonds Load

    private IDataAccessResult<List<AgencyBondDto>> _agencyBondsResult = null!;

    private LoadItem AgencyBondsLoad => AddEventNotify(new()
    {
        Key = $"AgencyBondGrid{Agency.Id}_{AccountNum}_{_skip}_{_take}",
        AsyncLoadTask = async () => _agencyBondsResult = await DataAccess.GetAgencyBonds(Agency.Id, AccountNum, _skip, _take),
        CacheLoadTask = cache => _agencyBondsResult = new DataAccessResult<List<AgencyBondDto>>
        {
            Data = (List<AgencyBondDto>)cache!
        },
        ResultVariable = () => _agencyBondsResult,
        AfterLoad = () =>
        {
            _agencyBonds = _agencyBondsResult.Data!;
        }
    }, "agency bond grid");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        GridSettingsKey = "AgencyBondsGrid";

        await ShowLoading();

        await GetGridSettings();

        await LoadAgencyBonds(null);
    }

    private async Task LoadAgencyBonds(LoadDataArgs? args)
    {
        if (Agency.Id == Guid.Empty)
            return;

        var countResult = await DataAccess.GetAgencyBondsCount(Agency.Id);
        if (countResult.Success)
            _count = countResult.Data!.Count;

        if (!string.IsNullOrEmpty(args?.Filter) && _lastFilter != args.Filter)
        {
            _lastFilter = args.Filter;
            args.Skip = 0;
        }

        _skip = args == null ? 0 : args.Skip!.Value;
        _take = args == null ? 15 : args.Top!.Value;

        await DataAccess.GetCacheOrLoadDataAsync(AgencyBondsLoad);
    }

    private async Task StatusFilterChange()
    {
        if (_statusFilter != null && !_statusFilter.Any())
        {
            _statusFilter = null;
        }

        await Grid.Reload();
    }

    private async Task ClassFilterChange()
    {
        if (_classFilter != null && !_classFilter.Any())
        {
            _classFilter = null;
        }

        await Grid.Reload();
    }

    private async Task BondTypeFilterChange()
    {
        if (_bondTypeFilter != null && !_bondTypeFilter.Any())
        {
            _bondTypeFilter = null;
        }

        await Grid.Reload();
    }

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }
}
