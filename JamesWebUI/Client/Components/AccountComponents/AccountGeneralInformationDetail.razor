@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenFieldset Text="General Information" Style="width: 100%">
    @if (_isEditMode)
    {
        <RadzenTemplateForm TItem="AccountGeneralInfoModel" Data="@GeneralInfoModel" Submit="OnSubmit" @ref="@Form">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem;">
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenText Style="height: 30px;"/>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="GIA Execution Date" Variant="Variant.Text">
                            <RadzenDatePicker @bind-Value=@GeneralInfoModel.GIAExecutionDate DateFormat="MM/dd/yyyy"
                                              Name="GIAExecutionDate"/>
                            <RadzenRequiredValidator Text="GIA Execution Date is required."
                                                     Component="GIAExecutionDate"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Account FYE Date" Variant="Variant.Text">
                            <RadzenDropDown TValue="string" @bind-Value="@GeneralInfoModel.FiscalYearEnd"
                                            Data="@_endFiscalYearList" AllowClear="true" Name="FiscalYearEnd"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <JamesFormField Text="Business Type" Variant="Variant.Text">
                            <RadzenDropDown TValue="string" @bind-Value="@GeneralInfoModel.BusinessType"
                                            ValueProperty="@nameof(BusinessTypeClassCodeDm.BusinessType)"
                                            TextProperty="@nameof(BusinessTypeClassCodeDm.BusinessType)"
                                            AllowFiltering="true" Data="@_businessClasses" AllowClear="false"
                                            Name="BusinessType"/>
                            <RadzenRequiredValidator Text="Business Type is required." Component="BusinessType"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <JamesFormField Text="Account Industry" Variant="Variant.Text">
                            <RadzenDropDown TValue="string" @bind-Value="@GeneralInfoModel.SicCode"
                                            ValueProperty="@nameof(Sic.Code)"
                                            TextProperty="@nameof(Sic.Name)"
                                            AllowFiltering="true" Data="@_sicCodes" AllowClear="false"
                                            Name="SicCode"/>
                            <RadzenRequiredValidator Text="Account Industry is required." Component="SicCode"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Prior Surety" Variant="Variant.Text">
                            <RadzenTextBox @bind-Value="@GeneralInfoModel.PriorSuretyCompany" Name="PriorSurety"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Shared Surety" Variant="Variant.Text">
                            <RadzenRadioButtonList @bind-Value="@GeneralInfoModel.IsSharedSurety" TValue="bool?"
                                                   Name="IsSharedSurety">
                                <Items>
                                    <RadzenRadioButtonListItem Text="Yes" Value="true" Style="height: 40px;"/>
                                    <RadzenRadioButtonListItem Text="No" Value="false" Style="height: 40px;"/>
                                </Items>
                            </RadzenRadioButtonList>
                            <RadzenRequiredValidator Text="Is shared surety is required." Component="IsSharedSurety"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <JamesFormField Text="Private Equity" Variant="Variant.Text">
                            <RadzenTextBox @bind-Value="@GeneralInfoModel.PrivateEquity" Name="PrivateEquity"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <JamesFormField Text="Snapshot of table with historic data" Variant="Variant.Text">
                            <RadzenTextBox @bind-Value="@GeneralInfoModel.SnapshotHistoricData"
                                           Name="SnapshotHistoricData"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.End">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem;">
                        <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                      ButtonType="ButtonType.Submit" Disabled="@(!Form.IsValid)"/>
                        <RadzenButton Text="Cancel" Icon="cancel" Click="OnCancel" ButtonStyle="ButtonStyle.Light"
                                      ButtonType="ButtonType.Reset"/>
                    </RadzenStack>
                </RadzenRow>
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem;">
            <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                              Click="@ToggleEditMode" Style="height: 30px;"/>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <JamesFormField Text="GIA Execution Date" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value="11/12/2025"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <JamesFormField Text="Account FYE Date" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value="@Account.FiscalYearEnd"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <JamesFormField Text="Business Type" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value="@Account.BusinessType"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <JamesFormField Text="Account Industry" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;"/> @*Value="@Account.SicCode"/>*@
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <JamesFormField Text="Prior Surety" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value="@Account.PriorSuretyCompany"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <JamesFormField Text="Shared Surety" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value="No"/>
                                       @*Value="@(GeneralInfoModel.IsSharedSurety ? "Yes" : "No" )"/>*@
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <JamesFormField Text="Private Equity" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value=""/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <JamesFormField Text="Snapshot of table with historic data" Variant="Variant.Text">
                        <RadzenTextBox Disabled="true" Style="color: black;" Value=""/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    }
</RadzenFieldset>

@code {
    [Parameter, EditorRequired] public required Account Account { get; set; } = null!;

    private bool _isEditMode;
    private RadzenTemplateForm<AccountGeneralInfoModel> Form { get; set; } = null!;
    private AccountGeneralInfoModel GeneralInfoModel { get; set; } = new();
    private List<BusinessTypeClassCodeDm> _businessClasses = [];
    private List<Sic> _sicCodes = [];

    private readonly List<string> _endFiscalYearList =
        ["01/31", "02/28", "03/31", "04/30", "05/31", "06/30", "07/31", "08/31", "09/30", "10/31", "11/30", "12/31"];

    #region Loaders

    #region BusinessClass

    private IDataAccessResult<List<BusinessTypeClassCodeDm>> _businessClassResult = null!;

    private LoadItem BusinessClassLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.BusinessClasses,
        AsyncLoadTask = async () => _businessClassResult = await DataAccess.GetAllBusinessTypeClassCodes(),
        CacheLoadTask = cache => _businessClassResult = new DataAccessResult<List<BusinessTypeClassCodeDm>>
        {
            Data = (List<BusinessTypeClassCodeDm>)cache!
        },
        ResultVariable = () => _businessClassResult,
        AfterLoad = () => { _businessClasses = _businessClassResult.Data!; }
    }, "business classes");

    #endregion*/

    #region SICCodes

    private IDataAccessResult<List<Sic>> _sicCodesResult = null!;

    private LoadItem SicCodesLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.SicCodes,
        AsyncLoadTask = async () => _sicCodesResult = await DataAccess.GetAllSicCodes(),
        CacheLoadTask = cache => _sicCodesResult = new DataAccessResult<List<Sic>>
        {
            Data = (List<Sic>)cache!
        },
        ResultVariable = () => _sicCodesResult,
        AfterLoad = () => { _sicCodes = _sicCodesResult.Data!; }
    }, "SIC codes");

    #endregion

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadReferenceTables();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private void ToggleEditMode()
    {
        GeneralInfoModel = new()
        {
            BusinessType = Account.BusinessType,
            FiscalYearEnd = Account.FiscalYearEnd,
            GIAExecutionDate = null, // Account.GIAExecutionDate
            PriorSuretyCompany = Account.PriorSuretyCompany,
            IsSharedSurety = false, // Account.IsSharedSurety
            SicCode = "", // Account.SicCode
            PrivateEquity = "", // Account.PrivateEquity
            SnapshotHistoricData = "" // Account.SnapshotHistoricData
        };
        
        _isEditMode = !_isEditMode;
    }

    private async Task LoadReferenceTables()
    {
        await DataAccess.ParallelGetCacheOrDataAsync(BusinessClassLoad, SicCodesLoad);
    }

    private async Task OnSubmit(AccountGeneralInfoModel model)
    {
        var result = await DataAccess.SetAccountGeneralInfoPanel(Account.Id, model.GIAExecutionDate, model.FiscalYearEnd,
            model.BusinessType, model.SicCode, model.PriorSuretyCompany, model.IsSharedSurety, model.PrivateEquity,
            model.SnapshotHistoricData);

        if(!result.Success)
        {
            NotifySaveError(result.Errors, "account general information");
            return;
        }
        
        NotifySuccessfulSave("account general information");

        //Account.GiaExecutionDate = model.GIAExecutionDate;
        Account.FiscalYearEnd = model.FiscalYearEnd;
        Account.BusinessType = model.BusinessType;
        //Account.SicCode = model.SicCode;
        Account.PriorSuretyCompany = model.PriorSuretyCompany;
        //Account.IsSharedSurety = model.IsSharedSurety;
        //Account.PrivateEquity = model.PrivateEquity;
        //Account.SnapshotHistoricData = model.SnapshotHistoricData;

        _isEditMode = false;
    }

    private void OnCancel()
    {
        GeneralInfoModel = new();
        _isEditMode = false;
    }

}