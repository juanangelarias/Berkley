@using Blazorise.Animate;

@inherits SlidingComponent

<Theme />

<RenderModeBackground/>

<PositionSavingTabs Change="@HandleChangeDirection" TabControlName="AgencyGeneralInfoGrids" TabPosition="TabPosition.Left" >
    <Tabs>
        <PositionSavingTabsItem Text="Licenses" TabName="Licenses">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyLicenseGrid Agency="Agency" />
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="POAs" TabName="POAs">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyPOAGrid Agency="Agency" />
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="Related Parties" TabName="RelatedParties">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyRelatedPartiesGrid AgencyId="Agency.Id" NotResumed="true"/>
            </Animate>
        </PositionSavingTabsItem>
    </Tabs>
</PositionSavingTabs>

@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
}
