<RenderModeBackground />
<RadzenTemplateForm TItem="List<AgencyCommission>" Data="@_commissionRates" Submit="@SaveCommissionRates">
    <RadzenRow Component="CommissionRates">
        <RadzenColumn Size="5">
            <RadzenFieldset Text="Contract Rates">
                <TieredValueEditor T="double" EditMode=@_editMode
                                   @ref=@_contractEditor
                                   ShowValidations="@ValidationRequired"
                                   ValuePlaceholder="Commission Rate" ValueHeaderText="Commission Rate"
                                   ValueMinimum="1" ValueMaximum="100" Values=@_contractRates />
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn Size="5">
            <RadzenFieldset Text="Commercial Rates">
                <TieredValueEditor T="double" EditMode=@_editMode
                                   @ref=@_commercialEditor
                                   ShowValidations="@ValidationRequired"
                                   ValuePlaceholder="Commission Rate" ValueHeaderText="Commission Rate"
                                   ValueMinimum="1" ValueMaximum="100" Values=@_commercialRates />
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn>
            @if (_editMode)
            {
                <RadzenButton Click=@SaveEdit Text="Save" />
                <RadzenButton Click=@CancelEdit Text="Cancel" />
            }
            else
            {
                <RadzenButton Click=@(_=>_editMode=true)>Edit</RadzenButton>
            }
            <br />
            <span style="font-size:small">Temp UI by Greg</span>
        </RadzenColumn>
    </RadzenRow>
    <RadzenCustomValidator Component="CommissionRates" Validator="@IsValid" Text="Commission rates must exist, have no gaps and not overlap" />
</RadzenTemplateForm>

@code {
    [Parameter] public Guid AgencyId { get; set; }
    [Parameter] public string AgencyStatus { get; set; }
    string _agencyStatus = "";
    bool _editMode;
    List<AgencyCommission> _commissionRates;
    List<ITieredValue<double>> _commercialRates;
    List<ITieredValue<double>> _contractRates;
    TieredValueEditor<Double> _contractEditor;
    TieredValueEditor<Double> _commercialEditor;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await LoadRates();
    }

    async Task LoadRates()
    {
        //UNDONE:  Query from DB
        _commissionRates =
        [
            new() {AgencyId = AgencyId, BondType = "Commercial", Minimum = 1, Maximum = 50000, Rate = 30},
            new() {AgencyId = AgencyId, BondType = "Commercial", Minimum = 50001, Maximum = 250000, Rate = 25},
            new() {AgencyId = AgencyId, BondType = "Commercial", Minimum = 250001, Maximum = 1000000, Rate = 20},
            new() {AgencyId = AgencyId, BondType = "Commercial", Minimum = 1000001, Rate = 5}
        ];
        await Task.Delay(250);
        _commercialRates = _commissionRates.Where(r => r.BondType == "Commercial").Cast<ITieredValue<double>>().ToList();
        _contractRates = _commissionRates.Where(r => r.BondType == "Contract").Cast<ITieredValue<double>>().ToList();
        StateHasChanged();
    }

    async Task CancelEdit()
    {
        _editMode = false;
        await LoadRates();
    }

    async Task SaveEdit()
    {
        //UNDONE: Save to DB
        _editMode = false;
        await LoadRates();
    }

    private string[] _noValidationStatuses = {"Pending", "Lost", "Terminated"};
    private bool ValidationRequired => !_noValidationStatuses.Contains(AgencyStatus);

    private bool IsValid() => !ValidationRequired || (_contractEditor.IsValid() && _commercialEditor.IsValid());

    private void SaveCommissionRates(List<AgencyCommission> obj)
    {
        throw new NotImplementedException();
    }

}
