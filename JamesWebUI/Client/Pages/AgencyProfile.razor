@page "/Agency/{Id}"
@using System.Diagnostics
@using James.Shared

@inherits LayoutComponentBase

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@*@inject JamesClient JamesClient  TODO:Remove after debugging *@
@inject IDataAccess _dataAccess
@inject ILoggingService _logging
@attribute [Authorize]

<Theme />

<PageTitle>Agency Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>
 @* ReSharper disable ConditionalAccessQualifierIsNonNullableAccordingToAPIContract *@
<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" Collapsed="_summaryView">
        <FooterTemplate>
            <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                <RadzenButton Icon="expand_less" Variant="Variant.Text" Click="@(() => _summaryView = !_summaryView)" />
            </RadzenStack>
        </FooterTemplate>
        <SummaryTemplate>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@_agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@_agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@_agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                    <RadzenButton Icon="expand_more" Variant="Variant.Text" Click="@(() => _summaryView = !_summaryView)" />
                </RadzenStack>
            </RadzenRow>
        </SummaryTemplate>
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@_agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@_agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenRow>
                                <RadzenColumn Size="3">
                                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="3">
                                    <RadzenFormField Text="Parent No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.ParentNavigation?.AgencyIdNavigation?.AgencyNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="Parent" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.ParentNavigation?.FullName" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenFormField Text="Tax ID" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_username" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Approved Date" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField Text="NPN" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                        <RadzenTextBox Value="@_agencyToDisplay?.NationalProducerNumber" Disabled="true" Style="color: black;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <br />
                            </RadzenRow>
                            <RadzenRow Gap="2">
                                <RadzenColumn Size="12">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@_agencyToDisplay.W9"
                                                            Text="W-9" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success"
                                                            Text="Need 1099" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                        <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@_agencyToDisplay.Nasbp"
                                                            Text="NASBP" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenTabs>
                        <Tabs>
                            <RadzenTabsItem Text="Main">
                                <AddressDisplay AddressId="@_mainAddress.Id" />
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Billing">
                                <AddressDisplay AddressId="@_billingAddress.Id" />
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Errors & Omissions Coverage">
                                <RadzenStack Orientation="Orientation.Vertical">
                                    <RadzenFormField AllowFloatingLabel="false" Text="Carrier">
                                        <RadzenText Text="@_agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Carrier" />
                                    </RadzenFormField>
                                    <RadzenFormField AllowFloatingLabel="false" Text="Exp Date">
                                        <RadzenText Text="@_agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Expiration.ToShortDateString()" />
                                    </RadzenFormField>
                                    <RadzenFormField AllowFloatingLabel="false" Text="Limit">
                                        <RadzenText Text="@_agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.CoverageLimit.ToString("c0")" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px">
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="General Info">
                    <AgencyGeneralInfoGrids agencyId="@_agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Contacts">
                    <AgencyContactsGrid AgencyId="@_agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Inventory">
                    <AgencyInventoryGrid AgencyId="@_agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Accounts and Bonds">
                    <AgencyAccountsAndBonds agencyToDisplay="@_agencyToDisplay" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Commission Rates">
                    <AgencyCommissionRates AgencyId="@_agencyToDisplay.Id" AgencyStatus="@_agencyToDisplay?.Status" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Virtual File">
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenPanel>
</RadzenStack>
@* ReSharper restore ConditionalAccessQualifierIsNonNullableAccordingToAPIContract *@

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    private string _username = "";
    public Notification[]? Notifications;
    private bool _contactsGridView = false;
    private Agency _agencyToDisplay = new Agency();
    private Address _mainAddress = new Address();
    private Address _billingAddress = new Address();
    private bool _summaryView;
    IDisposable? _mainAddressSubscription;
    IDisposable? _billingAddressSubscription;
    RadzenDataGrid<AgencyLicense>? _licenseGrid;

    private bool MainAddressEditMode { get; set; }
    private bool BillingAddressEditMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthenticationState != null)
        {
            var state = await AuthenticationState;

            _username = state.User.FindFirst("nickname")?.Value ?? string.Empty;
        }

        ThemeService.Initialize(NavigationManager);

        Notifications =
        [
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 1234567"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 2345678"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 3456789"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 4567890"}
        ];
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (null == Id) 
            throw new ArgumentNullException(nameof(Id));
        var result = await _dataAccess.GetAgencyByAgencyNumber(Id);
        if (result.Success)
        {
            Debug.Assert(result.Data != null, "result.Data != null if result.Success == true");
            _agencyToDisplay = result.Data; //ThisToThat.ToEntityType<Agency>(result.Data.AgencyByAgencyNumber);

            _mainAddress = _agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address ?? new Address();
            _billingAddress = _agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Billing")?.Address ?? new Address();
            _mainAddressSubscription = _dataAccess.AddressModified(_mainAddress.Id, _ =>
            {
                //TODO:Compare result to what is in editor
                ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Detail = "Information on this page has been changed by another user.",
                        Duration = 4000
                    });
            });
            _billingAddressSubscription = _dataAccess.AddressModified(_billingAddress.Id, a =>
            {
                //TODO:Compare result to what is in editor
                ShowNotification(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Detail = "Information on this page has been changed by another user.",
                        Duration = 4000
                    });
            });
        }
        else
        {
            _logging.LogWarning("GetAgencyByAgencyNumber returned error(s)", string.Join("\r\n", result.Errors), "GraphQl");
        }
    }

    private void ToggleMainAddressEditMode()
    {
        MainAddressEditMode = !MainAddressEditMode;
    }
    private void ToggleBillingAddressEditMode()
    {
        BillingAddressEditMode = !BillingAddressEditMode;
    }
    async Task SubmitAddressChange(Address newAddress)
    {
        await _dataAccess.SetAddress(newAddress);

    }
    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
    // async Task AddressChangeDetected(Address result)
    // {
    //     var data = result;
    // }
    // private async Task CanChange(StepsCanChangeEventArgs args)
    // {
    //     return;
    // }
}
