@using JamesWebUI.Client.Services
@inherits JamesLayoutComponentBase
@inject NavigationManager NavigationManager


<link href="@Href" rel="stylesheet" />

@code {
    bool IsPremiumTheme => JamesThemeService.CurrentTheme == "fluent" || JamesThemeService.CurrentTheme == "material-dark";

    string Href => IsPremiumTheme ? $"/css/{JamesThemeService.CurrentTheme}-base.css" : $"_content/Radzen.Blazor/css/{JamesThemeService.CurrentTheme}-base.css";

    protected override void OnInitialized()
    {
        JamesThemeService.Initialize(NavigationManager);
    }
}