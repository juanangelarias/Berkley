@inject IDataAccess DataAccess;

@inherits JamesLayoutComponentBase

<RenderModeBackground/>

<RadzenColumn Size="12">
    <RadzenRow>
        <RadzenTabs TabPosition="TabPosition.Top">
            <Tabs>
                <RadzenTabsItem Text="Contract">
                    <RadzenTabs TabPosition="TabPosition.Left">
                        <Tabs>
                            <RadzenTabsItem Text="Current">
                                <AgencyCommissionRatesGrid AgencyId="Agency.Id"
                                                           BondType="BondType.Contract"
                                                           CommissionType="CommissionType.Current"
                                                           Rates="_contractCurrentRates" OnCreate="OnCreateCommission"
                                                           OnUpdate="OnUpdateCommission" OnDelete="OnDeleteCommission"/>
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Scheduled">
                                <AgencyCommissionRatesGrid AgencyId="Agency.Id"
                                                           BondType="BondType.Contract"
                                                           CommissionType="CommissionType.Scheduled"
                                                           Rates="_contractScheduledRates" OnCreate="OnCreateCommission"
                                                           OnUpdate="OnUpdateCommission" OnDelete="OnDeleteCommission"/>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Commercial">
                    <RadzenTabs TabPosition="TabPosition.Left">
                        <Tabs>
                            <RadzenTabsItem Text="Current">
                                <AgencyCommissionRatesGrid AgencyId="Agency.Id"
                                                           BondType="BondType.Commercial"
                                                           CommissionType="CommissionType.Current"
                                                           Rates="_commercialCurrentRates" OnCreate="OnCreateCommission"
                                                           OnUpdate="OnUpdateCommission" OnDelete="OnDeleteCommission"/>
                            </RadzenTabsItem>
                            <RadzenTabsItem Text="Scheduled">
                                <AgencyCommissionRatesGrid AgencyId="Agency.Id"
                                                           BondType="BondType.Commercial"
                                                           CommissionType="CommissionType.Scheduled"
                                                           Rates="_commercialScheduledRates"
                                                           OnCreate="OnCreateCommission"
                                                           OnUpdate="OnUpdateCommission" OnDelete="OnDeleteCommission"/>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenRow>
    <RadzenRow>
        <AgencyCommissionProfit Agency="Agency"/>
    </RadzenRow>
</RadzenColumn>

@code {
    [Parameter] public Agency Agency { get; set; } = null!;

    [Parameter] public string AgencyStatus { get; set; } = null!;

    
    private List<AgencyCommission> _commissionRates = null!;
    private List<AgencyCommission> _commercialCurrentRates = null!;
    private List<AgencyCommission> _commercialScheduledRates = null!;
    private List<AgencyCommission> _contractCurrentRates = null!;
    private List<AgencyCommission> _contractScheduledRates = null!;

    private string _keyAgencyCommission = string.Empty;

    private IDataAccessResult<List<AgencyCommission>> _ratesResult = null!;

    private LoadItem RatesLoad => AddEventNotify(new LoadItem
    {
        Key = _keyAgencyCommission,
        AsyncLoadTask = async () => _ratesResult = await DataAccess.GetAgencyCommissionRates(Agency.Id),
        CacheLoadTask = cache => _ratesResult = new DataAccessResult<List<AgencyCommission>>
        {
            Data = (List<AgencyCommission>)cache!
        },
        ResultVariable = () => _ratesResult
    }, "agency commission rates");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        _keyAgencyCommission = $"AgencyCommissionRates{Agency.Id}";
        await LoadRates();
    }

    private async Task LoadRates()
    {
        if (Agency.Id == Guid.Empty)
            return;

        await DataCache.GetCacheOrLoadDataAsync(RatesLoad);

        if (!_ratesResult.Success)
            return;

        _commissionRates = _ratesResult.Data ?? [];

        DistributeCommissions();
    }

    private void DistributeCommissions()
    {
        _commercialCurrentRates = _commissionRates.Where(r => r.BondType.ToLower() == "commercial" && r.Expires == null).ToList();
        _commercialScheduledRates = _commissionRates.Where(r => r.BondType.ToLower() == "commercial" && r.Expires != null).ToList();
        
        _contractCurrentRates = _commissionRates.Where(r => r.BondType.ToLower() == "contract" && r.Expires == null).ToList();
        _contractScheduledRates = _commissionRates.Where(r => r.BondType.ToLower() == "contract" && r.Expires != null).ToList();
    }

    private string[] _noValidationStatuses = { "Pending", "Lost", "Terminated" };
    private bool ValidationRequired => !_noValidationStatuses.Contains(AgencyStatus);

    private async Task OnCreateCommission(AgencyCommission rate)
    {
        var result = await DataAccess.SetAgencyCommissionRate(rate);

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "agency commission rates");
        }
        else
        {
            _commissionRates.Add(rate);
            DistributeCommissions();
            DataCache.UpdateCache(_keyAgencyCommission, _commissionRates);

            StateHasChanged();
        }
    }

    private async Task OnUpdateCommission(AgencyCommission rate)
    {
        var result = await DataAccess.SetAgencyCommissionRate(rate);

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "agency commission rates");
        }
        else
        {
            NotifySuccessfulSave("agency commission");
            var toUpdate = _commissionRates.FirstOrDefault(f => f.Id == rate.Id);
            if (toUpdate != null)
            {
                _commissionRates.Remove(toUpdate);
                _commissionRates.Add(rate);
            }

            DistributeCommissions();
            DataCache.UpdateCache(_keyAgencyCommission, _commissionRates);

            StateHasChanged();
        }
    }

    private async Task OnDeleteCommission(Guid id)
    {
        var result = await DataAccess.DeleteAgencyCommissionRate(id);
        
        if (!result.Success)
        {
            NotifySaveError(result.Errors, "agency commission rates");
        }
        else
        {
            NotifySuccessfulSave("agency commission");
            var toRemove = _commissionRates.FirstOrDefault(f => f.Id == id);
            if (toRemove != null)
            {
                _commissionRates.Remove(toRemove);
                
                DistributeCommissions();
                DataCache.UpdateCache(_keyAgencyCommission, _commissionRates);

                StateHasChanged();
            }
        }
    }
}
