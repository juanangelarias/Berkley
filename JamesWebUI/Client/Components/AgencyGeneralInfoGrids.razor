@using System.Globalization;
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;
@using James.Shared;
@using Blazorise.Animate;

@inherits SlidingComponent

@inject ThemeService ThemeService
@inject JamesClient JamesClient

<Theme />

<RadzenTabs Change="@HandleChangeDirection" TabPosition="TabPosition.Left">
    <Tabs>
        <RadzenTabsItem Text="Licenses">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenFieldset Text="Agency Licenses">
                    <AgencyLicenseGrid AgencyId="agencyToDisplay.Id" />
                </RadzenFieldset>
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="POAs">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenFieldset Text="Agency POAs">
                    <RadzenDataGrid TItem="string" Data="@blankList"
                                    Style="border-radius: 20px;" EmptyText="No records to display">
                        <Columns>
                            <RadzenDataGridColumn TItem="string" Title="Insurer" Width="100px" />
                            <RadzenDataGridColumn TItem="string" Title="Limit" Width="100px" />
                            <RadzenDataGridColumn TItem="string" Title="Reference #" Width="200px" />
                            <RadzenDataGridColumn TItem="string" Title="Date of 1st Issue" Width="200px" />
                            <RadzenDataGridColumn TItem="string" Title="Current POA Date" Width="200px" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenFieldset>
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Related Parties">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenFieldset Text="Related Parties">
                    <RadzenDataGrid TItem="string" Data="@blankList"
                                    Style="border-radius: 20px;" EmptyText="No records to display">
                        <Columns>
                            <RadzenDataGridColumn TItem="string" Title="Agency #" Width="100px" />
                            <RadzenDataGridColumn TItem="string" Title="Agency Name" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenFieldset>
            </Animate>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public Agency agencyToDisplay { get; set; } = new Agency();
    List<string> blankList = new List<string>();

}
