@using James.Shared.Dto
@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<Theme />


<RadzenDataGrid TItem="AgencyAccountDto" @ref="@_agencyAccountGrid" Data="@_agencyAccounts" AllowGrouping="true" AllowSorting="true"
                Style="height: 400px; border-radius: 10px;" AllowColumnResize="true" AllowColumnPicking="true" Density="Density.Compact"
                AllowFiltering="true" FilterMode="FilterMode.Advanced" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                RowExpand="RowExpand" IsLoading="@IsLoading">
    <Template Context="account">
        <RadzenDataGrid Data="account.Bonds" TItem="AgencyAccountBondDto" Density="Density.Compact"
                        Style="height: 400px; border-radius: 10px;" >
            <Columns>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Status" Property="Status" MinWidth="80px" TextAlign="TextAlign.Center">
                    <Template Context="bond">
                        @if (bond.Status == "Active")
                        {
                            <RadzenIcon Icon="circle" Style="color: green;"/>
                        } 
                        else
                        {
                            <RadzenIcon Icon="circle" Style="color: red;"/>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Bond #" Property="BondNumber" MinWidth="100px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Account Name" Width="300px">
                    <Template>
                        <RadzenText Text="@account.Name"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Branch" MinWidth="90px">
                    <Template>
                        <RadzenText Text="@account.Branch"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Type" Property="BondType" MinWidth="110px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Begin Date" Property="Effective" FormatString="{0:dd/MM/yyyy}" MinWidth="120px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="End Date" Property="Expiration" FormatString="{0:dd/MM/yyyy}" MinWidth="120px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Appointment" Property="Appointment" FormatString="{0:dd/MM/yyyy}" MinWidth="120px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Termination" Property="Termination" FormatString="{0:dd/MM/yyyy}" MinWidth="120px"/>
            </Columns>
        </RadzenDataGrid>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Status" Property="Status" Frozen="true" Width="120px"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Acc. #" Property="AccountNum" Frozen="true" Width="130px">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Account" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Number" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Name" Property="Name" Frozen="true" MinWidth="250px"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Address" Property="MainAddress.Address1" MinWidth="200px">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.Address1"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="City" Width="150px">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.City"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="State" Width="120px" Property="MainAddress.StateCode">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.StateCode"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Postal Code" Width="150px">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Postal" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Code" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.PostalCode"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Branch" Property="Branch" Width="130px"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Bond Count" Width="125px">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Bond" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Count" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
            <Template Context="account">
                <RadzenText Text="@account.Bonds.Count().ToString()"/>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        No Records to Display
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public required string AgencyNumber { get; set; }

    private List<AgencyAccountDto> _agencyAccounts = new();
    private RadzenDataGrid<AgencyAccountDto> _agencyAccountGrid = null!;
    
    private IDataAccessResult<List<AgencyAccountDto>> _accountResult = null!;

    // ToDo: Once we resolve the problem of deserialization we need to remove the line
    //       >> CacheDuration = new (0, 0, 0, 0) <<
    private LoadItem AccountLoad => AddEventNotify(new LoadItem<List<Account>>
    {
        Key = $"Accounts{AgencyNumber}",
        AsyncLoadTask = async () => _accountResult = await DataAccess.GetAgencyAccounts(AgencyNumber),
        CacheLoadTask = cache => _accountResult = new DataAccessResult<List<AgencyAccountDto>>
        {
            Data = (List<AgencyAccountDto>)cache!
        },
        ResultVariable = () => _accountResult,
        AfterLoad = () => { _agencyAccounts = _accountResult.Data!; },
        CacheDuration = new(0, 0, 0, 0)
    }, "accounts");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await Task.Delay(100);

    }
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadAgencyAccounts();

    }

    private async Task LoadAgencyAccounts()
    {
        if (string.IsNullOrEmpty(AgencyNumber))
            return;

        await DataAccess.GetCacheOrLoadDataAsync(AccountLoad);
    }
    
    private async Task RowExpand(AgencyAccountDto arg)
    {
        if(arg.Bonds.Any())
            return;
        
        var bondsResult = await DataAccess.GetAgencyAccountBonds(arg.AccountNum);
        
        if (bondsResult.Success)
            arg.Bonds = bondsResult.Data!;
        else
            NotifyLoadError(bondsResult.Errors, "bonds", true);
    }
}
