@page "/Account/{AccountNumber?}"

@using JamesWebUI.Client.Model
@inherits JamesLayoutComponentBase

@attribute [Authorize]

<Theme/>

<PageTitle>BasisTNG - Account Profile</PageTitle>

<RadzenColumn Size="12">
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenCard Variant="Variant.Text" Style="width: 100%; margin: 10px; padding: 0;" >
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="8">
                            <AccountSearch SetAccount="OnSetAccount" CreateNewAccount="CreateNewAccount"/>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenCard Variant="Variant.Text" Style="width: 100%;">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.End">
                                <RadzenLabel Text="View Type: " Style="font-size: small;"
                                             Visible="@IsUserManager"/>
                                <RadzenDropDown Data="@(Enum.GetValues(typeof(AccountLayout)).Cast<Enum>())"
                                                @bind-Value="@SelectedType"
                                                Text="Select View Type" Style="font-size: small; height: 35px;"
                                                Visible="@IsUserManager"/>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenRow>
        @if (IsAccountLoaded)
        {
            <RadzenRow Style="width: 100%; margin-top: -30px;">
                @switch (SelectedType)
                {
                    case AccountLayout.Commercial:
                        <AccountCommercial/>
                        break;
                    case AccountLayout.Contract:
                        <AccountContract/>
                        break;
                    case AccountLayout.Default:
                        <AccountDefault/>
                        break;
                    default:
                        <RadzenColumn span="12">
                            <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                                <RadzenText Text="The user needs to be defined as Commercial or Contract user"
                                            TextStyle="TextStyle.DisplayH5" TextAlign="TextAlign.Center"/>
                            </RadzenRow>
                        </RadzenColumn>
                        break;
                }
            </RadzenRow>
        }
        else
        {
            <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4">
                            <BusyDialog Message="Loading..."/>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenRow>
        }
    </RadzenStack>
</RadzenColumn>

@code {
    [Parameter] public string? AccountNumber { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await SetLayout();

        if (string.IsNullOrEmpty(AccountNumber))
        {
            ClearAccount();
            IsAccountLoaded = true;
            return;
        }

        await Initialize();

        StateHasChanged();
    }

    private async Task OnSetAccount(string arg)
    {
        AccountNumber = arg;
        AccountNumber = arg;

        await Initialize();
    }
    
    private async Task CreateNewAccount()
    {
        throw new NotImplementedException();
    }
}
