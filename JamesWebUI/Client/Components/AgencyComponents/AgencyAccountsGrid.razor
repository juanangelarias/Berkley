@using Newtonsoft.Json
@using James.Shared.Constants
@using James.Shared.Dto
@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess
@inject TooltipService TooltipService;

<Theme/>

<RadzenDataGrid TItem="AgencyAccountDto" @ref="@AgencyAccountGrid" Data="@_agencyAccounts" AllowGrouping="true"
                AllowSorting="true" Style="height: 400px; border-radius: 10px;" AllowColumnResize="true" AllowColumnPicking="true" 
                Density="Density.Compact" AllowFiltering="true" FilterMode="FilterMode.Advanced" IsLoading="@IsLoading" 
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" RowExpand="RowExpand" 
                @bind-Settings="@GridSettings" AllowColumnReorder="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Icon="settings" Click="SaveGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                          Visible="@_userSettingsChanged"/>
            <RadzenButton Icon="reset_settings" Click="ResetGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                          Visible="@_userSettingsLoaded"/>
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="account">
        <RadzenDataGrid Data="account.Bonds" TItem="AgencyAccountBondDto" Density="Density.Compact"
                        Style="height: 400px; border-radius: 10px;">
            <Columns>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Status" Property="Status" MinWidth="80px"
                                      TextAlign="TextAlign.Center" Resizable="true">
                    <Template Context="bond">
                        @if (bond.Status == "Active")
                        {
                            <RadzenIcon Icon="circle" Style="color: green;"/>
                        }
                        else
                        {
                            <RadzenIcon Icon="circle" Style="color: red;"/>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Bond No." Property="BondNumber"
                                      MinWidth="100px" Resizable="true"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Account Name" Width="300px" Resizable="true">
                    <Template>
                        <RadzenText Text="@account.Name"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Branch" MinWidth="90px" Resizable="true">
                    <Template>
                        <RadzenText Text="@account.Branch"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Type" Property="BondType" MinWidth="110px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Begin Date" Property="Effective"
                                      FormatString="{0:dd/MM/yyyy}" MinWidth="120px" Resizable="true"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="End Date" Property="Expiration"
                                      FormatString="{0:dd/MM/yyyy}" MinWidth="120px" Resizable="true"/>
            </Columns>
        </RadzenDataGrid>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Status" Property="Status" Frozen="true" Width="120px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Property="AccountNum" Frozen="true" Width="130px"
                              Resizable="true">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Account" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Number" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Name" Property="Name" Frozen="true" MinWidth="250px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Address" Property="MainAddress.Address1" MinWidth="200px"
                              Resizable="true">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.Address1"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="City" Width="150px" Resizable="true">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.City"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="State" Width="120px" Property="MainAddress.StateCode"
                              Resizable="true">
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.StateCode"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Postal Code" Width="150px" Resizable="true">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Postal" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Code" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
            <Template Context="account">
                <RadzenText Text="@account.MainAddress?.PostalCode"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Branch" Property="Branch" Width="130px" Resizable="true"/>
        <RadzenDataGridColumn TItem="AgencyAccountDto" Title="Bond Count" Width="125px" Resizable="true">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenText Text="Bond" TextStyle="TextStyle.Body2"/>
                    <RadzenText Text="Count" TextStyle="TextStyle.Body2"/>
                </RadzenStack>
            </HeaderTemplate>
            <Template Context="account">
                <RadzenText Text="@account.Bonds.Count().ToString()"/>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        No Records to Display
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public required string AgencyNumber { get; set; }

    private List<AgencyAccountDto> _agencyAccounts = new();
    private RadzenDataGrid<AgencyAccountDto> AgencyAccountGrid { get; set; } = null!;

    private IDataAccessResult<List<AgencyAccountDto>> _accountResult = null!;

    #region Grid User Settings

    private DataGridSettings? _dataGridSettings;
    private DataGridSettings? GridSettings
    {
        get => _dataGridSettings;
        set
        {
            if (_dataGridSettings == value)
                return;

            _dataGridSettings = value;
            _userSettingsChanged = true;
        }
    }

    private bool _userSettingsLoaded;
    private bool _userSettingsChanged;

    #endregion
    
    private ExportFormat _defaultExportFormat;

    // ToDo: Once we resolve the problem of deserialization we need to remove the line
    //       >> CacheDuration = new (0, 0, 0, 0) <<
    private LoadItem AccountLoad => AddEventNotify(new LoadItem<List<Account>>
    {
        Key = $"Accounts{AgencyNumber}",
        AsyncLoadTask = async () => _accountResult = await DataAccess.GetAgencyAccounts(AgencyNumber),
        CacheLoadTask = cache => _accountResult = new DataAccessResult<List<AgencyAccountDto>>
        {
            Data = (List<AgencyAccountDto>)cache!
        },
        ResultVariable = () => _accountResult,
        AfterLoad = () => { _agencyAccounts = _accountResult.Data!; },
        CacheDuration = new(0, 0, 0, 0)
    }, "accounts");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await GetGridSettings();
        await Task.Delay(100);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadAgencyAccounts();
    }

    private async Task LoadAgencyAccounts()
    {
        if (string.IsNullOrEmpty(AgencyNumber))
            return;

        await DataAccess.GetCacheOrLoadDataAsync(AccountLoad);
    }

    private async Task RowExpand(AgencyAccountDto arg)
    {
        if (arg.Bonds.Any())
            return;

        var bondsResult = await DataAccess.GetAgencyAccountBonds(arg.AccountNum);

        if (bondsResult.Success)
            arg.Bonds = bondsResult.Data!;
        else
            NotifyLoadError(bondsResult.Errors, "bonds", true);
    }

    #region Grid User Settings

    private async Task SaveGridSettings()
    {
        await ShowLoading();
        
        var userGridSettings = new GridSettings
        {
            DefaultExportFormat = _defaultExportFormat,
            Settings = GridSettings
        };

        var value = JsonConvert.SerializeObject(userGridSettings);
        var response = await DataAccess.SetUserSetting(UserSettingsKeyConstants.AgencyAccountGrid, value);

        if (!response.Success)
        {
            NotifySaveError(response.Errors, "user settings");
            return;
        }

        _userSettingsLoaded = true;
        _userSettingsChanged = false;
        StateHasChanged();
    }

    private async Task GetGridSettings()
    {
        await ShowLoading();
        
        var response = await DataAccess.GetUserSetting(UserSettingsKeyConstants.AgencyAccountGrid);
        if (!response.Success || response is { Success: true, Data: null })
        {
            if (!response.Success)
                NotifyLoadError(response.Errors, "user settings");

            _userSettingsLoaded = false;
            return;
        }

        var userGridSettings = JsonConvert.DeserializeObject<GridSettings>(response.Data!.Value);

        if (userGridSettings == null)
            return;

        _defaultExportFormat = userGridSettings.DefaultExportFormat;
        GridSettings = userGridSettings.Settings;
        _userSettingsLoaded = true;
        _userSettingsChanged = false;
    }

    private async Task ResetGridSettings()
    {
        await ShowLoading();
        
        GridSettings = null;
        _defaultExportFormat = ExportFormat.Excel;
        await AgencyAccountGrid.ReloadSettings();

        await DataAccess.ResetUserSetting(UserSettingsKeyConstants.AgencyAccountGrid);
        _userSettingsLoaded = false;
        _userSettingsChanged = false;
    }

    #endregion

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }

}
