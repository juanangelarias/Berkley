<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<add key="globalPackagesFolder" value="C:\Projects\packages" />
	</config>
	<packageRestore>
		<add key="enabled" value="True" />
		<add key="automatic" value="True" />
	</packageRestore>
	<bindingRedirects>
		<add key="skip" value="False" />
	</bindingRedirects>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="BSGBuildServer" value="https://USILG01-APD124/Nuget/nuget" />
		<add key="BTS" value="https://nex3.berkley-bts.com:8443/service/local/nuget/nuget-internal/" />
		<!--<add key="Telerik Nuget" value="https://nuget.telerik.com/nuget" />-->
		<!--<add key="Local Nuget Feed" value="https://localhost/Nuget/nuget" />-->
	</packageSources>
	<activePackageSource>
		<!-- this tells that all of them are active -->
		<add key="All" value="(Aggregate source)" />
	</activePackageSource>
</configuration>
