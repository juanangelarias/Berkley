@page "/Agency/{Id?}"

@using System.Diagnostics
@using James.Shared
@using James.Shared.Imaging

@inherits JamesLayoutComponentBase
@implements IDisposable

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess
@inject ILoggingService Logging

@attribute [Authorize]

<Theme />
<RenderModeBackground></RenderModeBackground>
<PageTitle>BasisTNG - Agency Profile</PageTitle>

@* ReSharper disable ConditionalAccessQualifierIsNonNullableAccordingToAPIContract *@

<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" Collapsed="_summaryView" class="rz-shadow-7">
        <FooterTemplate>
            <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                <RadzenButton Icon="expand_less" Variant="Variant.Text" Click="@(() => _summaryView = !_summaryView)" />
            </RadzenStack>
        </FooterTemplate>
        <SummaryTemplate>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@_agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@_agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@_agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                    <RadzenButton Icon="expand_more" Variant="Variant.Text" Click="@(() => _summaryView = !_summaryView)" />
                </RadzenStack>
            </RadzenRow>
        </SummaryTemplate>
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@_agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <AgencySearch />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@_agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" Click="ShowStatusDialog" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Agency Info">
                        <RadzenPanel class="rz-shade-6">
                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@_agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Parent No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.ParentNavigation?.AgencyIdNavigation?.AgencyNumber" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Parent" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@_agencyToDisplay?.IdNavigation?.ParentNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Tax ID" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <ChildContent>
                                                    @* TODO: Once encryption is figured out replace these values *@
                                                    <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" Visible="ShowTaxId" />
                                                    <RadzenPassword Value="Placeholder" Disabled="true" Visible="!ShowTaxId" />
                                                </ChildContent>
                                                <End>
                                                    @* TODO: Add authorization to use this button due to PII. *@
                                                    <RadzenButton Icon="@(ShowTaxId ? "visibility" : "visibility_off")" Click="@(() => ShowTaxId = !ShowTaxId)" Variant="Variant.Text" Size="ButtonSize.Small" />
                                                </End>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Branch" Variant="Variant.Text" AllowFloatingLabel="true" Style="width:90%">
                                                <RadzenDropDown TValue="string" @bind-Value="@_agencyToDisplay.Branch"
                                                                Data="AllBranches" ValueProperty="BranchKey" TextProperty="Name"
                                                                Disabled="!EditMode" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Approved Date" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="NPN" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox @bind-Value="@_agencyToDisplay.NationalProducerNumber" Disabled="!EditMode" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <br />
                                    </RadzenRow>
                                    <RadzenRow Gap="2">
                                        <RadzenColumn Size="12">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@_agencyToDisplay.W9"
                                                                    Text="W-9" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!EditMode" ToggleIcon="check" />
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@_agencyToDisplay.Need1099"
                                                                    Text="Need 1099" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!EditMode" ToggleIcon="check" />
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@_agencyToDisplay.Nasbp"
                                                                    Text="NASBP" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!EditMode" ToggleIcon="check" />
                                                <RadzenButton Text="Edit" Icon="edit" Visible="!EditMode" Click="@(() => EditMode = !EditMode)" />
                                                <RadzenButton Text="Save" Icon="save" Visible="EditMode" Click="SaveAgencyChanges" />
                                                <RadzenButton Text="Cancel" Icon="cancel" Visible="EditMode" Click="@(() => EditMode = !EditMode)" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenPanel>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Addresses">
                        <LegalEntityAddressManager LegalEntityId="@_agencyToDisplay.Id" />
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px">
        <PositionSavingTabs @ref="@TabsAgencyProfile" @bind-SelectedIndex="@TabsAgencyProfile.NewSelectedIndex" TabControlName="tabsAgencyProfile">
            <Tabs>
                <PositionSavingTabsItem Text="General Info" TabName="tabGenInfo">
                    <AgencyGeneralInfoGrids Agency="@_agencyToDisplay" />
                </PositionSavingTabsItem>
                <PositionSavingTabsItem Text="Contacts" TabName="tabContacts">
                    <AgencyContactsGrid AgencyId="@_agencyToDisplay.Id" />
                </PositionSavingTabsItem>
                <PositionSavingTabsItem Text="Inventory" TabName="tabInventory">
                    <AgencyInventoryGrid AgencyId="@_agencyToDisplay.Id" />
                </PositionSavingTabsItem>
                <PositionSavingTabsItem Text="Accounts and Bonds" TabName="tabAccountsBonds">
                    <AgencyAccountsAndBonds agencyToDisplay="@_agencyToDisplay" />
                </PositionSavingTabsItem>
                <PositionSavingTabsItem Text="Commission Rates" TabName="tabCommissionRates">
                    <AgencyCommissionRates AgencyId="@_agencyToDisplay.Id" AgencyStatus="@_agencyToDisplay?.Status" />
                </PositionSavingTabsItem>
                <PositionSavingTabsItem Text="Virtual File" TabName="tabVirtualFile">
                    <ImagingFull ImagingId="@_agencyToDisplay?.AgencyNumber" DocumentCategory="ImagingDocumentCategory.Agency" />
                </PositionSavingTabsItem>
            </Tabs>
        </PositionSavingTabs>
    </RadzenPanel>
</RadzenStack>

@* ReSharper restore ConditionalAccessQualifierIsNonNullableAccordingToAPIContract *@

@code {
    [Parameter] public string? Id { get; set; }
    private Agency _agencyToDisplay = new();
    private bool _summaryView;
    private bool EditMode { get; set; }
    private bool ShowTaxId { get; set; }

    private PositionSavingTabs TabsAgencyProfile { get; set; } = new();
    private List<Branch> AllBranches { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadBranches();

        JamesThemeService.Initialize(NavigationManager);

        //TODO: Remove this once testing of notification window is done.
    }

    private IDataAccessResult<Agency> _agencyResult = null!;
    private LoadItem AgencyByAgencyNumberLoadItem(string agencyNumber) =>
        AddEventNotify(new LoadItem<Agency>
            {
                Key = $"Agency{agencyNumber}",
                AsyncLoadTask = async () => _agencyResult = (await DataAccess.GetAgencyByAgencyNumber(agencyNumber))!,
                CacheLoadTask = cache => _agencyResult = new DataAccessResult<Agency> { Data = (Agency)cache! },
                ResultVariable = () => _agencyResult,
                AfterLoad = () =>
                {
                    if (!_agencyResult.Success) 
                        return;
                    
                    Debug.Assert(_agencyResult.Data != null, "AgencyResult.Data != null if result.Success == true");
                    _agencyToDisplay = _agencyResult.Data; //ThisToThat.ToEntityType<Agency>(result.Data.AgencyByAgencyNumber);
                },
                CacheDuration = TimeSpan.FromHours(8) //Subscription will update this if changed, so a long cache time is appropriate.
            }, $"agency");

    private IDataAccessResult<List<Branch>> _branchesResult = null!;
    private LoadItem BranchesLoadItem() =>
        AddEventNotify(new LoadItem<List<Branch>>
        {
            Key = "branches",
            AsyncLoadTask = async () => _branchesResult = await DataAccess.GetAllBranches(),
            CacheLoadTask = cache => _branchesResult = new DataAccessResult<List<Branch>> { Data = (List<Branch>)cache! },
            ResultVariable = () => _branchesResult,
            AfterLoad = () =>
            {
                Debug.Assert(_branchesResult.Data != null);
                AllBranches = _branchesResult.Data.OrderBy(b => b.Name).ToList();
            }
        }, "branches");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var loadItems = new List<LoadItem>([BranchesLoadItem()]);
        
        if (null != Id)
            loadItems.Add(AgencyByAgencyNumberLoadItem(Id));
        
        await DataAccess.ParallelGetCacheOrDataAsync(loadItems.ToArray());
    }
    
    private async Task LoadBranches()
    {
        await DataAccess.GetCacheOrLoadDataAsync(BranchesLoadItem());        
    }
    
    private async Task SaveAgencyChanges()
    {
        //TODO: Handle errors
        await DataAccess.SetAgencyGeneralInfo(_agencyToDisplay.Id, _agencyToDisplay.IdNavigation.FullName, _agencyToDisplay.IdNavigation.ParentNavigation!.Id,
            _agencyToDisplay.IdNavigation.TaxIdEncrypted, _agencyToDisplay.NationalProducerNumber, _agencyToDisplay.W9, _agencyToDisplay.Need1099,
            _agencyToDisplay.Nasbp, _agencyToDisplay.Branch);
        EditMode = !EditMode;
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Changes saved successfully.", Duration = 5000 });
    }

    public void Dispose()
    {
        AuthenticationState?.Dispose();
    }
    private async Task ShowStatusDialog()
    {
        await DialogService.OpenAsync<AgencyStatusGrid>("Agency Status",
        new Dictionary<string, object>() { { "AgencyNumber", _agencyToDisplay.AgencyNumber }, { "CurrentStatus", _agencyToDisplay.Status } },
        new DialogOptions()
        {
            Resizable = false,
            Draggable = true,
            CloseDialogOnOverlayClick = true,
            Style = "border-radius: 20px",
            Width = "1000px",
            Height = "500px"
        }
        );
    }
}

