@using James.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILoggingService LoggingService
<!--Changes the background color of the enclosing div according to whether
    it is rendered on the client-side or server-side
-->
<div class="renderModeBaseDiv" @ref=_baseDiv></div>

@code {
    IJSObjectReference? _module;
    ElementReference _baseDiv;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/RenderModeBackground.razor.js");
        //TODO:Add a check that this is not run in production.
        if (_module != null)
            try
            {
                if (OperatingSystem.IsBrowser())
                    await _module.InvokeVoidAsync("setBackgroundClient", _baseDiv);
                else
                    await _module.InvokeVoidAsync("setBackgroundServer", _baseDiv);
            }
            catch (JSDisconnectedException ex)
            {
                // Ignore
            }
            catch (Exception ex)
            {
                LoggingService.LogException(ex, "Unable to set background color", severity: Severity.Warning, category:StandardLoggingCategories.UserInterface);
            }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}
