@inherits JamesLayoutComponentBase

<RadzenSteps>
    <Steps>
        <RadzenStepsItem Text="Contract Bond Request Information">
            <RadzenRow>
                <RadzenColumn>
                    <RadzenText Text="Contract Bond Request Information" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="2">
                    <JamesFormField Text="Date of Request" AllowFloatingLabel="false" >
                        <RadzenDatePicker TValue="DateTime" ShowTime="false" />
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <JamesFormField Text="" AllowFloatingLabel="false" >
                        <RadzenDropDown TValue="string">
                            
                        </RadzenDropDown>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <JamesFormField Text="Bid Date" AllowFloatingLabel="false" >
                        <RadzenDatePicker TValue="DateTime" ShowTime="false" />
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <JamesFormField Text="Bond Number" AllowFloatingLabel="false" >
                        <RadzenTextBox Value="Placeholder" />
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="5">
                <RadzenColumn Size="4">
                    <JamesFormField Text="Obligee" AllowFloatingLabel="false" Style="width: 95%;">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="SelectedObligee" />
                        </ChildContent>
                        <End>
                            <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"/>
                        </End>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenButton Variant="Variant.Filled" Text="Add New Obligee" ButtonStyle="ButtonStyle.Light" Click="CreateObligeeClick" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <JamesFormField Text="Project Name" AllowFloatingLabel="false" Style="width:95%">
                        <RadzenTextBox Value="Placeholder"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStepsItem>
        <RadzenStepsItem Text="Send Request for Approval">

        </RadzenStepsItem>
        <RadzenStepsItem Text="Notes and Remarks">

        </RadzenStepsItem>
        <RadzenStepsItem Text="Bidders & Subs">

        </RadzenStepsItem>
    </Steps>
</RadzenSteps>

@code {
    private string SelectedObligee { get; set; } = "";

    public async Task CreateObligeeClick()
    {
        var result = await DialogService.OpenAsync<Pages.CreateObligee>("Create Obligee", 
        new Dictionary<string, object>() { { "IsDialog", true } },
        new DialogOptions()
            {
                Resizable = false,
                Draggable = false,
                Width = "750px",
                Height = "750px"
            });

        if (null != result)
        {
            SelectedObligee = result.IdNavigation.FullName;
        }
    }
}
