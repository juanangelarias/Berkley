@inherits JamesLayoutComponentBase

<RadzenColumn Size="12">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="3">
                <RadzenText Text="Type"/>
            </RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenText Text="@Alert.Type" Style="width: 100%;"/>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="3">
                <RadzenText Text="Date"/>
            </RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenText Text="@Alert.DateText" Style="width: 100%;"/>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
            <RadzenColumn Size="3">
                <RadzenText Text="Notification"/>
            </RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenTextArea Value="@Alert.Alert" Rows="3"
                                ReadOnly="true" Style="width: 100%;"/>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Style="margin-top: 1rem;">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End">
                <RadzenButton Text="Goto Account" Icon="folder" Click="OnOpenAccount"/>
                <RadzenButton Text="Close" Icon="close" Click="OnClose"/>
            </RadzenStack>
        </RadzenRow>
    </RadzenStack>
</RadzenColumn>

@code {
    [Parameter, EditorRequired] public required AccountAlertDto Alert { get; set; } = null!;
    
    private void OnOpenAccount(MouseEventArgs obj)
    {
        DialogService.Close(true);
    }
    
    private void OnClose(MouseEventArgs obj)
    {
        DialogService.Close(false);   
    }
}