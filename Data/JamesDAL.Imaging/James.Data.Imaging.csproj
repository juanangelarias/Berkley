    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WcfCoreMtomEncoderV2" Version="1.0.1" />
    <PackageReference Include="Winista.MimeDetect" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\James.Shared.Server\James.Shared.Server.csproj" />
    <ProjectReference Include="..\..\Shared\James.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.AspNetCore.Mvc.Core">
      <HintPath>..\..\..\..\..\Program Files\dotnet\shared\Microsoft.AspNetCore.App\8.0.7\Microsoft.AspNetCore.Mvc.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
