@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using JamesWebUI.Client.Controls.Extensions

@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <RadzenProfileMenu Click="ProfileItemClicked">
            <Template>
                <RadzenGravatar Email="TUser1@BerkleySurety.com" AlternateText="@context.User.Identity?.Name">
                </RadzenGravatar>
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="@("Hello, " + context.User.Identity.Name)" />
                <RadzenProfileMenuItem Text="My Profile" Path="profile" Icon="account_circle"/>
                <RadzenProfileMenuItem Text="My Dashboard" Path="" Icon="home"/>
                <RadzenProfileMenuItem Text="Logout" Icon="logout" />
            </ChildContent>
        </RadzenProfileMenu>
    </Authorized>
    <NotAuthorized>
        <a href="user/login?redirectUri=@Navigation.Page()">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task ProfileItemClicked(RadzenProfileMenuItem item)
    {
        if (item.Text == "Logout")
            Navigation.NavigateToLogout("user/logout");
    }
    
}
