@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<Theme />
<RenderModeBackground />
<AuthorizeView>
    <Authorized>
        <RadzenDataGrid @ref="StatusLogGrid" TItem="AgencyStatusLog" Data="AgencyStatusLogs"
                        Style="border-radius: 20px;"
                        RowCreate="@OnStatusCreate">
            <HeaderTemplate>
                <RadzenButton Icon="add" Text="New Record" Variant="Variant.Text" Click="@InsertStatusRow" />
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="AgencyStatusLog" Title="Effective" Property="Effective">
                    <Template Context="statusLog">
                        <RadzenText Text="@statusLog.Effective.ToShortDateString()" Style="width: 95%"/>
                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenDatePicker TValue="DateTime" ShowTime="false" @bind-Value="@statusLog.Effective" Style="width: 95%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyStatusLog" Title="Old Status" Property="OldStatus">
                    <Template Context="statusLog">
                        <RadzenText Text="@statusLog.OldStatus" Style="width: 95%" />
                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenText Text="@CurrentStatus" Style="width: 95%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyStatusLog" Title="New Status" Property="NewStatus">
                    <Template Context="statusLog">
                        <RadzenText Text="@statusLog.NewStatus" Style="width: 95%" />
                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenDropDown TValue="string" Data="AllStatuses" Style="width: 95%"
                            @bind-Value="@statusLog.NewStatus" TextProperty="Status" ValueProperty="Status" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyStatusLog" Title="Created By" Property="ChangedByNavigation.Initials">
                    <Template Context="statusLog">
                        <RadzenText Text="@statusLog.ChangedByNavigation?.FullName" Style="width: 95%" />
                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenText @ref="TxtUserName" Text="@(context.User.Identity?.Name)" Style="width: 95%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyStatusLog" Title="Comments" Property="Comments">
                    <Template Context="statusLog">
                        <RadzenText Text="@statusLog.Comments" Style="width: 95%" />
                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenTextBox @bind-Value="@statusLog.Comments" Style="width: 95%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @*TODO: Add save/cancel button column*@
                <RadzenDataGridColumn TItem="AgencyStatusLog">
                    <Template Context="statusLog">

                    </Template>
                    <EditTemplate Context="statusLog">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => SaveStatusLogRow(statusLog))">
                        </RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </Authorized>
</AuthorizeView>
@code {
    [Parameter, EditorRequired] public string AgencyNumber { get; set; } = null!;
    [Parameter, EditorRequired] public string CurrentStatus { get; set; } = null!;
    
    private List<AgencyStatusLog> AgencyStatusLogs { get; set; } = new List<AgencyStatusLog>();
    private bool IsLoading { get; set; }
    private RadzenDataGrid<AgencyStatusLog> StatusLogGrid { get; set; } = null!;
    private List<AgencyStatusLog> StatusLogsToInsert { get; set; } = [];
    private RadzenText TxtUserName { get; set; } = null!; 

    //TODO: Remove this once we implement caching
    private List<AgencyStatusDm> AllStatuses { get; set; } = new List<AgencyStatusDm>();
    
    private IDataAccessResult<List<AgencyStatusLog>> _statusLogs = null!;

    private LoadItem AgencyStatusLogLoad =>
        AddEventNotify(new LoadItem<List<AgencyStatusLog>>
            {
                Key = $"AgencyStatusLog{AgencyNumber}",
                AsyncLoadTask = async () => _statusLogs = await DataAccess.GetAgencyStatusLog(AgencyNumber),
                CacheLoadTask = cache => _statusLogs = new DataAccessResult<List<AgencyStatusLog>>
                {
                    Data = (List<AgencyStatusLog>)cache!
                },
                ResultVariable = () => _statusLogs,
                AfterLoad = () =>
                {
                    if (_statusLogs.Success)
                        AgencyStatusLogs = _statusLogs.Data!;
                }
            }, "agency status log");
    
    private IDataAccessResult<List<AgencyStatusDm>> _statuses = null!;

    private LoadItem StatusesLoad => AddEventNotify(new LoadItem<List<AgencyStatusDm>>
    {
        Key = "AgencyStatuses",
        AsyncLoadTask = async () => _statuses = await DataAccess.GetAgencyStatuses(),
        CacheLoadTask = cache => _statuses = new DataAccessResult<List<AgencyStatusDm>>
        {
            Data = (List<AgencyStatusDm>)cache!
        },
        ResultVariable = () => _statuses,
        AfterLoad = () =>
        {
            if (_statuses.Success)
                AllStatuses = _statuses.Data!;
        }
    }, "agency statuses");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadData();
    }

    private async Task LoadData()
    {
        LoadItem[] loadItems =
        [
            StatusesLoad,
            AgencyStatusLogLoad
        ];

        await DataAccess.ParallelGetCacheOrDataAsync(loadItems);
    }

    private async Task LoadAgencyStatusLog()
    {
        await DataAccess.GetCacheOrLoadDataAsync(AgencyStatusLogLoad);
    }

    private void Reset()
    {
        StatusLogsToInsert.Clear();
        StatusLogsToInsert.Clear();
    }
    
    private void Reset(AgencyStatusLog statusLog)
    {
        StatusLogsToInsert.Remove(statusLog);
        StatusLogsToInsert.Remove(statusLog);
    }
    
    private async Task SaveStatusLogRow(AgencyStatusLog statusLog)
    {
        await ShowLoading();
        var userProfile = await DataAccess.GetUserProfileByUserName(TxtUserName.Text);
        statusLog.ChangedByNavigation = userProfile.Data;
        await StatusLogGrid.UpdateRow(statusLog);
        await LoadAgencyStatusLog();
    }
    
    private async Task InsertStatusRow()
    {
        await ShowLoading();
        var newStatusLog = new AgencyStatusLog()
            {
                Id = Guid.NewGuid(),
                OldStatus = CurrentStatus,
                Effective = DateTime.Today
            };
        StatusLogsToInsert.Add(newStatusLog);
        await StatusLogGrid.InsertRow(newStatusLog);
    }
    
    private async Task OnStatusCreate(AgencyStatusLog statusLog)
    {
        //TODO: Get UserID
        var userName = TxtUserName.Text;
        var userProfile = await DataAccess.GetUserProfileByUserName(userName);

        var result = await DataAccess.CreateAgencyStatusLog(
            statusLog.Id,
            AgencyNumber,
            statusLog.Effective,
            CurrentStatus,
            statusLog.NewStatus!,
            userProfile.Data!.Id,
            statusLog.Comments
        );

        if (!result.Success)
            NotifySaveError(result.Errors, "agency status log");
        
        StatusLogsToInsert.Remove(statusLog);
    }
    
    protected async Task ShowLoading()
    {
        IsLoading = true;

        await Task.Yield();

        IsLoading = false;
    }
}
