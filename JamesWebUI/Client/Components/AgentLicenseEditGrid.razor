@page "/AgentLicenses/{agentId}"


@using System.Globalization;
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;
@using James.Shared;
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject JamesClient JamesClient

<Theme />

<RadzenDataGrid TItem="AgencyLicense" @ref="licenseGrid" 
    EditMode="DataGridEditMode.Multiple" Density="Density.Compact" >
    <HeaderTemplate>
        <RadzenButton Icon="edit" Text="Edit All" Click="EditAll"/>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="License #" Width="125px">
            <Template Context="license">
                <RadzenText Text="@license.LicenseNumber" />
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="license.LicenseNumber" /> 
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Width="100px">
            <Template Context="license">
                <RadzenText Text="@license.State" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" Width="125px">
            <Template Context="license">
                <RadzenCheckBox Value="@license.IsResident" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" Width="125px">
            <Template Context="license">
                <RadzenCheckBox Value="@license.AppointingState" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer">
            <Template Context="license">
                <RadzenText Text="@license.Insurer.IdNavigation.FullName" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="Guid" @ref="dropSelectInsurer" LoadData="LoadSelectInsurerDropDown" Style="width:95%"
                                TextProperty="IdNavigation.FullName" ValueProperty="Id" @bind-Value="@license.InsurerId" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public string agentId { get; set ; }
    private RadzenDataGrid<AgencyLicense> licenseGrid;
    private List<AgencyLicense> licenses = new List<AgencyLicense>();
    private RadzenDropDown<Guid> dropSelectInsurer { get; set; }

    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadLicenses();
    }

    private async Task LoadLicenses()
    {
        

        var result = await JamesClient.AgentByAgentId.ExecuteAsync(Guid.Parse(agentId));

        foreach (var license in result.Data.AgentByAgentId.AgencyLicenses)
        {
            licenses.Add(ThisToThat.ToEntityType<AgencyLicense>(license));
        }

        licenseGrid.Data = licenses;
        licenseGrid.Reload();
    }

    async Task EditAll()
    {
        await licenseGrid.EditRows(licenses);
    }
    private async Task LoadSelectInsurerDropDown()
    {
        dropSelectInsurer.Data = await GetInsurers();
    }
    private async Task<List<Insurer>> GetInsurers()
    {
        var result = await JamesClient.AllInsurers.ExecuteAsync();

        var insurerList = new List<Insurer>();

        foreach (var insurer in result.Data.AllInsurers)
        {
            insurerList.Add(James.Shared.ThisToThat.ToEntityType<Insurer>(insurer));
        }
        return insurerList.OrderBy(i => i.IdNavigation.FullName).ToList();
    }
}
