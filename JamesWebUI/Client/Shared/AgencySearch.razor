@using James.Shared
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager


@inject IDataAccess _dataAccess

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenAutoComplete @ref="@autoComplete" MinLength="3" Style="width: 100%;"
                        ValueChanged="ResultSelected"
                        Placeholder="Search..." Data="@SearchResults" LoadData="SearchAgency"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Template Context="agency">
            <RadzenStack Orientation="Orientation.Horizontal" Style="width:500px;">
                <RadzenIcon Icon="person" />
                <RadzenText Text="@agency.AgencyNumber" Style="width: 100px;" />
                <RadzenText Text="@agency.IdNavigation.FullName" Style="width: 400px;" />
            </RadzenStack>
        </Template>
    </RadzenAutoComplete>
</RadzenStack>


@code {
    private List<Agency> SearchResults { get; set; } = new List<Agency>();
    private Agency SelectedAgency { get; set; }
    private RadzenAutoComplete autoComplete { get; set; }

    private async Task SearchAgency(LoadDataArgs args)
    {
        var result = await _dataAccess.SearchAgencies(args.Filter, false);

        if (result.Errors.Any())
        {
            //TODO: Error Handling
        }
        else
        {
            SearchResults = result.Data;
        }
    }
    private async Task ResultSelected(dynamic args)
    {

        if (null != autoComplete.Value && (autoComplete.Value.GetType()) == typeof(Agency))
        {
            NavigationManager.NavigateTo("/Agency/" + ((Agency)autoComplete.Value).AgencyNumber); 
            autoComplete.Value = "";
        }
    }
}
