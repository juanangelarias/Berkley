<RadzenRow>
    <RadzenText Text="Bank Line of Credit"/>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="Bank"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@Account.Bank" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="Amount"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@($"{Account.BankLoc:C0}")" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="Expires"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@($"{Account.BankLocexpires:MM/dd/yyyy}")" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="When"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@($"{Account.BankLochighDate:MM/dd/yyyy}")" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="Most Used"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@($"{Account.BankLocused:C0}")" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenText Text="Security"/>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenText Text="@Account.BankLocsecurity" TextAlign="TextAlign.Right"/>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter, EditorRequired] public required Account Account { get; set; }
}