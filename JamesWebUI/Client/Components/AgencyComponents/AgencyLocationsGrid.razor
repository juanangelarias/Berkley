@using James.Shared.Dto
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme/>

<RadzenDataGrid @ref="RelatedPartiesGrid" Data="RelatedParties" TItem="AgencyLocationsDto"
                GridLines="DataGridGridLines.Vertical"
                AllowSorting="true" AllowGrouping="@NotResumed" AllowColumnPicking="@NotResumed"
                Density="Density.Compact"
                Style="@style" IsLoading="@IsLoading" FilterMode="FilterMode.Advanced" AllowColumnResize="true"
                CellRender="RenderGridCell">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Visible="@NotResumed"
                     Gap="2rem">
            <BsgExportGridToButton IsLoading="@IsLoading" ExportGrid="ExportGrid"/>
            <RadzenText Text="@_parentLocation" TextStyle="TextStyle.Body2"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Status" Property="Agency.Status" Width="110px"
                              TextAlign="TextAlign.Center">
            <Template Context="relParty">
                @if (relParty.Agency.Status == "Active")
                {
                    <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success"/>
                }
                else
                {
                    <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger"/>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Agency" Property="Agency.AgencyNumber" Width="110px"
                              TextAlign="TextAlign.Right"/>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Agency Name" Property="Agency.IdNavigation.FullName"
                              MinWidth="250px"/>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Address" Filterable="false" MaxWidth="200px"
                              Property="Agency.MainAddress.Address1" Visible="@NotResumed">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.Address1
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Address2" Filterable="false" MaxWidth="200px"
                              Property="Agency.IdNavigation.MainAddress.Address2" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.Address2
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Address3" Filterable="false" MaxWidth="200px"
                              Property="Agency.IdNavigation.MainAddress.Address3" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.Address3
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="City" Width="150x"
                              Property="Agency.IdNavigation.MainAddress.City">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.City
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="State" Width="100px" TextAlign="TextAlign.Center"
                              Property="Agency.IdNavigation.MainAddress.State">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.StateCode
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLocationsDto" Title="Zip Code" Width="110px" TextAlign="TextAlign.Center"
                              Property="Agency.IdNavigation.MainAddress.PostalCode" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.Agency.MainAddress?.PostalCode
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public required Guid AgencyId { get; set; }
    [Parameter, EditorRequired] public required bool NotResumed { get; set; }

    private List<AgencyLocationsDto> RelatedParties { get; set; } = [];
    private RadzenDataGrid<AgencyLocationsDto> RelatedPartiesGrid { get; set; } = null!;
    private string style = string.Empty;
    private string _parentLocation = string.Empty;

    private IDataAccessResult<List<AgencyLocationsDto>> _relatedPartiesResult = null!;

    private LoadItem RelatedPartiesLoad => AddEventNotify(new LoadItem<List<Agency>>
    {
        Key = $"RelatedParties{AgencyId}",
        AsyncLoadTask = async () => _relatedPartiesResult = await DataAccess.GetAgencyRelatedParties(AgencyId),
        CacheLoadTask = cache => _relatedPartiesResult = new DataAccessResult<List<AgencyLocationsDto>>
        {
            Data = (List<AgencyLocationsDto>)cache!
        },
        ResultVariable = () => _relatedPartiesResult,
        AfterLoad = () =>
        {
            RelatedParties = _relatedPartiesResult.Data!;
            var parentLocation = RelatedParties
                .FirstOrDefault(f => f.IsTopParent);
            _parentLocation = parentLocation == null
                ? ""
                : $"Parent: {parentLocation.Agency.AgencyNumber} - {parentLocation.Agency.IdNavigation.FullName}";
        }
    }, "agency related parties");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        style = NotResumed
            ? "height: 400px; border-radius: 10px;"
            : "height: 225px; border-radius: 10px;";

        await ShowLoading();
        await LoadRelatedParties();
    }

    private async Task LoadRelatedParties()
    {
        if (AgencyId == Guid.Empty)
            return;

        await ShowLoading();

        await DataAccess.GetCacheOrLoadDataAsync(RelatedPartiesLoad);
    }

    protected async Task ShowLoading()
    {
        IsLoading = true;

        await Task.Yield();

        IsLoading = false;
    }

    private void ExportGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Agency.AgencyNumber", "Agency.AgencyNumber", "Number");
        substitutions.AddSubstitution("Agency.IdNavigation.FullName", "Agency.IdNavigation.FullName", "Agency");
        substitutions.AddSubstitution("Agency.MainAddress.Address1", "Agency.MainAddress.Address1", "Address");
        substitutions.AddSubstitution("Agency.MainAddress.Address2", "Agency.MainAddress.Address2", "Address2");
        substitutions.AddSubstitution("Agency.MainAddress.Address3", "Agency.MainAddress.Address3", "Address3");
        substitutions.AddSubstitution("Agency.IdNavigation.MainAddress.City", "Agency.MainAddress.City", "City");
        substitutions.AddSubstitution("Agency.IdNavigation.MainAddress.State", "Agency.MainAddress.StateCode", "State");
        substitutions.AddSubstitution("Agency.MainAddress.PostalCode", "Agency.MainAddress.PostalCode", "Zip");
        substitutions.AddSubstitution("Agency.Status", "Agency.Status", "Status");

        NavigationManager.NavigateTo(ExportDataGridUrl(RelatedPartiesGrid,
                $"/export/AgencyRelatedParties/{AgencyId}", format, substitutions),
            true);
    }

    private void RenderGridCell(DataGridCellRenderEventArgs<AgencyLocationsDto> args)
    {
        if (args.Data.IsTopParent)
        {
            args.Attributes.Add("style", "background-color: var(--rz-success);");
        }
        else
        {
            args.Attributes.Add("style", "background-color: var(--rz-base-background-color);");
        }
    }

}
