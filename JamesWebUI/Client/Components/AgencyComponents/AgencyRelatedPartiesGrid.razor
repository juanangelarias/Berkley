@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme />

<RadzenDataGrid @ref="RelatedPartiesGrid" Data="RelatedParties" TItem="Agency" GridLines="DataGridGridLines.Vertical"
                AllowSorting="true" AllowGrouping="@NotResumed" AllowColumnPicking="@NotResumed" Density="Density.Compact"
                Style="@style"  IsLoading="@IsLoading" FilterMode="FilterMode.Advanced" AllowColumnResize="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Visible="@NotResumed">
            <BsgExportGridToButton IsLoading="@IsLoading" ExportGrid="ExportGrid"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="Agency" Title="Status" Property="Status" Width="110px" TextAlign="TextAlign.Center">
            <Template Context="relParty">
                @if (relParty.Status == "Active")
                {
                    <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success"/>
                }
                else
                {
                    <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger"/>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Agency" Property="AgencyNumber" Width="110px"
                              TextAlign="TextAlign.Right"/>
        <RadzenDataGridColumn TItem="Agency" Title="Agency Name" Property="IdNavigation.FullName"
                              MinWidth="250px"/>
        <RadzenDataGridColumn TItem="Agency" Title="Address" Filterable="false" MaxWidth="200px"
                              Property="MainAddress.Address1" Visible="@NotResumed">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address1
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Address2" Filterable="false" MaxWidth="200px"
                              Property="IdNavigation.MainAddress.Address2" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address2
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Address3" Filterable="false" MaxWidth="200px"
                              Property="IdNavigation.MainAddress.Address3" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address3
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="City" Width="150x"
                              Property="IdNavigation.MainAddress.City">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.City
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="State" Width="100px" TextAlign="TextAlign.Center"
                              Property="IdNavigation.MainAddress.State">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.StateCode
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Zip Code" Width="110px" TextAlign="TextAlign.Center"
                              Property="IdNavigation.MainAddress.PostalCode" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.PostalCode
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public required Guid AgencyId { get; set; }
    [Parameter, EditorRequired] public required bool NotResumed { get; set; }
    
    private List<Agency> RelatedParties { get; set; } = [];
    private RadzenDataGrid<Agency> RelatedPartiesGrid { get; set; } = null!;
    private string style = string.Empty;
    
    private IDataAccessResult<List<Agency>> _relatedPartiesResult = null!;

    private LoadItem RelatedPartiesLoad => AddEventNotify(new LoadItem<List<Agency>>
        {
            Key = $"RelatedParties{AgencyId}",
            AsyncLoadTask = async () => _relatedPartiesResult = await DataAccess.GetAgencyRelatedParties(AgencyId),
            CacheLoadTask = cache => _relatedPartiesResult = new DataAccessResult<List<Agency>>
            {
                Data = (List<Agency>)cache!
            },
            ResultVariable = () => _relatedPartiesResult,
            AfterLoad = () =>
            {
                RelatedParties = _relatedPartiesResult.Data!;
            }
        }, "agency related parties");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        
        style = NotResumed
            ? "height: 400px; border-radius: 10px;"
            : "height: 225px; border-radius: 10px;";

        await ShowLoading();
        await LoadRelatedParties();
    }
    
    private async Task LoadRelatedParties()
    {
        if(AgencyId == Guid.Empty)
            return;
        
        await ShowLoading();

        await DataAccess.GetCacheOrLoadDataAsync(RelatedPartiesLoad);
    }

    private void ExportGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("AgencyNumber", "AgencyNumber", "Number");
        substitutions.AddSubstitution("IdNavigation.FullName", "IdNavigation.FullName", "Agency");
        substitutions.AddSubstitution("MainAddress.Address1", "MainAddress.Address1", "Address");
        substitutions.AddSubstitution("MainAddress.Address2", "MainAddress.Address2", "Address2");
        substitutions.AddSubstitution("MainAddress.Address3", "MainAddress.Address3", "Address3");
        substitutions.AddSubstitution("IdNavigation.MainAddress.City", "MainAddress.City", "City");
        substitutions.AddSubstitution("IdNavigation.MainAddress.State", "MainAddress.StateCode", "State");
        substitutions.AddSubstitution("MainAddress.PostalCode", "MainAddress.PostalCode", "Zip");
        substitutions.AddSubstitution("Status", "Status", "Status");
        
        NavigationManager.NavigateTo(ExportDataGridUrl(RelatedPartiesGrid,
                $"/export/AgencyRelatedParties/{AgencyId}", format, substitutions),
            true);
    }
}
