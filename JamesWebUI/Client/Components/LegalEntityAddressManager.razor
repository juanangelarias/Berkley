@using System.Diagnostics

@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenTabs TabPosition="TabPosition.Left" @bind-SelectedIndex="@SelectedTab">
    <Tabs>
        @{
            if (AllAddresses.Any())
            {
                foreach (var a in AllAddresses)
                {
                    <RadzenTabsItem Text="@(a.LegalEntityAddress!.Type)">
                        <AddressDisplay @ref="_addressDisplays[a.LegalEntityAddress!.Type]" Address="a"
                                        StateChanged="@LoadAddresses"
                                        AddressEdited="UpdateAddresses" AddressDeleted="DeleteAddress"/>
                    </RadzenTabsItem>
                    //NOTE: The redundant specification of the AddressCreate below is needed to prevent the AddressCreate from being selected initially
                    if (a == AllAddresses.Last())
                    {
                        <RadzenTabsItem Icon="add" Text="Add Address">
                            <AddressCreate LegalEntityId="@LegalEntityId"
                                           AddressCreated="@AddressCreated"></AddressCreate>
                        </RadzenTabsItem>
                    }
                }
            }
            else
            {
                <RadzenTabsItem Icon="add" Text="Add Address">
                    <AddressCreate LegalEntityId="@LegalEntityId" AddressCreated="@AddressCreated"></AddressCreate>
                </RadzenTabsItem>
            }
        }
    </Tabs>
</RadzenTabs>


@code {

    [Parameter, EditorRequired] public required Guid LegalEntityId { get; set; }
    [Parameter] public Func<IDisposable>? AddSubscription { get; set; }

    private List<Address> AllAddresses { get; set; } = [];
    private readonly Dictionary<string, AddressDisplay> _addressDisplays = [];
    private int SelectedTab { get; set; }
    private IDisposable? _subscription;

    private readonly Guid _editorIdentifier = Guid.NewGuid();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (LegalEntityId != Guid.Empty)
        {
            await LoadAddresses();
            if (null != AddSubscription)
                _subscription = AddSubscription();
        }
    }

    private IDataAccessResult<List<Address>> _addressesLoadResult = null!;

    private LoadItem AddressesLoadItem => AddEventNotify(
        new LoadItem<List<Address>>
        {
            Key = $"Adds{LegalEntityId}",
            AsyncLoadTask = async () => _addressesLoadResult = await DataAccess.GetAllLegalEntityAddresses(LegalEntityId),
            CacheLoadTask = cache => _addressesLoadResult = new DataAccessResult<List<Address>> { Data = (List<Address>)cache! },
            ResultVariable = () => _addressesLoadResult,
            AfterLoad = void () =>
            {
                Debug.Assert(_addressesLoadResult.Data != null);
                AllAddresses = _addressesLoadResult.Data;
                SelectedTab = 0;
            },
            AddSubscriptionTask = li =>
            {
                //NOTE: Subscriptions for the address editors are added via the AddressDisplay AddSubscription function
                li.Subscription = DataAccess.AddressCollectionModified(LegalEntityId, async void (_) =>
                {
                    DataAccess.Clear("addresses");
                    await LoadAddresses();
                });
            }
        }, "addresses");

    private async Task UpdateAddresses(Address address)
    {
        await DataAccess.SetAddress(address, _editorIdentifier.ToString());
        var actual = AllAddresses.FirstOrDefault(f => f.Id == address.Id);

        if (actual == null)
        {
            AllAddresses.Add(address);
        }
        else
        {
            actual.Address1 = address.Address1;
            actual.Address2 = address.Address2;
            actual.Address3 = address.Address3;
            actual.City = address.City;
            actual.StateCode = address.StateCode;
            actual.PostalCode = address.PostalCode;
        }
    }

    private async Task DeleteAddress(Guid id)
    {
        var deleteResult = await DataAccess.DeleteAddress(id, _editorIdentifier.ToString());

        if (deleteResult.Errors.Any())
        {
            LoggingService.LogError("DeleteAddress return error(s)", string.Join("\r\n", deleteResult.Errors), "GraphQL");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Detail = "Error while deleting this address.",
                Duration = 4000
            });
            return;
        }

        var toDelete = AllAddresses
            .FirstOrDefault(f => f.Id == id);

        if (toDelete != null)
            AllAddresses.Remove(toDelete);
    }

    private async Task LoadAddresses()
    {
        await DataAccess.GetCacheOrLoadDataAsync(AddressesLoadItem);
    }

    private async Task AddressCreated(Guid addressToSelect)
    {
        await LoadAddresses();

        if (_addressesLoadResult.Success)
        {
            var selected = AllAddresses.FirstOrDefault(a => a.Id == addressToSelect);
            SelectedTab = null != selected
                ? AllAddresses.IndexOf(selected)
                : 0;
        }
    }

}
