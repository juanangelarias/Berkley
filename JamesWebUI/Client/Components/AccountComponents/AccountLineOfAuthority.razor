@inherits JamesLayoutComponentBase

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenRow Style="max-height: 700px;">
        <AccountLineOfAuthorityUWRecommendation AccountNum="@Account.AccountNum"/>
    </RadzenRow>
    <RadzenRow Style="max-height: 500px;" class="rz-pb-2">
        <AccountLOAAccountProgram Account="@Account"/>
    </RadzenRow>
    <RadzenRow Style="max-height: 500px" class="rz-pb-2">
        <AccountLOAAccountLOA Account="@Account"/>
    </RadzenRow>
    <RadzenRow class="rz-mt-1">
        <RadzenText Text="Agency Line of Authority" TextStyle="TextStyle.DisplayH6"/>
    </RadzenRow>
    <RadzenRow Style="max-height: 500px">
        <AccountLOAAgencyLOA Account="@Account"></AccountLOAAgencyLOA>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public Account Account { get; set; }
}