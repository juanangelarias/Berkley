                        </RadzenDataGrid> *@
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenStack>
    </RadzenPanel>
</RadzenStack>

@code {
    private Guid _agentId;
    
    [Parameter]
    public Guid AgentId
    {
        get => _agentId;
        set
        {
            if (_agentId == value) return;
            _agentId = value;
            _ = LoadAgent();
        }
    }

    private Agent AgentToDisplay { get; set; } = new()
    {
        IdNavigation = new LegalEntity()
    };

    private RadzenDropDown<Guid> DropSelectInsurer { get; set; } = null!;
    private List<Insurer> AllInsurers { get; set; } = [];

    private IDataAccessResult<Agent> _agentResult = null!;
    private IDataAccessResult<List<Insurer>> _insurerResult = null!;

    private LoadItem AgentLoad => AddEventNotify(new LoadItem<Agent>
        {
            Key = $"Agent{AgentId}",
            AsyncLoadTask = async () => _agentResult = await DataAccess.GetAgent(AgentId),
            CacheLoadTask = cache => _agentResult = new DataAccessResult<Agent> { Data = (Agent)cache! },
            ResultVariable = () => _agentResult,
            AfterLoad = () => { AgentToDisplay = _agentResult.Data!; }
        }, "agent");

    private LoadItem InsurerLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = "Insurers",
        AsyncLoadTask = async () => _insurerResult = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurerResult = new DataAccessResult<List<Insurer>> { Data = (List<Insurer>)cache! },
        ResultVariable = () => _insurerResult,
        AfterLoad = () =>
        {
            Debug.Assert(_insurerResult.Data != null, "result.Data != null");
            AllInsurers = _insurerResult.Data.OrderBy(i => i.IdNavigation.FullName).ToList();
        }
    }, "insurers");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        BusyDialog();
        await LoadAgent();
        await LoadSelectInsurerDropDown();
        DialogService.Close();
    }
    
    private async Task LoadAgent()
    {
        if(AgentId == Guid.Empty)
            return;
        
        BusyDialog();

        await DataAccess.GetCacheOrLoadDataAsync(AgentLoad);

        DialogService.Close();
    }
    
    private async Task LoadSelectInsurerDropDown()
    {
        await DataAccess.GetCacheOrLoadDataAsync(InsurerLoad);
    }

    private void BusyDialog()
    {
        DialogService.Open("", ds =>
        @<RadzenStack AlignItems="AlignItems.Center" Gap="2rem" class="rz-p-12">
            <RadzenText TextStyle="TextStyle.H6">Loading, please wait...</RadzenText>
        </RadzenStack>, new DialogOptions() { ShowTitle = false, Style = "min-height:auto;min-width:auto;width:auto", CloseDialogOnEsc = false });
    }
}