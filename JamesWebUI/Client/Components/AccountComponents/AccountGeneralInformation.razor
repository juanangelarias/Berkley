<RadzenCard Style="width: 100%" Variant="Variant.Text">
    <RadzenRow>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="General Information" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountGeneralInformationDetail Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="LOA Summary" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountLoaSummary Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="Bonds/Outstanding Liability" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountBondsOutstandingLiability Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="Rate & Commission" Style="max-height: 400px;" class="rz-overflow-auto">

            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="Annual Premium" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountAnnualPremium Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="S&P Rating" Style="max-height: 400px;" class="rz-overflow-auto">

            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="Bank Information" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountBankInformation Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
        <RadzenColumn SizeLG="4" SizeMD="6" SizeSM="12">
            <RadzenFieldset Text="Collateral" Style="max-height: 400px;" class="rz-overflow-auto">
                <AccountCollateral Account="@Account"/>
            </RadzenFieldset>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public required Account Account { get; set; }
}