@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenDataGrid Data="RelatedParties">
    <HeaderTemplate>
        <RadzenButton Variant="Variant.Outlined" Icon="add" Text="Add New Related Party"/>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="IdNavigation.FullName" Title="Name">
            <Template Context="relParty">
                <RadzenText Text="@relParty.IdNavigation.FullName" />
            </Template>    
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Indemnity" Title="Indemnity">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.Indemnity" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="FinancialStatements" Title="Financial Statements">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.FinancialStatements" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Guarantor" Title="Guarantor">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.Guarantor" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Comments">
            <Template>
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Icon="more_horiz" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public Account AccountToDisplay { get; set; } = null!;
    private List<AdditionalRelatedParty> RelatedParties { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadRelatedParties();
    }

    private async Task LoadRelatedParties()
    {
        IDataAccessResult<List<AdditionalRelatedParty>> result = null!;

        var loadItem = AddEventNotify(new LoadItem
        {
            Key = $"GetAccountAdditionalRelatedParties{AccountToDisplay.AccountNum}",
            AsyncLoadTask = async () => { result = await DataAccess.GetAdditionalRelatedParties(AccountToDisplay.AccountNum); },
            CacheLoadTask = cache => result = new DataAccessResult<List<AdditionalRelatedParty>>
            {
                Data = (List<AdditionalRelatedParty>)cache!
            },
            ResultVariable = () => result
        });

        await DataCache.GetCacheOrLoadDataAsync(loadItem);

        if (result.Success)
            RelatedParties = result.Data!;
        else
            await HandleLoadError("Failed to load related parties: No Response", result.Errors);
    }
}
