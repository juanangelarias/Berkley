@inherits JamesGridLayoutComponentBase<AccountProgramDto>

@inject IDataAccess DataAccess
@inject TooltipService TooltipService


<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mb-3" Style="max-height: 490px;">
    <RadzenRow>
        <RadzenText Text="Account Program" TextStyle="TextStyle.DisplayH6"/>
    </RadzenRow>
    <RadzenRow>
        <RadzenDataGrid TItem="AccountProgramDto" Data="@Data" @ref="@Grid" EditMode="DataGridEditMode.Single"
                        EmptyText="No records to display" Density="Density.Compact" SelectionMode="DataGridSelectionMode.Single"
                        AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowColumnResize="true" IsLoading="@IsLoading"
                        Sort="@ShowLoading" Page="ShowLoading" Group="ShowLoading" Filter="ShowLoading"
                        RowUpdate="UpdateGridRow" RowCreate="CreateGridRow" Style="max-height: 450px">
            <HeaderTemplate>
                <AuthorizeView Policy="InRoleCanProposeAccountProgram">
                    <RadzenButton Icon="add" Text="Add new Program" Variant="Variant.Text" Click="@InsertRow"/>
                </AuthorizeView>
            </HeaderTemplate>
            <Template Context="program">
                <RadzenDataGrid TItem="AccountProgramStatusLogDto" Data="@program.Logs">
                    <Columns>
                        <RadzenDataGridColumn Title="Status Date" Property="@nameof(AccountProgramStatusLogDto.StatusDate)"
                                              MinWidth="125px" Width="125px" MaxWidth="125px">
                            <Template Context="row">
                                <RadzenText Text="@($"{row.StatusDate:MM/dd/yyyy hh:mm}")" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Previous Status" MinWidth="125px" Width="125px"
                                              Property="@nameof(AccountProgramStatusLogDto.OldStatus)">
                            <Template Context="row">
                                <RadzenText Text="@row.OldStatus" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="New Status" MinWidth="125px" Width="135px"
                                              Property="@nameof(AccountProgramStatusLogDto.NewStatus)">
                            <Template Context="row">
                                <RadzenText Text="@row.NewStatus" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Single" Property="@nameof(AccountProgramStatusLogDto.NewSingle)"
                                              Width="125px" MinWidth="125px" FormatString="{0:C0}" TextAlign="TextAlign.Right">
                            <HeaderTemplate>
                                <RadzenText Text="Single" TextAlign="TextAlign.Right" class="rz-pr-4 rz-pt-2"
                                            TextStyle="TextStyle.Subtitle2"/>
                            </HeaderTemplate>
                            <Template Context="row">
                                <RadzenText Text="@($"{row.NewSingle:c0}")" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Aggregate" Property="@nameof(AccountProgramStatusLogDto.NewAggregate)"
                                              Width="125px" MinWidth="125px" FormatString="{0:C0}" TextAlign="TextAlign.Right">
                            <HeaderTemplate>
                                <RadzenText Text="Aggregate" TextAlign="TextAlign.Right" class="rz-pr-4 rz-pt-2"
                                            TextStyle="TextStyle.Subtitle2"/>
                            </HeaderTemplate>
                            <Template Context="row">
                                <RadzenText Text="@($"{row.NewAggregate:c0}")" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Status changed by"
                                              Property="@nameof(AccountProgramStatusLogDto.StatusChangeByFullName)"
                                              Width="200px" MinWidth="200px" FormatString="{0:C0}">
                            <Template Context="row">
                                <RadzenText Text="@row.StatusChangeByFullName" TextStyle="TextStyle.Body2"/>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </Template>
            <Columns>
                <RadzenDataGridColumn Title="Status" Property="@nameof(AccountProgramDto.Status)" MinWidth="125px"/>
                <RadzenDataGridColumn Title="Req. Expiration" Property="@nameof(AccountProgramDto.RequireExpiration)"
                                      MinWidth="125px" TextAlign="TextAlign.Center">
                    <Template Context="program">
                        <RadzenCheckBox TValue="bool" @bind-Value="@program.RequireExpiration" ReadOnly="true"
                                        TextAlign="TextAlign.Center" TextStyle="TextStyle.Body2"/>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenCheckBox TValue="bool" @bind-Value="@program.RequireExpiration" TextAlign="TextAlign.Center"
                                        TextStyle="TextStyle.Body2" ReadOnly="true"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Effective Date" Property="@nameof(AccountProgramDto.Effective)" MinWidth="125px">
                    <Template Context="program">
                        <RadzenText Text="@($"{program.Effective:MM/dd/yyyy}")" TextStyle="TextStyle.Body2"/>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenDatePicker @bind-Value="@program.Effective" ShowTime="false" DateFormat="MM/dd/yyyy"
                                          Name="Effective" TextStyle="TextStyle.Body2" Style="display: block"/>
                        <RadzenRequiredValidator Text="Effective Date is required" Component="Effective" Popup="true"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Expiration Date" Property="@nameof(AccountProgramDto.Expiration)" MinWidth="125px">
                    <Template Context="program">
                        <RadzenText Text="@($"{program.Expiration:MM/dd/yyyy}")" TextStyle="TextStyle.Body2"/>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenDatePicker @bind-Value="@program.Expiration" ShowTime="false" DateFormat="MM/dd/yyyy"
                                          Name="Expiration" TextStyle="TextStyle.Body2" Style="display: block"/>
                        <RadzenRequiredValidator Text="Expiration Date is required" Component="Expiration" Popup="true"/>
                        <RadzenCompareValidator Value="@program.Effective" Component="Expiration" Popup="true"
                                                Text="Expiration date should be greater or equal to Effective date."
                                                Operator="CompareOperator.GreaterThanEqual"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Single" Property="@nameof(AccountProgramDto.Single)" TextAlign="TextAlign.Right"
                                      MinWidth="125px">
                    <HeaderTemplate>
                        <RadzenText Text="Single" TextAlign="TextAlign.Right" class="rz-pr-4 rz-pt-2"
                                    TextStyle="TextStyle.Subtitle2"/>
                    </HeaderTemplate>
                    <Template Context="program">
                        <RadzenText Text="@($"{program.Single:C0}")" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2"/>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenNumeric @bind-Value="@program.Single" Format="c0" ShowUpDown="false" Name="Single"
                                       TextStyle="TextStyle.Body2" Style="display: block"/>
                        <RadzenCompareValidator Component="Single" Operator="CompareOperator.GreaterThanEqual" Value="0"
                                                Text="Single value should be greater or equal to zero." Popup="true"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Aggregate" Property="@nameof(AccountProgramDto.Aggregate)" MinWidth="125px"
                                      TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <RadzenText Text="Aggregate" TextAlign="TextAlign.Right" class="rz-pr-4 rz-pt-2"
                                    TextStyle="TextStyle.Subtitle2"/>
                    </HeaderTemplate>
                    <Template Context="program">
                        <RadzenText Text="@($"{program.Aggregate:C0}")" TextAlign="TextAlign.Right"
                                    TextStyle="TextStyle.Body2"/>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenNumeric @bind-Value="@program.Aggregate" Format="c0" ShowUpDown="false" Name="Aggregate"
                                       TextStyle="TextStyle.Body2" Style="display: block"/>
                        <RadzenCompareValidator Component="Aggregate" Operator="CompareOperator.GreaterThanEqual" Value="0"
                                                Text="Aggregate value should be greater or equal to zero." Popup="true"/>
                        <RadzenCompareValidator Component="Aggregate" Operator="CompareOperator.GreaterThanEqual"
                                                Value="@program.Single" Popup="true"
                                                Text="Aggregate must be less than or equal to Single"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="125px" Filterable="false" Frozen="true" Resizable="false"
                                      reorderable="false" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="program">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem">
                            <AuthorizeView Policy="InRoleCanProposeAccountProgram">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowEdit(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.Edit))"
                                              Click="@(_ => EditRow(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                            <AuthorizeView Policy="InRoleCanProposeAccountProgram">
                                <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowRequestApproval(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.RequestApproval))"
                                              Click="@(_ => RequestApproval(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                            <AuthorizeView Policy="InRoleCanProposeAccountProgram">
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowRequestApproval(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.Remove))"
                                              Click="@(_ => RemoveRow(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                            <AuthorizeView Policy="InRoleCanApproveAccountProgram">
                                <RadzenButton Icon="order_approve" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowApprove(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.Approve))"
                                              Click="@(_ => Approve(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                            <AuthorizeView Policy="InRoleCanApproveAccountProgram">
                                <RadzenButton Icon="scan_delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowDecline(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.Decline))"
                                              Click="@(_ => Decline(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                            <AuthorizeView Policy="InRoleCanCancelAccountProgram">
                                <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                              Size="ButtonSize.Small" Visible="@ShowCancel(program)"
                                              MouseEnter="@(arg => ShowTooltip(arg, Action.Cancel))"
                                              Click="@(_ => Cancel(program))" @onclick:stopPropagation="true"/>
                            </AuthorizeView>
                        </RadzenStack>
                    </Template>
                    <EditTemplate Context="program">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@(_ => Save(program))"/>
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => CancelEdit(program))"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public required Account Account { get; set; }

    private List<AccountProgramDto> Data { get; set; } = [];
    private List<UserLineOfAuthority> _userLOA = [];
    private Dictionary<string, AccountProgramStatusDm> _statuses = new();

    private bool ShowEdit(AccountProgramDto program) => program.Status is "PROPOSED" or "DECLINED";
    private bool ShowDelete(AccountProgramDto program) => program.Status == "PROPOSED";
    private bool ShowRequestApproval(AccountProgramDto program) => program.Status == "PROPOSED";
    private bool ShowApprove(AccountProgramDto program) => program.Status is "APPROVAL REQUESTED" or "DECLINED";
    private bool ShowDecline(AccountProgramDto program) => program.Status == "APPROVAL REQUESTED";
    private bool ShowCancel(AccountProgramDto program) => program.Status == "APPROVED";

    #region Loaders

    #region AccountPrograms Load

    private IDataAccessResult<List<AccountProgramDto>> _accountProgramsResult = null!;

    private LoadItem AccountProgramsLoad => AddEventNotify(new LoadItem<List<AccountProgramDto>>
    {
        Key = CacheKeys.AccountPrograms(Account.AccountNum),
        AsyncLoadTask = async () => _accountProgramsResult = await DataAccess.GetAccountPrograms(Account.AccountNum),
        CacheLoadTask = cache => _accountProgramsResult = new DataAccessResult<List<AccountProgramDto>>
        {
            Data = (List<AccountProgramDto>)cache!
        },
        ResultVariable = () => _accountProgramsResult,
        AfterLoad = () => { Data = _accountProgramsResult.Data!; }
    }, "account programs");

    #endregion

    #region AccounProgramStatuses Load

    private IDataAccessResult<List<AccountProgramStatusDm>> _accountProgramStatusesResult = null!;

    private LoadItem AccountProgramStatusesLoad => AddEventNotify(new LoadItem<List<AccountProgramStatusDm>>
    {
        Key = CacheKeys.AccountProgramStatuses,
        AsyncLoadTask = async () => _accountProgramStatusesResult = await DataAccess.GetAllAccountProgramStatuses(),
        CacheLoadTask = cache => _accountProgramStatusesResult = new DataAccessResult<List<AccountProgramStatusDm>>
        {
            Data = (List<AccountProgramStatusDm>)cache!
        },
        ResultVariable = () => _accountProgramStatusesResult,
        AfterLoad = () => { _statuses = _accountProgramStatusesResult.Data!.ToDictionary(d => d.Description, d => d); },
        CacheDuration = TimeSpan.FromDays(7)
    }, "account program statuses");

    #endregion

    #region UserLOAByDivision Load

    private IDataAccessResult<List<UserLineOfAuthority>> _userLOAByDivisionResult = null!;

    private LoadItem UserLOAByDivisionLoad => AddEventNotify(new LoadItem<List<UserLineOfAuthority>>
    {
        Key = CacheKeys.UserLOA(Account.Division),
        AsyncLoadTask = async () => _userLOAByDivisionResult = await DataAccess.GetUserLOAByDivision(Account.Division),
        CacheLoadTask = cache => _userLOAByDivisionResult = new DataAccessResult<List<UserLineOfAuthority>>
        {
            Data = (List<UserLineOfAuthority>)cache!
        },
        ResultVariable = () => _userLOAByDivisionResult,
        AfterLoad = () => { _userLOA = _userLOAByDivisionResult.Data!; }
    }, "user LOA by division");

    #endregion

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await DataAccess.GetCacheOrLoadDataAsync(AccountProgramStatusesLoad);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadData();
    }

    private async Task LoadData()
    {
        await ShowLoading();
        await DataAccess.ParallelGetCacheOrDataAsync(AccountProgramsLoad, UserLOAByDivisionLoad);
    }

    private async Task InsertRow()
    {
        await ShowLoading();

        var newAccountProgram = new AccountProgramDto
        {
            Id = Guid.NewGuid(),
            AccountNum = Account.AccountNum,
            RequireExpiration = true,
            Effective = DateTime.Today,
            StatusId = _statuses["PROPOSED"].Id,
            Status = "PROPOSED"
        };

        await Grid.InsertRow(newAccountProgram);
    }

    private async Task EditRow(AccountProgramDto program)
    {
        await ShowLoading();
        await Grid.EditRow(program);
    }

    private async Task RemoveRow(AccountProgramDto program)
    {
        var confirm = await ConfirmAction(Action.Remove);
        if (!confirm)
            return;

        var result = await DataAccess.DeleteAccountProgram(program.Id);

        if (!result.Success)
        {
            NotifyDeleteError(result.Errors, "account program");
            return;
        }

        var record = Data.FirstOrDefault(f => f.Id == program.Id);

        if (record == null)
            return;

        Data.Remove(record);
        await Grid.Reload();
    }

    private async Task RequestApproval(AccountProgramDto program)
    {
        var confirm = await ConfirmAction(Action.RequestApproval);
        if (!confirm)
            return;

        var result = await DataAccess.AccountProgramChangeStatus(program.Id, "APPROVAL REQUESTED");

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "Approval request");
            return;
        }

        await ReloadData(program.Id);
    }

    private async Task Approve(AccountProgramDto program)
    {
        var confirm = await ConfirmAction(Action.Approve);
        if (!confirm)
            return;

        var result = await DataAccess.AccountProgramChangeStatus(program.Id, "APPROVED");

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "Approve");
            return;
        }

        await ReloadData(program.Id);
    }

    private async Task Decline(AccountProgramDto program)
    {
        var confirm = await ConfirmAction(Action.Decline);
        if (!confirm)
            return;

        var result = await DataAccess.AccountProgramChangeStatus(program.Id, "DECLINED");

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "Decline");
            return;
        }

        await ReloadData(program.Id);
    }

    private async Task Cancel(AccountProgramDto program)
    {
        var confirm = await ConfirmAction(Action.Cancel);
        if (!confirm)
            return;

        var result = await DataAccess.AccountProgramChangeStatus(program.Id, "CANCELED");

        if (!result.Success)
        {
            NotifySaveError(result.Errors, "Cancel");
            return;
        }

        await ReloadData(program.Id);
    }

    private async Task Save(AccountProgramDto program)
    {
        if (!ValidateFields(program))
            return;

        await ShowLoading();

        await Grid.UpdateRow(program);
    }

    private async Task CancelEdit(AccountProgramDto program)
    {
        await ShowLoading();

        Grid.CancelEditRow(program);
    }

    private async Task UpdateGridRow(AccountProgramDto program)
    {
        await ExecuteSetAccountProgram(program);
    }

    private async Task CreateGridRow(AccountProgramDto program)
    {
        await ExecuteSetAccountProgram(program);
    }

    private async Task ExecuteSetAccountProgram(AccountProgramDto program)
    {
        var result = await DataAccess.SetAccountProgram(program.Id, program.AccountNum, program.Effective,
            program.Expiration ?? new DateTime(9999, 12, 31), program.Single, program.Aggregate,
            "", program.StatusId);

        if (!result.Success)
        {
            await HandleError("Error setting account program", result.Errors);
            return;
        }

        NotifySuccessfulSave("account program");

        await ReloadData(program.Id);
    }

    private async Task ReloadData(Guid id)
    {
        var editedResult = await DataAccess.GetAccountProgramById(id);
        if (!editedResult.Success)
        {
            await HandleError("Error retrieving edited or created account program", editedResult.Errors);
            return;
        }

        var toDelete = Data.FirstOrDefault(r => r.Id == id);
        if (toDelete != null)
            Data.Remove(toDelete);

        Data.Add(editedResult.Data!);
        Data = Data
            .OrderByDescending(o => o.Effective)
            .ToList();

        DataAccess.UpdateCache(CacheKeys.AccountPrograms(Account.AccountNum), Data);

        await Grid.Reload();
    }

    private bool ValidateFields(AccountProgramDto program)
    {
        var flag = true;
        if (program.Expiration < program.Effective)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Expiration date should be greater than effective date.",
                Duration = 5000
            });
            flag = false;
        }

        if (program.Single < 0)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Single value should be greater than or equal to zero.",
                Duration = 5000
            });
            flag = false;
        }

        if (program.Aggregate < 0)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Aggregate value should be greater than or equal to zero.",
                Duration = 5000
            };
            NotificationService.Notify(message);
            flag = false;
        }

        if (program.Single > program.Aggregate)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Aggregate value should be greater than or equal to single value.",
                Duration = 5000
            });
            flag = false;
        }

        var userSingleMax = _userLOA.Max(m => m.Single);
        var userAggregateMax = _userLOA.Max(m => m.Aggregate);

        if (program.Single > userSingleMax)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Single value exceeds the user line of authority.",
                Duration = 5000
            });
            flag = false;
        }

        if (program.Aggregate > userAggregateMax)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Aggregate value exceeds the user line of authority.",
                Duration = 5000
            };
            NotificationService.Notify(message);
            flag = false;
        }

        return flag;
    }

    private void ShowTooltip(ElementReference element, Action name, TooltipOptions? options = null)
    {
        var message = name switch
        {
            Action.Edit => "Edit this program",
            Action.RequestApproval => "Request approval for this program",
            Action.Remove => "Remove this program",
            Action.Approve => "Approve this program",
            Action.Decline => "Decline this program",
            Action.Cancel => "Cancel this program",
            _ => ""
        };

        TooltipService.Open(element, message, options);
    }

    private async Task<bool> ConfirmAction(Action action)
    {
        var message = action switch
        {
            Action.RequestApproval => "Are you sure to submit for approval?",
            Action.Remove => "Are you sure you want to remove this program?",
            Action.Approve => "Are you sure you want to approve this program?",
            Action.Decline => "Are you sure you want to decline this program?",
            Action.Cancel => "Are you sure you want to cancel this program?",
            _ => ""
        };

        return await DialogService.Confirm(message, "Confirmation") == true;
    }

    private enum Action
    {
        Edit,
        RequestApproval,
        Remove,
        Approve,
        Decline,
        Cancel
    }

}