<RadzenCard class="rz-w-100">
    <RadzenRow>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Recommendation" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.Recommendation" Name="recommendation" Change=@Changed Rows="3"
                                Disabled="@IsReadOnly" class="rz-w-100"/>
                <RadzenRequiredValidator Text="Recommendation is required" Component="recommendation"/>
                <RadzenLengthValidator Min="75" Text="Recommendation must be at least 75 characters"
                                       Component="recommendation" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Debt Highlights" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.DebtHighlights" Name="debtHighlights" Change="@Changed"
                                Rows="3"
                                Disabled="@IsReadOnly" class="rz-w-100"/>
                <RadzenRequiredValidator Text="Debt Highlights is required" Component="debtHighlights"/>
                <RadzenLengthValidator Min="75" Text="Debt Highlights must be at least 75 characters"
                                       Component="debtHighlights" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Business Overview" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.BusinessOverview" Name="business" Change="@Changed" Rows="3"
                                class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Business Overview is required" Component="business"/>
                <RadzenLengthValidator Min="75" Text="Business Overview must be at least 75 characters"
                                       Component="business" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Follow-up Conditions" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.FollowUpConditions" Name="conditions" Change="@Changed"
                                Rows="3" class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Follow-up Conditions is required" Component="conditions"/>
                <RadzenLengthValidator Min="75" Text="Follow-up Conditions must be at least 75 characters"
                                       Component="conditions" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Bond Risk" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.BondRisk" Name="bondRisk" Change="@Changed" Rows="3"
                                class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Bond Risk is required" Component="bondRisk"/>
                <RadzenLengthValidator Min="75" Text="Bond Risk must be at least 75 characters"
                                       Component="bondRisk" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Financial Analysis" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.FinancialAnalysis" Name="financial" Change="@Changed" Rows="3"
                                class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Financial Data is required" Component="financial"/>
                <RadzenLengthValidator Min="75" Text="Financial Analysis must be at least 75 characters"
                                       Component="financial" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public LineOfAuthorityReason Data { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsReadOnly { get; set; }
    [Parameter, EditorRequired] public EventCallback<LineOfAuthorityReason> OnChanges { get; set; }

    private async Task Changed()
    {
        await OnChanges.InvokeAsync(Data);
    }

}
