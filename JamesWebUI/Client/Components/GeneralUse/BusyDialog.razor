<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
             Gap="2rem" class="rz-p-12">
    <RadzenImage Path="loading.gif" AlternateText="loading" Style="width: 150px; height: 150px;"/>
    <RadzenText TextStyle="TextStyle.H6" Text="@Message"/>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public required string Message { get; set; }
}