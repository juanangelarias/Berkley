@using James.Shared
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager


@inject NotificationService NotificationService
@inject IDataAccess DataAccess
<RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal">

        <RadzenColumn Size="2">
            <RadzenFormField Text="Country Code" AllowFloatingLabel="false" Variant="Variant.Text">
                <RadzenTextBox Value="@PhoneNumberToDisplay.CountryCode" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="5">
            <RadzenFormField Text="Phone Number" AllowFloatingLabel="false" Variant="Variant.Text">
                <RadzenMask Mask="(***) ***-****" CharacterPattern="[0-9]" Placeholder="(000) 000-0000" Value="@PhoneNumberToDisplay.MainNumber" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Success" Click="@DeletePhoneNumber" />
        </RadzenColumn>
    </RadzenStack>
</RadzenRow>
<RadzenRow>
    <RadzenColumn Size="4">
        <RadzenFormField Text="Extension" AllowFloatingLabel="false" Variant="Variant.Text">
            <RadzenTextBox Value="@PhoneNumberToDisplay.Extension" />
        </RadzenFormField>
    </RadzenColumn>
</RadzenRow>


@code {
    [Parameter] public Guid PhoneId { get; set; }
    [Parameter] public EventCallback<Guid> StateChanged { get; set; }

    private PhoneNumber PhoneNumberToDisplay { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadPhoneNumber();
    }
    async Task LoadPhoneNumber()
    {
        if (PhoneId != Guid.Empty)
        {
            var result = await DataAccess.GetPhoneNumber(PhoneId);

            if (result.Errors.Any() || result.Data == null)
            {
                LoggingService.LogError($"Error loading phone number with PhoneId {PhoneId}.", result.Errors.ToString());
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error loading phone number.",
                        Duration = 5000,
                        CloseOnClick = true,
                        Payload = DateTime.Now
                    });
            }
            else
            {
                PhoneNumberToDisplay = result.Data;
            }
        }
    }
    private async Task DeletePhoneNumber()
    {
        var result = await DialogService.OpenAsync("Confirm Phone Number Deletion", ds =>
            @<RadzenStack Orientation="Orientation.Vertical">
                <p>Are you sure you want to delete this phone number?</p>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Yes" Click="() => ds.Close(true)" Style="width:80px;" />
                    <RadzenButton Text="No" Click="() => ds.Close(false)" Style="width:80px;" />
                </RadzenStack>
            </RadzenStack>
    );
        if (result)
        {
            var deleteResult = await DataAccess.DeletePhoneNumber(PhoneId);
            if (deleteResult.Errors.Any())
            {
                LoggingService.LogError("DeletePhoneNumber return error(s)", string.Join("\r\n", result.Errors), "GraphQL");
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Detail = "Error when deleting this phone number.",
                        Duration = 4000
                    });
            }
            else
            {
                await StateChanged.InvokeAsync(PhoneId);
            }
        }
    }
}
