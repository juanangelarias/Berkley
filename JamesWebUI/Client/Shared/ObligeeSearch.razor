@using James.Shared
@inherits JamesWebUI.Shared.JamesLayoutComponentBase

@inject NavigationManager NavigationManager


@inject IDataAccess _dataAccess


<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenAutoComplete @ref="@autoComplete" MinLength="3" Style="width: 100%;" 
                        ValueChanged="ResultSelected" 
                        Placeholder="Search..." Data="@SearchResults" LoadData="SearchObligee" 
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Template Context="obligee">
            <RadzenStack Orientation="Orientation.Horizontal" Style="width:500px;">
                <RadzenIcon Icon="person" />
                <RadzenText Text="@obligee.ObligeeNum" Style="width: 100px;" />
                <RadzenText Text="@obligee.IdNavigation.FullName" Style="width: 400px;" />
            </RadzenStack>
        </Template>
    </RadzenAutoComplete>
</RadzenStack>



@code {
    private List<Obligee> SearchResults { get; set; } = new List<Obligee>();
    private Obligee SelectedObligee { get; set; }
    private RadzenAutoComplete autoComplete { get; set; }

    private async Task SearchObligee(LoadDataArgs args)
    {
        var result = await _dataAccess.SearchObligees(args.Filter);

        if (result.Errors.Any())
        {
            //TODO: Error Handling
        }
        else
        {
            SearchResults = result.Data;
        }
    }
    private async Task ResultSelected(dynamic args)
    {

        if (null != autoComplete.Value && (autoComplete.Value.GetType()) == typeof(Obligee))
        {
            NavigationManager.NavigateTo("/Obligee/" + ((Obligee)autoComplete.Value).ObligeeNum);
            autoComplete.Value = "";
        }
    }
}
