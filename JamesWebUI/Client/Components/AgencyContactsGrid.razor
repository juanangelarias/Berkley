@using System.Globalization;
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;
@using James.Shared;
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject JamesClient JamesClient

<Theme />

<RadzenPanel>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal">
@*             <RadzenButton Size="ButtonSize.Small" Icon="grid_view" Variant="Variant.Text" Click="@(() => contactsGridView = true)" />
            <RadzenButton Size="ButtonSize.Small" Icon="list" Variant="Variant.Text" Click="@(() => contactsGridView = false)" /> *@
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenDataGrid TItem="Agent" Data="@agents" @ref="@agentsGrid"
                        Style="border-radius: 20px;" EmptyText="No records to display"
                        AllowPaging="true" PageSize="10" AllowSorting="true">
            <Columns >
                <RadzenDataGridColumn TItem="Agent" Title="First Name">
                    <Template Context="agent">
                        <RadzenText Text="@agent.IdNavigation.GivenName"/>
                    </Template>    
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Agent" Property="IdNavigation.MiddleInitial" Title="MI">
                                        <Template Context="agent">
                        <RadzenText Text="@agent.IdNavigation.MiddleInitial"/>
                    </Template>  
                    </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Agent" Property="IdNavigation.FamilyName" Title="Last Name">
                    <Template Context="agent">
                        <RadzenText Text="@agent.IdNavigation.FamilyName" />
                    </Template>
                </RadzenDataGridColumn>
                @* <RadzenDataGridColumn TItem="Agent" Property="MainEmailAddress" Title="Email" /> *@
                @* <RadzenDataGridColumn TItem="Agent" Property="NationalProducerNumber" Title="NPN" /> *@
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenPanel>

@code {
    [Parameter] public Guid AgencyId { get; set; }
    private List<Agent> agents { get; set; }
    private RadzenDataGrid<Agent> agentsGrid { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        LoadAgents();
    }
    private async Task LoadAgents()
    {
        var result = await JamesClient.GetAgencyAgents.ExecuteAsync(AgencyId);

        if (result.Data.AgencyAgents.Count > 0)
        {
            var agentList = new List<Agent>();

            foreach (var agentInAgency in result.Data.AgencyAgents)
            {
                agentList.Add(ThisToThat.ToEntityType<Agent>(agentInAgency.Agent));
            }

            agents = agentList;
        }
        
    }
}
