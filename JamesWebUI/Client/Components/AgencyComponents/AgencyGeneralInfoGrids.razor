@using Blazorise.Animate;

@inherits SlidingComponent

<Theme />

<PositionSavingTabs Change="@HandleChangeDirection" TabControlName="AgGenInfoGrids" TabPosition="TabPosition.Top" >
    <Tabs>
        <PositionSavingTabsItem Text="Agency Licenses" TabName="Licenses">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyLicenseGrid Agency="Agency" />
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="POAs" TabName="POAs">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyPOAGrid Agency="Agency" />
            </Animate>
        </PositionSavingTabsItem>
        <PositionSavingTabsItem Text="Locations" TabName="Locations">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyLocationsGrid AgencyId="Agency.Id" NotResumed="true"/>
            </Animate>
        </PositionSavingTabsItem>
    </Tabs>
</PositionSavingTabs>

@code {
    [Parameter, EditorRequired] public required Agency Agency { get; set; }
}
