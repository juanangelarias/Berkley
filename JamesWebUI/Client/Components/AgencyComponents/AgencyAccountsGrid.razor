@inherits JamesGridLayoutComponentBase<AgencyAccountDto>

@inject TooltipService TooltipService
@inject IDataAccess DataAccess

<Theme/>

<RadzenDataGrid TItem="AgencyAccountDto" @ref="@Grid" Data="@_agencyAccounts" AllowGrouping="true"
                AllowSorting="true" Style="height: 400px; border-radius: 10px;" AllowColumnResize="true" AllowColumnPicking="true" 
                Density="Density.Compact" AllowFiltering="true" FilterMode="FilterMode.Advanced" IsLoading="@IsLoading" 
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" RowExpand="RowExpand" 
                @bind-Settings="@GridSettings" AllowColumnReorder="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Icon="settings" Click="SaveGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                          Visible="@UserSettingsChanged"/>
            <RadzenButton Icon="reset_settings" Click="ClearGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                          Visible="@UserSettingsLoaded"/>
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="account">
        <AgencyBondsGrid Agency="@Agency" AccountNum="@account.AccountNum"/>
        @*<RadzenDataGrid Data="account.Bonds" TItem="AgencyAccountBondDto" Density="Density.Compact"
                        Style="height: 400px; border-radius: 10px;">
            <Columns>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Status" Property="Status" MinWidth="80px"
                                      TextAlign="TextAlign.Center" Resizable="true">
                    <Template Context="bond">
                        @if (bond.Status == "Active")
                        {
                            <JamesStatusIcon IconStyle="IconStyle.Success"/>
                        }
                        else
                        {
                            <JamesStatusIcon IconStyle="IconStyle.Danger"/>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Bond No." Property="BondNumber"
                                      MinWidth="100px" Resizable="true"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Account Name" Width="300px" Resizable="true">
                    <Template>
                        <RadzenText Text="@account.Name"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Branch" MinWidth="90px" Resizable="true">
                    <Template>
                        <RadzenText Text="@account.Branch"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Type" Property="BondType" MinWidth="110px"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="Begin Date" Property="Effective"
                                      FormatString="{0:dd/MM/yyyy}" MinWidth="120px" Resizable="true"/>
                <RadzenDataGridColumn TItem="AgencyAccountBondDto" Title="End Date" Property="Expiration"
                                      FormatString="{0:dd/MM/yyyy}" MinWidth="120px" Resizable="true"/>
