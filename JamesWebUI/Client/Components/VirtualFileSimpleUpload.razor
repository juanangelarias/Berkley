@using System.ComponentModel.DataAnnotations
@using System.Diagnostics
@using James.Shared.Imaging
@inherits JamesLayoutComponentBase
@inject IDataAccess DataAccess
@* @inject TooltipService TooltipService *@

<RadzenTemplateForm TItem="string" Data="currentFileName">
    @* Submit="@(args=>StartUpload(args))"> *@
    <RadzenPanel Variant="Variant.Outlined">
        <h3>@Title</h3>
        <RadzenPanel Visible=@(!linkingToExisting)>
            <RadzenRow Gap="0rem" RowGap="0rem" class="rz-m-0 rz-m-md-12">
                <RadzenColumn Size="9">
                    <RadzenUpload id="ddUpload" @ref="@uploadDD"
                                  ChooseText="Drag and drop here or click to choose document"
                                  Auto="false" Multiple="false" Url=@($"ImagingRepository/UploadDocument/{DocumentType}/{(int)DocumentCategory}/{ImagingId}?filename={currentFileName};documentId={DocumentId}")
                                  InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})"
                                  Change=@UploadFileChanged
                                  Error=@UploadErrorHandler
                                  Complete=@UploadComplete
                                  Icon="upload_file"
                                  Progress=@(args => OnProgress(args, "Drag and drop file to upload")) Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Link to existing document" Click=@ToggleWorkflow />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="0rem" RowGap="0rem" class="rz-m-0 rz-m-md-12">
                <RadzenFormField Text="Name" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox Name="tbFileName" @ref="tbFilename" @bind-Value=@currentFileName Style="width:100%" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="tbFileName" Text="Name is required." />
                        <RadzenRegexValidator Component="tbFileName" Text="Must be a filename without path"
                                              Pattern="^[^\\/]+$" />
                        <RadzenCustomValidator Component="tbFileName" Text="Must be a valid filename"
                                               Validator="@(()=>ClientBusinessLogic.Validators.ValidateFileName(currentFileName))" />
                        <RadzenCustomValidator Component="tbFileName" Text="File extension is not allowed by BTS"
                                               Validator="@(()=>!ClientBusinessLogic.Validators.ValidateFileName(currentFileName)||
                                                                SharedBusinessLogic.ImagingBusinessLogic.IsValidImagingFileName(currentFileName))" />
                    </Helper>
                </RadzenFormField>
            </RadzenRow>
            <RadzenRow Visible="@(progress>0)">
                <RadzenColumn Size="12">
                    <RadzenProgressBar Value=@progress />
                    <RadzenText ref="@uploadedBytes" />
                    <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Cancel" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenButton Text="Upload" Disabled="@waitingForFileSelection"
                                  class="rz-mt-4" Click="@(args=>StartUpload(args))" />
                    @* ButtonType="ButtonType.Submit" /> *@
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Visible="@(null != DocumentId)">
                <RadzenColumn>
                    <RadzenButton Text="Unlink Existing" 
                                  class="rz-mt-4" Click="@(args=>Unlink(args))" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Visible="@(!string.IsNullOrWhiteSpace(uploadError))">
                <RadzenColumn Size="12">
                    <RadzenText Text=@uploadError Style="color:red;font-weight:bold" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
    </RadzenPanel>
</RadzenTemplateForm>
        <RadzenPanel Visible=@linkingToExisting Style="width:400px">
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenButton Variant="Variant.Text" Icon="info" Text="Can't see the file?" />
                </RadzenColumn>
                <RadzenColumn Size="6">&nbsp;</RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary"
                                  Text="Upload a new document" Click=@ToggleWorkflow />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenText Text="POA Forms" Style="font-weight:700;font-size:1.5em;" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenDataList @ref=@existingList Data=@existingDocuments
                                    TItem="ImagingDocument"
                                    LoadData=@(args=>LoadExistingDocumentOptions(args))
                                    IsLoading="@existingLoading">
                        <Template Context="doc">
                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenIcon Icon="Description" />
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenText Text=@doc.Filename Style="font-size:17px;font-weight:700" />
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenText Text=@doc.EntryDate.ToShortDateString() />
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenButton Variant="Variant.Text" Text="Link document" Icon="link"
                                                  Click=@(() => LinkExistingAndClose(doc.Guid)) />
                                </RadzenColumn>
                            </RadzenRow>
                        </Template>
                    </RadzenDataList>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenDataGrid TItem="ImagingDocument" IsLoading="@existingLoading"
                                    Data=@existingDocuments Style="min-width:600px">
                        <Columns>
                            <RadzenDataGridColumn Width="50px" >
                                <Template Context="doc">
                                    <RadzenIcon Icon="Description" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(ImagingDocument.Filename)"
                                                  Title="Documents Uploaded"/>
                            <RadzenDataGridColumn Property="@nameof(ImagingDocument.EntryDate)"
                                                  Title="Uploaded" FormatString="{0:d}"/>
                            <RadzenDataGridColumn >
                                <Template Context="doc">
                                    @* Text="Link document" Icon="link" *@
                                    <RadzenButton Variant="Variant.Text"
                                                  Click=@(() => LinkExistingAndClose(doc.Guid))>
                                        <RadzenText Text="Link document"/>
                                        <RadzenIcon Icon="link"/>
                                    </RadzenButton>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenText Text=@searchError Style="color:red;font-weight:bold" />
                </RadzenColumn>
            </RadzenRow>
    </RadzenPanel>
@* ReSharper disable CSharpWarnings::CS8618 *@
@* ReSharper disable InconsistentNaming *@
@code {
    RadzenUpload uploadDD;
    RadzenTextBox tbFilename;
    RadzenText uploadedBytes;
    bool existingLoading = true;
    RadzenDataList<ImagingDocument> existingList;
    ImagingDocument[] existingDocuments = [];
    string uploadError = "", searchError = "";
    [Parameter] public string Title { get; set; } = "Upload File To Imaging";
    [Parameter] public Action<Guid?>? UploadAction { get; set; }
    [Parameter] public Action<string>? ErrorAction { get; set; }
    [Required]
    [Parameter] public required ImagingDocumentCategory DocumentCategory { get; set; }
    [Required]
    [Parameter] public required string DocumentType { get; set; }
    [Parameter] public string? LinkableDocumentTypes { get; set; }
    [Parameter] public Guid? DocumentId { get; set; }

    [Required]
    [Parameter]
    public required string ImagingId
    {

        get; set;
    }

    string currentFileName
    {
        get;
        set;
    }
    FileInfo? currentFile;
    bool waitingForFileSelection = true;
    bool linkingToExisting;
    int progress;
    //void ShowTooltip(ElementReference elementReference, TooltipOptions options = null!) => TooltipService.Open(elementReference, "Name as it will be saved in Virtual File", options);

    void OnProgress(UploadProgressArgs args, string name)
    {
        progress = args.Progress;
        if (0 < progress && 100 > progress)
        {
            if (null != uploadedBytes)
                uploadedBytes.Text = $"({args.Loaded.ToScreenBytes()}/{args.Total.ToScreenBytes()})";
            else
                LoggingService.LogWarning("uploadedBytes control not instantiated", "uploadedBytes == null", "UI");
        }

        if (progress == 100)
        {
            //TODO: Auto-close pop-up, possibly after a success animation
        }
    }

    private void LinkExistingAndClose(string guid)
    {
        if (Guid.TryParse(guid, out var linkDocGuid))
        {
            DocumentId = linkDocGuid;
            UploadAction?.Invoke(linkDocGuid);
            //Autoclose
            DialogService.Close(DocumentId);
        } else
            LoggingService.LogError("Invalid Guid", 
                "String passed to LinkExistingAndClose was not a valid guid.", 
                "Virtual File", new Dictionary<string, string>{{"invalidGuid", guid }});
    }

    private void UploadFileChanged(UploadChangeEventArgs args)
    {
        var file = args.Files.SingleOrDefault();
        if (null == file)
        {
            waitingForFileSelection = true;
            currentFileName = string.Empty;
            if (currentFile != file)
            {
                currentFile = file;
                StateHasChanged();
            }

            return;
        }

        Debug.Assert(uploadDD.HasValue, "upload control shows .HasValue==false");

        DocumentId = Guid.NewGuid();
        waitingForFileSelection = false;

        if (string.IsNullOrWhiteSpace(currentFileName) || null != currentFile)
            //Should allow user to type the file name and then select the file without wiping out what they typed.
            currentFileName = file.Name;
        else
            //Keep the name the user has already inputted, but make sure it's file extension matches the selected file.
            currentFileName = Path.ChangeExtension(currentFileName, Path.GetExtension(file.Name));
        currentFile = file;

        StateHasChanged();
    }

    // private async Task StartUpload(string args)
    private async Task StartUpload(MouseEventArgs args)
    {
        if (null == currentFile) return;
        if (!uploadDD.HasValue)
        {
            NotifySaveError(["upload control has no value"], "imaging file");
            return;
        }
        uploadError = "";//Clear and previous errors

        //TODO:Exit if values aren't valid
        await uploadDD.Upload();
        //TODO:Handle imaging upload failure
    }

    private void UploadComplete(UploadCompleteEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(uploadError))
            UploadAction?.Invoke(DocumentId);
        if (!args.Cancelled && Guid.TryParse(args.RawResponse, out var guid))
        {
            DocumentId = guid;
            //Autoclose
            DialogService.Close(guid);
        }
    }

    private void UploadErrorHandler(UploadErrorEventArgs args)
    {
        uploadError = "There was an error uploading the file.";
        if (!string.IsNullOrWhiteSpace(args.Message))
            uploadError += "   " + args.Message;
    }

    private async Task ToggleWorkflow()
    {
        linkingToExisting = !linkingToExisting;
        if (linkingToExisting)
            await LoadExistingDocumentOptions(new LoadDataArgs());
        //TODO:Animate the transition if time allows
    }

    private async Task<ImagingDocument[]> LoadExistingDocumentOptions(LoadDataArgs obj)
    {
        existingLoading = true;
        searchError = "";//Clear any previous errors
        try
        {
            var documentTypes = new List<string>();
            if (null != LinkableDocumentTypes)
                documentTypes.AddRange(LinkableDocumentTypes.Split(",;|".ToCharArray(), StringSplitOptions.RemoveEmptyEntries));
            if (!documentTypes.Contains(DocumentType))
                documentTypes.Add(DocumentType);

            //TODO: Pull the ability to do a parallel IDataAccess result query into shared code
            var results =  documentTypes.AsParallel().Select( dt =>  DataAccess.SearchDocuments(ImagingId, DocumentCategory, dt)).ToList();
            await Task.WhenAll(results);
            if (results.All(r => r.Result.Success))
                existingDocuments = results.SelectMany(r => r.Result.Data).ToArray();
            else
            {
                var errors = results.SelectMany(r => r.Result.Errors).Distinct().ToArray();
                searchError = $"There {(errors.Length == 1 ? "was an error" : "were errors")} loading existing documents: {string.Join("  ", errors)}";
                existingDocuments = [];
            }
        }
        finally
        {
            existingLoading = false;
        }


        return existingDocuments;
    }

    private void Unlink(MouseEventArgs args)
    {
        UploadAction?.Invoke(DocumentId = null);
        //Autoclose
        DialogService.Close(DocumentId);
    }

}
@* ReSharper restore InconsistentNaming *@
@* ReSharper restore CSharpWarnings::CS8618 *@
