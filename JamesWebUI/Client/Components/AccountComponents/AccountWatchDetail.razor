@inherits JamesLayoutComponentBase

<RadzenCard Variant="Variant.Text">
    <RadzenColumn Size="12">
        <RadzenRow Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <RadzenColumn Size="5">
                    <RadzenFormField Text="Reason" Style="width: 300px;">
                        <RadzenTextArea @bind-Value="@AccountWatch.Reason" Style="width: 300px;" Rows="4"
                                        Name="Reason" ReadOnly="@(!InEdition)"/>
                        <RadzenRequiredValidator Text="Reason is required" Component="Reason"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="5">
                        <RadzenFormField Text="Action Plan" Style="width: 300px;">
                            <RadzenTextArea @bind-Value="@AccountWatch.ActionPlan" Style="width: 300px;" Rows="4"
                                            Name="ActionPlan" ReadOnly="@(!InEdition)"/>
                            <RadzenRequiredValidator Text="Action Plan is required" Component="ActionPlan"/>
                        </RadzenFormField>
                </RadzenColumn>
            </RadzenStack>
        </RadzenRow>
    </RadzenColumn>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public AccountWatchDisplay AccountWatch { get; set; } = null!;
    [Parameter, EditorRequired] public bool InEdition { get; set; }

}