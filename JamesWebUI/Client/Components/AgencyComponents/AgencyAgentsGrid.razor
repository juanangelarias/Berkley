@using James.Shared.Constants
@using Newtonsoft.Json
@inherits JamesGridLayoutComponentBase<Agent>

@inject NavigationManager NavigationManager

@inject TooltipService TooltipService

<Theme/>

<RadzenDataGrid TItem="Agent" Data="@Agents" @ref="@Grid" Density="Density.Compact"
                Style="border-radius: 10px; height: 400px;" EmptyText="No records to display" @bind-Settings="@GridSettings" AllowColumnReorder="true"
                GridLines="DataGridGridLines.Vertical" SelectionMode="DataGridSelectionMode.Single" 
                AllowRowSelectOnRowClick="true" AllowPaging="true" PageSize="10" AllowSorting="true" 
                AllowColumnResize="true" AllowFiltering="true" FilterMode="FilterMode.Advanced">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <BsgExportGridToButton IsLoading="@IsLoading" ExportGrid="ExportGrid" ExportFormat="DefaultExportFormat"/>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="margin-left: 3rem">
                <RadzenButton Icon="settings" Click="SaveGridSettings"
                              MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                              Visible="@UserSettingsChanged"/>
                <RadzenButton Icon="reset_settings" Click="ResetGridSettings"
                              MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                              Visible="@UserSettingsLoaded"/>
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="agent">
        <RadzenDataGrid Data="agent.AgencyLicenses" TItem="AgencyLicense" AllowColumnResize="true"
                        Style="height:300px;" AllowVirtualization="true" GridLines="DataGridGridLines.Vertical"
                        AllowFiltering="true">
            <HeaderTemplate>
                <RadzenText Style="font-weight: bold"
                            Text="@("Name: " + agent.IdNavigation.GivenName + " " + agent.IdNavigation.MiddleInitial + " " + agent.IdNavigation.FamilyName)"/>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="License No." Width="125px" Property="LicenseNumber">
                    <Template Context="license">
                        <RadzenText Text="@license.LicenseNumber"/>
                    </Template>

                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Width="100px">
                    <Template Context="license">
                        <RadzenText Text="@license.State"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" Width="125px">
                    <Template Context="license">
                        <RadzenCheckBox Value="@license.IsResident"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" Width="125px">
                    <Template Context="license">
                        <RadzenCheckBox Value="@license.AppointingState"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer">
                    <Template Context="license">
                        <RadzenText Text="@license.Insurer.IdNavigation.FullName"/>
                    </Template>
                    <EditTemplate Context="license">
                        <RadzenDropDown TValue="Guid" Data="AllInsurers" Style="width:95%"
                                        TextProperty="IdNavigation.FullName" ValueProperty="Id"
                                        @bind-Value="@license.InsurerId"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="Agent" Title="First Name" Property="IdNavigation.GivenName" Width="200px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.GivenName"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="MI" Property="IdNavigation.MiddleInitial" Width="75px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.MiddleInitial"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="Last Name" Property="IdNavigation.FamilyName" Width="200px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.FamilyName"/>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="NPN" Property="NationalProducerNumber">
            <Template Context="agent">
                <RadzenText Text="@agent.NationalProducerNumber"/>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>


@code {
    [Parameter, EditorRequired] public Guid AgencyId { get; set; }

    private List<Agent> Agents { get; set; } = [];
    private List<Insurer> AllInsurers { get; set; } = [];

    private IDataAccessResult<List<Agent>> _agentsResult = null!;
    private IDataAccessResult<List<Insurer>> _insurersResult = null!;

    private LoadItem AgencyContactsLoad => AddEventNotify(new LoadItem<List<Agent>>
    {
        Key = $"AgencyContacts{AgencyId}",
        AsyncLoadTask = async () => _agentsResult = await DataAccess.GetAgencyAgents(AgencyId),
        CacheLoadTask = cache => _agentsResult = new DataAccessResult<List<Agent>>
        {
            Data = (List<Agent>)cache!
        },
        ResultVariable = () => _agentsResult,
        AfterLoad = void () =>
        {
            if (_agentsResult.Success)
                Agents = _agentsResult.Data!;
        }
    }, "agency contacts");


    private LoadItem InsurersLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = "Insurers",
        AsyncLoadTask = async () => _insurersResult = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurersResult = new DataAccessResult<List<Insurer>> { Data = (List<Insurer>)cache! },
        ResultVariable = () => _insurersResult,
        AfterLoad = void () =>
        {
            if (_insurersResult.Success)
                AllInsurers = _insurersResult.Data!;
        }
    }, "insurers");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await GetGridSettings();
        IsLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        await LoadData();
    }

    private async Task LoadData()
    {
        if (AgencyId == Guid.Empty)
            return;

        await DataAccess.ParallelGetCacheOrDataAsync(AgencyContactsLoad, InsurersLoad);
    }

    private void ExportGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        //TODO: Determine substitutions
        substitutions.AddSubstitution("IdNavigation.GivenName", "IdNavigation.GivenName", "Given Name");
        substitutions.AddSubstitution("IdNavigation.MiddleInitial", "IdNavigation.MiddleInitial", "Middle Initial");
        substitutions.AddSubstitution("IdNavigation.FamilyName", "IdNavigation.FamilyName", "Family Name");
        substitutions.AddSubstitution("", "License.LicenseNumber", "License Number");
        substitutions.AddSubstitution("", "License.State");
        substitutions.AddSubstitution("", "License.IsResident", "Is Resident");
        substitutions.AddSubstitution("", "License.AppointingState", "Appointing State");
        substitutions.AddSubstitution("", "License.Insurer.IdNavigation.FullName", "Insurer");
        substitutions.AddSubstitution("NationalProducerNumber", "NationalProducerNumber", "NationalProducerNumber");

        NavigationManager.NavigateTo(ExportDataGridUrl(Grid,
                $"/export/AgencyContacts/{AgencyId}", format, substitutions),
            true);
    }

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }
}
