@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject JamesWebUI.Client.Services.ThemeService ThemeService
@inject IDataAccess _dataAccess

<Theme />


<RadzenDataGrid TItem="Account" @ref="@agencyAccountGrid" Data="@_agencyAccounts" AllowGrouping="true" AllowSorting="true"
                Style="height: 400px; border-radius: 10px;" AllowColumnResize="true" AllowColumnPicking="true" Density="Density.Compact"
                AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                IsLoading="@_isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <Template Context="account">
        <RadzenDataGrid Data="account.Bonds" TItem="Bond" Style="height: 400px; border-radius: 10px;">
            <Columns>
                <RadzenDataGridColumn TItem="Bond" Title="Bond #" Property="BondNumber" />
                <RadzenDataGridColumn TItem="Bond" Title="Type" Property="BondType.BondType" />
                <RadzenDataGridColumn TItem="Bond" Title="Begin Date" Property="Effective" FormatString="{0:d}" />
                <RadzenDataGridColumn TItem="Bond" Title="End Date" Property="Expiration" FormatString="{0:d}" />
                <RadzenDataGridColumn TItem="Bond" Title="Amount" />
                <RadzenDataGridColumn TItem="Bond" Title="UW" Property="UnderWriter.IdNavigation.FullName" />
                <RadzenDataGridColumn TItem="Bond" Title="SIC" Property="Siccode" />
                <RadzenDataGridColumn TItem="Bond" Title="Obligee" Property="Obligee.FullName" />
                <RadzenDataGridColumn TItem="Bond" Title="Municipality" Property="Municipality" />
                <RadzenDataGridColumn TItem="Bond" Title="Class" Property="BondClass" />
            </Columns>
        </RadzenDataGrid>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="Account" Title="Status" Frozen="true" Width="75px"/>
        <RadzenDataGridColumn TItem="Account" Title="Account #" Property="AccountNum" Frozen="true" Width="100px"/>
        <RadzenDataGridColumn TItem="Account" Title="Name" Property="IdNavigation.FullName" Frozen="true" Width="250px" />
        <RadzenDataGridColumn TItem="Account" Title="Address" Width="250px" Property="MainAddress.Address1">
            <Template Context="account">
                <RadzenText Text="@account?.MainAddress?.Address1" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Account" Title="City">
            <Template Context="account">
                <RadzenText Text="@account?.MainAddress?.City" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Account" Title="State" Width="100px" Property="MainAddress.StateCode">
            <Template Context="account">
                <RadzenText Text="@account?.MainAddress?.StateCode" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Account" Title="Postal Code">
            <Template Context="account">
                <RadzenText Text="@account?.MainAddress?.PostalCode" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Account" Title="Branch" Property="Branch" Width="125px" />
        <RadzenDataGridColumn TItem="Account" Title="Bond Count" Width="100px">
            <Template Context="account">
                <RadzenText Text="@account.Bonds.Count().ToString()"/>
            </Template>
        </RadzenDataGridColumn>

    </Columns>
    <EmptyTemplate>
        No Records to Display
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public required string AgencyNumber { get; set; }

    private List<Account> _agencyAccounts = new();
    private RadzenDataGrid<Account> agencyAccountGrid;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        await LoadAgencyAccounts();

    }

    private async Task LoadAgencyAccounts()
    {
        var result = await _dataAccess.GetAgencyAccounts(AgencyNumber);
        agencyAccountGrid.Data = _agencyAccounts = result.Data;
            await agencyAccountGrid.Reload();
    }
    protected async Task ShowLoading()
    {
        _isLoading = true;

        await Task.Yield();

        _isLoading = false;
    }
}
