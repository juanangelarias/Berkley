@using James.Shared
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess

<RadzenDataGrid Data="relatedParties">
    <HeaderTemplate>
        <RadzenButton Variant="Variant.Outlined" Icon="add" Text="Add New Related Party"/>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="IdNavigation.FullName" Title="Name">
            <Template Context="relParty">
                <RadzenText Text="@relParty.IdNavigation.FullName" />
            </Template>    
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Indemnity" Title="Indemnity">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.Indemnity" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="FinancialStatements" Title="Financial Statements">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.FinancialStatements" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Guarantor" Title="Guarantor">
            <Template Context="relParty">
                <RadzenCheckBox Value="@relParty.Guarantor" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Comments">
            <Template>
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Icon="more_horiz" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public Account accountToDisplay { get; set; }
    private List<AdditionalRelatedParty> relatedParties { get; set; } = new List<AdditionalRelatedParty>();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadRelatedParties();
    }

    private async Task LoadRelatedParties()
    {
        if (null != accountToDisplay)
        {
            var result = await DataAccess.GetAdditionalRelatedParties(accountToDisplay.AccountNum);

            if (result.Success)
            {
                relatedParties = result.Data;
            }
            else
            {
                //TODO: Handle errors
            }
        }
    }
}
