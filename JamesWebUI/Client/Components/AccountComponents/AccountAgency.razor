@using James.Shared.Constants
@using JamesWebUI.Client.Model

@inject IDataAccess DataAccess
@inject TooltipService TooltipService

@inherits JamesLayoutComponentBase

<Theme/>
@if (_isEditMode)
{
    <RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
        <RadzenTemplateForm TItem="AccountAgencyAgentModel" Data="@_model" Submit="@SaveEdit" @ref="@_form">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenText Style="height: 30px;"/>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                    <BsgFormField Text="Agency">
                        <RadzenDropDown Data="@_allAgencies" AllowFiltering="true"
                                        Multiple="false" Change="@(_ => OnAgencyChanged())"
                                        TextProperty="@nameof(AgencyDto.FullNameDisplay)"
                                        @bind-Value="@_model!.AgencyNumber"
                                        ValueProperty="@nameof(AgencyDto.AgencyNumber)"
                                        Name="Agency"/>
                        <RadzenRequiredValidator Text="The agency is required." Component="Agency"/>
                    </BsgFormField>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="5">
                        <BsgFormField Text="City">
                            <RadzenTextBox Value="@AgencyCity" ReadOnly="true"/>
                        </BsgFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <BsgFormField Text="State">
                            <RadzenTextBox Value="@AgencyStateCode" ReadOnly="true"/>
                        </BsgFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <BsgFormField Text="Status">
                            <Start>
                                <RadzenIcon Icon="fiber_manual_record" IconStyle="@AgencyStatusStyle"/>
                            </Start>
                            <ChildContent>
                                <RadzenTextBox Value="@AgencyStatus" ReadOnly="true"/>
                            </ChildContent>
                        </BsgFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <BsgFormField Text="Agency Email">
                        <RadzenTextBox Value="@AgencyEmail" Style="color: black;" Disabled="true"/>
                    </BsgFormField>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <BsgFormField Text="Agent">
                            <RadzenDropDown Data="@_agencyAgentsLookup" AllowFiltering="true"
                                            TextProperty="@nameof(BsgLookup.Name)" ValueProperty="@nameof(BsgLookup.Id)"
                                            @bind-Value="@_model!.AgentId" Name="Agent" Change="@SetAgent"/>
                        </BsgFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <BsgFormField Text="Agent Email">
                            <RadzenTextBox Value="@AgentEmail" Style="color: black;" Disabled="true"/>
                        </BsgFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenButton Icon="add" Text="Add" Size="ButtonSize.Small" ImageAlternateText="Add Agent"
                                      MouseEnter="@(args => ShowTooltipAddAgent(args))"
                                      Click="OnRequestAgent"/>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenButton Text="Cancel" Icon="cancel" Click="@CancelEdit" ButtonType="ButtonType.Reset"
                                      ButtonStyle="ButtonStyle.Light"/>
                        <RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit"
                                      ButtonStyle="ButtonStyle.Primary"/>
                    </RadzenStack>
                </RadzenRow>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}
else
{
    <RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                              Click="@ToggleEditMode" Disabled="@(_isEditMode)"/>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="3">
                    <BsgFormField Text="Agency No.">
                        <RadzenTextBox Value="@Account.AgencyNumber" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="9">
                    <BsgFormField Text="Agency">
                        <RadzenTextBox Value="@AgencyName" Style="color: black;"/>
                    </BsgFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="5">
                    <BsgFormField Text="City">
                        <RadzenTextBox Value="@AgencyCity" ReadOnly="true"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <BsgFormField Text="State">
                        <RadzenTextBox Value="@AgencyStateCode" ReadOnly="true"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="5">
                    <BsgFormField Text="Status">
                        <Start>
                            <RadzenIcon Icon="fiber_manual_record" IconStyle="@AgencyStatusStyle"/>
                        </Start>
                        <ChildContent>
                            <RadzenTextBox Value="@AgencyStatus" ReadOnly="true"/>
                        </ChildContent>
                    </BsgFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <BsgFormField Text="Agency Email">
                    <RadzenTextBox Value="@AgencyEmail" ReadOnly="true"/>
                </BsgFormField>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <BsgFormField Text="Agent">
                        <RadzenTextBox Value="@AgentName" ReadOnly="true"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <BsgFormField Text="Agent Email">
                        <RadzenTextBox Value="@AgentEmail" ReadOnly="true"/>
                    </BsgFormField>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenButton Icon="add" Text="Add" Size="ButtonSize.Small" ImageAlternateText="Add Agent"
                                  MouseEnter="@(args => ShowTooltipAddAgent(args))"
                                  Click="OnRequestAgent"/>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter, EditorRequired] public required Account Account { get; set; }

    private RadzenTemplateForm<AccountAgencyAgentModel> _form = null!;
    private bool _isEditMode;
    private AccountAgencyAgentModel? _model;
    private AgencyDto? _agency;
    private Agent? _agent;
    private List<AgencyDto> _allAgencies = [];
    private List<Agent> _agencyAgents = [];
    private List<BsgLookup> _agencyAgentsLookup = [];

    private IconStyle AgencyStatusStyle => _agency?.Status.ToLower() switch
    {
        "active" => IconStyle.Success,
        "pending" or "on hold" => IconStyle.Warning,
        "lost" or "terminated" => IconStyle.Danger,
        _ => IconStyle.Base
    };

    private string AgencyName => _agency?.FullNameDisplay ?? "";

    private string AgencyCity => _agency?.Addresses
        .FirstOrDefault(f => f.Type.ToLower() == "main")?
        .City ?? "";

    private string AgencyStateCode => _agency?.Addresses
        .FirstOrDefault(f => f.Type.ToLower() == "main")?
        .StateCode ?? "";

    private string AgencyEmail => _agency?.Emails
        .FirstOrDefault(f => f.Type.ToLower() == "main")?
        .EmailAddress ?? "";

    private string AgencyStatus => _agency?.Status ?? "";

    private string AgentName => _agent?.IdNavigation.FullName ?? "";
    private string AgentEmail => _agent?.IdNavigation.GetMainEmail() ?? "";

    #region Loaders

    #region Agency Agents

    private IDataAccessResult<List<Agent>> _agencyAgentsResult = null!;

    private LoadItem AgencyAgentsLoad => AddEventNotify(new()
    {
        Key = CacheKeys.AgencyAgents(_model?.AgencyNumber ?? Account.AgencyNumber ?? ""),
        AsyncLoadTask = async () =>
            _agencyAgentsResult = await DataAccess.GetAgencyAgents(_agency?.Id ?? Account.AgencyNumberNavigation?.Id ?? Guid.Empty),
        CacheLoadTask = cache => _agencyAgentsResult = new DataAccessResult<List<Agent>>
        {
            Data = (List<Agent>)cache!
        },
        ResultVariable = () => _agencyAgentsResult,
        AfterLoad = () =>
        {
            _agencyAgents = _agencyAgentsResult.Data!;
            _agencyAgentsLookup = _agencyAgents
                .Select(s => new BsgLookup
                {
                    Id = s.Id,
                    Code = "",
                    Name = s.IdNavigation.FullName
                })
                .ToList();
        }
    }, "agency agents");

    #endregion

    #region Agencies

    private IDataAccessResult<List<AgencyDto>> _agenciesResult = null!;

    private LoadItem AgenciesLoad => AddEventNotify(new()
    {
        Key = CacheKeys.AgenciesDto,
        AsyncLoadTask = async () => _agenciesResult = await DataAccess.GetAllActiveAgencies(),
        CacheLoadTask = cache => _agenciesResult = new DataAccessResult<List<AgencyDto>>
        {
            Data = (List<AgencyDto>)cache!
        },
        ResultVariable = () => _agenciesResult,
        AfterLoad = () => { _allAgencies = _agenciesResult.Data!; }
    }, "agencies");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await LoadAgencies();
        await LoadAgents();

        _agency = _allAgencies.FirstOrDefault(f => f.AgencyNumber == Account.AgencyNumber);
        _agent = _agencyAgents.FirstOrDefault(f => f.Id == Account.AgentId);
    }

    private async Task LoadAgencies()
    {
        var start = DateTime.Now;
        await DataAccess.GetCacheOrLoadDataAsync(AgenciesLoad);
        var lapse = DateTime.Now - start;
        Console.WriteLine($"Agencies load time: {lapse.TotalMilliseconds / 1000:N3} seconds");
    }

    private async Task LoadAgents()
    {
        var start = DateTime.Now;
        await DataAccess.GetCacheOrLoadDataAsync(AgencyAgentsLoad);
        var lapse = DateTime.Now - start;
        Console.WriteLine($"Agents load time: {lapse.TotalMilliseconds / 1000:N3} seconds");
    }

    private async Task OnAgencyChanged()
    {
        SetAgency();

        await LoadAgents();
    }

    private async Task ToggleEditMode()
    {
        await InitializeWorkModel();
        _isEditMode = !_isEditMode;
    }

    private void ShowTooltipAddAgent(ElementReference element, TooltipOptions? options = null)
    {
        options ??= new()
        {
            Position = TooltipPosition.Bottom
        };

        TooltipService.Open(element, "Request for a new agent", options);
    }

    private async Task OnRequestAgent(MouseEventArgs arg)
    {
        var dialogOptions = new DialogOptions
        {
            Draggable = true,
            Resizable = false,
            CloseDialogOnEsc = true,
            ShowClose = true,
            Width = "500px",
            Height = "400px"
        };

        var dialogParameters = new Dictionary<string, object>
        {
            { "AgencyName", AgencyName },
            { "AgencyNumber", Account.AccountNum }
        };

        await DialogService.OpenAsync<AccountNewAgent>("Request for a new Agent", dialogParameters, dialogOptions);
    }

    private async Task CancelEdit()
    {
        await InitializeWorkModel();
        _isEditMode = false;
    }

    private void SetAgency()
    {
        _agency = _allAgencies.FirstOrDefault(f => f.AgencyNumber == _model!.AgencyNumber);
        _agent = null;
        StateHasChanged();
    }

    private void SetAgent()
    {
        _agent = _agencyAgents
            .FirstOrDefault(f => f.Id == _model!.AgentId);
        
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (!_form.IsValid)
            return;

        var success = await SaveAgencyAndAgent(_model!.AgencyNumber!, _model!.AgentId);

        if (success)
            NotifySuccessfulSave("Agency and Agent successfully updated");

        _isEditMode = false;
    }

    private async Task<bool> SaveAgencyAndAgent(string agencyNumber, Guid? agentId)
    {
        var response = await DataAccess.SetAccountAgencyAndAgent(Account.Id, agencyNumber, agentId);
        if (response.Success)
        {
            var agencyResponse = await DataAccess.GetAgencyByAgencyNumber(agencyNumber);
            Account.AgencyNumber = agencyNumber;
            Account.AgencyNumberNavigation = agencyResponse.Data;

            if (agentId != null)
            {
                var agentResponse = await DataAccess.GetAgent(agentId.Value);

                if (!agentResponse.Success)
                {
                    Account.AgentId = null;
                    Account.Agent = null;

                    NotifyLoadError(agentResponse.Errors, "agent", true);
                }
                else
                {
                    Account.AgentId = agentId;
                    Account.Agent = agentResponse.Data;
                }
            }
            else
            {
                Account.AgentId = null;
                Account.Agent = null;
            }

            return true;
        }

        NotifyLoadError(response.Errors, "account", true);
        return false;
    }

    private async Task InitializeWorkModel()
    {
        _model = new(Account.AgencyNumber, Account.AgentId);
        _agency = _allAgencies.FirstOrDefault(f => f.AgencyNumber == Account.AgencyNumber);
        await LoadAgents();
        _agent = _agencyAgents.FirstOrDefault(f => f.Id == Account.AgentId);
        StateHasChanged();
    }

}