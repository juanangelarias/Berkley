@page "/Agency/{Id}"

@using System.Diagnostics
@using System.Globalization
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject JamesClient JamesClient

<Theme />

<PageTitle>Agency Profile</PageTitle>


<UseGetAgencyByAgencyNumber AgencyNumber="@Id">
    <ChildContent Context="agencyFromServer">
        @if (agencyFromServer.AgencyByAgencyNumber != null)
        {
            this.agency = James.Shared.ThisToThat.ToEntityType<Agency>(agencyFromServer.AgencyByAgencyNumber);
        }
        <RadzenStack Orientation="Orientation.Vertical" Gap="10px">
            <RadzenPanel Style="border-radius: 20px">
                <RadzenRow JustifyContent="JustifyContent.End">
                    <RadzenColumn>
                        <RadzenText TextStyle="TextStyle.DisplayH5" Text="@agency.IdNavigation.FullName" />
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText Text="Status:" />
                            <RadzenText Text="@agency.Status" />
                            <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="2">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText Text="Agency #: " />
                            <RadzenText Text="@agency.AgencyNumber" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText Text="Name: " />
                            <RadzenText Text="@agency.IdNavigation?.FullName" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="2">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText Text="Parent #: " />
                            <RadzenText Text="10300" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenText Text="Parent: " />
                            <RadzenText Text="NFP Property & Casualty Services, Inc." />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenPanel>
            <RadzenPanel Style="border-radius: 20px">
                <RadzenTabs>
                    <Tabs>
                        <RadzenTabsItem Text="General Info">
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenFieldset Text="Address">
                                                <HeaderTemplate>
                                                    <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" Click="ToggleGenInfoEdit" Visible=!genInfoEditMode />
                                                    <RadzenButton Icon="save" Size="ButtonSize.ExtraSmall" Click="ToggleGenInfoEdit" Visible=genInfoEditMode />
                                                </HeaderTemplate>
                                                <ChildContent>
                                                    <RadzenStack Orientation="Orientation.Vertical">
                                                        <RadzenRow>
                                                            <RadzenColumn Size="2">
                                                                <RadzenText Style="font-weight: bold;" Text="Address: " />
                                                            </RadzenColumn>
                                                            <RadzenColumn>
                                                                <RadzenText>
                                                                    @{
                                                                        @agency?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main").Address?.Address1
                                                                        ;
                                                                    }
                                                                </RadzenText>
                                                            </RadzenColumn>
                                                        </RadzenRow>
                                                        <RadzenRow>
                                                            <RadzenColumn Size="2">
                                                                <RadzenText Style="font-weight: bold;" Text="Address 2: " />
                                                            </RadzenColumn>
                                                            <RadzenColumn>
                                                                <RadzenText>
                                                                    @{
                                                                        @agency.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main").Address?.Address2
                                                                        ;
                                                                    }
                                                                </RadzenText>
                                                            </RadzenColumn>
                                                        </RadzenRow>
                                                        <RadzenRow>
                                                            <RadzenColumn Size="1">
                                                                <RadzenText Style="font-weight: bold;" Text="City: " />
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="2">
                                                                <RadzenText>
                                                                    @{
                                                                        @agency.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main").Address?.City
                                                                        ;
                                                                    }
                                                                </RadzenText>
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="1">
                                                                <RadzenText Style="font-weight: bold;" Text="State: " />
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="1">
                                                                <RadzenText>
                                                                    @{
                                                                        @agency.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main").Address?.StateCode
                                                                        ;
                                                                    }
                                                                </RadzenText>
                                                            </RadzenColumn>
                                                            <RadzenColumn Size="3">
                                                                <RadzenText Style="font-weight: bold;" Text="Postal Code: " />
                                                            </RadzenColumn>
                                                            <RadzenText>
                                                                @{
                                                                    @agency.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main").Address?.PostalCode
                                                                    ;
                                                                }
                                                            </RadzenText>
                                                        </RadzenRow>
                                                        <RadzenRow>
                                                            <RadzenStack Orientation="Orientation.Horizontal">
                                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@agency.W9"
                                                                                    Text="W-9" Style="height: 25px; border-radius: 10px" />
                                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success"
                                                                                    Text="Need 1099" Style="height: 25px; border-radius: 10px" />
                                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" Value="@agency.Nasbp"
                                                                                    Text="NASBP" Style="height: 25px; border-radius: 10px" />
                                                            </RadzenStack>
                                                        </RadzenRow>
                                                        <RadzenRow>

                                                        </RadzenRow>
                                                    </RadzenStack>

                                                </ChildContent>
                                            </RadzenFieldset>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="12">
                                            <RadzenFieldset Text="Errors & Omissions Coverage">
                                                <RadzenStack Orientation="Orientation.Vertical">
                                                    <RadzenText Text="Carrier: Indian Harbor Insurance Company" />
                                                    <RadzenText Text="Expiration Date: 6/1/2024" />
                                                    <RadzenText Text="Limit of Coverage: $10,000,000" />
                                                </RadzenStack>
                                            </RadzenFieldset>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFieldset Text="Notes" AllowCollapse="true">
                                        <Notebook></Notebook>
                                        <RadzenDataList Data="notifications" Density="Density.Compact" WrapItems="true"
                                                        TItem="Notification" AllowPaging="true" PageSize="4">
                                            <Template Context="notification">
                                                <NotificationCard NotificationToDisplay="notification" />
                                            </Template>
                                        </RadzenDataList>
                                    </RadzenFieldset>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow Size="12">
                                <RadzenFieldset Text="Agency Licenses">

                                    <UseGetAgencyLicenses AgencyId="agency.Id">

                                        <ChildContent Context="licenseResult">
                                            @{
                                                // if (licenseResult.AgencyLicenses != null)
                                                // {
                                                //     this.agencyLicenses = James.Shared.ThisToThat.ToEntityType<List<AgencyLicense>>(licenseResult.AgencyLicenses);
                                                // }
                                            }
                                            <RadzenDataGrid TItem="IGetAgencyLicenses_AgencyLicenses" Data="licenseResult.AgencyLicenses"
                                                            Style="border-radius: 20px;" EmptyText="No records to display"
                                                            AllowPaging="true" PageSize="10" AllowSorting="true"
                                                            AllowGrouping="true" AllowColumnPicking="true">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="Status" Property="Status" Width="100px">
                                                        <Template Context="license">
                                                            @{
                                                                if (license.Status == "Active")
                                                                {
                                                                    <RadzenIcon Icon="check_circle" IconColor="@Colors.Success" />
                                                                }
                                                                else
                                                                {
                                                                    <RadzenIcon Icon="cancel" IconColor="@Colors.Danger" />
                                                                }
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="State" Property="State" Width="100px" SortOrder="SortOrder.Ascending" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="No Aptmt" Width="100px">
                                                        <Template Context="license">
                                                            <RadzenCheckBox TValue="bool?" Value="license.AppointingState" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="License" Property="LicenseNumber" Width="100px" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="Resident" Width="100px">
                                                        <Template Context="license">
                                                            <RadzenCheckBox TValue="bool?" Value="license.IsResident" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="IGetAgencyLicenses_AgencyLicenses" Title="Insurer" Property="Insurer.FullName" />
                                                </Columns>
                                            </RadzenDataGrid>
                                        </ChildContent>
                                    </UseGetAgencyLicenses>
                                </RadzenFieldset>
                            </RadzenRow>
                            <RadzenRow Size="12">
                                <RadzenFieldset Text="Agency POAs">
                                    <RadzenDataGrid TItem="string" Data="@blankList"
                                                    Style="border-radius: 20px;" EmptyText="No records to display">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="string" Title="Insurer" Width="100px" />
                                            <RadzenDataGridColumn TItem="string" Title="Limit" Width="100px" />
                                            <RadzenDataGridColumn TItem="string" Title="Reference #" Width="200px" />
                                            <RadzenDataGridColumn TItem="string" Title="Date of 1st Issue" Width="200px" />
                                            <RadzenDataGridColumn TItem="string" Title="Current POA Date" Width="200px" />
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenFieldset>
                            </RadzenRow>
                            <RadzenRow Size="12">
                                <RadzenFieldset Text="Related Parties">
                                    <RadzenDataGrid TItem="string" Data="@blankList"
                                                    Style="border-radius: 20px;" EmptyText="No records to display">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="string" Title="Agency #" Width="100px" />
                                            <RadzenDataGridColumn TItem="string" Title="Agency Name" />
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenFieldset>
                            </RadzenRow>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Contacts">
                            <RadzenTextBox Placeholder="Search..." />
                            <RadzenButton Icon="search" Size="ButtonSize.Small" Click="SearchAgents" />
                            <RadzenPanel>
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal">
                                        <RadzenButton Size="ButtonSize.Small" Icon="grid_view" Variant="Variant.Text" Click="@(() => contactsGridView = true)" />
                                        <RadzenButton Size="ButtonSize.Small" Icon="list" Variant="Variant.Text" Click="@(() => contactsGridView = false)" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <ChildContent>
                                    <UseGetAgencyAgents AgencyId="agency.Id">
                                        <ChildContent Context="agentList">
                                            <RadzenDataGrid TItem="IGetAgencyAgents_AgencyAgents" Data="agentList?.AgencyAgents">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="IGetAgencyAgents_AgencyAgents" Property="Agent.GivenName" Title="First Name" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyAgents_AgencyAgents" Property="Agent.MiddleInitial" Title="MI" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyAgents_AgencyAgents" Property="Agent.FamilyName" Title="Last Name" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyAgents_AgencyAgents" Property="Agent.MainEmailAddress" Title="Email" />
                                                    <RadzenDataGridColumn TItem="IGetAgencyAgents_AgencyAgents" Property="Agent.NationalProducerNumber" Title="NPN" />
                                                </Columns>
                                            </RadzenDataGrid>
                                        </ChildContent>
                                    </UseGetAgencyAgents>
                                </ChildContent>
                            </RadzenPanel>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Inventory"></RadzenTabsItem>
                        <RadzenTabsItem Text="Accounts and Bonds">
                            <RadzenPanel>
                                <RadzenTabs>
                                    <Tabs>
                                        <RadzenTabsItem Text="Accounts">

                                            <RadzenDataGrid TItem="Account" Data="agency?.Accounts"
                                                            AllowPaging="true" PageSize="15"
                                                            AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="Account" Title="Account #" Property="AccountNum" />
                                                    <RadzenDataGridColumn TItem="Account" Title="Account Name" Property="IdNavigation.FullName" />
                                                    <RadzenDataGridColumn TItem="Account" Title="City" Property="MainAddress.City" />
                                                    <RadzenDataGridColumn TItem="Account" Title="State" Property="MainAddress.State" />
                                                    <RadzenDataGridColumn TItem="Account" Title="Postal Code" Property="MainAddress.PostalCode" />
                                                    <RadzenDataGridColumn TItem="Account" Title="Branch" Property="Branch" />
                                                    <RadzenDataGridColumn TItem="Account" Title="Status" />

                                                </Columns>
                                                <EmptyTemplate>
                                                    No Records to Display
                                                </EmptyTemplate>
                                            </RadzenDataGrid>
                                        </RadzenTabsItem>
                                        <RadzenTabsItem Text="Bonds">
                                            @* <UseGetAgencyBonds AgencyId="agency.Id">

                                            </UseGetAgencyBonds> *@
                                        </RadzenTabsItem>
                                    </Tabs>
                                </RadzenTabs>
                            </RadzenPanel>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Commission Rates">
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenFieldset Text="Contract Rates">
                                        <RadzenRow>
                                            <RadzenColumn Size="3">
                                                <span>$1 - $2,500,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="100000000"
                                                              TValue="IEnumerable<int>" @bind-Value="@firstRange" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <span>$2,500,000 - $5,000,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="100000000"
                                                              TValue="IEnumerable<int>" @bind-Value="@secondRange" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <span>$5,000,000 - $7,500,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="100000000"
                                                              TValue="IEnumerable<int>" @bind-Value="@thirdRange" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <span>$7,500,000 - $100,000,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="100000000"
                                                              TValue="IEnumerable<int>" @bind-Value="@fourthRange" />
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenFieldset>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFieldset Text="Commercial Rates">
                                        <RadzenRow>
                                            <RadzenColumn Size="3">
                                                <span>$1 - $2,500,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="7500000"
                                                              TValue="IEnumerable<int>" @bind-Value="@firstRange" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <span>$2,500,000 - $5,000,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="7500000"
                                                              TValue="IEnumerable<int>" @bind-Value="@secondRange" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <span>$5,000,000 - $7,500,000</span>
                                            </RadzenColumn>
                                            <RadzenColumn Size="9">
                                                <RadzenSlider Range="true" Min="1" Max="7500000"
                                                              TValue="IEnumerable<int>" @bind-Value="@thirdRange" />
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenFieldset>
                                </RadzenColumn>
                            </RadzenRow>

                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Virtual File"></RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenPanel>
        </RadzenStack>
    </ChildContent>
</UseGetAgencyByAgencyNumber>

@code {
    [Parameter] public string Id { get; set; }
    public Notification[] notifications;
    List<string> blankList = new List<string>();
    private bool contactsGridView = false;
    private Agency agency = new Agency();
    private List<AgencyLicense> agencyLicenses = new List<AgencyLicense>();

    private bool genInfoEditMode { get; set; } = false;

    //TODO: Remove test code below
    IEnumerable<int> firstRange = new int[] { 1, 2500000 };
    IEnumerable<int> secondRange = new int[] { 2500000, 5000000 };
    IEnumerable<int> thirdRange = new int[] { 5000000, 7500000 };
    IEnumerable<int> fourthRange = new int[] { 7500000, 100000000 };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeService.Initialize(NavigationManager);

        notifications = new Notification[]{
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 1234567"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 2345678"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 3456789"},
            new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 4567890"}
    };

    }
    async Task SearchAgents()
    {
        // IGetAgencyByAgencyNumber_AgencyByAgencyNumber_AgentsInAgencies agent = new IGetAgencyByAgencyNumber_AgencyByAgencyNumber_AgentsInAgencies();
        // agent.Agent.IdNavigation.AgencyLicenseAgents.First().S
    }
    private void ToggleGenInfoEdit()
    {
        genInfoEditMode = !genInfoEditMode;
    }

}
