@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

@attribute [Authorize]

<Theme />

<RenderModeBackground></RenderModeBackground>

<RadzenAutoComplete @ref="@AutoComplete" MinLength="3" Style="width:100%"
                    ValueChanged="ResultSelected"
                    Value="@_selectedAgent"
                    Placeholder="Search..." Data="@SearchResults" LoadData="SearchAgent"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
    <Template Context="agent">
        <RadzenStack Orientation="Orientation.Horizontal" Style="width:500px;">
            <RadzenIcon Icon="person" />
            <RadzenText Text="@agent.IdNavigation.FullName" />
        </RadzenStack>
    </Template>
</RadzenAutoComplete>

@code {
    [Parameter, EditorRequired] 
    public Guid SelectedAgentId { get; set; }
    
    [Parameter]
    public EventCallback<Guid> SelectedAgentIdChanged { get; set; }
    
    private List<Agent> SearchResults { get; set; } = [];
    private RadzenAutoComplete AutoComplete { get; set; } = null!;
    private string _selectedAgent = "";
    private IDataAccessResult<List<Agent>> _searchResult = null!;

    private LoadItem AgentsLoad(string filter) => AddEventNotify(new LoadItem
        {
            Key = $"SearchResult{SelectedAgentId}",
            AsyncLoadTask = async () => _searchResult = await DataAccess.SearchAgents(filter),
            CacheLoadTask = cache => _searchResult = new DataAccessResult<List<Agent>>
            {
                Data = (List<Agent>)cache!
            },
            ResultVariable = () => _searchResult,
            AfterLoad = () => { SearchResults = _searchResult.Data!; },
            CacheDuration = TimeSpan.FromSeconds(1)
        }, "Search result");
    
    private async Task SearchAgent(LoadDataArgs args)
    {
        await DataCache.GetCacheOrLoadDataAsync(AgentsLoad(args.Filter));
    }
    
    private async Task ResultSelected(dynamic args)
    {
        if (null == AutoComplete.Value || (AutoComplete.Value.GetType()) != typeof(Agent)) 
            return;
        
        SelectedAgentId = ((Agent)AutoComplete.Value).Id;
        _selectedAgent = ((Agent)AutoComplete.Value).IdNavigation.FullName;
        await SelectedAgentIdChanged.InvokeAsync(SelectedAgentId);
    }
}
