@using James.Shared.Imaging
@inherits JamesWebUI.Shared.JamesLayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject TooltipService TooltipService
@inject IDataAccess DataAccess
@inject NavigationManager NavigationManager
<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenButton Icon="description"
                  Size="ButtonSize.Small"
                  ButtonStyle="ButtonStyle.Base"
                  Variant="Variant.Text"
                  Visible=@HasDocument
                  MouseEnter="@(args => ShowTooltip(args,"Download "+ DocumentShortName))"
                  Click=@DownloadDocument />
    <RadzenButton Icon="upload_file"
                  Size="ButtonSize.Small"
                  ButtonStyle="ButtonStyle.Base"
                  Variant="Variant.Text"
                  Visible=@(AllowUploads && !HasDocument)
                  MouseEnter="@(args => ShowTooltip(args,"Upload "+ DocumentShortName))"
                  Click=@ShowSimpleUpload />
    <RadzenButton Icon="more_horiz"
                  Size="ButtonSize.ExtraSmall"
                  ButtonStyle="ButtonStyle.Base"
                  Variant="Variant.Text"
                  Visible=@(AllowUploads && HasDocument)
                  MouseEnter="@(args => ShowTooltip(args,"Replace "+ DocumentShortName))"
                  Click=@ShowSimpleUpload />
    @* TODO: Discuss if a remove button is needed *@
</RadzenStack>
<script>
    window.triggerFileDownload = (fileName, url) => {
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
    }
</script>
@code {
    /// <summary>
    /// Id of the document inside the P8 imaging system
    /// </summary>
    [Parameter]
    public Guid? DocumentId { get; set; }
    [Parameter]
    public required ImagingDocumentCategory DocumentCategory { get; set; }
    [Parameter]
    public required string DocumentType { get; set; }
    [Parameter]
    public string? LinkableDocumentTypes { get; set; }
    /// <summary>
    /// The Id used inside the DocumentCategory to link to an account/bond/bond request/agency/etc.
    /// </summary>
    [Parameter]
    public required string ImagingId { get; set; }

    [Parameter] public bool AllowUploads { get; set; } = true;
    [Parameter]
    public Action<Guid?>? UploadAction { get; set; }
    [Parameter]
    public Action<string>? UploadErrorAction { get; set; }
    /// <summary>
    /// Used to make tooltip more descriptive.  Should be title cased.
    /// </summary>
    [Parameter] public string DocumentShortName { get; set; } = "Document";

    protected override Task OnParametersSetAsync()
    {
        //TODO:Query filename for tooltip
        return base.OnParametersSetAsync();
    }

    private bool HasDocument => DocumentId != null;

    //TODO: Load file name in background for tooltip
    void ShowTooltip(ElementReference elementReference, string message, TooltipOptions options = null) => TooltipService.Open(elementReference, message, options);
    private async Task DownloadDocument()
    {
        if (null == DocumentId) return;
        NavigationManager.NavigateTo($"/ImagingRepository/GetDocument/{DocumentCategory}/{DocumentId}", true);
        // throw new NotImplementedException();
    }

    private async Task ShowSimpleUpload()
    {
        var dialogArguments = new Dictionary<string, object>() { { "Title", "Upload POA Document" },
            { "DocumentCategory", DocumentCategory },
            {"DocumentType",DocumentType },
            {"DocumentId",DocumentId ?? Guid.Empty},
            {"ImagingId",ImagingId},
            {"LinkableDocumentTypes",LinkableDocumentTypes ?? ""},
            {"UploadAction", UploadAction!}
        };
        var result = await DialogService.OpenAsync<VirtualFileSimpleUpload>("Attach POA Document", dialogArguments,
            new DialogOptions { Width = "700px" });//TODO:Set DialogOptions
        if (null == result || result is Guid)
            //Set DocumentId to update UI
            DocumentId = result;
    }

    private async Task LogUploadError(string message)
    {
        if (null == UploadErrorAction)
        {
            //Generic error logging since no information of the calling object is known
            LoggingService.LogError("Upload failed",
                "An upload to the imaging system failed.", "Imaging",
                data: new Dictionary<string, string>
                    {
                    { "Error Message", message }
                    });
        }
        else
            UploadErrorAction.Invoke(message);
    }

    //The below is to prevent the file drop cursor from being shown except when the file is dragged onto the RadzenUpload
    IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Shared/InlineImagingDocument.razor.js");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}
