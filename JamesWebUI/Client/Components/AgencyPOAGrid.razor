@using James.Shared.Imaging
@using SharedBusinessLogic

@inherits JamesLayoutComponentBase

@inject TooltipService TooltipService
@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme />

<RadzenDataGrid @ref="POAGrid" TItem="PowerOfAttorney" Data="PowerOfAttorneys"
                AllowFiltering="true" FilterMode="FilterMode.Advanced" Style="height: 400px; border-radius: 10px;"
                AllowSorting="true" AllowGrouping="true" AllowColumnPicking="true" Density="Density.Compact"
                RowCreate="@OnPoaCreate" RowUpdate="@UpdatePoaRow" EditMode="DataGridEditMode.Single"
                IsLoading="@_isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New POA" Variant="Variant.Text" Click="@InsertPOARow" />
            <RadzenSplitButton Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem"
                               Wrap="FlexWrap.Wrap" ButtonStyle="ButtonStyle.Secondary" Text="Export"
                               Click="@(args => ExportGrid(args))"
                               Disabled="@_isLoading" Size="ButtonSize.Small">
                <ChildContent>
                    <RadzenSplitButtonItem Text="Excel" Value="Excel" Icon="download"/>
                    <RadzenSplitButtonItem Text="CSV" Value="CSV" Icon="download"/>
                </ChildContent>
            </RadzenSplitButton>
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="poa">
        <RadzenDataList TItem="PowerOfAttorneyDocumentStatus" Data="poa.PowerOfAttorneyDocumentStatuses" Density="Density.Compact"
                        Style="max-height:400px; overflow:auto; width:100%" AllowVirtualization="true" WrapItems="false" AllowPaging="false">
            <Template Context="poaDocStatus">
                <PowerOfAttorneyDocumentStatusCard PoaDocumentStatus="@poaDocStatus" />
            </Template>
        </RadzenDataList>
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="Status" Property="Status" Type="typeof(string)"
                              FilterValue="@_statusFilter" FilterProperty="Status" FilterOperator="FilterOperator.Contains">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_statusFilter" AllowClear="true" Style="width:95%" 
                                Multiple="true" TValue="List<string>" Data="@_statusList" />
            </FilterTemplate>
            <EditTemplate Context="poa">
                <RadzenDropDown TValue="string" @bind-Value="poa.Status" Data="@_statusList" Style="width: 95%"/>
            </EditTemplate>
            <Template Context="poa">
                <RadzenText Text="@poa.Status" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Insurer" Property="Insurer.IdNavigation.FullName" Width="300px" Type="typeof(string)"
                              FilterValue="@_insurerFilter" FilterProperty="Insurer.IdNavigation.FullName" FilterOperator="FilterOperator.Contains">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_insurerFilter" AllowClear="true" Style="width:95%"
                                Multiple="true" TValue="List<string>" Data="@_insurerList" />
            </FilterTemplate>
            <EditTemplate Context="poa">
                <RadzenDropDown @bind-Value="poa.Insurer.IdNavigation.FullName" Data="@_insurerList" Style="width: 95%"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Limit" Property="Limit" FormatString="{0:c0}" Filterable="false" Width="175px">
            <EditTemplate Context="poa">
                <RadzenNumeric @bind-Value="poa.Limit" Format="c0" Style="width: 95%" ShowUpDown="false" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Ref #" Property="ReferenceNumber">
            <EditTemplate Context="poa">
                <RadzenTextBox @bind-Value="poa.ReferenceNumber" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="First Issue Date" Property="FirstIssued" FormatString="{0:d}" Width="200px">
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.FirstIssued" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Current POA Date" Property="CurrentIssued" FormatString="{0:d}" SortOrder="SortOrder.Descending" Width="200px">
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.CurrentIssued" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="POA Document">
            <Template Context="poa">
                @* <RadzenButton Variant="Variant.Text" Icon="picture_as_pdf" Size="ButtonSize.ExtraSmall" /> *@
                <InlineImagingDocument DocumentShortName="POA Document"
                                       DocumentCategory="ImagingDocumentCategory.Agency"
                                       DocumentId="@poa.ImagingId"
                                       DocumentType="@($"AG{poa.Insurer.ToWritingCompany()}POA" )"
                                       ImagingId="@poa.Agency.AgencyNumber"
                                       AllowUploads=@(null != poa.Insurer.ToWritingCompany())
                                       UploadAction=@(async void (guid) => await PoaDocumentUploaded(guid, poa.Id))
                                       UploadErrorAction=@(msg=>LogUploadError(msg, poa)) />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="PowerOfAttorney"
                              Filterable="false" Sortable="false" TextAlign="TextAlign.Right">
            <Template Context="poa">
                <RadzenButton Variant="Variant.Flat" 
                              Icon="edit" 
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" 
                              Click="@(args => EditPoaRow(poa))" 
                              @onclick:stopPropagation="true" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                              Icon="delete"
                              Variant="Variant.Flat"
                              Shade="Shade.Lighter"
                              Size="ButtonSize.Small"
                              class="my-1 ms-1"
                              Click="@(_ => DeletePoaRow(poa))" 
                              @onclick:stopPropagation="true"/>
            </Template>
            <EditTemplate Context="poa">
                <RadzenButton Icon="check"
                              ButtonStyle="ButtonStyle.Success"
                              Variant="Variant.Flat"
                              Size="ButtonSize.Small"
                              Click="@(_=> SavePoaRow(poa))"/>
                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Flat"
                              ButtonSize="ButtonSize.Small"
                              class="my-1 ms-1"
                              Click="@(_=> CancelPoaEdit(poa))" />
                <RadzenButton Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Flat"
                              Shade="Shade.Lighter"
                              Size="ButtonSize.Small"
                              class="my-1 ms-1"
                              Click="@(_=> DeletePoaRow(poa))"/>
            </EditTemplate>
        </RadzenDataGridColumn> 
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code 
{
    [Parameter, EditorRequired] required public Agency Agency { get; set; }

    private string AgencyPOAKey => $"AgencyPOAs{Agency.Id}";

    private RadzenDataGrid<PowerOfAttorney> POAGrid { get; set; } = null!;

    private List<PowerOfAttorney> PowerOfAttorneys { get; set; } = [];

    private List<PowerOfAttorney> _poasToInsert = [];
    private List<PowerOfAttorney> _poasToUpdate = [];

    private List<Insurer> AllInsurers { get; set; } = [];
    private List<PowerOfAttorneyStatusDm> AllStatuses { get; set; } = [];

    private List<string>? _insurerFilter;
    private List<string>? _statusFilter;

    private List<string> _insurerList = [];
    private List<string> _statusList = [];

    private bool _isLoading;
    private bool _poaEditMode;

    #region Loaders

    private IDataAccessResult<List<PowerOfAttorney>> _poas = null!;

    private LoadItem AgencyPoasLoad => AddEventNotify(new LoadItem
    {
        Key = AgencyPOAKey,
        AsyncLoadTask = async () => _poas = await DataAccess.GetAgencyPoas(Agency.Id),
        CacheLoadTask = cache => _poas = new DataAccessResult<List<PowerOfAttorney>>
        {
            Data = (List<PowerOfAttorney>)cache!
        },
        ResultVariable = () => _poas,
        AfterLoad = () =>
        {
            PowerOfAttorneys = _poas.Data!;

            _statusList = PowerOfAttorneys
                .OrderBy(p => p.Status)
                .GroupBy(p => p.Status)
                .Select(p => p.FirstOrDefault()?.Status ?? "")
                .ToList();

            _insurerList = PowerOfAttorneys
                .OrderBy(p => p.Insurer.IdNavigation.FullName)
                .GroupBy(p => p.Insurer.IdNavigation.FullName)
                .Select(p => p.FirstOrDefault()?.Insurer.IdNavigation.FullName ?? "")
                .ToList();
        }
    }, "agency POAs");

    private IDataAccessResult<List<Insurer>> insurers = null!;

    private LoadItem InsurersLoad => AddEventNotify(new LoadItem
    {
        Key = "Insurers",
        AsyncLoadTask = async () => insurers = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => insurers = new DataAccessResult<List<Insurer>>
        {
            Data = (List<Insurer>)cache!
        },
        ResultVariable = () => insurers,
        AfterLoad = () =>
        {
            if (insurers.Success)
                AllInsurers = insurers.Data!;
        }
    }, "insurers");

    private IDataAccessResult<List<PowerOfAttorneyStatusDm>> statuses = null!;

    private LoadItem StatusesLoad => AddEventNotify(new LoadItem
    {
        Key = "Statuses",
        AsyncLoadTask = async () => statuses = await DataAccess.GetAllPoaStatuses(),
        CacheLoadTask = cache => statuses = new DataAccessResult<List<PowerOfAttorneyStatusDm>>
        {
            Data = (List<PowerOfAttorneyStatusDm>)cache!
        },
        ResultVariable = () => statuses,
        AfterLoad = async void () =>
        {
            if (statuses.Success)
                AllStatuses = statuses.Data!;
        }
    }, "statuses");

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        await LoadData();
    }

    private async Task LoadData()
    {
        if (Agency.Id == Guid.Empty)
            return;

        await DataCache.ParallelGetCacheOrDataAsync(AgencyPoasLoad, InsurersLoad, StatusesLoad);
    }

    private Task Reset()
    {
        _poasToInsert.Clear();
        _poasToUpdate.Clear();

        return Task.CompletedTask;
    }

    private Task Reset(PowerOfAttorney powerOfAttorney)
    {
        _poasToInsert.Remove(powerOfAttorney);
        _poasToUpdate.Remove(powerOfAttorney);

        return Task.CompletedTask;
    }

    private async Task LoadPOAs()
    {
        await DataCache.GetCacheOrLoadDataAsync(AgencyPoasLoad);
    }

    private async Task SavePoaRow(PowerOfAttorney powerOfAttorney)
    {
        await ShowLoading();
        await POAGrid.UpdateRow(powerOfAttorney);
        await LoadPOAs();
    }

    // private async Task InsurerFilterChange()
    // {
    //     if (_insurerFilter != null && !_insurerFilter.Any())
    //     {
    //         _insurerFilter = null;
    //     }
    //     //await POAGrid.Reload();
    // }
    //
    // private async Task StatusFilterChange()
    // {
    //     if (_statusFilter != null && !_statusFilter.Any())
    //     {
    //         _statusFilter = null;
    //     }
    //     //await POAGrid.Reload();
    // }

    protected async Task ShowLoading()
    {
        _isLoading = true;

        await Task.Yield();

        _isLoading = false;
    }

    private void TogglePoaEditMode()
    {
        _poaEditMode = !_poaEditMode;
    }

    private async Task InsertPOARow()
    {
        await ShowLoading();
        var newPoa = new PowerOfAttorney
        {
            Id = Guid.NewGuid(),
            AgencyId = Agency.Id,
            Agency = Agency,
            Insurer = new Insurer
            {
                IdNavigation = new LegalEntity
                {
                    FullName = ""
                }
            }
        };
        _poasToInsert.Add(newPoa);
        await POAGrid.InsertRow(newPoa);
    }

    //Enable row edit mode for a POA record.
    private async Task EditPoaRow(PowerOfAttorney poaToEdit)
    {
        await ShowLoading();
        await Reset();
        _poasToUpdate.Add(poaToEdit);
        await POAGrid.EditRow(poaToEdit);

    }

    //Save changes to a POA row, disable edit mode for that row.
    private async Task UpdatePoaRow(PowerOfAttorney? poaToUpdate)
    {
        await ShowLoading();
        if (poaToUpdate != null)
        {
            var result = await DataAccess.SetPowerOfAttorney(poaToUpdate.Id,
                poaToUpdate.Insurer.Id,
                poaToUpdate.Limit,
                poaToUpdate.ReferenceNumber,
                poaToUpdate.FirstIssued,
                poaToUpdate.CurrentIssued,
                poaToUpdate.Comments,
                poaToUpdate.Status);
            if (result.Success)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Changes saved successfully.", Duration = 5000 });

                await Reset(poaToUpdate);
                await POAGrid.Reload();
            }
            else
            {
                LoggingService.LogError("Could not link document to POA.", string.Join("; ", result.Errors));
            }
            DataCache.UpdateCache(AgencyPOAKey, PowerOfAttorneys);
        }
    }

    private async Task OnPoaCreate(PowerOfAttorney powerOfAttorney)
    {
        var result = await DataAccess.CreateAgencyPOA(powerOfAttorney.Id,
            powerOfAttorney.Insurer.Id,
            Agency.Id,
            Convert.ToInt32(powerOfAttorney.Limit),
            powerOfAttorney.ReferenceNumber,
            powerOfAttorney.FirstIssued,
            powerOfAttorney.CurrentIssued,
            powerOfAttorney.Comments,
            powerOfAttorney.Status);

        if (result.Success)
            _poasToInsert.Remove(powerOfAttorney);
        else
            NotifySaveError(result.Errors, "Agency POA");
        
        DataCache.UpdateCache(AgencyPOAKey, PowerOfAttorneys);
    }

    private async Task DeletePoaRow(PowerOfAttorney powerOfAttorney)
    {
        await ShowLoading();
        await Reset(powerOfAttorney);
        var result = await DataAccess.DeleteAgencyPOA(powerOfAttorney.Id);
        if (result.Success)
        {
            NotifySuccessfulSave("agency POA deleted");
            DataCache.UpdateCache(AgencyPOAKey, PowerOfAttorneys);
        }
        else
            NotifySaveError(result.Errors, "agency POA deletion");
    }

    private async Task CancelPoaEdit(PowerOfAttorney poa)
    {
        await ShowLoading();
        
        POAGrid.CancelEditRow(poa);

        DataCache.Clear(AgencyPOAKey);
        //await LoadPOAs();
    }

    private void ShowTooltip(ElementReference elementReference, string message, TooltipOptions? options = null) => TooltipService.Open(elementReference, message, options);

    private async Task PoaDocumentUploaded(Guid? documentId, Guid poaId)
    {
        var saveResult = await DataAccess.SetPowerOfAttorneyDocumentLink(poaId, documentId);
        if (saveResult.Success)
            NotifySuccessfulSave("POA document");
        else
            NotifySaveError(saveResult.Errors, "POA document");
    }

    private void LogUploadError(string message, PowerOfAttorney poa)
    {
        LoggingService.LogError("Upload failed",
            "Uploading a file to imaging returned an error",
            "Imaging",
            data: new Dictionary<string, string>
            {
                { "Error Message", message },
                { "AgencyNumber", poa.Agency.AgencyNumber },
                { "Poa Id", poa.Id.ToString() }
            });
    }

    private void ExportGrid(RadzenSplitButtonItem? item)
    {
        if (item == null)
            return;

        var format = item.Value.ToLower() == "excel" ? ExportFormat.Excel : ExportFormat.CSV;

        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Status", "Status", "Status");
        substitutions.AddSubstitution("Insurer.IdNavigation.FullName", "Insurer.IdNavigation.FullName", "Insurer");
        substitutions.AddSubstitution("Limit", "Limit", "Limit");
        substitutions.AddSubstitution("ReferenceNumber", "ReferenceNumber", "Reference No.");
        substitutions.AddSubstitution("FirstIssued", "FirstIssued", "First Issued Date");
        substitutions.AddSubstitution("CurrentIssued", "CurrentIssued", "Current POA Date");
        NavigationManager.NavigateTo(ExportDataGridUrl(POAGrid,
                $"/export/AgencyPOAs/{Agency.Id}", format, substitutions),
            true);
    }
}

