@using James.Shared
@inherits JamesLayoutComponentBase

@inject TooltipService TooltipService
@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess
@inject ILoggingService LoggingService
@inject NotificationService NotificationService

<Theme />

<RadzenDataGrid @ref="poaGrid" TItem="PowerOfAttorney" Data="powerOfAttorneys"
                AllowFiltering="true" FilterMode="FilterMode.Simple" Style="height: 400px; border-radius: 10px;"
                AllowSorting="true" AllowGrouping="true" AllowColumnPicking="true" Density="Density.Compact"
                RowCreate="@OnPoaCreate" RowUpdate="@UpdatePoaRow" EditMode="DataGridEditMode.Single"
                IsLoading="@isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New POA" Variant="Variant.Text" Click="@InsertPOARow" />
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="poa">
        <RadzenDataList TItem="PowerOfAttorneyDocumentStatus" Data="poa.PowerOfAttorneyDocumentStatuses" Density="Density.Compact"
                        Style="max-height:400px; overflow:auto; width:100%" AllowVirtualization="true" WrapItems="false" AllowPaging="false">
            <Template Context="poaDocStatus">
                <PowerOfAttorneyDocumentStatusCard poaDocumentStatus="poaDocStatus" />
            </Template>
        </RadzenDataList>
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="Status" Property="Status" Type="typeof(IEnumerable<Guid>)"
                              FilterValue="@StatusFilter" FilterProperty="Status" FilterOperator="FilterOperator.Contains">
            <FilterTemplate>
                <RadzenDropDown Change="StatusFilterChange" @bind-Value="@StatusFilter" AllowClear="true" Style="width:95%" TextProperty="StatusNavigation.Status" ValueProperty="Status"
                                Multiple="true" TValue="List<Guid>"
                                Data="@powerOfAttorneys?.OrderBy(p => p.StatusNavigation.Status).GroupBy(p => p.Status).Select(p => p?.FirstOrDefault()).ToList()" />
            </FilterTemplate>
            <EditTemplate Context="poa">
                <RadzenDropDown TValue="string" @bind-Value="poa.Status" Data="@AllStatuses" Style="width: 95%"
                                TextProperty="Status" ValueProperty="Id" />
            </EditTemplate>
            <Template Context="poa">
                <RadzenText Text="@poa.Status" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Insurer" Property="Insurer.IdNavigation.FullName"
                              Width="300px" Type="typeof(IEnumerable<String>)"
                              FilterValue="@InsurerFilter" FilterProperty="Insurer.IdNavigation.FullName" FilterOperator="FilterOperator.Contains">
            <FilterTemplate>
                <RadzenDropDown Change="InsurerFilterChange" @bind-Value="@InsurerFilter" AllowClear="true" Style="width:95%"
                                Multiple="true" TValue="List<String>"
                                Data="@powerOfAttorneys?.OrderBy(p => p.Insurer.IdNavigation.FullName).GroupBy(p => p.Insurer.Id).Select(p => p?.FirstOrDefault()?.Insurer.IdNavigation.FullName).ToList()" />
            </FilterTemplate>
            <EditTemplate Context="poa">
                <RadzenDropDown @bind-Value="poa.Insurer" Data="@AllInsurers" Style="width: 95%"
                                TextProperty="IdNavigation.FullName" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Limit" Property="Limit" FormatString="{0:c0}" Filterable="false" Width="175px">
            <EditTemplate Context="poa">
                <RadzenNumeric @bind-Value="poa.Limit" Format="c0" Style="width: 95%" ShowUpDown="false" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Ref #" Property="ReferenceNumber">
            <EditTemplate Context="poa">
                <RadzenTextBox @bind-Value="poa.ReferenceNumber" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="First Issue Date" Property="FirstIssued" FormatString="{0:d}" Width="200px">
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.FirstIssued" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Current POA Date" Property="CurrentIssued" FormatString="{0:d}" SortOrder="SortOrder.Descending" Width="200px">
            <EditTemplate Context="poa">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@poa.CurrentIssued" Style="width: 95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="POA">
            <Template>
                <RadzenButton Variant="Variant.Text" Icon="picture_as_pdf" Size="ButtonSize.ExtraSmall" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="PowerOfAttorney"
                              Filterable="false" Sortable="false" TextAlign="TextAlign.Right">
            <Template Context="poa">
                <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.ExtraSmall" Click="@(args => EditPoaRow(poa))" @onclick:stopPropagation="true" />
                <RadzenButton Variant="Variant.Text" Icon="post_add" Size="ButtonSize.ExtraSmall" MouseEnter="@(args => ShowTooltip(args, "Add New POA Document."))"/>
                <RadzenButton Variant="Variant.Text" Icon="delete" Size="ButtonSize.ExtraSmall" Click="@(args => DeletePoaRow(poa))" />
            </Template>
            <EditTemplate Context="poa">
                <RadzenButton Variant="Variant.Text" Icon="save" Size="ButtonSize.ExtraSmall" Click="@(args => SavePoaRow(poa))" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyID { get; set; }

    private RadzenDataGrid<PowerOfAttorney> poaGrid { get; set; }

    private List<PowerOfAttorney> powerOfAttorneys { get; set; }

    private List<PowerOfAttorney> poasToInsert { get; set; } = new List<PowerOfAttorney>();
    private List<PowerOfAttorney> poasToUpdate { get; set; } = new List<PowerOfAttorney>();

    private List<Insurer> AllInsurers { get; set; } = new List<Insurer>();
    private List<PowerOfAttorneyStatusDm> AllStatuses { get; set; } = new List<PowerOfAttorneyStatusDm>();
    
    private List<String> InsurerFilter = null;
    private List<Guid> StatusFilter = null;

    private RadzenDropDown<Guid> filterInsurerDropDown { get; set; }


    private bool isLoading = false;
    private bool poaEditMode = false;


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadPOAs();

        if (AllInsurers.Count == 0)
            AllInsurers = await LoadInsurers();
        if (AllStatuses.Count == 0)
            AllStatuses = await LoadStatuses();
    }
    async Task Reset()
    {
        poasToInsert.Clear();
        poasToUpdate.Clear();
    }
    async Task Reset(PowerOfAttorney powerOfAttorney)
    {
        poasToInsert.Remove(powerOfAttorney);
        poasToUpdate.Remove(powerOfAttorney);
    }
    private async Task LoadPOAs()
    {
        var result = await DataAccess.GetAgencyPoas(AgencyID);

        if (result.Success)
        {
            powerOfAttorneys = result.Data;
            await poaGrid.Reload();
        }
        else
        {
            //TODO:Add error details
            LoggingService.LogError("Error loading POAs in the AgencyPOAGrid");
        }
    }
    async Task SavePoaRow(PowerOfAttorney powerOfAttorney)
    {
        await ShowLoading();
        await poaGrid.UpdateRow(powerOfAttorney);
        await LoadPOAs();
    }
    private async Task<List<Insurer>> LoadInsurers()
    {
        var result = await DataAccess.GetAllInsurers();
        if (result.Success)
            return result.Data!.OrderBy(i => i.IdNavigation.FullName).ToList();
        else
        {
            //TODO:Add error details
            LoggingService.LogError("Error getting insurers in the AgencyPOAGrid");
            return [];
        }
    }
    private async Task<List<PowerOfAttorneyStatusDm>> LoadStatuses()
    {
        var result = await DataAccess.GetAllPoaStatuses();
        if (result.Success)
            return result.Data.OrderBy(s => s.Status).ToList();
        //TODO:Add error details
        LoggingService.LogError("Error getting all statuses in the AgencyPOAGrid");
        return [];
    }
    async Task InsurerFilterChange()
    {
        if (InsurerFilter != null && !InsurerFilter.Any())
        {
            InsurerFilter = null;
        }
        await poaGrid.Reload();
    }
    async Task StatusFilterChange()
    {
        if (StatusFilter != null && !StatusFilter.Any())
        {
            StatusFilter = null;
        }
        await poaGrid.Reload();
    }
    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
    private void TogglePoaEditMode()
    {
        poaEditMode = !poaEditMode;
    }
    async Task InsertPOARow()
    {
        await ShowLoading();
        var newPoa = new PowerOfAttorney() { Id = Guid.NewGuid() };
        poasToInsert.Add(newPoa);
        await poaGrid.InsertRow(newPoa);
    }
    //Enable row edit mode for a POA record.
    private async Task EditPoaRow(PowerOfAttorney poaToEdit)
    {
        await ShowLoading();
        await Reset();
        poasToUpdate.Add(poaToEdit);
        await poaGrid.EditRow(poaToEdit);

    }
    //Save changes to a POA row, disable edit mode for that row.
    private async Task UpdatePoaRow(PowerOfAttorney poaToUpdate)
    {
        await ShowLoading();
        if (poaToUpdate != null)
        {
            var result = await DataAccess.SetPowerOfAttorney(poaToUpdate.Id,
                poaToUpdate.Insurer.Id,
                poaToUpdate.Limit,
                poaToUpdate.ReferenceNumber,
                poaToUpdate.FirstIssued,
                poaToUpdate.CurrentIssued,
                poaToUpdate.Comments,
                poaToUpdate.Status);
            if (result.Success)
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Changes saved successfully.", Duration = 5000 });

                Reset(poaToUpdate);
                await poaGrid.Reload();
            }
            else
            {
                //TODO: Deal with errors.
            }

        }
    }
    async Task OnPoaCreate(PowerOfAttorney powerOfAttorney)
    {
        var result = await DataAccess.CreateAgencyPOA(powerOfAttorney.Id,
            powerOfAttorney.Insurer.Id,
            AgencyID,
            (int)powerOfAttorney.Limit,
            powerOfAttorney.ReferenceNumber,
            powerOfAttorney.FirstIssued,
            powerOfAttorney.CurrentIssued,
            powerOfAttorney.Comments,
            powerOfAttorney.Status);
        poasToInsert.Remove(powerOfAttorney);
    }
    async Task DeletePoaRow(PowerOfAttorney powerOfAttorney)
    {
        await ShowLoading();
        await Reset(powerOfAttorney);
        var result = await DataAccess.DeleteAgencyPOA(powerOfAttorney.Id);
        await LoadPOAs();
    }
    void ShowTooltip(ElementReference elementReference, string message, TooltipOptions options = null) => TooltipService.Open(elementReference, message, options);
}
