@page "/CreateObligee"

@using System.Globalization
@using James.Shared;
@using ClientBusinessLogic


@inherits JamesLayoutComponentBase
@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme />

<RadzenPanel Style="border-radius: 20px;">
    <HeaderTemplate>
        <RadzenText Text="Create New Obligee" TextStyle="TextStyle.DisplayH4" />
    </HeaderTemplate>
    <ChildContent>
        <RadzenTemplateForm TItem="Obligee" Submit="@(async (Obligee args) => { await SubmitObligee(args);})" Data="NewObligee">
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Name" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                        <ChildContent>
                            <RadzenTextBox Name="ObligeeName" @bind-Value="@NewObligee.IdNavigation.FullName"  />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="ObligeeName" Text="Obligee Name is required." />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Address 1" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                        <ChildContent>
                            <RadzenTextBox Name="Address1" @bind-Value="@NewAddress.Address1" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Address1" Text="Address 1 is required." />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">

                    <RadzenFormField Text="Address 2" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                        <ChildContent>
                            <RadzenTextBox Name="Address2" @bind-Value="@NewAddress.Address2" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenFormField Text="City" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:250px;">
                            <ChildContent>
                                <RadzenTextBox Name="City" @bind-Value="@NewAddress.City" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="City" Text="City is required." />
                            </Helper>
                        </RadzenFormField>
                        <RadzenFormField Text="State" AllowFloatingLabel="true" Variant="Variant.Text">
                            <ChildContent>
                                <RadzenDropDown Name="State" TValue="String" @bind-Value="@NewAddress.StateCode"
                                                Data="AllStates" ValueProperty="Code" TextProperty="Name" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="State" Text="State is required." />
                            </Helper>


                        </RadzenFormField>
                        <RadzenFormField Text="Postal Code" AllowFloatingLabel="true" Variant="Variant.Text">
                            <ChildContent>
                                <RadzenTextBox Name="Postal Code" @bind-Value="@NewAddress.PostalCode" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Postal Code" Text="Postal Code is required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Phone" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                        <ChildContent>
                            <RadzenMask Name="Phone" @bind-Value="@NewPhoneNumber.MainNumber" Mask="(***) ***-****"
                                        CharacterPattern="[0-9]" Placeholder="(000) 000-0000" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Email" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                            <ChildContent>
                                <RadzenTextBox Name="Email" @bind-Value="@NewEmail" />
                            </ChildContent>
                            <Helper>
                                <RadzenCustomValidator Component="Email" Text="Email is invalid."
                                                       Validator="@(() => null == NewEmail ? true : Validators.ValidateEmail(NewEmail))" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenStack Orientation="Orientation.Vertical">
                        <RadzenFormField Text="Type" AllowFloatingLabel="true" Variant="Variant.Text" Style="width:500px;">
                            <RadzenDropDown TValue="string" Name="Type" Data="ObligeeTypes" ValueProperty="Type" TextProperty="Type" @bind-Value="@NewObligee.Type" />
                        </RadzenFormField>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="ReceiveLetters" TriState="false" TValue="bool" @bind-Value="@NewObligee.PrintStatusLetter" />
                            <RadzenText Text="Receive Status Letters" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenButton Variant="Variant.Outlined" Icon="add" Text="Add Contact" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary"
                                      Text="Cancel" Click="CancelClicked" />
                        <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit"
                                      Text="Create Obligee and Load" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenTemplateForm>
    </ChildContent>
</RadzenPanel>


@code {
    [Parameter] public bool IsDialog { get; set; } = false;
    private List<State> AllStates { get; set; }
    private List<ObligeeTypeDm> ObligeeTypes { get; set; } = new List<ObligeeTypeDm>();

    private Obligee NewObligee { get; set; } = new Obligee()
    {
        PrintStatusLetter = true,
        Type = "Unknown",
        IdNavigation = new LegalEntity()
        {
            EntityType = "Obligee"
        }
    };

    private LegalEntityAddress LegalEntityAddress { get; set; } = new LegalEntityAddress()
        {
            Type = "Main"
        };
    private Address NewAddress { get; set; } = new Address();
    private PhoneNumber NewPhoneNumber { get; set; } = new PhoneNumber();
    private string? _newEmail;
    private string? NewEmail 
    { 
        get
        {
            return _newEmail;
        }
        set
        {
            _newEmail = value == "" ? null : value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadStates();
        await LoadObligeeTypes();
    }
    private async Task LoadStates()
    {
        var result = await DataAccess.GetAllStates();
        if (result.Errors.Any())
        {
            LoggingService.LogError("Error loading states.", result.Errors.ToString());
        }
        else
        {
            AllStates = result.Data;
        }
    }
    private async Task LoadObligeeTypes()
    {
        var result = await DataAccess.GetObligeeTypes();
        if (result.Errors.Any())
        {
            LoggingService.LogError("Error loading Obligee Types.", result.Errors.ToString());
        }
        else
        {
            ObligeeTypes = result.Data;
        }
    }
    private async Task CancelClicked()
    {
        if (IsDialog)
            DialogService.Close(null);
    }
    private async Task SubmitObligee(Obligee newObligee)
    {
        newObligee.Id = Guid.NewGuid();
        var result = await DataAccess.CreateObligee(newObligee.Id, newObligee.IdNavigation.FullName, "Public", newObligee.PrintStatusLetter,
        newObligee.Notes, NewAddress.Address1, NewAddress.Address2, NewAddress.City, NewAddress.StateCode, NewAddress.PostalCode,
        NewPhoneNumber.MainNumber.Replace("(", "").Replace(")", "").Replace("-", "").Replace(" ", ""), null);

        //TODO: Handle errors better.
        if (result.Errors.Any())
        {
            LoggingService.LogError("Error creating obligee", result.Errors.ToString());
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error when creating new Obligee.",
                    Duration = 5000,
                    CloseOnClick = true,
                    Payload = DateTime.Now
                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Successfully created new Obligee.",
                    Duration = 5000,
                    CloseOnClick = true,
                    Payload = DateTime.Now
                });

            //HACK: Need to make the CreateObligee call return the obligee number instead of pulling the data from another data call. 
            // var createdObligee = await DataAccess.GetObligeeById(newObligee.Id);
            if (IsDialog)
            {
                DialogService.Close(result.Data);
            }
            else
            {
                NavigationManager.NavigateTo("/Obligee/" + result.Data.ObligeeNum);
            }
        }
    }
}
