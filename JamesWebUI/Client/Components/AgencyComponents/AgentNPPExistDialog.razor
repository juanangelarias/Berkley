@inherits JamesLayoutComponentBase

@inject IJSRuntime JSRuntime

<RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
    <RadzenText Text="An existent Agent with the same NPP already exists."/>
    <RadzenRow Visible="@ExistentAgent.Active" class="rz-mt-4 rz-mb-0 rz-pb-0" JustifyContent="JustifyContent.Center">
        <RadzenText TextStyle="TextStyle.Subtitle1">
            @((MarkupString)"The existent Agent is active in the agency<br>")
        </RadzenText>
    </RadzenRow>
    <RadzenRow Visible="@ExistentAgent.Active" class="rz-mt-0 rz-pt-0 rz-mb-4" JustifyContent="JustifyContent.Center">
        <RadzenLink Text="@ExistentAgent.AgencyName" Target="_blank" tabindex="-1"
                    Path=@($"/agency/{ExistentAgent.AgencyNum}?tabsAgencyProfile=tabAgents")/>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
        <RadzenPanel Text="Proposed Agent" class="rz-w-50">
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Name:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ProposedAgent.FullName"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="NPN:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ProposedAgent.NationalProducerNumber"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Email"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ProposedAgent.Email"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Phone Number:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ProposedAgent.PhoneNumber"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Extension:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ProposedAgent.Extension"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="AIF:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenCheckBox TValue="bool" Value="@ProposedAgent.AIF" ReadOnly="true"/>
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
        <RadzenPanel Text="Existent Agent" class="rz-w-50">
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Name:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ExistentAgent.FullName"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="NPN:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ExistentAgent.NationalProducerNumber"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Email"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ExistentAgent.Email"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Phone Number:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ExistentAgent.PhoneNumber"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="Extension:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenText Text="@ExistentAgent.Extension"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenText Text="AIF:"/>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenCheckBox TValue="bool" Value="@ExistentAgent.AIF" ReadOnly="true"/>
                </RadzenColumn>
            </RadzenRow>
        </RadzenPanel>
    </RadzenStack>
    <RadzenRow class="rz-mt-5" visible="@(!ExistentAgent.Active)">
        <RadzenText TextAlign="TextAlign.Center" class="rz-w-100">
            @GetMessage()
        </RadzenText>
    </RadzenRow>
    <RadzenRow Gap="1rem" Visible="@(!ExistentAgent.Active)" class="rz-mt-3" JustifyContent="JustifyContent.Center">
        <RadzenButton Icon="" Text="Associate" ButtonStyle="ButtonStyle.Success" Click="@Associate"
                      Style="width: 150px"/>
        <RadzenButton Icon="cancel" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel"
                      Style="width: 150px"/>
    </RadzenRow>
    <RadzenRow Gap="1rem" Visible="@ExistentAgent.Active" class="rz-mt-3" JustifyContent="JustifyContent.Center">
        <RadzenButton Icon="double_arrow" Text="Transfer" ButtonStyle="ButtonStyle.Success" Click="@Transfer"
                      Style="width: 150px"/>
        <RadzenButton Icon="cancel" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel"
                      Style="width: 150px"/>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public required AgencyAgentDto ExistentAgent { get; set; }
    [Parameter, EditorRequired] public required AgencyAgentDto ProposedAgent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private MarkupString GetMessage()
    {
        var message = $"<p style=\"color: var(--rz-info)\">The selected agent is not currently linked to an agency.</p>" +
                      $"Would you like to activate <strong>{ProposedAgent.FullName}</strong> under " +
                      $"<strong>{ProposedAgent.AgencyName}</strong>?";

        return (MarkupString)message;
    }

    private void Associate()
    {
        DialogService.Close("associate");
    }

    private void Transfer(MouseEventArgs arg)
    {
        DialogService.Close("transfer");
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }

}