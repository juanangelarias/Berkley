@using James.Shared.Imaging

@inherits JamesLayoutComponentBase
@inject IDataAccess DataAccess

<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenFieldset Text="General Information">
                <RadzenRow JustifyContent="JustifyContent.End">
                    <RadzenColumn Size="4">
                        <JamesFormField Text="Year Started" AllowFloatingLabel="false" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)">
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.YearOpened" Disabled="@(!MasterEditMode && !GenInfoEditMode)" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <JamesFormField Text="Curr. Mgt Year" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.CurrentManagementYear" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Visible="!GenInfoEditMode" Click="@(() => GenInfoEditMode = true)" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        <RadzenButton Icon="save" Variant="Variant.Text" Size="ButtonSize.Small" Visible="GenInfoEditMode" Click="SaveGenInfoChanges" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        <RadzenButton Icon="cancel" Variant="Variant.Text" Size="ButtonSize.Small" Visible="GenInfoEditMode" Click="() => GenInfoEditMode = false" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="4">
                        <JamesFormField Text="Business Class" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.BusinessTypeClass" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <JamesFormField Text="Business Type" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.BusinessType" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <JamesFormField Text="Prior Surety" AllowFloatingLabel="false" >
                        <RadzenTextBox @bind-Value="@AccountToDisplay!.PriorSuretyCompany" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                    </JamesFormField>
                </RadzenRow>
                <RadzenRow>
                    <JamesFormField Text="Est. Annual Premium" AllowFloatingLabel="false" >
                        <RadzenTextBox Value="Placeholder" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                    </JamesFormField>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="Systems">
                <RadzenRow JustifyContent="JustifyContent.End">
                    <RadzenColumn Size="10">
                        <JamesFormField Text="Estimating System" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.EstimatingSystem" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Visible="!SystemsEditMode" Click="@(() => SystemsEditMode = true)" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        <RadzenButton Icon="save" Variant="Variant.Text" Size="ButtonSize.Small" Visible="SystemsEditMode" Click="SaveSystemsChanges" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        <RadzenButton Icon="cancel" Variant="Variant.Text" Size="ButtonSize.Small" Visible="SystemsEditMode" Click="() => SystemsEditMode = false" 
                                      Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <JamesFormField Text="Estimating Sign-Off" AllowFloatingLabel="false" >
                        <RadzenTextBox @bind-Value="@AccountToDisplay!.EstimatingSignoff" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                    </JamesFormField>
                </RadzenRow>
                <RadzenRow>
                    <JamesFormField Text="Internal Accounting System" AllowFloatingLabel="false" >
                        <RadzenTextBox @bind-Value="@AccountToDisplay!.AccountingSystem" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                    </JamesFormField>
                </RadzenRow>
                <RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenCheckBox Name="chkInterimWIPs" @bind-Value="@AccountToDisplay!.InterimWips" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                        <RadzenLabel Text="Can Create Interim WIPs" Component="chkInterimWIPs" />
                    </RadzenStack>
                </RadzenRow>
                <RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenCheckBox Name="chkInterimPOCs" @bind-Value="@AccountToDisplay!.Pocinterims" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)" />
                        <RadzenLabel Text="Can Create POC Interims" Component="chkInterimPOCs" />
                    </RadzenStack>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="Credit Report">
                <RadzenRow>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Credit Report" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.CreditReport" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Report Date" AllowFloatingLabel="false" >
                            <RadzenDatePicker ShowTime="false" TValue="DateOnly?" @bind-Value="@AccountToDisplay!.DunBradstreetDate" 
                                              Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Rating" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.DunBradstreetRate" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3" Visible="@(null!=AccountToDisplay)" Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)">
                        <InlineImagingDocument DocumentShortName="Current Credit Report"
                                               DocumentCategory="ImagingDocumentCategory.Account"
                                               DocumentId="@AccountToDisplay?.CreditReportImagingId"
                                               DocumentType="CBR"
                                               LinkableDocumentTypes="CBR,AEXPNR,AOCRPT,AEQFXR"
                                               ImagingId="@AccountToDisplay?.AccountNum"
                                               UploadAction="@(async void (guid) => await CreditReportUploaded(guid, AccountToDisplay?.AccountNum ?? ""))"
                                               UploadErrorAction=@(msg=>LogUploadError(msg))/>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="SIC Code" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.DunBradstreetSic" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn>
                        <JamesFormField Text="SIC Name" AllowFloatingLabel="false" >
                            <RadzenTextBox Placeholder="SIC Name"   
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Paydex/Intelliscore" AllowFloatingLabel="false" >
                            <RadzenNumeric @bind-Value="@AccountToDisplay!.PaydexIntelliscore" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="NAICS" AllowFloatingLabel="false" >
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.Naics" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn>
                        <JamesFormField Text="NAICS Name" AllowFloatingLabel="false" >
                            <RadzenTextBox Placeholder="NAICS Name" 
                                           Disabled="@((!MasterEditMode && !GenInfoEditMode) || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="Job Mix">
                <RadzenRow>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Public" AllowFloatingLabel="false" Style="width: 95%;">
                            <RadzenNumeric TValue="double?" Format="###%" @bind-Value="@AccountToDisplay!.PublicPercent" 
                                           Disabled="@(!JobMixEditMode || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Private" AllowFloatingLabel="false" Style="width: 95%;">
                            <RadzenNumeric TValue="double?" Format="##%" @bind-Value="@AccountToDisplay!.PrivatePercent"  
                                           Disabled="@(!JobMixEditMode || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Subbed" AllowFloatingLabel="false" Style="width: 95%;">
                            <RadzenNumeric Format="p2" @bind-Value="@AccountToDisplay!.SubcontractPercent" 
                                           Disabled="@(!JobMixEditMode || Disabled)"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Visible="!JobMixEditMode" Click="@(() => JobMixEditMode = true)" 
                                      Disabled="@(Disabled)"/>
                        <RadzenButton Icon="save" Variant="Variant.Text" Size="ButtonSize.Small" Visible="JobMixEditMode" Click="SaveJobMixChanges" 
                                      Disabled="@(Disabled)"/>
                        <RadzenButton Icon="cancel" Variant="Variant.Text" Size="ButtonSize.Small" Visible="JobMixEditMode" Click="() => JobMixEditMode = false" 
                                      Disabled="@(Disabled)"/>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="4">
                        <JamesFormField Text="Sub Protection" AllowFloatingLabel="false" Style="width: 95%;">
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.SubcontractProtection" Disabled="!JobMixEditMode" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <JamesFormField Text="Geographic Spread of Work" AllowFloatingLabel="false" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="@AccountToDisplay!.GeographicSpread" Disabled="!JobMixEditMode" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenFieldset Text="Additional Information">
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenRow>
                        <RadzenText Text="Indemnity" />
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkFullIndemnity" Value="@AccountToDisplay?.IndemnityFull" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Full Indemnity" Component="chkFullIndemnity" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkCorporation" Value="@AccountToDisplay?.IndemnityCorp" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Corp." Component="chkCorporation" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkPersonal" Value="@AccountToDisplay?.IndemnityPerson" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Pers." Component="chkPersonal" />
                        </RadzenStack>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                <RadzenText Text="Continuity" Style="width:85%" />
                                <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Visible="!AddlInfoEditMode" Click="() => AddlInfoEditMode = true" 
                                              Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)"/>
                                <RadzenButton Icon="save" Variant="Variant.Text" Size="ButtonSize.Small" Visible="AddlInfoEditMode" Click="SaveAdditionalInformationChanges" 
                                              Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)"/>
                                <RadzenButton Icon="cancel" Variant="Variant.Text" Size="ButtonSize.Small" Visible="AddlInfoEditMode" Click="() => AddlInfoEditMode = false" 
                                              Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)"/>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkKeyManagementLifeInsurance" @bind-Value="@AccountToDisplay!.ContinuityKeyManagementLifeInsurance" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Key Management Life Insurance" Component="chkKeyManagement" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkManagementIncentives" @bind-Value="@AccountToDisplay!.ContinuityManagementIncentives" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Management Incentives" Component="chkManagementIncentives" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkFundedBuySell" @bind-Value="@AccountToDisplay!.ContinuityFundedBuySell" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Funded Buy/Sell" Component="chkFundedBuySell" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkActiveMultipleOwners" @bind-Value="@AccountToDisplay!.ContinuityActiveMultipleOwners" Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Active Multiple Owners/Indemnitors" Component="chkActiveMultipleOwners" />
                        </RadzenStack>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenText Text="More" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkTrackCommAccount" TValue="bool" 
                                            Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Track Comm. Acct." Component="chkTrackCommAccount" />
                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenCheckBox Name="chkBerkleyAffiliate" @bind-Value="@AccountToDisplay!.BerkleyAffiliate" 
                                            Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                            <RadzenLabel Text="Berkley Affiliate" Component="chkBerkleyAffiliate" />
                        </RadzenStack>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Comments" AllowFloatingLabel="true" Variant="Variant.Outlined">
                        <RadzenTextArea Rows="3" Style="width: 95%" @bind-Value="@AccountToDisplay!.IndemnityComments" 
                                        Disabled="@((!MasterEditMode && !AddlInfoEditMode) || Disabled)" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="LOA Summary">
            <RadzenRow>
                <RadzenColumn Size="3">

                </RadzenColumn>
                <RadzenColumn Size="3">
                    Single
                </RadzenColumn>
                <RadzenColumn Size="3">
                    Aggregate
                </RadzenColumn>
                <RadzenColumn Size="3">
                    Expiration
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    Contract LOA
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenNumeric Value="@inforceLOAs.ContractLOA?.Loasingle" Format="c0" Style="width: 95%" Disabled="true" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenNumeric Value="@inforceLOAs.ContractLOA?.Loaaggregate" Format="c0" Style="width: 95%" Disabled="true"/>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenTextBox Value="@(inforceLOAs.ContractLOA?.Expiration.ToShortDateString())"
                                   Style="@($"width: 95%; background-color: {(inforceLOAs.ContractLOA?.Expiration < DateTime.Today ? "yellow": "white")}")" Disabled="true" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    Commercial LOA
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenNumeric Value="@inforceLOAs.CommercialLOA?.Loasingle" Format="c0" Style="width: 95%" Disabled="true" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenNumeric Value="@inforceLOAs.CommercialLOA?.Loaaggregate" Format="c0" Style="width: 95%" Disabled="true" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenTextBox Value="@(inforceLOAs.CommercialLOA?.Expiration.ToShortDateString())"
                                   Style="@($"width: 95%; background-color: {(@inforceLOAs.CommercialLOA?.Expiration < DateTime.Today ? "yellow": "white")}")" Disabled="true" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenText Text="Notes: Yellow labels indicate the LOA is Expired. Red labels indicate LOA is not approved." />
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="Most Recent Cost to Complete">
            <RadzenRow>
                <JamesFormField Text="Cost to Complete" AllowFloatingLabel="false" >
                    <RadzenTextBox Placeholder="Placeholder" Disabled="@(Disabled)"/>
                </JamesFormField>
            </RadzenRow>
            <RadzenRow>
                <JamesFormField Text="As of" AllowFloatingLabel="false" >
                    <RadzenTextBox Placeholder="Placeholder" Disabled="@(Disabled)"/>
                </JamesFormField>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="Tax Basis and Business Structure">
            <RadzenRow>
                <RadzenColumn>
                    <JamesFormField Text="Tax Basis" AllowFloatingLabel="false">
                        <RadzenDropDown TValue="string" Value="@AccountToDisplay?.TaxBasis" 
                                        Disabled="@(Disabled)"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn>
                    <JamesFormField Text="Business Structure" AllowFloatingLabel="false">
                        <RadzenDropDown TValue="string" Placeholder="placeholder" 
                                        Disabled="@(Disabled)"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public Account? AccountToDisplay { get; set; }
    public InforceAccountLOA inforceLOAs { get; set; } = new InforceAccountLOA()
        {
            ContractLOA = new LineOfAuthorityLog(),
            CommercialLOA = new LineOfAuthorityLog()
        };

    private bool MasterEditMode { get; set; } = false;
    private bool GenInfoEditMode { get; set; }
    private bool AddlInfoEditMode { get; set; }
    private bool SystemsEditMode { get; set; }
    private bool JobMixEditMode {get;set;}
    private bool Disabled => AccountToDisplay == null;
    
    private IDataAccessResult<InforceAccountLOA> _inforceLOAResult = null!;

    private LoadItem InforceLOALoad => AddEventNotify(new LoadItem<InforceAccountLOA>
        {
            Key = $"GetInforceLOAs{AccountToDisplay?.AccountNum}",
            AsyncLoadTask = async () => { _inforceLOAResult = await DataAccess.GetInforceAccountLOAsByAccountNumber(AccountToDisplay?.AccountNum ?? ""); },
            CacheLoadTask = cache => _inforceLOAResult = new DataAccessResult<InforceAccountLOA>
            {
                Data = (InforceAccountLOA)cache!
            },
            ResultVariable = () => _inforceLOAResult,
            AfterLoad = () => { inforceLOAs = _inforceLOAResult.Data!; }
        }, $"inforce LOAs");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (AccountToDisplay != null)
        {
            await LoadInforceLOAs();
        }
    }

    private async Task SaveGenInfoChanges()
    {
        try
        {
            //TODO: Handle Est. Annual Premium
            var result = await DataAccess.SetAccountGeneralInfo(AccountToDisplay?.Id ?? Guid.Empty, AccountToDisplay?.YearOpened, AccountToDisplay?.CurrentManagementYear, 
                AccountToDisplay?.BusinessTypeClass, AccountToDisplay?.BusinessType, AccountToDisplay?.PriorSuretyCompany, null);

            if (result.Errors.Any())
            {
                NotifySaveError(result.Errors,"general information");
            }
            else
            {
                NotifySuccessfulSave("general information");
                GenInfoEditMode = !GenInfoEditMode;
            }
        }
        catch (Exception ex)
        {
            LoggingService.LogException(ex, "general information");
            NotifySaveError(["Error saving Account General Info changes."], "general information", false);
        }
    }

    private async Task SaveSystemsChanges()
    {
        try
        {
            var result = await DataAccess.SetAccountSystems(AccountToDisplay?.Id ?? Guid.Empty, AccountToDisplay?.EstimatingSystem, AccountToDisplay?.EstimatingSignoff,
                AccountToDisplay?.AccountingSystem, AccountToDisplay?.InterimWips, AccountToDisplay?.Pocinterims);

            if (result.Errors.Any())
            {
                NotifySaveError(result.Errors,"system changes");
            }
            else
            {
                NotifySuccessfulSave("system changes");
                SystemsEditMode = !SystemsEditMode;
            }
        }
        catch (Exception ex)
        {
            LoggingService.LogException(ex, "system changes");
            NotifySaveError(["Error saving Account Systems changes."],"system changes", false);
        }
    }

    private async Task SaveAdditionalInformationChanges()
    {
        try
        {
            //TODO: Deal with Track Comm Acct. Looks to be missing from DB.
            var result = await DataAccess.SetAccountAdditionalInformation(AccountToDisplay?.Id ?? Guid.Empty, AccountToDisplay?.IndemnityFull, 
                AccountToDisplay?.IndemnityCorp, AccountToDisplay?.IndemnityPerson, AccountToDisplay?.ContinuityKeyManagementLifeInsurance, 
                AccountToDisplay?.ContinuityManagementIncentives, AccountToDisplay?.ContinuityFundedBuySell, AccountToDisplay?.ContinuityActiveMultipleOwners,
            false, AccountToDisplay?.BerkleyAffiliate, AccountToDisplay?.IndemnityComments);

            if (result.Errors.Any())
            {
                NotifySaveError(result.Errors, "additional information changes");
            }
            else
            {
                NotifySuccessfulSave("additional information changes");
                AddlInfoEditMode = !AddlInfoEditMode;
            }
        }
        catch (Exception ex)
        {
            LoggingService.LogException(ex,"additional information changes");
            NotifySaveError(["Error saving Account Additional Information changes."], "additional information changes", false);
        }
    }
    
    private async Task SaveJobMixChanges()
    {
        // ToDo: To be defined!
        
        await Task.Delay(500);
    }

    private async Task LoadInforceLOAs()
    {
        if (string.IsNullOrWhiteSpace(AccountToDisplay?.AccountNum))
            return;

        await DataAccess.GetCacheOrLoadDataAsync(InforceLOALoad);
    }

    private async Task CreditReportUploaded(Guid? documentId, string accountNum)
    {
        var saveResult = await DataAccess.SetAccountCreditReportDocumentLink(documentId, accountNum);
        if (saveResult.Success)
            NotifySuccessfulSave("Credit Report");
        else
            NotifySaveError(saveResult.Errors, "credit report");
    }

    private void LogUploadError(string message)
    {
        NotifySaveError([message], "credit report", false);
        
        LoggingService.LogError("Upload failed",
            "Uploading a credit report to imaging returned an error",
            "Imaging",
            data: new Dictionary<string, string>
            {
                { "Error Message", message },
                { "AccountNum", AccountToDisplay?.AccountNum ?? "" }
            });
    }
}
