@code {
    RadzenUpload uploadDD = null!;
    RadzenTextBox tbFilename = null!;

    string currentFileName = null!, DocumentType = "AEXPNR", ImagingId = "1005";

    Guid DocumentId = Guid.NewGuid();

    ImagingDocumentCategory DocumentCategory = ImagingDocumentCategory.Account;

    protected async Task ButtonClick(MouseEventArgs args)
    {
        if (currentFileName == null!) return;
        if (uploadDD.HasValue)
            await uploadDD.Upload();
        else
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "File not selected." });
    }

    private void UploadFileChanged(UploadChangeEventArgs ucea)
    {
        var file = ucea.Files.FirstOrDefault();
        if (null == file)
            currentFileName = null!;
        else
        {
            var uploadFileName = file.Name;
            var extension = Path.GetExtension(uploadFileName);
            currentFileName = Path.ChangeExtension($"FakeCreditReport{DocumentId.GetHashCode()}", extension);
            StateHasChanged();
        }

    }

    private void UploadComplete(UploadCompleteEventArgs args)
    {
        NotificationService.Notify(NotificationSeverity.Success, "Upload complete");
    }

    private void UploadErrorHandler(UploadErrorEventArgs args)
    {
        Debug.WriteLine(args.Message);
        NotificationService.Notify(NotificationSeverity.Error, args.Message);
    }
    private SiteUserInfo SiteUserInfo = null!;
