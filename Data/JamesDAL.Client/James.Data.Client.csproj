  <ItemGroup>
    <ProjectReference Include="..\..\Shared\James.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <GenerateGraphQLCodeItems Remove="GraphQL\Mutations\ObligeeMutations.graphql" />
  </ItemGroup>

  <ItemGroup>
