@using James.Shared.EnumTypes
@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess;

<RadzenRow JustifyContent="JustifyContent.End" Visible="@_selectTypeVisible">
    <RadzenFormField Text="Bond Type">
        <RadzenDropDown TValue="string" Data="@Types" Text="Type" @bind-Value="@SelectedType" Change="@OnTypeChanged"
                        class="rz-mb-3" Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
    </RadzenFormField>
</RadzenRow>
<RadzenRow Visible="@(SelectedType == AccountType.Commercial)">
    <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Rate Group">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.RateGroups" @bind-Value="@SelectedRateGroup"
                                Change="@OnCommercialFilterChanged" FilterAsYouType="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Rate Type">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.CommercialBondTypes"
                                @bind-Value="@SelectedBondType" Change="@OnCommercialFilterChanged"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                FilterAsYouType="true" AllowFiltering="true"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Risk Type">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.RiskTypes" @bind-Value="@SelectedRiskType"
                                Change="@OnCommercialFilterChanged" FilterAsYouType="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Visible="@(SelectedRateGroup != null && SelectedBondType != null && SelectedRiskType != null)">
        <RadzenText Text="Select Rate Group, Rate Type, and Risk Type"/>
    </RadzenRow>
    <RadzenRow>
        <RadzenDataGrid TItem="CommercialRate" Data="_commercialRates" @ref="@_commercialGrid" Density="Density.Compact"
                        Style="max-height: 235px; min-width: 440px;">
            <Columns>
                <RadzenDataGridColumn Title="Minimum" Width="125px" MaxWidth="125px" TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.MinumumAmount:C0}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Maximum" Property="MaximumAmount" Width="125px"
                                      TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.MaximumAmount:C0}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Rate" Property="AmountPerUnit" Width="125px" TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.AmountPerUnit:C0}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
</RadzenRow>
<RadzenRow Visible="@(SelectedType == AccountType.Contract)">
    <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Rate Group">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.RateGroups" @bind-Value="@SelectedRateGroup"
                                Change="@OnContractFilterChanged" FilterAsYouType="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Rate Class">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.RateClasses" @bind-Value="@SelectedRateClass"
                                Change="@OnContractFilterChanged" FilterAsYouType="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenFormField Text="Rate type">
                <RadzenDropDown TValue="string" Data="@RateAndCommission.RateTypes" @bind-Value="@SelectedRateType"
                                Change="@OnContractFilterChanged" FilterAsYouType="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Style="font-size: 0.75rem; height: 30px; max-width: 145px;"/>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Visible="@(SelectedRateGroup == null && SelectedRateClass == null && SelectedRateType == null)">
        <RadzenText Text="Select Rate Group, Class, and Type, and Risk Type"/>
    </RadzenRow>
    <RadzenRow>
        <RadzenDataGrid TItem="ContractRate" Data="_contractRates" @ref="@_contractGrid" Density="Density.Compact"
                        Style="max-height: 235px; min-width: 440px;">
            <Columns>
                <RadzenDataGridColumn Title="Minimum" Property="MinumumAmount" TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.MinumumAmount:C0}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Maximum" Property="MaximumAmount" TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.MaximumAmount:C0}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Premium Rate" Property="PremiumRate" TextAlign="TextAlign.Right">
                    <Template Context="rate">
                        <RadzenText Text="@($"{rate.PremiumRate:N4}")" TextAlign="TextAlign.Right"/>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
</RadzenRow>
<RadzenRow Style="margin-top: 1rem;" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
    <RadzenColumn Size="4">
        <RadzenFormField Text="Download" Style="width: 100%;">
            <RadzenDropDown TValue="string" Data="@_downloadDocumentType" @bind-Value="_downloadDocument"
                            Style="height: 30px; font-size: 0.75rem; width: 100%;"/>
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenButton Text="Download" Click="@(() => DownloadDocument())" Style="height: 30px; width: 100%;"
                      Disabled="@(string.IsNullOrEmpty(_downloadDocument))"/>
    </RadzenColumn>
</RadzenRow>

<style>
    .rz-dropdown-item, .rz-menuitem, .rz-autocomplete-list-item, .rz-multiselect-item, .rz-dropdown-items li, .rz-autocomplete-items li, .rz-multiselect-items li {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public string? InputType { get; set; }

    private AccountRateAndCommissionDto RateAndCommission { get; set; } = new();
    private RadzenDataGrid<CommercialRate> _commercialGrid = null!;
    private RadzenDataGrid<ContractRate> _contractGrid = null!;
    private bool _selectTypeVisible;
    private List<string> Types = AccountType.GetList();
    private string? SelectedType { get; set; }
    private string? SelectedRateGroup { get; set; }
    private string? SelectedBondType { get; set; }
    private string? SelectedRiskType { get; set; }
    private string? SelectedRateClass { get; set; }
    private string? SelectedRateType { get; set; }
    private List<CommercialRate> _commercialRates = [];
    private List<ContractRate> _contractRates = [];
    private List<string> _downloadDocumentType = ["Blank worksheet", "Rates worksheet"];
    private string _downloadDocument = "";

    #region Loaders

    #region RiskCommission Load

    private IDataAccessResult<AccountRateAndCommissionDto> _riskCommissionResult = null!;

    private LoadItem RiskCommissionLoad => AddEventNotify(new LoadItem<AccountRateAndCommissionDto>
    {
        Key = CacheKeys.RiskCommission,
        AsyncLoadTask = async () => _riskCommissionResult = await DataAccess.GetAccountRiskAndCommissions(),
        CacheLoadTask = cache => _riskCommissionResult = new DataAccessResult<AccountRateAndCommissionDto>
        {
            Data = (AccountRateAndCommissionDto)cache!
        },
        ResultVariable = () => _riskCommissionResult,
        AfterLoad = () => { RateAndCommission = _riskCommissionResult.Data!; }
    }, "account risk and commissions");

    #endregion

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await DataAccess.GetCacheOrLoadDataAsync(RiskCommissionLoad);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var validInput = Types.Contains(InputType ?? "");
        _selectTypeVisible = !validInput;
        SelectedType = validInput ? InputType : null;

        StateHasChanged();
    }

    private void OnTypeChanged()
    {
        if (SelectedType == AccountType.Commercial)
            OnCommercialFilterChanged();

        if (SelectedType == AccountType.Contract)
            OnContractFilterChanged();
    }

    private void OnCommercialFilterChanged()
    {
        _commercialRates = SelectedRateGroup == null || SelectedBondType == null || SelectedRiskType == null
            ? []
            : RateAndCommission.CommercialRates
                .Where(r => string.Equals(r.RateGroup.Trim(), SelectedRateGroup.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
                            string.Equals(r.CommercialBondType.Trim(), SelectedBondType.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
                            string.Equals(r.RiskType.Trim(), SelectedRiskType.Trim(), StringComparison.CurrentCultureIgnoreCase))
                .OrderBy(o => o.RateGroup)
                .ThenBy(t1 => t1.CommercialBondType)
                .ThenBy(t2 => t2.RiskType)
                .ThenBy(t3 => t3.MinumumAmount)
                .ToList();

        _commercialGrid.Reload();
    }

    private void OnContractFilterChanged()
    {
        _contractRates = SelectedRateGroup == null || SelectedRateClass == null || SelectedRateType == null
            ? []
            : RateAndCommission.ContractRates
                .Where(r => string.Equals(r.RateGroup.Trim(), SelectedRateGroup.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
                            string.Equals(r.Class.Trim(), SelectedRateClass.Trim(), StringComparison.CurrentCultureIgnoreCase) &&
                            string.Equals(r.RateType.Trim(), SelectedRateType.Trim(), StringComparison.CurrentCultureIgnoreCase)
                )
                .OrderBy(o => o.RateGroup)
                .ThenBy(t1 => t1.Class)
                .ThenBy(t2 => t2.RateType)
                .ThenBy(t3 => t3.MinumumAmount)
                .ToList();

        _contractGrid.Reload();
    }

    private void DownloadDocument()
    {
        switch (_downloadDocument)
        {
            case "Blank worksheet":
                DialogService.Alert("Coming soon!", "Blank worksheet download");
                break;
            case "Rates worksheet":
                DialogService.Alert("Coming soon!", "Rates worksheet download");
                break;
        }
    }
}