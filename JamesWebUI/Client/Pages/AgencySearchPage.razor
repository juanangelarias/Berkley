@page "/AgencySearch"

@using James.Data.Client.GraphQL;
@using James.Data.Client.GraphQL.Components;
@using James.Shared
@using StrawberryShake;
@using SearchOptions = James.Shared.Model.SearchOptions

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess
@inject ILoggingService _logging;
@inject AuthenticationStateProvider _context;
@* @attribute [Authorize] *@

<Theme />


<PageTitle>Agency Profile</PageTitle>

<RadzenLayout>
    <RadzenHeader>

    </RadzenHeader>
    <RadzenBody>
        <RadzenRow Gap="2" JustifyContent="JustifyContent.Right">
            <RadzenColumn Style="vertical-align: middle" Size="1">
                <RadzenLabel Text="Search by:" Component="txtSearch"></RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox Placeholder="Agency/Producer No." Name="txtSearch" Style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenTextBox Placeholder="Name" Style="width: 100%" @ref="@_txtAgencyNameSearch" Change="@OnAgencySearchChange" />
                @* <RadzenAutoComplete @ref="@txtAgencyNameSearch" Placeholder="Name" Style="width: 100%;" ValueChanged="@OnAgencySearchChange" FilterDelay="200" /> *@
            </RadzenColumn>
            <RadzenColumn Style="vertical-align: middle">
                <RadzenButton Icon="search" Size="ButtonSize.Small" Click="SearchAgencies" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Create New Agency" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow RowGap="2" JustifyContent="JustifyContent.Center">
            @{
                if (!String.IsNullOrWhiteSpace(_txtAgencyNameSearch?.Value))
                {
                    <RadzenColumn Size="10">
                        <UseSearchAgencies SearchString="@_agencySearchString" Context="agencyResults" Strategy="ExecutionStrategy.CacheFirst">
                            <ChildContent>
                                <RadzenDataGrid style="border-radius: 20px;" AllowSorting="true" Density="Density.Compact" @ref="AgencyResultsGrid"
                                                AllowVirtualization="false" AllowPaging="true" PageSize="10" PagerPosition="PagerPosition.Bottom"
                                                AllowColumnReorder="true" RowDoubleClick="OpenAgency"
                                                AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                Data="@agencyResults.SearchAgencies" TItem="ISearchAgencies_SearchAgencies">
                                    <Columns>
                                        <RadzenDataGridColumn Width="150px" Filterable="true"
                                                              TItem="ISearchAgencies_SearchAgencies" Property="AgencyNumber" Title="Agency #" />
                                        <RadzenDataGridColumn Filterable="true"
                                                              TItem="ISearchAgencies_SearchAgencies" Property="IdNavigation.FullName" Title="Name" />
                                        <RadzenDataGridColumn Filterable="true"
                                                              TItem="ISearchAgencies_SearchAgencies" Title="City">
                                            <Template Context="agency">
                                                @(agency?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address.City + ", " + agency?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address.StateCode)
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="150px" Type="typeof(IEnumerable<String>)"
                                                              Filterable="true" FilterValue="@BranchFilter" FilterProperty="Branch" FilterOperator="FilterOperator.Contains"
                                                              TItem="ISearchAgencies_SearchAgencies" Property="Branch" Title="Branch">
                                            <FilterTemplate>
                                                <RadzenDropDown @bind-Value="@BranchFilter" TValue="List<String>" Change="BranchFilterChange"
                                                                Multiple="true" Data="@agencyResults.SearchAgencies.OrderBy(a => a.Branch).GroupBy(a => a.Branch).Select(a => a?.FirstOrDefault()?.Branch).ToList()" />
                                            </FilterTemplate>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="200px" Type="typeof(IEnumerable<String>)"
                                                              Filterable="true" FilterValue="@StatusFilter" FilterProperty="Status" FilterOperator="FilterOperator.Contains"
                                                              TItem="ISearchAgencies_SearchAgencies" Property="Status" Title="Status">
                                            <Template Context="agency">
                                                @{
                                                    if (agency.Status == "Active")
                                                    {
                                                        <RadzenIcon Icon="check_circle" IconColor="@Colors.Success" />
                                                    }
                                                    else
                                                    {
                                                        <RadzenIcon Icon="cancel" IconColor="@Colors.Danger" />
                                                    }
                                                }
                                                @agency.Status
                                            </Template>
                                            <FilterTemplate>
                                                <RadzenDropDown @bind-Value="@StatusFilter" TValue="List<String>" Change="StatusFilterChange"
                                                                Multiple="true" Data="@agencyResults.SearchAgencies.OrderBy(a => a.Status).GroupBy(a => a.Status).Select(a => a?.FirstOrDefault()?.Status).ToList()" />
                                            </FilterTemplate>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </ChildContent>
                            <LoadingContent>
                                Loading...
                            </LoadingContent>
                        </UseSearchAgencies>
                    </RadzenColumn>
                }
            }

        </RadzenRow>
    </RadzenBody>
</RadzenLayout>


@code {
    string[] _dropDownValues = { "Test1", "Test2", "Test3" };

    //DropDown Data
    private IReadOnlyList<Agency> _agencyResults = null!;
    private RadzenTextBox _txtAgencyNameSearch = null!;
    private string _agencySearchString = null!;
    private readonly SearchOptions _searchOptions = new() {Agency=true};
    public ISearchAgencies_SearchAgencies SelectedAgency = null!;
    public List<string>? BranchFilter;
    public List<string>? StatusFilter;
    public RadzenDataGrid<ISearchAgencies_SearchAgencies> AgencyResultsGrid = null!;
    
    private IDataAccessResult<List<Agency>> _agenciesResult = null!;

    private LoadItem AgenciesLoad => AddEventNotify(new LoadItem
    {
        Key = "SearchAgencies",
        AsyncLoadTask = async () => _agenciesResult = await DataAccess.SearchAgencies(_txtAgencyNameSearch.Value, _searchOptions.ActiveOnly),
        CacheLoadTask = cache => _agenciesResult = new DataAccessResult<List<Agency>> { Data = (List<Agency>)cache! },
        ResultVariable = () => _agenciesResult,
        AfterLoad = () => { _agencyResults = _agenciesResult.Data!; },
        CacheDuration = TimeSpan.FromSeconds(1)
    }, "Search agencies");

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _logging.LogDebug("Initializing Agency Search Page", "AgencySearch.razor");//, data: new Dictionary<string, string>({ { "user", .User.Identity.Name } }));
        JamesThemeService.Initialize(NavigationManager);
    }
    
    private async Task SearchAgencies()
    {
        await DataCache.GetCacheOrLoadDataAsync(AgenciesLoad);
    }
    
    // async Task SearchAgencies(string searchString)
    // {
    //     var results = await DataAccess.SearchAgencies(searchString);
    //     if (results.Success)
    //         agencyResults = results.Data;
    //     else
    //     {
    //         //TODO:Add error details
    //         _logging.LogError("Error searching agencies in AgencySearch");
    //     }
    // }
    
    private async Task OpenAgency(DataGridRowMouseEventArgs<ISearchAgencies_SearchAgencies> args)
    {
        NavigationManager.NavigateTo("Agency/" + args.Data.AgencyNumber, true);
    }
    
    private async Task OnAgencySearchChange(dynamic args)
    {
        _agencySearchString = args;
        // await SearchAgencies(AgencySearchString);
    }
    
    private async Task BranchFilterChange()
    {
        await AgencyResultsGrid.Reload();
    }
    
    private async Task StatusFilterChange()
    {
        await AgencyResultsGrid.Reload();
    }
}

