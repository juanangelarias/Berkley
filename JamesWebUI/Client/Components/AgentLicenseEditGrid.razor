@page "/AgentLicenses/{agentId}"

@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<Theme />

<RadzenDataGrid TItem="AgencyLicense" @ref="_licenseGrid"
                EditMode="DataGridEditMode.Multiple" Density="Density.Compact"
                Data="_licenses">
    <HeaderTemplate>
        <RadzenButton Icon="edit" Text="Edit All" Click="EditAll" />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="License No." Width="125px">
            <Template Context="license">
                <RadzenText Text="@license.LicenseNumber" />
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="license.LicenseNumber" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Width="100px">
            <Template Context="license">
                <RadzenText Text="@license.State" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" Width="125px">
            <Template Context="license">
                <RadzenCheckBox Value="@license.IsResident" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" Width="125px">
            <Template Context="license">
                <RadzenCheckBox Value="@license.AppointingState" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer">
            <Template Context="license">
                <RadzenText Text="@license.Insurer.IdNavigation.FullName" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="Guid" Style="width:95%" Data="_insurers" TextProperty="IdNavigation.FullName" 
                                ValueProperty="Id" @bind-Value="@license.InsurerId" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public string AgentId { get; set; } = null!;
    private RadzenDataGrid<AgencyLicense> _licenseGrid = null!;
    private List<AgencyLicense> _licenses = [];
    private List<Insurer> _insurers = [];
    
    private IDataAccessResult<Agent> _agent = null!;
    private LoadItem AgentLoad => AddEventNotify(new LoadItem<Agent>
        {
            Key = $"Agent{AgentId}",
            AsyncLoadTask = async () => _agent = await DataAccess.GetAgent(Guid.Parse(AgentId)),
            CacheLoadTask = cache => _agent = new DataAccessResult<Agent>
            {
                Data = (Agent)cache!
            },
            ResultVariable = () => _agent,
            AfterLoad = void () =>
            {
                if (_agent.Success)
                    _licenses = _agent.Data?.AgencyLicenses.ToList() ?? [];
            }
        }, $"agent");

    private IDataAccessResult<List<Insurer>> _insurersResult = null!;
    private LoadItem InsurersLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = "Insurers",
        AsyncLoadTask = async () => _insurersResult = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurersResult = new DataAccessResult<List<Insurer>>
        {
            Data = (List<Insurer>)cache!
        },
        ResultVariable = () => _insurersResult,
        AfterLoad = void () =>
        {
            if (_insurersResult.Success)
                _insurers = _insurersResult.Data?.ToList() ?? [];
        }
    }, "insurers");
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadData();
    }

    private async Task LoadData()
    {
        LoadItem[] items =
        [
            AgentLoad,
            InsurersLoad
        ];

        await DataAccess.ParallelGetCacheOrDataAsync(items);
    }

    async Task EditAll()
    {
        await _licenseGrid.EditRows(_licenses);
    }
    
