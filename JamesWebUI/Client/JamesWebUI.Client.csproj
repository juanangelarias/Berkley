<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>	  
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
	<CompressionEnabled>false</CompressionEnabled>
	<NuGetAuditMode>all</NuGetAuditMode>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GraphQL\**" />
    <Content Remove="GraphQL\**" />
    <EmbeddedResource Remove="GraphQL\**" />
    <GraphQL Remove="GraphQL\**" />
    <None Remove="GraphQL\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Blazorise.Animate" Version="2.1.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Radzen.Blazor" Version="10.4.6" />
    <PackageReference Include="StrawberryShake.Blazor" Version="16.0.9" />
    <PackageReference Include="StrawberryShake.Transport.WebSockets" Version="16.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BusinessLogic\ClientBusinessLogic\ClientBusinessLogic.csproj" />
    <ProjectReference Include="..\..\Data\JamesDAL.Client\James.Data.Client.csproj" />
    <ProjectReference Include="..\..\Data\JamesDAL.Imaging\James.Data.Imaging.csproj" />
    <ProjectReference Include="..\..\Shared\James.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\img\" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="BsgComponents\BsgColumnHeader.razor" />
    <_ContentIncludedByDefault Remove="Components\BsgComponents\JamesColumnHeader.razor" />
    <_ContentIncludedByDefault Remove="Components\Notifications\NotificationPropertiesGrid.razor" />
    <_ContentIncludedByDefault Remove="Components\GeneralUse\BusyDialog.razor" />
    <_ContentIncludedByDefault Remove="Components\GeneralUse\EventConsole.razor" />
  </ItemGroup>

</Project>
