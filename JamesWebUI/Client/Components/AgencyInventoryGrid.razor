@using System.Globalization;
@using James.Shared
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject IDataAccess _dataAccess
@inject ILoggingService _logging

<Theme />
<RenderModeBackground />

<RadzenDataGrid @ref="@inventoryGrid" TItem="AgencyInventory" Data="@agencyInventories"
                Style="border-radius: 20px; height: 400px;" Density="Density.Compact"
                EmptyText="No records to display" IsLoading="@isLoading"
                AllowSorting="true" AllowGrouping="true"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New Record" Variant="Variant.Text" Click="@InsertInventoryRow" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Date Sent" Property="Sent" FormatString="{0:d}"
                              Filterable="false" SortOrder="SortOrder.Descending" Width="200px" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Doc Type" Property="DocumentType" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Quantity" Property="Quantity"
                              Filterable="false" Width="125px" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Sent To" Property="Addressee" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Address" Property="Address.Address1" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="City" Property="Address.City"
                              Width="150px" />
        <RadzenDataGridColumn TItem="AgencyInventory" Title="State" Property="Address.StateCode"
                              Width="150px" />
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyId { get; set; }
    private RadzenDataGrid<AgencyInventory> inventoryGrid { get; set; }
    private List<AgencyInventory> agencyInventories { get; set; }
    private List<AgencyInventory> inventoriesToInsert { get; set; } = new List<AgencyInventory>();
    private bool isLoading { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadInventory();
    }

    private async Task LoadInventory()
    {
        await ShowLoading();
        var result = await _dataAccess.GetAgencyInventory(AgencyId);
        if (result.Success)
        {
            if (result.Data != null)
                agencyInventories = result.Data;
        }
        else
        {
            _logging.LogError("Error Getting Agency Inventory in the Agency Inventory Grid.", result.Errors.ToString());
        }
    }

    async Task InsertInventoryRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        var newInventory = new AgencyInventory();
        inventoriesToInsert.Add(newInventory);
        await inventoryGrid.InsertRow(newInventory);
    }

    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
}
