@using James.Shared.Constants
@using JamesWebUI.Client.Model

@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<Theme/>

@if (_isEditMode)
{
    <RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
        <RadzenTemplateForm TItem="AccountBasicInfoModel" Data="@_workAccount" @ref="@Form" Submit="@OnSave">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenText Style="height: 30px;"/>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenColumn Size="3">
                        <JamesFormField Text="Account No.">
                            <RadzenTextBox @bind-Value="@_workAccount.AccountNum" ReadOnly="true"/>
                            <RadzenRequiredValidator Text="Account No. is required"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <JamesFormField Text="Name">
                            <RadzenTextBox @bind-Value="@_workAccount.FullName"/>
                            <RadzenRequiredValidator Text="Name is required"/>
                            <RadzenLengthValidator Min="5" Max="255"
                                                   Text="The lenght should be between 5 and 255 characters"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="5">
                        <JamesFormField Text="Concerns/Watch">
                            <RadzenTextBox Value="@(_activeWatch?.WatchStatus ?? "None")" ReadOnly="true"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">

                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Underwriter" Style="width: 100%">
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains"
                                            AllowFiltering="true" Name="Underwriter"
                                            Data="@_underwritersLookup" TextProperty="@nameof(JamesLookup.Name)"
                                            ValueProperty="@nameof(JamesLookup.Id)"
                                            @bind-Value="@_workAccount.UnderwriterId"/>
                            <RadzenRequiredValidator Text="Underwriter is required" Component="Underwriter"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Branch" Style="width: 100%">
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains"
                                            AllowFiltering="true" Name="Branch" Data="@_branchesLookup"
                                            TextProperty="@nameof(JamesLookup.Label)"
                                            ValueProperty="@nameof(JamesLookup.Code)"
                                            @bind-Value="@_workAccount.Branch"/>
                            <RadzenRequiredValidator Text="Branch is required" Component="Branch"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <JamesFormField Text="HO Lead" Style="width: 100%">
                            <RadzenTextBox Value="HO Lead (TBD)" Name="HoLead"/>
                            <RadzenRequiredValidator Text="HO Lead is required" Component="HoLead"/>
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <JamesFormField Text="Division" Style="width: 100%">
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains"
                                            AllowFiltering="true" Name="Division" Data="@_divisionsLookup"
                                            TextProperty="@nameof(JamesLookup.Label)"
                                            ValueProperty="@nameof(JamesLookup.Code)"
                                            @bind-Value="@_workAccount.Division"/>
                            <RadzenRequiredValidator Text="Division is required" Component="Division"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <JamesFormField Text="SIC Code" Style="width: 100%">
                            <RadzenTextBox Value="SIC Code (TBD)" Name="SicCode"/>
                            <RadzenRequiredValidator Text="SIC Code is required" Component="SicCode"/>
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem" Visible="@(_isEditMode)">
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  ButtonType="ButtonType.Submit" Disabled="@(!Form.IsValid)"/>
                    <RadzenButton Text="Cancel" Icon="cancel" Click="OnCancel" ButtonStyle="ButtonStyle.Light"
                                  ButtonType="ButtonType.Reset"/>
                </RadzenRow>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}
else
{
    <RadzenCard Style="border-radius: 10px; width: 100%; height: 100%; overflow-x: scroll; white-space: nowrap;">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenRow JustifyContent="JustifyContent.End" Gap="1rem">
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                              Click="@ToggleEditMode" Style="height: 30px;"/>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                <RadzenColumn Size="3">
                    <JamesFormField Text="Account No.">
                        <RadzenTextBox Value="@Account.AccountNum" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="9">
                    <JamesFormField Text="Name">
                        <RadzenTextBox Value="@Account.IdNavigation.FullName" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenColumn Size="5">
                    <JamesFormField Text="Concerns/Watch">
                        <RadzenTextBox Value="@(_activeWatch?.WatchStatus ?? "None")" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenButton Text="Reason/Action Plan" ButtonStyle="@(GetButtonStyle())"
                                  Click="@ShowReasonAndActionPlan" Style="width: 100%"/>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <JamesFormField Text="Underwriter" Style="width: 100%">
                        <RadzenTextBox Value="@(UnderwriterName)" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <JamesFormField Text="Branch" Style="width: 100%">
                        <RadzenTextBox Value="@(BranchName)" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <JamesFormField Text="HO Lead" Style="width: 100%">
                        <RadzenTextBox Value="HO Lead (TBD)" Name="HoLead" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <JamesFormField Text="Division" Style="width: 100%">
                        <RadzenTextBox Value="@(DivisionName)" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <JamesFormField Text="SIC Code" Style="width: 100%">
                        <RadzenTextBox Value="SIC Code (TBD)" Name="SicCode" ReadOnly="true"/>
                    </JamesFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
}

@code {
    // ToDo Waiting for SicCode and HoLead to be added to the Account model

    [Parameter, EditorRequired] public required Account Account { get; set; }
    [Parameter, EditorRequired] public required EventCallback<string> OnAccountNameChange { get; set; }

    private RadzenTemplateForm<AccountBasicInfoModel> Form { get; set; } = null!;

    private bool _isEditMode;
    private AccountBasicInfoModel _workAccount = null!;
    private AccountWatch? _activeWatch;
    private List<JamesLookup> _underwritersLookup = [];
    private List<JamesLookup> _branchesLookup = [];
    private List<JamesLookup> _divisionsLookup = [];
    private List<WatchStatusDm> _watchStatuses = [];
    private List<AccountWatch> _accountWatches = [];

    private string UnderwriterName => _underwritersLookup.FirstOrDefault(f => f.Id == Account.UnderwriterId)?.Name ?? "";
    private string BranchName => _branchesLookup.FirstOrDefault(f => f.Code == Account.Branch)?.Label ?? "";
    private string DivisionName => _divisionsLookup.FirstOrDefault(f => f.Code == Account.Division)?.Label ?? "";

    #region Loaders

    #region AccountWatches

    private IDataAccessResult<List<AccountWatch>> _accountWatchesResult = null!;

    private LoadItem AccountWatchesLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.AccountWatches(Account.AccountNum),
        AsyncLoadTask = async () => _accountWatchesResult = await DataAccess.GetAccountWatches(Account.AccountNum),
        CacheLoadTask = cache => _accountWatchesResult = new DataAccessResult<List<AccountWatch>>
        {
            Data = (List<AccountWatch>)cache!
        },
        ResultVariable = () => _accountWatchesResult,
        AfterLoad = () => { _accountWatches = _accountWatchesResult.Data!; },
    }, "account watches");

    #endregion

    #region WatchStatuses

    private IDataAccessResult<List<WatchStatusDm>> _watchStatusesResult = null!;

    private LoadItem WatchStatusesLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.WatchStatuses,
        AsyncLoadTask = async () => _watchStatusesResult = await DataAccess.GetAllWatchStatuses(),
        CacheLoadTask = cache => _watchStatusesResult = new DataAccessResult<List<WatchStatusDm>>
        {
            Data = (List<WatchStatusDm>)cache!
        },
        ResultVariable = () => _watchStatusesResult,
        AfterLoad = () => { _watchStatuses = _watchStatusesResult.Data!; }
    }, "watch statuses");

    #endregion

    #region Branches

    private IDataAccessResult<List<Branch>> _branchesResult = null!;

    private LoadItem BranchesLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.Branches,
        AsyncLoadTask = async () => _branchesResult = await DataAccess.GetAllBranches(),
        CacheLoadTask = cache => _branchesResult = new DataAccessResult<List<Branch>>
        {
            Data = (List<Branch>)cache!
        },
        ResultVariable = () => _branchesResult,
        AfterLoad = () =>
        {
            _branchesLookup = _branchesResult.Data!
                .Select(s => new JamesLookup
                {
                    Id = s.Id,
                    Code = s.BranchKey,
                    Name = s.Name,
                })
                .ToList();
        }
    }, "branches");

    #endregion

    #region Divisions

    private IDataAccessResult<List<DivisionDm>> _divisionsResult = null!;

    private LoadItem DivisionsLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.Divisions,
        AsyncLoadTask = async () => _divisionsResult = await DataAccess.GetDivisions(),
        CacheLoadTask = cache => _divisionsResult = new DataAccessResult<List<DivisionDm>>
        {
            Data = (List<DivisionDm>)cache!
        },
        ResultVariable = () => _divisionsResult,
        AfterLoad = () =>
        {
            _divisionsLookup = _divisionsResult.Data!
                .Select(s => new JamesLookup
                {
                    Id = s.Id,
                    Code = s.DivisionCode,
                    Name = s.Division
                })
                .ToList();
        }
    }, "divisions");

    #endregion

    #region Underwriters

    private IDataAccessResult<List<Underwriter>> _underwritersResult = null!;

    private LoadItem UnderwritersLoad => AddEventNotify(new LoadItem
    {
        Key = CacheKeys.Underwriters,
        AsyncLoadTask = async () => _underwritersResult = await DataAccess.GetUnderwriters(),
        CacheLoadTask = cache => _underwritersResult = new DataAccessResult<List<Underwriter>>
        {
            Data = (List<Underwriter>)cache!
        },
        ResultVariable = () => _underwritersResult,
        AfterLoad = () =>
        {
            _underwritersLookup = _underwritersResult.Data!
                .Select(s => new JamesLookup
                {
                    Id = s.Id,
                    Code = s.IdNavigation.Initials,
                    Name = s.IdNavigation.FullName,
                })
                .ToList();
        }
    }, "underwriters");

    #endregion

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadLookups();
        _workAccount = CloneAccount();
    }

    private async Task LoadLookups()
    {
        await DataAccess.ParallelGetCacheOrDataAsync(BranchesLoad, DivisionsLoad, UnderwritersLoad, WatchStatusesLoad,
            AccountWatchesLoad);

        ReSortAccountWatches();
    }

    private void ReSortAccountWatches()
    {
        _accountWatches = _accountWatches
            .OrderByDescending(o => o.WatchDate)
            .ToList();

        _activeWatch = _accountWatches
            .FirstOrDefault();
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
    }

    private async Task ShowReasonAndActionPlan()
    {
        var options = new DialogOptions()
        {
            Resizable = false,
            Draggable = true,
            Width = "700px",
            Height = "550px",
            ShowClose = false,
            CloseDialogOnOverlayClick = false
        };

        var parameters = new Dictionary<string, object>
        {
            { "AccountNum", Account.AccountNum },
            { "AccountWatches", _accountWatches },
            { "WatchStatuses", _watchStatuses }
        };

        var response = await DialogService
            .OpenAsync<AccountWatchesDialog>("Account Watches and Concerns", parameters, options);

        _accountWatches.Clear();
        _accountWatches = (List<AccountWatch>)response;
        ReSortAccountWatches();

        StateHasChanged();
    }

    private ButtonStyle GetButtonStyle()
    {
        return _activeWatch?.WatchStatus switch
        {
            "None" => ButtonStyle.Success,
            "Concerns" => ButtonStyle.Warning,
            "Watch" => ButtonStyle.Danger,
            _ => ButtonStyle.Success
        };
    }

    private async Task OnSave(AccountBasicInfoModel account)
    {
        if (!Form.IsValid)
            return;

        var nameChanged = account.FullName != Account.IdNavigation.FullName;

        var response = await DataAccess
            .SetAccountCommercialInfo(Account.Id, _workAccount.FullName, _workAccount.UnderwriterId!.Value,
                _workAccount.Branch, _workAccount.Division, Guid.Empty, Guid.Empty);

        if (!response.Success)
        {
            NotifySaveError(response.Errors);
            return;
        }

        NotifySuccessfulSave("basic information");
        Account.IdNavigation.FullName = _workAccount.FullName;
        Account.UnderwriterId = _workAccount.UnderwriterId;
        Account.Branch = _workAccount.Branch;
        Account.Division = _workAccount.Division;
        // ToDo: Waiting for SicCode and HoLead to be added to the Account model
        //Account.SicCode = _workAccount.SicCode;
        //Account.HoLead = _workAccount.HoLead;

        if (nameChanged)
            await OnAccountNameChange.InvokeAsync(_workAccount.FullName);
        
        _isEditMode = false;
    }

    private void OnCancel()
    {
        _workAccount = CloneAccount();
        _isEditMode = false;
    }

    private AccountBasicInfoModel CloneAccount()
    {
        return new()
        {
            AccountNum = Account.AccountNum,
            Branch = Account.Branch,
            Division = Account.Division,
            FullName = Account.IdNavigation.FullName,
            HoLead = "",
            SicCode = "",
            UnderwriterId = Account.UnderwriterId
        };
    }

}