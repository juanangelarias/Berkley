@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme />

<RadzenDataGrid @ref="RelatedPartiesGrid" Data="RelatedParties" TItem="Agency"
                AllowSorting="true" AllowGrouping="true" AllowColumnPicking="true"
                Style="height: 400px; border-radius: 10px;" IsLoading="@_isLoading" FilterMode="FilterMode.Advanced">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <BsgExportGridToButton IsLoading="@_isLoading" ExportGrid="ExportGrid"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="Agency" Title="Agency #" Property="AgencyNumber" Width="100px" />
        <RadzenDataGridColumn TItem="Agency" Title="Agency Name" Property="IdNavigation.FullName" />
        <RadzenDataGridColumn TItem="Agency" Title="Address" Filterable="false"
                              Property="MainAddress.Address1">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address1
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Address2" Filterable="false"
                              Property="IdNavigation.MainAddress.Address2" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address2
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Address3" Filterable="false"
                              Property="IdNavigation.MainAddress.Address3" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.Address3
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="City"
                              Property="IdNavigation.MainAddress.City">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.City
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="State"
                              Property="IdNavigation.MainAddress.State">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.StateCode
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agency" Title="Zip Code"
                              Property="IdNavigation.MainAddress.PostalCode" Visible="false">
            <Template Context="relatedParty">
                @relatedParty.MainAddress?.PostalCode
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyId { get; set; }
    private List<Agency> RelatedParties { get; set; } = [];
    private RadzenDataGrid<Agency> RelatedPartiesGrid { get; set; } = null!;
    private bool _isLoading;
    private ExportFormat _defaultExportFormat;
    
    private IDataAccessResult<List<Agency>> _relatedPartiesResult = null!;

    private LoadItem RelatedPartiesLoad => AddEventNotify(new LoadItem
        {
            Key = $"RelatedParties{AgencyId}",
            AsyncLoadTask = async () => _relatedPartiesResult = await DataAccess.GetAgencyRelatedParties(AgencyId),
            CacheLoadTask = cache => _relatedPartiesResult = new DataAccessResult<List<Agency>>
            {
                Data = (List<Agency>)cache!
            },
            ResultVariable = () => _relatedPartiesResult,
            AfterLoad = () => { RelatedParties = _relatedPartiesResult.Data!; }
        }, "agency related parties");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadRelatedParties();
    }
    
    private async Task LoadRelatedParties()
    {
        if(AgencyId == Guid.Empty)
            return;
        
        await ShowLoading();

        await DataCache.GetCacheOrLoadDataAsync(RelatedPartiesLoad);
    }
    
    protected async Task ShowLoading()
    {
        _isLoading = true;

        await Task.Yield();

        _isLoading = false;
    }

    private void ExportGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("AgencyNumber", "AgencyNumber", "Number");
        substitutions.AddSubstitution("IdNavigation.FullName", "IdNavigation.FullName", "Agency");
        substitutions.AddSubstitution("MainAddress.Address1", "MainAddress.Address1", "Address");
        substitutions.AddSubstitution("MainAddress.Address2", "MainAddress.Address2", "Address2");
        substitutions.AddSubstitution("MainAddress.Address3", "MainAddress.Address3", "Address3");
        substitutions.AddSubstitution("MainAddress.City", "MainAddress.City", "City");
        substitutions.AddSubstitution("MainAddress.State", "MainAddress.StateCode", "State");
        substitutions.AddSubstitution("MainAddress.PostalCode", "MainAddress.PostalCode", "Zip");
        NavigationManager.NavigateTo(ExportDataGridUrl(RelatedPartiesGrid,
                $"/export/AgencyRelatedParties/{AgencyId}", format, substitutions),
            true);
    }
}
