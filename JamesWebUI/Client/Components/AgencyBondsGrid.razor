@using System.Globalization;
@using James.Shared;
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess  DataAccess

<Theme />

<RadzenDataGrid TItem="Bond" @ref="@agencyBondGrid" Data="@agencyBonds"
                AllowGrouping="true" AllowSorting="true" AllowColumnResize="true" AllowColumnPicking="true"
                Density="Density.Compact" Style="height: 400px; border-radius: 10px;" 
                AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                IsLoading="@isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <Columns>
        <RadzenDataGridColumn TItem="Bond" Filterable="true" FilterValue="@StatusFilter" FilterProperty="Status" FilterOperator="FilterOperator.Contains"
            Title="Status" Property="Status" Width="125px" Type="typeof(List<String>)">
            <Template Context="bond">
                @{
                    if (bond.Status.Trim() == "Open")
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success" />
                            <RadzenText Text="@bond.Status" />
                        </RadzenStack>

                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger" />
                            <RadzenText Text="@bond.Status" />
                        </RadzenStack>
                    }
                }
            </Template>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@StatusFilter" @ref="statusFilterDropDown" Change="StatusFilterChange"
                                TValue="List<String>" Multiple="true" AllowClear="true"
                                Data="@agencyBonds.Select(b => b.Status).Distinct().ToList()">
                    
                </RadzenDropDown>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Bond" Title="Bond No." Property="BondNumber" Width="100px" />
        <RadzenDataGridColumn TItem="Bond" Title="Account No." Property="AccountNumNavigation.AccountNum" Width="100px" />
        <RadzenDataGridColumn TItem="Bond" Title="Account Name" Property="AccountNumNavigation.IdNavigation.FullName" Width="150px" />
        <RadzenDataGridColumn TItem="Bond" Title="Bond Type" Property="BondType.BondType" Width="150px"
                              FilterValue="BondTypeFilter" FilterProperty="BondType.BondType" FilterOperator="FilterOperator.Contains" Type="typeof(List<String>)">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@BondTypeFilter" @ref="bondTypeFilterDropDown" Change="BondTypeFilterChange"
                    TValue="List<String>" Multiple="true" AllowClear="true" 
                    Data="@agencyBonds.Select(b=>b.BondType.BondType).Distinct().ToList()"/>
            </FilterTemplate>    
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Bond" Title="Begin Date" Property="Effective" FormatString="{0:d}" Width="175px" />
        <RadzenDataGridColumn TItem="Bond" Title="End Date" Property="Expiration" FormatString="{0:d}" Width="175px" SortOrder="SortOrder.Descending" />
        <RadzenDataGridColumn TItem="Bond" Title="UW" Property="UnderWriter.IdNavigation.FullName" Width="200px"/>
        <RadzenDataGridColumn TItem="Bond" Title="SIC" Property="Siccode" FormatString="{0:d}" Width="75px" />
        <RadzenDataGridColumn TItem="Bond" Title="Obligee" Property="Obligee.FullName"  Width="200px"/>
        <RadzenDataGridColumn TItem="Bond" Title="Municipality" Property="Municipality" FormatString="{0:d}" Width="200px" />
        <RadzenDataGridColumn TItem="Bond" Title="Class" Property="BondClass"
                              Filterable="true" FilterValue="@ClassFilter" FilterProperty="BondClass" FilterOperator="FilterOperator.Contains" Type="typeof(List<String>)"
            FormatString="{0:d}" Width="200px">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@ClassFilter" @ref="classFilterDropDown" Change="ClassFilterChange"
                                TValue="List<String>" Multiple="true" AllowClear="true"
                                Data="@agencyBonds.OrderBy(b =>b.BondClass).Select(b => b.BondClass).Distinct().ToList()">

                </RadzenDropDown>
            </FilterTemplate>    
        </RadzenDataGridColumn>


    </Columns>    
</RadzenDataGrid>


@code {
    [Parameter] public Guid AgencyId { get; set; }

    private List<Bond> agencyBonds = new List<Bond>();
    private RadzenDataGrid<Bond> agencyBondGrid;
    private bool isLoading = false;
    private List<String> StatusFilter = null;
    private List<String> ClassFilter = null;
    private List<String> BondTypeFilter = null;
    private RadzenDropDown<List<String>> statusFilterDropDown { get; set; }
    private RadzenDropDown<List<String>> classFilterDropDown { get; set; }
    private RadzenDropDown<List<String>> bondTypeFilterDropDown { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        await LoadAgencyBonds();
    }
    private async Task LoadAgencyBonds()
    {
        var result = await DataAccess.GetAgencyBonds(AgencyId);
        if (result.Success == false)
        {
            //TODO:Add error details
            LoggingService.LogError("Error loading agency bonds");
        }
        if (result.Data?.Any() == true)
        {
            agencyBonds = result.Data;
            await agencyBondGrid.Reload();
        }
    }
    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
    async Task StatusFilterChange()
    {
        if (StatusFilter != null && !StatusFilter.Any())
        {
            StatusFilter = null;
        }
        await agencyBondGrid.Reload();
    }
    async Task ClassFilterChange()
    {
        if (ClassFilter != null && !ClassFilter.Any())
        {
            ClassFilter = null;
        }
        await agencyBondGrid.Reload();
    }
    async Task BondTypeFilterChange()
    {
        if (BondTypeFilter != null && !BondTypeFilter.Any())
        {
            BondTypeFilter = null;
        }
        await agencyBondGrid.Reload();
    }
}
