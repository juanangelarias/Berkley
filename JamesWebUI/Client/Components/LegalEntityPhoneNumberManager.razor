@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenTabs TabPosition="TabPosition.Left" @bind-SelectedIndex="@SelectedTab" >
    <Tabs>
        @{
            if (AllPhoneNumbers.Any())
            {
                foreach (var a in AllPhoneNumbers)
                {
                    <RadzenTabsItem Text="@(a.LegalEntityPhone!.Type)">
                        <PhoneDisplay PhoneId="a.Id" StateChanged="@(() => LoadPhoneNumbers())" />
                    </RadzenTabsItem>
                    if (a == AllPhoneNumbers.Last())
                    {
                        <RadzenTabsItem Icon="add" Text="Add Phone">
                            <PhoneNumberCreate LegalEntityId="@LegalEntityId" PhoneNumberCreated="@PhoneNumberCreated" />
                        </RadzenTabsItem>
                    }

                }
            }
            else
            {
                <RadzenTabsItem Icon="add" Text="Add Phone">
                    <PhoneNumberCreate LegalEntityId="@LegalEntityId" PhoneNumberCreated="@PhoneNumberCreated" />
                </RadzenTabsItem>
            }
        }
    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public Guid LegalEntityId { get; set; }

    private List<PhoneNumber> AllPhoneNumbers {get;set;} = [];
    private int SelectedTab { get; set; }
    
    private IDataAccessResult<List<PhoneNumber>> _phoneNumbersResult = null!;

    private LoadItem PhoneNumbersLoad => AddEventNotify(new LoadItem
        {
            Key = $"PhoneNumbers{LegalEntityId}",
            AsyncLoadTask = async () => _phoneNumbersResult = await DataAccess.GetAllLegalEntityPhoneNumbers(LegalEntityId),
            CacheLoadTask = cache => _phoneNumbersResult = new DataAccessResult<List<PhoneNumber>>
            {
                Data = (List<PhoneNumber>)cache!
            },
            ResultVariable = () => _phoneNumbersResult,
            AfterLoad = () => { AllPhoneNumbers = _phoneNumbersResult.Data!; }
        }, "Phone numbers");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadPhoneNumbers();
    }

    private async Task LoadPhoneNumbers()
    {
        await DataCache.GetCacheOrLoadDataAsync(PhoneNumbersLoad);
    }

    private async Task PhoneNumberCreated(Guid phoneToSelect)
    {
        await LoadPhoneNumbers();
        
        var selected = AllPhoneNumbers.FirstOrDefault(a => a.Id == phoneToSelect);
        SelectedTab = null != selected 
            ? AllPhoneNumbers.IndexOf(selected) 
            : 0;
    }
}
