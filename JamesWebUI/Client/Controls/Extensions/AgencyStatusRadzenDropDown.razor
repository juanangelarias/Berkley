@using System.Globalization
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject JamesClient JamesClient

<UseGetAgencyStatuses Context="statusData">
    <ChildContent>
        <RadzenDropDown @rendermode="@InteractiveWebAssembly" Placeholder="Status"
                        Multiple="true" Chips="true" SelectAllText="Select All"
                        AllowFiltering="true" FilterOperator="StringFilterOperator.Contains" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        TValue="List<IGetAgencyStatuses_AgencyStatuses>" Data="statusData.AgencyStatuses.ToList()"
                        TextProperty="Status">
        </RadzenDropDown>
    </ChildContent>
    <ErrorContent>
        Something went wrong...<br />
    </ErrorContent>
    <LoadingContent>
        <RadzenDropDown Placeholder="Loading..." TValue="IGetAgencyStatuses_AgencyStatuses" />
    </LoadingContent>
</UseGetAgencyStatuses>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeService.Initialize(NavigationManager);
    }
}