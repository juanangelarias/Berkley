@using System.Globalization;
@using James.Shared
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject IDataAccess _dataAccess
@inject ILoggingService _logging

<Theme />
<RenderModeBackground />

<RadzenDataGrid @ref="@inventoryGrid" TItem="AgencyInventory" Data="@agencyInventories"
                Style="border-radius: 20px; height: 400px;" Density="Density.Compact"
                EmptyText="No records to display" IsLoading="@isLoading"
                AllowSorting="true" AllowGrouping="true" EditMode="DataGridEditMode.Single"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                RowUpdate="UpdateInventoryRow" RowCreate="CreateInventoryRow"
                Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New Record" Variant="Variant.Text" Click="@InsertInventoryRow" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Date Sent" Property="Sent" FormatString="{0:d}"
                              Filterable="false" SortOrder="SortOrder.Descending" Width="200px">
            <Template Context="inventory">
                <RadzenText Text="@(inventory?.Sent?.ToShortDateString())" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDatePicker ShowTime="false" @bind-Value="@inventory.Sent" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Doc Type" Property="DocumentType">
            <Template Context="inventory">
                <RadzenText Text="@inventory.DocumentType" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDropDown TValue="string" @bind-Value="@inventory.DocumentType" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Quantity" Property="Quantity"
                              Filterable="false" Width="125px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Quantity.ToString()" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenNumeric @bind-Value="@inventory.Quantity" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Sent To" Property="Addressee">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Addressee" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Addressee" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="Address" Property="Address.Address1">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address.Address1" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address.Address1" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="City" Property="Address.City"
                              Width="150px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address.City" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenTextBox @bind-Value="@inventory.Address.City" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyInventory" Title="State" Property="Address.StateCode"
                              Width="150px">
            <Template Context="inventory">
                <RadzenText Text="@inventory.Address.StateCode" />
            </Template>
            <EditTemplate Context="inventory">
                <RadzenDropDown TValue="string" @ref="stateDropDown" LoadData="LoadStateDropDown" @bind-Value="@inventory.Address.StateCode"
                                TextProperty="Name" ValueProperty="Code" Style="width:95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="75px" TItem="AgencyInventory" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="inventory">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditInventoryRow(inventory))" @onclick:stopPropagation="true">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteInventoryRow(inventory))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="inventory">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@((args) => SaveInventoryRow(inventory))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" class="my-1 ms-1" Click="@((args) => CancelInventoryEdit(inventory))">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteInventoryRow(inventory))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyId { get; set; }
    private RadzenDataGrid<AgencyInventory> inventoryGrid { get; set; }
    private List<AgencyInventory> agencyInventories { get; set; }
    private List<AgencyInventory> inventoriesToInsert { get; set; } = new List<AgencyInventory>();
    private bool isLoading { get; set; } = false;
    private RadzenDropDown<string> stateDropDown { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadInventory();
    }
    private async Task LoadStateDropDown()
    {
        var result = await _dataAccess.GetAllStates();
        if (result.Success == false)
            //UNDONE: Add actual errors as data
            _logging.LogError("Error getting all States in Agency License Grid");
        stateDropDown.Data = result.Data;
    }
    private async Task LoadInventory()
    {
        await ShowLoading();
        var result = await _dataAccess.GetAgencyInventory(AgencyId);
        if (result.Success)
        {
            if (result.Data != null)
                agencyInventories = result.Data;
        }
        else
        {
            _logging.LogError("Error Getting Agency Inventory in the Agency Inventory Grid.", result.Errors.ToString());
        }
    }
    async Task EditInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        await inventoryGrid.EditRow(inventory);
    }
    async Task DeleteInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        //TODO: Delete the row
        var result = await _dataAccess.DeleteAgencyInventory(inventory.Id);
        await LoadInventory();
    }
    async Task SaveInventoryRow(AgencyInventory inventory)
    {
        await ShowLoading();
        await inventoryGrid.UpdateRow(inventory);
        await LoadInventory();
    }
    async Task CancelInventoryEdit(AgencyInventory inventory)
    {
        await ShowLoading();
        inventoryGrid.CancelEditRow(inventory);
        await LoadInventory();
    }
    async Task InsertInventoryRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        var newInventory = new AgencyInventory();
        inventoriesToInsert.Add(newInventory);
        await inventoryGrid.InsertRow(newInventory);
    }
    async Task UpdateInventoryRow(AgencyInventory inventory)
    {
        //This is where the actual update is handled.
        var result = await _dataAccess.SetAgencyInventory(inventory.Id,
        inventory.Sent,
        inventory.Quantity,
        inventory.DocumentType,
        inventory.Addressee,
        inventory.Address.Id,
        inventory.Address.Address1,
        inventory.Address.Address2,
        inventory.Address.Address3,
        inventory.Address.City,
        inventory.Address.StateCode,
        inventory.Address.PostalCode);

    }
    async Task CreateInventoryRow()
    {
        //TODO: Make a 'create' mutation and implement it here.
    }
    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
}
