@page "/Account/{AccountNumber?}"

@inject IAccountState AccountState
@using JamesWebUI.Client.Model
@inherits JamesLayoutComponentBase

@attribute [Authorize]

<Theme/>

<PageTitle>BasisTNG - Account Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>

<RadzenColumn Size="12" Visible="@(!_isAccountLoaded)">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
            <RadzenColumn Size="4">
                <BusyDialog Message="Loading..."/>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
</RadzenColumn>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenPanel Style="border-radius: 10px;" class="rz-shadow=7">
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenLabel Text="View Type: " Style="font-size: small;"/>
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(AccountLayout)).Cast<Enum>())"
                                    @bind-Value="@AccountState.SelectedType"
                                    Text="Select View Type" Style="font-size: small; height: 35px;"/>
                </RadzenStack>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn Size="4">

                </RadzenColumn>
                <RadzenColumn Size="4">

                </RadzenColumn>
                <RadzenColumn Size="4">

                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
</RadzenStack>
<RadzenRow Style="width: 100%;">
    <RadzenColumn Size="12" Visible="@_isAccountLoaded">
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenRow JustifyContent="JustifyContent.End" Visible="@AccountState.IsUserManager">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <RadzenLabel Text="View Type: " Style="font-size: small;"/>
                    <RadzenDropDown Data="@(Enum.GetValues(typeof(AccountLayout)).Cast<Enum>())"
                                    @bind-Value="@AccountState.SelectedType"
                                    Text="Select View Type" Style="font-size: small; height: 35px;"/>
                </RadzenStack>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenPanel Style="border-radius: 20px; width: 100%;" class="rz-shadow-2">
                    <RadzenRow JustifyContent="JustifyContent.End" class="rz-text-align-center">
                        <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.DisplayH5"
                                        Text="@AccountState.Account?.IdNavigation.FullName"/>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <AccountSearch SetAccount="OnSetAccount"/>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End"
                                         JustifyContent="JustifyContent.End">
                                <RadzenText Text="Status: "/>
                                <RadzenText Text="Placeholder"/>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenPanel>
            </RadzenRow>
            <RadzenRow Style="width: 100%">
                @switch (AccountState.SelectedType)
                {
                    case AccountLayout.Commercial:
                        <AccountCommercial/>
                        break;
                    case AccountLayout.Contract:
                        <AccountContract/>
                        break;
                    case AccountLayout.Default:
                        <AccountDefault/>
                        break;
                    default:
                        <RadzenColumn span="12">
                            <RadzenRow>
                                <RadzenText Text="The user needs to be defined as Commercial or Contract user"
                                            TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center"/>
                            </RadzenRow>
                        </RadzenColumn>
                        break;
                }
            </RadzenRow>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public string? AccountNumber { get; set; }

    private bool _isAccountLoaded;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (string.IsNullOrEmpty(AccountNumber))
            return;

        AccountState.AccountNumber = AccountNumber;

        _isAccountLoaded = await AccountState.Initialize();
    }

    private async Task OnSetAccount(string arg)
    {
        AccountNumber = arg;
        AccountState.AccountNumber = arg;

        await AccountState.Initialize();
    }
}
