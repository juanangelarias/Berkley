@inherits JamesLayoutComponentBase
@inject IDataAccess DataAccess

<RadzenCard class="rz-mt-2" Style="width: 1280px; height: 770px; max-height: 770px;">
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenRow class="rz-mb-0 rz-pb-0">
                <RadzenText Text="Agency" TextStyle="TextStyle.Caption"/>
            </RadzenRow>
            <RadzenRow>
                <RadzenText Text="@AgencyName" Style="font-weight: bold;"/>
            </RadzenRow>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenRow class="rz-mb-0 rz-pb-0" JustifyContent="JustifyContent.Right">
                <RadzenText Text="Agent" TextStyle="TextStyle.Caption"/>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.Right">
                <RadzenText Text="@AgentName" Style="font-weight: bold;"/>
            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Style="height:650px; max-height: 650px; overflow-y: auto; width: 1270px; max-width: 1270px;">
        <RadzenDataGrid TItem="AgencyLicenseBulk" Data="@Licenses" ColumnWidth="125px" @ref="@Grid"
                        Style="border-radius: 10px; max-height: 640px; height: 640px; overflow-y: auto; width: 1260px; max-width: 1260px;"
                        EmptyText="No records to display" AllowColumnReorder="true" CellRender="@CellRender"
                        GridLines="DataGridGridLines.Vertical" AllowSorting="true" Density="Density.Compact" 
                        SelectionMode="DataGridSelectionMode.Multiple" AllowFiltering="false" AllowColumnResize="false"
                        EditMode="DataGridEditMode.Multiple" IsLoading="@IsLoading" Page="@ShowLoading" >
            <Columns>
                <RadzenDataGridColumn Width="50px" MinWidth="50px" TItem="AgencyLicenseBulk" Filterable="false"
                                      Sortable="false" TextAlign="TextAlign.Center" Frozen="true"
                                      FrozenPosition="FrozenColumnPosition.Left">
                    <EditTemplate Context="license">
                        <RadzenRow JustifyContent="JustifyContent.Center" Style="background-color: white">
                            <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Style="width:200px"
                                          Visible="license.Changed" Click="@(() => Revert(license))"
                                          Variant="Variant.Filled"/>
                        </RadzenRow>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="State" Type="typeof(IEnumerable<string>)"
                                      Property="State" Width="125px" FilterOperator="FilterOperator.Contains" 
                                      MinWidth="10px" TextAlign="TextAlign.Center">
                    <Template Context="license">
                        <RadzenText Text="@license.StateCode"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="Status" Property="IsActive" MinWidth="10px" 
                                      TextAlign="TextAlign.Center" Width="125px">
                    <EditTemplate Context="license">
                        <RadzenCheckBox @bind-Value="@license.IsActive" class="rz-success-lighter"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="No Aptmt" MinWidth="10px" 
                                      Property="AppointingState" TextAlign="TextAlign.Center" Width="125px">
                    <EditTemplate Context="license">
                        <RadzenCheckBox @bind-Value="license.AppointingState"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="License No." Property="LicenseNumber" 
                                      MinWidth="10px" Width="160px">
                    <EditTemplate Context="license">
                        <RadzenTextBox @bind-Value="license.LicenseNumber" Style="width:95%;"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="Resident" MinWidth="10px" Property="IsResident"
                                      TextAlign="TextAlign.Center" Width="125px">
                    <EditTemplate Context="license">
                        <RadzenCheckBox TValue="bool" @bind-Value="license.IsResident"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="Insurer" Property="Insurer" MinWidth="10px" 
                                      Width="350px">
                    <Template Context="license">
                        <RadzenText Text="@(GetInsurerName(license.InsurerId))"/>
                    </Template>
                    <EditTemplate Context="license">
                        <RadzenDropDown TValue="Guid?" Data="Insurers" Name="CmbInsurer" Style="width:95%;"
                                        TextProperty="IdNavigation.FullName" ValueProperty="Id"
                                        @bind-Value="@license.InsurerId"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="Appointment" Property="Appointment" 
                                      MinWidth="10px" Width="170px">
                    <EditTemplate Context="license">
                        <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Appointment"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicenseBulk" Title="Termination" Property="Termination" 
                                      MinWidth="10px" Width="170px">
                    <EditTemplate Context="license">
                        <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Termination"/>
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenRow>
    <RadzenRow JustifyContent="JustifyContent.Right" Gap="3rem" class="rz-mt-2">
        <RadzenButton Icon="cancel" Text="Cancel" ButtonStyle="ButtonStyle.Light" Style="width:200px"
                      Click="@Close"/>
        <RadzenButton Icon="restart_alt" Text="Reset All" ButtonStyle="ButtonStyle.Secondary" Style="width:200px"
                      Disabled="@(!Changed || IsLoading)" Click="@RevertAll"/>
        <RadzenButton Icon="check" Text="Submit Changes" ButtonStyle="ButtonStyle.Success" Style="width:200px"
                      Disabled="@(!Changed || IsLoading)" Click="@SubmitChanges"/>
    </RadzenRow></RadzenCard>

@code {
    [Parameter, EditorRequired] public Guid AgencyId { get; set; }
    [Parameter, EditorRequired] public string AgencyName { get; set; }
    [Parameter, EditorRequired] public Guid AgentId { get; set; }
    [Parameter, EditorRequired] public string AgentName { get; set; }

    private Dictionary<Guid, string> InsurerNames { get; set; } = [];
    private List<Insurer> Insurers { get; set; } = [];
    private List<State> States { get; set; } = [];
    private List<AgencyLicense> AgentLicenses { get; set; } = [];
    private List<AgencyLicenseBulk> Licenses { get; set; } = [];
    private RadzenDataGrid<AgencyLicenseBulk> Grid { get; set; } = null!;
    private bool Changed => Licenses.Any(l => l.Changed);

    #region Loaders

    #region Insurers Load

    private IDataAccessResult<List<Insurer>> _insurersResult = null!;

    private LoadItem InsurersLoad => AddEventNotify(new LoadItem<List<Insurer>>
    {
        Key = CacheKeys.Insurers,
        AsyncLoadTask = async () => _insurersResult = await DataAccess.GetAllInsurers(),
        CacheLoadTask = cache => _insurersResult = new DataAccessResult<List<Insurer>>
        {
            Data = (List<Insurer>)cache!
        },
        ResultVariable = () => _insurersResult,
        AfterLoad = () =>
        {
            InsurerNames = _insurersResult.Data!
                .ToDictionary(o => o.Id, o => o.IdNavigation.FullName);
            Insurers = _insurersResult.Data!
                .OrderBy(o => o.IdNavigation.FullName)
                .ToList();
        }
    }, "insurers");

    #endregion

    #region States Load

    private IDataAccessResult<List<State>> _statesResult = null!;

    private LoadItem StatesLoad => AddEventNotify(new LoadItem<List<State>>
    {
        Key = CacheKeys.States,
        AsyncLoadTask = async () => _statesResult = await DataAccess.GetAllStates(),
        CacheLoadTask = cache => _statesResult = new DataAccessResult<List<State>>
        {
            Data = (List<State>)cache!
        },
        ResultVariable = () => _statesResult,
        AfterLoad = () =>
        {
            States = _statesResult.Data!
                .OrderBy(s => s.Code)
                .ToList();
        }
    }, "states");

    #endregion

    #region Licenses Load

    private IDataAccessResult<List<AgencyLicense>> _licensesResult = null!;

    private LoadItem LicensesLoad => AddEventNotify(new LoadItem<List<AgencyLicense>>
    {
        Key = CacheKeys.AgencyAgentLicenses(AgencyId.ToString(), AgentId.ToString()),
        AsyncLoadTask = async () => _licensesResult = await DataAccess.GetAgencyAgentLicenses(AgencyId, AgentId),
        CacheLoadTask = cache => _licensesResult = new DataAccessResult<List<AgencyLicense>>
        {
            Data = (List<AgencyLicense>)cache!
        },
        ResultVariable = () => _licensesResult,
        AfterLoad = () => { AgentLicenses = _licensesResult.Data!; }
    }, "agency agent licenses");

    #endregion

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await ShowLoading();

        await DataAccess.ParallelGetCacheOrDataAsync(InsurersLoad, StatesLoad);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        DataAccess.Clear(CacheKeys.AgencyAgentLicenses(AgencyId.ToString(), AgentId.ToString()));
        await DataAccess.GetCacheOrLoadDataAsync(LicensesLoad);

        Licenses = [];
        var controlId = 0;
        foreach (var state in States)
        {
            controlId++;
            var license = AgentLicenses.FirstOrDefault(x => x.State == state.Code);
            var newLicense = new AgencyLicenseBulk(controlId, license?.Id, license?.State ?? state.Code,
                license?.IsResident ?? false, license?.LicenseNumber ?? "", license?.InsurerId, license?.Expiration,
                license?.Comments, license?.Appointment, license?.Termination, license?.AppointingState ?? false,
                license?.IsActive ?? false);
            newLicense.OnChanged += OnLicenseChanged;
            Licenses.Add(newLicense);
        }

        await Grid.Reload();

        await Grid.EditRows(Licenses);
    }

    private void CellRender(RowRenderEventArgs<AgencyLicenseBulk> args)
    {
        var license = args.Data;
        if (license == null) return;
        
        if (!license.Original && !license.Changed)
            return;

        var colorProperty = license.Original
            ? license.Changed
                ? "background-color: var(--rz-success-light)"
                : "background-color: var(--rz-success-lighter)"
            : license.Changed
                ? "background-color: var(--rz-info-light)"
                : "";

        if (string.IsNullOrEmpty(colorProperty)) return;

        if (args.Attributes.TryGetValue("style", out var existingStyle))
            args.Attributes["style"] = $"{existingStyle} {colorProperty}";
        else
            args.Attributes.Add("style", colorProperty);
    }

    private void OnLicenseChanged(bool changed)
    {
        StateHasChanged();
    }

    private void Revert(AgencyLicenseBulk license)
    {
        license.ResetAll();
        StateHasChanged();
    }

    private void RevertAll()
    {
        foreach (var license in Licenses)
        {
            license.ResetAll();
        }
        StateHasChanged();
    }

    private string GetInsurerName(Guid? insurerId) => insurerId.HasValue && InsurerNames.TryGetValue(insurerId.Value, out var name) ? name : "";

    private void Close(MouseEventArgs arg)
    {
        DialogService.Close(false);
    }

    private async Task SubmitChanges()
    {
        if(!Grid.IsValid)
            return;

        var errors = new List<string>();
        foreach (var license in Licenses.Where(l => l.Changed))
        {
            errors.AddRange(Validate(license));
        }

        if (errors.Any())
        {
            await DialogService.Alert(string.Join("\r\n", errors), "Validation Errors");
            return;
        }
        
        var toSave = Licenses
            .Where(l => l.Changed)
            .Select(s => new AgencyLicense
            {
                Id = s.Id ?? Guid.NewGuid(),
                AgencyId = AgencyId,
                AgentId = AgentId,
                State = s.StateCode,
                LicenseNumber = s.LicenseNumber,
                IsResident = s.IsResident,
                InsurerId = s.InsurerId!.Value,
                Expiration = s.Expiration,
                Comments = s.Comments,
                Appointment = s.Appointment,
                Termination = s.Termination,
                AppointingState = s.AppointingState,
                IsActive = s.IsActive
            })
            .ToList();
        
        var response = await DataAccess.UpdateAgencyLicenseBulk(toSave);
        if (!response.Success)
        {
            NotifySaveError(response.Errors);
            return;
        }
        
        NotifySuccessfulSave("agency licenses");
        
        DialogService.Close(true);
    }

    private List<string> Validate(AgencyLicenseBulk license)
    {
        var response = new List<string>();
        if(string.IsNullOrEmpty(license.LicenseNumber))
            response.Add($"License Number is required for State {license.StateCode}");
        
        if(license.InsurerId == null)
            response.Add($"Insurer is required for State {license.StateCode}");
        
        return response;
    }

    class AgencyLicenseBulk(long controlId, Guid? id, string stateCode, bool isResident, string licenseNumber,
        Guid? insurerId, DateOnly? expiration, string? comments, DateOnly? appointment, DateOnly? termination,
        bool appointingState, bool isActive) : NotifyPropertyChangedBase
    {
        public event Action<bool>? OnChanged;

        public long ControlId
        {
            get => _controlId;
            set => _controlId = value;
        }

        public Guid? Id
        {
            get => _id;
            set => _id = value;
        }

        public string StateCode
        {
            get => _stateCode;
            set
            {
                if (_stateCode == value) return;
                _stateCode = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public bool IsResident
        {
            get => _isResident;
            set
            {
                if (_isResident == value) return;
                _isResident = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public string LicenseNumber
        {
            get => _licenseNumber;
            set
            {
                if (_licenseNumber == value) return;
                _licenseNumber = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public Guid? InsurerId
        {
            get => _insurerId;
            set
            {
                if (_insurerId == value) return;
                _insurerId = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public DateOnly? Expiration
        {
            get => _expiration;
            set
            {
                if (_expiration == value) return;
                _expiration = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public string? Comments
        {
            get => _comments;
            set
            {
                if (_comments == value) return;
                _comments = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public DateOnly? Appointment
        {
            get => _appointment;
            set
            {
                if (_appointment == value) return;
                _appointment = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public DateOnly? Termination
        {
            get => _termination;
            set
            {
                if (_termination == value) return;
                _termination = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public bool AppointingState
        {
            get => _appointingState;
            set
            {
                if (_appointingState == value) return;
                _appointingState = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public bool IsActive
        {
            get => _isActive;
            set
            {
                if (_isActive == value) return;
                _isActive = value;
                OnPropertyChanged();
                OnChanged?.Invoke(Changed);
            }
        }

        public string ColorProperty => Original
            ? Changed
                ? "background-color: var(--rz-success-lighter)"
                : "background-color: var(--rz-success-light)"
            : Changed
                ? "background-color: var(--rz-info-lighter)"
                : "";

        private long _controlId = controlId;
        private Guid? _id = id;
        private string _stateCode = stateCode;
        private bool _isResident = isResident;
        private string _licenseNumber = licenseNumber;
        private Guid? _insurerId = insurerId;
        private DateOnly? _expiration = expiration;
        private string? _comments = comments;
        private DateOnly? _appointment = appointment;
        private DateOnly? _termination = termination;
        private bool _appointingState = appointingState;
        private bool _isActive = isActive;

        private long _controlIdOriginal = controlId;
        private Guid? _idOriginal = id;
        private readonly string _stateCodeOriginal = stateCode;
        private readonly bool _isResidentOriginal = isResident;
        private readonly string _licenseNumberOriginal = licenseNumber;
        private readonly Guid? _insurerIdOriginal = insurerId;
        private readonly DateOnly? _expirationOriginal = expiration;
        private readonly string? _commentsOriginal = comments;
        private readonly DateOnly? _appointmentOriginal = appointment;
        private readonly DateOnly? _terminationOriginal = termination;
        private readonly bool _appointingStateOriginal = appointingState;
        private readonly bool _isActiveOriginal = isActive;

        private bool StateCodeChanged => _stateCode != _stateCodeOriginal;
        private bool IsResidentChanged => _isResident != _isResidentOriginal;
        private bool LicenseNumberChanged => _licenseNumber != _licenseNumberOriginal;
        private bool InsurerIdChanged => _insurerId != _insurerIdOriginal;
        private bool ExpirationChanged => _expiration != _expirationOriginal;
        private bool CommentsChanged => _comments != _commentsOriginal;
        private bool AppointmentChanged => _appointment != _appointmentOriginal;
        private bool TerminationChanged => _termination != _terminationOriginal;
        private bool AppointingStateChanged => _appointingState != _appointingStateOriginal;
        private bool IsActiveChanged => _isActive != _isActiveOriginal;

        public bool Changed => StateCodeChanged ||
                               IsResidentChanged ||
                               LicenseNumberChanged ||
                               InsurerIdChanged ||
                               ExpirationChanged ||
                               CommentsChanged ||
                               AppointmentChanged ||
                               TerminationChanged ||
                               AppointingStateChanged ||
                               IsActiveChanged;

        public bool Original => Id != null && Id != Guid.Empty;

        public override void ResetAll()
        {
            if (!Changed) return;
            _stateCode = _stateCodeOriginal;
            _isResident = _isResidentOriginal;
            _licenseNumber = _licenseNumberOriginal;
            _insurerId = _insurerIdOriginal;
            _expiration = _expirationOriginal;
            _comments = _commentsOriginal;
            _appointment = _appointmentOriginal;
            _termination = _terminationOriginal;
            _appointingState = _appointingStateOriginal;
            _isActive = _isActiveOriginal;
            OnPropertyChanged("");
        }
    }

}