@page "/Account/{AccountNumber?}"
@using System.Diagnostics
@using James.Shared

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess
@inject ILoggingService _logging
@attribute [Authorize]

<Theme />

<PageTitle>BasisTNG - Account Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>

<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" class="rz-shadow-7">
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@AccountToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <AccountSearch />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End">
                        <RadzenText Text="Status: " />
                        <RadzenText Text="Placeholder" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Account Info">
                        <RadzenPanel class="rz-shade-6">
                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.AccountNum" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Parent No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.IdNavigation?.ParentNavigation?.AccountIdNavigation?.AccountNum" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Parent" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.IdNavigation?.ParentNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Tax ID" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <ChildContent>
                                                    @* TODO: Once encryption is figured out replace these values *@
                                                    <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" Visible="ShowTaxId" />
                                                    <RadzenPassword Value="Placeholder" Disabled="true" Visible="!ShowTaxId" />
                                                </ChildContent>
                                                <End>
                                                    @* TODO: Add authorization to use this button due to PII. *@
                                                    <RadzenButton Icon="@(ShowTaxId ? "visibility" : "visibility_off")" Click="@(() => ShowTaxId = !ShowTaxId)" Variant="Variant.Text" Size="ButtonSize.Small" />
                                                </End>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="UW" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.Underwriter?.IdNavigation?.FullName"/>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Branch" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@AccountToDisplay?.Branch" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Division" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%;">
                                                <RadzenTextBox Value="@AccountToDisplay?.Division"/>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenPanel>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Contact Info">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="Addresses">
                                    <LegalEntityAddressManager LegalEntityId="@AccountToDisplay.Id" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Phone Numbers">
                                    <LegalEntityPhoneNumberManager LegalEntityId="@AccountToDisplay.Id"/>
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px;" class="rz-shadow-7">
        <ChildContent>
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Account Info">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="General Information">
                                    <AccountGeneralInformation AccountToDisplay="@AccountToDisplay" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Account Program">
                                    <AccountProgramDisplay AccountNumber="@AccountToDisplay?.AccountNum" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Account References">

                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Commercial Credit Information">

                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Key Personnel">

                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Bank and Security">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="Bank/CPA/Legal">
                                    <AccountBankCPALegal AccountToDisplay="@AccountToDisplay" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Security">

                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Bond Requests">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Bonds">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Financial">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="WIP">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Line of Authority">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Virtual File">

                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            
        </ChildContent>    
    </RadzenPanel>
</RadzenStack>

@code {
    [Parameter] public string? AccountNumber { get; set; }
    private Account AccountToDisplay { get; set; } = new Account()
        {
            IdNavigation = new LegalEntity()
        };
    private InforceAccountLOA inForceLOAs { get; set; } = new InforceAccountLOA();
    private bool ShowTaxId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadAccount();
    }

    private async Task LoadAccount()
    {
        if (!string.IsNullOrWhiteSpace(AccountNumber))
        {
            var result = await DataAccess.GetAccountByNumber(AccountNumber);
            if (result.Errors.Any() || result.Data == null)
            {
                _logging.LogError("Unable to retrieve account.", result.Errors.ToString());
            }
            else
            {
                AccountToDisplay = result.Data;
                //StateHasChanged();
            }
        }
    }
    private async Task LoadInforceLOAs()
    {
        if (!string.IsNullOrWhiteSpace(AccountNumber))
        {
            var result = await DataAccess.GetInforceAccountLOAsByAccountNumber(AccountNumber);
            if (result.Errors.Any())
            {
                _logging.LogError("Unable to retrieve Account Inforce LOAs.", result.Errors.ToString());
            }
            else
            {
                inForceLOAs = result.Data;
            }
        }
    }
}
