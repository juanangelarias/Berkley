@page "/Agency/{Id}"

@using System.Security.Claims
@using James.Shared

@inherits LayoutComponentBase

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject DialogService DialogService
@inject IDataAccess _dataAccess
@inject ILoggingService _logging
@attribute [Authorize]

<Theme />

<PageTitle>Agency Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>
<RadzenStack Orientation="Orientation.Vertical" Gap="10px">
    <RadzenPanel Style="border-radius: 20px;" Collapsed="SummaryView" class="rz-shadow-7">
        <FooterTemplate>
            <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                <RadzenButton Icon="expand_less" Variant="Variant.Text" Click="@(() => SummaryView = !SummaryView)" />
            </RadzenStack>
        </FooterTemplate>
        <SummaryTemplate>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="3">
                    <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                        <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="width: 100%">
                    <RadzenButton Icon="expand_more" Variant="Variant.Text" Click="@(() => SummaryView = !SummaryView)" />
                </RadzenStack>
            </RadzenRow>
        </SummaryTemplate>
        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenColumn>
                    <RadzenText TextStyle="TextStyle.DisplayH5" Text="@agencyToDisplay?.IdNavigation?.FullName" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenText Text="Status:" />
                        <RadzenText Text="@agencyToDisplay?.Status" />
                        <RadzenButton Variant="Variant.Text" Icon="edit" Size="ButtonSize.Small" Click="ShowStatusDialog" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Agency Info">
                        <RadzenPanel class="rz-shade-6">
                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Agency No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@agencyToDisplay?.AgencyNumber" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Name" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Parent No." Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.ParentNavigation?.AgencyIdNavigation?.AgencyNumber" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Parent" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="@agencyToDisplay?.IdNavigation?.ParentNavigation?.FullName" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Tax ID" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <ChildContent>
                                                    @* TODO: Once encryption is figured out replace these values *@
                                                    <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" Visible="showTaxId" />
                                                    <RadzenPassword Value="Placeholder" Disabled="true" Visible="!showTaxId" />
                                                </ChildContent>
                                                <End>
                                                    @* TODO: Add authorization to use this button due to PII. *@
                                                    <RadzenButton Icon="@(showTaxId ? "visibility" : "visibility_off")" Click="@(() => showTaxId = !showTaxId)" Variant="Variant.Text" Size="ButtonSize.Small" />
                                                </End>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="Branch" Variant="Variant.Text" AllowFloatingLabel="true" Style="width:90%">
                                                <RadzenDropDown TValue="string" @bind-Value="@agencyToDisplay.Branch" 
                                                Data="AllBranches" ValueProperty="BranchKey" TextProperty="Name"
                                                Disabled="!editMode" Style="color: black;"/>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Approved Date" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox Value="Placeholder" Disabled="true" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn>
                                            <RadzenFormField Text="NPN" Variant="Variant.Text" AllowFloatingLabel="false" Style="width:90%">
                                                <RadzenTextBox @bind-Value="@agencyToDisplay.NationalProducerNumber" Disabled="!editMode" Style="color: black;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow>
                                        <br />
                                    </RadzenRow>
                                    <RadzenRow Gap="2">
                                        <RadzenColumn Size="12">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@agencyToDisplay.W9"
                                                                    Text="W-9" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!editMode" />
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@agencyToDisplay.Need1099"
                                                                    Text="Need 1099" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!editMode" />
                                                <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" @bind-Value="@agencyToDisplay.Nasbp"
                                                                    Text="NASBP" Style="border-radius: 20px; width: 125px;" Size="ButtonSize.Small" Disabled="!editMode" />
                                                <RadzenButton Text="Edit" Icon="edit" Visible="!editMode" Click="@(() => editMode = !editMode)" />
                                                <RadzenButton Text="Save" Icon="save" Visible="editMode" Click="SaveAgencyChanges" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenPanel>
                    </RadzenFieldset>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFieldset Text="Addresses and Coverages">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="Main">
                                    <AddressDisplay AddressId="@mainAddress.Id" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Billing">
                                    <AddressDisplay AddressId="@billingAddress.Id" />
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Errors & Omissions Coverage">
                                    <RadzenStack Orientation="Orientation.Vertical">
                                        <RadzenStack Orientation="Orientation.Horizontal">
                                            <RadzenFormField AllowFloatingLabel="false" Text="Carrier" Variant="Variant.Text" Style="width: 400px;">
                                                <RadzenTextBox Value="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Carrier"
                                                               Disabled="!errorsAndOmissionsEditMode" />
                                            </RadzenFormField>
                                            <RadzenButton Icon="edit" Visible="!errorsAndOmissionsEditMode" Size="ButtonSize.Small" Text="Edit" Click="@(() => errorsAndOmissionsEditMode = !errorsAndOmissionsEditMode)" />
                                        </RadzenStack>
                                        <RadzenFormField AllowFloatingLabel="false" Text="Exp Date" Variant="Variant.Text">
                                            <RadzenTextBox Value="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.Expiration.ToShortDateString()" Disabled="!errorsAndOmissionsEditMode" />
                                        </RadzenFormField>
                                        <RadzenFormField AllowFloatingLabel="false" Text="Limit" Variant="Variant.Text">
                                            <RadzenTextBox Value="@agencyToDisplay?.AgencyErrorAndOmissions?.FirstOrDefault()?.CoverageLimit.ToString("c0")" Disabled="!errorsAndOmissionsEditMode" />
                                        </RadzenFormField>
                                    </RadzenStack>
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                    </RadzenFieldset>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px">
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="General Info">
                    <AgencyGeneralInfoGrids agencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Contacts">
                    <AgencyContactsGrid AgencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Inventory">
                    <AgencyInventoryGrid AgencyId="@agencyToDisplay.Id" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Accounts and Bonds">
                    <AgencyAccountsAndBonds agencyToDisplay="@agencyToDisplay" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Commission Rates">
                    <AgencyCommissionRates AgencyId="@agencyToDisplay.Id" AgencyStatus="@agencyToDisplay?.Status" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Virtual File">
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenPanel>
</RadzenStack>

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private string Username = "";
    public Notification[]? notifications;
    List<string> blankList = new List<string>();
    private bool contactsGridView = false;
    private Agency agencyToDisplay = new Agency();
    private Address mainAddress = new Address();
    private Address billingAddress = new Address();
    private bool SummaryView = false;
    IDisposable? session;
    RadzenDataGrid<AgencyLicense>? licenseGrid;

    private bool mainAddressEditMode { get; set; } = false;
    private bool billingAddressEditMode { get; set; } = false;
    private bool errorsAndOmissionsEditMode { get; set; } = false;
    private bool editMode { get; set; } = false;
    private bool showTaxId { get; set; } = false;

    //TODO: Remove after implementing caching
    private List<Branch> AllBranches { get; set; } = new List<Branch>();


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadBranches();
        
        //TODO: Remove after testing
        _logging.LogInformation("AgencyProfile initialized for AgencyId: " + Id, data: new Dictionary<string, string> { { "username", Username } });
        // session = JamesClient.AddressModified.Watch().Subscribe(a =>
        //     {
        //         ShowNotification(new NotificationMessage
        //             {
        //                 Severity = NotificationSeverity.Info,
        //                 Detail = "Information on this page has been changed by another user.",
        //                 Duration = 4000
        //             });
        //     });
        session = _dataAccess.AddressModified();

        ThemeService.Initialize(NavigationManager);

        //TODO: Remove this once testing of notification window is done.
        notifications = new Notification[]{
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 1234567"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 2345678"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 3456789"},
                        new Notification {Title = "Renew Bond", CreatedDate = DateTime.Today, Content = "Please renew bond 4567890"}
    };
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await LoadBranches();
        var result = await _dataAccess.GetAgencyByAgencyNumber(Id);
        if (result.Success)
        {
            agencyToDisplay = result.Data; //ThisToThat.ToEntityType<Agency>(result.Data.AgencyByAgencyNumber);

            mainAddress = agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address ?? new Address();
            billingAddress = agencyToDisplay?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Billing")?.Address ?? new Address();
        }
        else
        {
            _logging.LogWarning("GetAgencyByAgencyNumber returned error(s)", string.Join("\r\n", result.Errors), "GraphQl");
        }
    }
    private async Task LoadBranches()
    {
        var result = await _dataAccess.GetAllBranches();
        if (result.Success)
        {
            AllBranches = result.Data.OrderBy(b => b.Name).ToList();
        }
        else
        {
            _logging.LogWarning("GetAllBranches returned error(s)", string.Join("\r\n", result.Errors), "GraphQL");
        }
    }
    private async Task SaveAgencyChanges()
    {
        //TODO: Handle errors
        var result = await _dataAccess.SetAgencyGeneralInfo(agencyToDisplay.Id, agencyToDisplay.IdNavigation.FullName, agencyToDisplay.IdNavigation.ParentNavigation.Id,
        agencyToDisplay.IdNavigation.TaxIdEncrypted, agencyToDisplay.NationalProducerNumber, agencyToDisplay.W9, agencyToDisplay.Need1099,
        agencyToDisplay.Nasbp, agencyToDisplay.Branch);
        editMode = !editMode;
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Changes saved successfully.", Duration = 5000 });
    }
    private void ToggleMainAddressEditMode()
    {
        mainAddressEditMode = !mainAddressEditMode;
    }
    private void ToggleBillingAddressEditMode()
    {
        billingAddressEditMode = !billingAddressEditMode;
    }
    async Task SubmitAddressChange(Address newAddress)
    {
        await _dataAccess.SetAddress(newAddress);

    }
    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
    async Task AddressChangeDetected(Address result)
    {
        var data = result;
    }
    private async Task CanChange(StepsCanChangeEventArgs args)
    {
        return;
    }
    private async Task ShowStatusDialog()
    {
        await DialogService.OpenAsync<AgencyStatusGrid>("Agency Status",
            new Dictionary<string, object>() { { "AgencyNumber", agencyToDisplay.AgencyNumber }, { "CurrentStatus", agencyToDisplay.Status } },
            new DialogOptions()
                {
                    Resizable = false,
                    Draggable = true,
                    CloseDialogOnOverlayClick = true,
                    Style = "border-radius: 20px",
                    Width = "1000px",
                    Height = "500px"
                }
        );

    }

}
