@page "/Account/{AccountNumber?}"

@inject IAccountState AccountState
@inherits JamesLayoutComponentBase

@attribute [Authorize]

<Theme/>

<PageTitle>BasisTNG - Account Profile</PageTitle>
<RenderModeBackground></RenderModeBackground>

<RadzenColumn Size="12">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <RadzenRow JustifyContent="JustifyContent.End" Visible="@AccountState.IsUserManager">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenLabel Text="View Type: " Style="font-size: small;"/>
                <RadzenDropDown Data="AccountState.Types" @bind-Value="@AccountState.SelectedType"
                                Text="Select View Type" Style="font-size: small; height: 35px;"/>
            </RadzenStack>
        </RadzenRow>
        <RadzenRow Style="width: 100%;">
            <RadzenPanel Style="border-radius: 20px; width: 100%;" class="rz-shadow-2">
                <ChildContent>
                    <RadzenRow JustifyContent="JustifyContent.End">
                        <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.DisplayH5" Text="@AccountState.Account?.IdNavigation.FullName"/>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <AccountSearch SetAccount="OnSetAccount"/>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End"
                                         JustifyContent="JustifyContent.End">
                                <RadzenText Text="Status: "/>
                                <RadzenText Text="Placeholder"/>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenPanel>
        </RadzenRow>
        <RadzenRow>
            @switch (AccountState.SelectedType)
            {
                case "Commercial":
                    <AccountCommercial/>
                    break;
                case "Contract":
                    <AccountContract/>
                    break;
                case "Default":
                    <AccountDefault/>
                    break;
                default:
                    <RadzenColumn span="12">
                        <RadzenRow>
                            <RadzenText Text="The user needs to be defined as Commercial or Contract user"
                                        TextStyle="TextStyle.DisplayH4" TextAlign="TextAlign.Center"/>
                        </RadzenRow>
                    </RadzenColumn>
                    break;
            }
        </RadzenRow>
    </RadzenStack>
</RadzenColumn>

@code {

    [Parameter]
    public string? AccountNumber { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        Console.WriteLine($"Account Number: {AccountNumber}");

        if(string.IsNullOrEmpty(AccountNumber))
            return;
        
        AccountState.AccountNumber = AccountNumber;
        AccountState.Initialize();
    }
    
    private async Task OnSetAccount(string arg)
    {
        AccountNumber = arg;
        AccountState.AccountNumber = arg;
        
        await AccountState.Initialize();
    }
}
