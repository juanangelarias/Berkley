@using James.Shared.Notification

@inherits JamesLayoutComponentBase

@inject INotificationGeneralState NotificationState

<RadzenDataGrid TItem="NotificationProperty" Data="@NotificationState.NotificationPropertyList" AllowGrouping="false"
                AllowSorting="true"
                Style="height: 400px; border-radius: 10px;" AllowColumnResize="true" AllowColumnPicking="false"
                GridLines="DataGridGridLines.Vertical"
                Density="Density.Compact" AllowFiltering="true" IsLoading="@IsLoading"
                SelectionMode="DataGridSelectionMode.Single" EditMode="DataGridEditMode.Single"
                RowUpdate="@OnRowUpdate" RowCreate="@OnRowCreate" @ref="_notificationGrid">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem">
            <RadzenButton Text="Add Property" Icon="add" Variant="Variant.Text" Click="@OnAddRow"
                          Disabled="@(_notificationToInsert.Count > 0)"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Width="1*" Property="Name" Title="Name" Filterable="true" Sortable="true">
            <Template Context="prop">
                <RadzenText Text="@prop.Name"/>
            </Template>
            <EditTemplate Context="prop">
                <RadzenTextBox @bind-Value="@prop.Name" Name="propName"/>
                <RadzenRequiredValidator Text="The name is required" Component="propName"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="2*" Property="Type" Title="Type" Filterable="true" Sortable="true">
            <Template Context="prop">
                <RadzenText Text="@prop.Type"/>
            </Template>
            <EditTemplate Context="prop">
                <RadzenDropDown TValue="string" @bind-Value="@prop.Type" Data="_types" Name="propType"/>
                <RadzenRequiredValidator Text="The type is required" Component="propType"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="prop" Filterable="false" Sortable="false" TextAlign="TextAlign.Right"
                              Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="100px">
            <Template Context="prop">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1"
                              Click="@(_ => EditRow(prop))" @onclick:stopPropagation="true"/>
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1"
                              Click="@(_ => DeleteRow(prop))" @onclick:stopPropagation="true"/>
            </Template>
            <EditTemplate Context="prop">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" Click="@(_ => SaveRow(prop))" aria-label="Save"/>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1"
                              Click="@(_ => CancelEdit(prop))" aria-label="Cancel"/>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private RadzenDataGrid<NotificationProperty> _notificationGrid = null!;

    private readonly List<string> _types = NotificationType.GetNotificationTypes();
    

    private List<NotificationProperty> _notificationToInsert = [];
    private List<NotificationProperty> _notificationToUpdate = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        //await NotificationState.LoadProperties();
        await _notificationGrid.Reload();
    }

    private async Task OnRowUpdate(NotificationProperty prop)
    {
        if(prop == null)
            return;
        
        await ShowLoading();

        Reset(prop);

        var response = await NotificationState.SetNotificationProperty(prop);
        if (!response.Success)
        {
            NotifySaveError(response.Errors);
        }
        else
        {
            NotifySuccessfulSave("notification property");
        }
    }

    private async Task OnRowCreate(NotificationProperty prop)
    {
        await ShowLoading();

        var response = await NotificationState.SetNotificationProperty(prop);
        if (!response.Success)
        {
            NotifySaveError(response.Errors);
            return;
        }

        NotifySuccessfulSave("notification property");

        NotificationState.NotificationPropertyList.Add(prop);

        _notificationToInsert.Remove(prop);
    }

    private async Task OnAddRow(MouseEventArgs obj)
    {
        await ShowLoading();
        if (!_notificationGrid.IsValid)
            return;

        Reset();

        var property = new NotificationProperty
        {
            Id = Guid.NewGuid()
        };

        _notificationToInsert.Add(property);
        await _notificationGrid.InsertRow(property);
    }

    private async Task EditRow(NotificationProperty prop)
    {
        if (!_notificationGrid.IsValid)
            return;

        Reset();

        _notificationToUpdate.Add(prop);
        await _notificationGrid.EditRow(prop);
    }

    private async Task DeleteRow(NotificationProperty prop)
    {
        await ShowLoading();

        Reset(prop);
        if (NotificationState.NotificationPropertyList.Contains(prop))
        {
            NotificationState.NotificationPropertyList.Remove(prop);
            var response = await NotificationState.DeleteNotificationProperty(prop.Id);
            if (!response.Success)
            {
                NotifySaveError(response.Errors, "notification property");
                return;
            }

            NotifySuccessfulSave("notification property");

            await _notificationGrid.Reload();
        }
    }

    private async Task SaveRow(NotificationProperty prop)
    {
        if (!_notificationGrid.IsValid)
            return;

        await _notificationGrid.UpdateRow(prop);
    }

    private void CancelEdit(NotificationProperty prop)
    {
        Reset(prop);

        _notificationGrid.CancelEditRow(prop);
    }

    private void Reset()
    {
        _notificationToInsert.Clear();
        _notificationToUpdate.Clear();
    }

    private void Reset(NotificationProperty property)
    {
        _notificationToInsert.Remove(property);
        _notificationToUpdate.Remove(property);
    }
}