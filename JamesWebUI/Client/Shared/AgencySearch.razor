@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<style>
    #popup-dropDownDataGrid {
        width: 900px !important;
    }
</style>

<RadzenColumn Size="12">
    <RadzenDropDownDataGrid TValue="AgencySearchDto" Name="SearchDropDown" @bind-Value="@SelectedAgency" @ref="@SearchCtrl"
                            Data="@SearchResults" AllowColumnResize="true" Style="width: 90%" FilterDelay="300"
                            AllowFilteringByAllStringColumns="true" Placeholder="Select an Agency" FilterAsYouType="true"
                            AllowFiltering="true" LoadData="@SearchAgency" FocusFilterOnPopup="false" 
                            TextProperty="@nameof(AgencySearchDto.AgencyName)" id="dropDownDataGrid">
        <Columns>
            <RadzenDropDownDataGridColumn Title="" Width="60px">
                <Template>
                    <RadzenIcon Icon="person"/>
                </Template>
            </RadzenDropDownDataGridColumn>
            <RadzenDropDownDataGridColumn Title="Number" Width="125px" Property="@nameof(AgencySearchDto.AgencyNumber)"/>
            <RadzenDropDownDataGridColumn Title="Name" Width="250px" Property="@nameof(AgencySearchDto.AgencyName)"/>
            <RadzenDropDownDataGridColumn Title="City" Width="150px" Property="@nameof(AgencySearchDto.City)"/>
            <RadzenDropDownDataGridColumn Title="Branch" Width="110px" Property="@nameof(AgencySearchDto.Branch)"/>
            <RadzenDropDownDataGridColumn Title="Status" Width="110px" Property="@nameof(AgencySearchDto.Status)"/>
            <RadzenDropDownDataGridColumn Title="Parent" Width="110px" Property="@nameof(AgencySearchDto.ParentChild)"/>
        </Columns>
    </RadzenDropDownDataGrid>
</RadzenColumn>

@code {
    private RadzenDropDownDataGrid<AgencySearchDto> SearchCtrl { get; set; } = null!;
    private List<AgencySearchDto> SearchResults { get; set; } = [];
    private AgencySearchDto? _selectedAgency;
    private AgencySearchDto? SelectedAgency
    {
        get => _selectedAgency;
        set
        {
            if (_selectedAgency != value)
            {
                _selectedAgency = value;
                ResultSelected();
            }
        }
    }

    private async Task SearchAgency(LoadDataArgs args)
    {
        if(string.IsNullOrWhiteSpace(args.Filter))
        {
            SearchResults.Clear();
            return;
        }
        
        var result = await DataAccess.SearchAgencies(args.Filter, true);

        if (result.Errors.Any())
        {
            NotifyLoadError(result.Errors, "agency search");
        }
        else
        {
            SearchResults = result.Data!;
        }
    }

    private void ResultSelected()
    {
        if (SelectedAgency == null)
            return;

        var agencyNumber = SelectedAgency.AgencyNumber;
        _selectedAgency = null;
        SearchCtrl.Reset();
        NavigationManager.NavigateTo($"/Agency/{agencyNumber}");
    }

}
