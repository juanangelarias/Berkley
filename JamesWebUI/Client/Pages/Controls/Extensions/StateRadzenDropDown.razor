@using James.Data.Client.GraphQL;
@using James.Data.Client.GraphQL.Components;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService

<UseGetAllStates Context="stateData">
    <ChildContent>
        @{
            if (MultiSelect)
            {
                <RadzenDropDown @rendermode="@InteractiveWebAssembly"
                                Multiple="true" Chips="true" SelectAllText="Select All" Disabled="@Disabled"
                        AllowFiltering="true" FilterOperator="StringFilterOperator.Contains" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        TValue="List<IGetAllStates_AllStates>" Data="stateData.AllStates.ToList()"
                        TextProperty="Name">
                </RadzenDropDown>
            }
            else
            {
                <RadzenDropDown @rendermode="@InteractiveWebAssembly"
                                Multiple="false" Disabled="@Disabled"
                                AllowFiltering="true" FilterOperator="StringFilterOperator.Contains" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                TValue="IGetAllStates_AllStates" Data="stateData.AllStates.ToList()"
                                TextProperty="Name">
                </RadzenDropDown>
            }
        }
        
    </ChildContent>
    <ErrorContent>
        Something went wrong...<br />
    </ErrorContent>
    <LoadingContent>
        <RadzenDropDown Placeholder="Loading..." TValue="IGetAllStates_AllStates"/>
    </LoadingContent>
</UseGetAllStates>

@code {
    [Parameter] public bool MultiSelect { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeService.Initialize(NavigationManager);
    }
}
