@using James.Shared.Imaging

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess

<Theme />
<RenderModeBackground />

<RadzenDataGrid TItem="AgencyLicense" @ref="@LicenseGrid" Data="@AgencyLicenses"
                Style="border-radius: 10px; height: 400px;" EmptyText="No records to display"
                AllowSorting="true" Density="Density.Compact" SelectionMode="DataGridSelectionMode.Multiple"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                AllowColumnPicking="true" AllowGrouping="true"
                RowUpdate="UpdateLicenseRow" EditMode="DataGridEditMode.Single" RowCreate="@OnLicenseCreate"
                IsLoading="@_isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New License" Variant="Variant.Text" Click="@InsertLicenseRow" />
            <RadzenButton Text="Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.Excel))" Disabled="@_isLoading" />
            <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.CSV))" Disabled="@_isLoading" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLicense" Filterable="false"
                              Title="Status" Property="IsActive" Width="90px">
            <Template Context="license">
                @{
                    if (license.IsActive)
                    {
                        <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success" />
                    }
                    else
                    {
                        <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger" />
                    }
                }
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="@license.IsActive" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Type="typeof(IEnumerable<string>)"
                              Filterable="true" FilterValue="@_stateFilter" FilterProperty="State" FilterOperator="FilterOperator.Contains"
                              Title="State" Property="State" Width="100px" SortOrder="SortOrder.Ascending">
            <Template Context="license">
                <RadzenText Text="@license.State" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="string" Data="AllStates" @bind-Value="license.State"
                                TextProperty="Name" ValueProperty="Code" Style="width:95%" />
            </EditTemplate>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_stateFilter" Change="StateFilterChange"
                                Style="width: 95%;" Multiple="true" AllowClear="true" TValue="List<string>"
                                Data="@AgencyLicenses.OrderBy(a => a.State).GroupBy(a => a.State).Select(a => a.FirstOrDefault()?.State).ToList()" />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense"
                              Title="No Aptmt" Width="75px" Property="AppointingState">
            <Template Context="license">
                <RadzenCheckBox Value="license.AppointingState" ReadOnly="true" />
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="license.AppointingState" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="License #" Property="LicenseNumber" Width="100px">
            <Template Context="license">
                <RadzenText Text="@license.LicenseNumber" />
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="license.LicenseNumber" Style="width:95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense"
                              Title="Resident" Width="75px" Property="IsResident">
            <Template Context="license">
                <RadzenCheckBox TValue="bool" Value="license.IsResident" ReadOnly="true" />
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox TValue="bool" @bind-Value="license.IsResident" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Filterable="false"
                              Title="Insurer" Property="Insurer" Width="200px">
            <Template Context="license">
                <RadzenText Text="@license.Insurer.IdNavigation.FullName" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="Insurer" Data="AllInsurers" Style="width:95%"
                                TextProperty="IdNavigation.FullName" @bind-Value="@license.Insurer" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Appointment" Property="Appointment" Width="125px" FormatString="{0:d}">
            <Template Context="license">
                <RadzenText Text="@license.Appointment.ToString()" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Appointment" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Termination" Property="Termination" Width="125px" FormatString="{0:d}">
            <Template Context="license">
                <RadzenText Text="@license.Termination.ToString()" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Termination" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Certificate" Width="60px">
            <Template Context="lic">
                <InlineImagingDocument DocumentShortName="License Certificate"
                                       DocumentCategory="ImagingDocumentCategory.Agency"
                                       DocumentId="@lic.ImagingId"
                                       DocumentType="AGALIC"
                                       ImagingId="@lic.Agency.AgencyNumber"
                                       UploadAction=@(async void (guid) => await CertificateUploaded(guid, lic.Id))
                                       UploadErrorAction=@(msg=>LogUploadError(msg, lic)) />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="75px" TItem="AgencyLicense" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="license">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => EditLicenseRow(license))" @onclick:stopPropagation="true">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => DeleteLicenseRow(license))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="license">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => SaveLicenseRow(license))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => CancelLicenseEdit(license))">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(_ => DeleteLicenseRow(license))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyId { get; set; }

    private RadzenDataGrid<AgencyLicense> LicenseGrid { get; set; } = null!;

    private List<AgencyLicense> AgencyLicenses { get; set; } = [];

    private readonly List<AgencyLicense> _licensesToInsert = [];
    private readonly List<AgencyLicense> _licensesToUpdate = [];

    //TODO: Remove this stuff once we figure out caching
    private static List<Insurer> AllInsurers { get; set; } = [];
    private static List<State> AllStates { get; set; } = [];

    private List<string>? _stateFilter;

    private bool _isLoading;
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadData();
    }

    // ToDo (JAA) This way will not work when trying to reload licenses
    // after add, edit or delete a license because it will read from
    // the cache and not from the database.
    // We need to use subscriptions for the reloading of agencyLicenses
    // or add a boolean parameter in the DataCache.ParallelGetCacheOrDataAsync and
    // DataCache.GetCacheOrLoadDataAsync that when it is true force the load from 
    // the database
    private async Task LoadData()
    {
        if(AgencyId == Guid.Empty)
            return;
        
        IDataAccessResult<List<State>> states = null!;
        IDataAccessResult<List<Insurer>> insurers = null!;
        IDataAccessResult<List<AgencyLicense>> licenses = null!;

        LoadItem[] loadItems =
        [
            AddEventNotify(new LoadItem
            {
                Key = "States",
                AsyncLoadTask = async () => states = await DataAccess.GetAllStates(),
                CacheLoadTask = cache => states = new DataAccessResult<List<State>>
                {
                    Data = (List<State>)cache!
                },
                ResultVariable = () => states,
                AfterLoad = async void () => { await HandleStateLoadResult(states); }
            }, "States"),
            AddEventNotify(new LoadItem
            {
                Key = "Insurers",
                AsyncLoadTask = async () => insurers = await DataAccess.GetAllInsurers(),
                CacheLoadTask = cache => insurers = new DataAccessResult<List<Insurer>>
                {
                    Data = (List<Insurer>)cache!
                },
                ResultVariable = () => insurers,
                AfterLoad = async void () => { await HandleInsurerLoadResult(insurers); }
            }),
            AddEventNotify(new LoadItem
            {
                Key = $"AgencyLicenses{AgencyId}",
                AsyncLoadTask = async () => licenses = await DataAccess.GetAgencyLicenses(AgencyId),
                CacheLoadTask = cache => licenses = new DataAccessResult<List<AgencyLicense>>
                {
                    Data = (List<AgencyLicense>)cache!
                },
                ResultVariable = () => licenses,
                AfterLoad = async void () => { await HandleAgencyLicensesLoadResult(licenses); }
            })
        ];

        await DataCache.ParallelGetCacheOrDataAsync(loadItems);
    }

    private async Task HandleStateLoadResult(IDataAccessResult<List<State>> state)
    {
        if (state.Success)
            AllStates = state.Data!;
        else
            await HandleLoadError("Error loading States", state.Errors);
    }
    
    private async Task HandleInsurerLoadResult(IDataAccessResult<List<Insurer>> insurers)
    {
        if (insurers.Success)
            AllInsurers = insurers.Data!;
        else
            await HandleLoadError("Error loading Insurers", insurers.Errors);
    }
    
    private async Task HandleAgencyLicensesLoadResult(IDataAccessResult<List<AgencyLicense>> licenses)
    {
        if (licenses.Success)
            AgencyLicenses = licenses.Data!;
        else
            await HandleLoadError("Error loading Agency Licenses", licenses.Errors);
    }

    private void Reset()
    {
        _licensesToInsert.Clear();
        _licensesToUpdate.Clear();
    }

    private void Reset(AgencyLicense license)
    {
        _licensesToInsert.Remove(license);
        _licensesToUpdate.Remove(license);
    }

    private async Task LoadLicenses()
    {
        IDataAccessResult<List<AgencyLicense>> licenses = null!;

        var loadItem = AddEventNotify(new LoadItem
        {
            Key = $"AgencyLicenses{AgencyId}",
            AsyncLoadTask = async () => licenses = await DataAccess.GetAgencyLicenses(AgencyId),
            CacheLoadTask = cache => licenses = new DataAccessResult<List<AgencyLicense>>
            {
                Data = (List<AgencyLicense>)cache!
            },
            ResultVariable = () => licenses,
            AfterLoad = async void () => { await HandleAgencyLicensesLoadResult(licenses); }
        });

        await DataCache.GetCacheOrLoadDataAsync(loadItem);
    }

    private async Task InsertLicenseRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        await ShowLoading();
        var newLicense = new AgencyLicense() { Id = Guid.NewGuid() };
        _licensesToInsert.Add(newLicense);
        await LicenseGrid.InsertRow(newLicense);
    }

    private async Task EditLicenseRow(AgencyLicense license)
    {
        await ShowLoading();
        Reset();
        _licensesToUpdate.Add(license);
        await LicenseGrid.EditRow(license);
    }

    private async Task DeleteLicenseRow(AgencyLicense license)
    {
        await ShowLoading();
        Reset(license);
        _ = await DataAccess.DeleteLicense(license.Id);
        await LoadLicenses();
    }

    private async Task SaveLicenseRow(AgencyLicense license)
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Update/Insert is done in those methods.
        await ShowLoading();
        await LicenseGrid.UpdateRow(license);
        await LoadLicenses();
    }

    private async Task OnLicenseCreate(AgencyLicense license)
    {
        //This is where we handle row inserts.

        _ = await DataAccess.CreateLicense(
            license.Id,
            AgencyId,
            null,
            license.AppointingState,
            license.Comments,
            license.Appointment,
            license.Expiration,
            license.Termination,
            license.Insurer.Id,
            license.IsResident,
            license.LicenseNumber,
            license.State,
            license.IsActive
        );

        _licensesToInsert.Remove(license);
        //await LoadLicenses();
        //TODO: Check for errors and notify.
    }

    private async void CancelLicenseEdit(AgencyLicense license)
    {
        await ShowLoading();
        Reset(license);
        LicenseGrid.CancelEditRow(license);
        await LoadLicenses();
    }

    private async Task UpdateLicenseRow(AgencyLicense license)
    {
        Reset(license);
        //This is where we handle row Updates.
        _ = await DataAccess.SetAgencyLicense(license.Id,
            license.AgencyId,
            license.AgentId,
            license.AppointingState,
            license.Comments,
            license.Appointment,
            license.Expiration,
            license.Termination,
            license.InsurerId,
            license.IsResident,
            license.LicenseNumber,
            license.State,
            license.IsActive
        );
    }

    private async Task StateFilterChange()
    {
        if (_stateFilter != null && !_stateFilter.Any())
        {
            _stateFilter = null;
        }

        await LicenseGrid.Reload();
    }

    protected async Task ShowLoading()
    {
        _isLoading = true;

        await Task.Yield();

        _isLoading = false;
    }

    private async Task CertificateUploaded(Guid? certificateId, Guid licenseId)
    {
        //Set the document link
        var saveResult = await DataAccess.SetAgencyLicenseDocumentLink(licenseId, certificateId);
        if (saveResult.Success)
            NotifySuccessfulSave("License certificate");
        else
            NotifySaveError(saveResult.Errors, "license certificate");
    }

    private void LogUploadError(string message, AgencyLicense license)
    {
        LoggingService.LogError("Upload failed",
            "Uploading a file to imaging returned an error",
            "Imaging",
            data: new Dictionary<string, string>
            {
                { "Error Message", message },
                { "AgencyNumber", license.Agency.AgencyNumber },
                { "License Id", license.Id.ToString() }
            });
        NotifySaveError([message], "license certificate");
    }

    private void ExportLicenseGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Insurer", "Insurer.IdNavigation.FullName");
        substitutions.AddSubstitution("IsActive", title: "Is Active");
        substitutions.AddSubstitution("IsResident", title: "Is Resident");
        substitutions.AddSubstitution("AppointingState", title: "Appointing State");
        NavigationManager.NavigateTo(ExportDataGridUrl(LicenseGrid,
                $"/export/AgencyLicenses/{AgencyId}", format, substitutions),
            true);
    }
}
