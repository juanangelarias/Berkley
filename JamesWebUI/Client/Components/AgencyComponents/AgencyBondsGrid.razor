@using James.Shared.Constants
@using Newtonsoft.Json
@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess
@inject TooltipService TooltipService

<Theme/>

<RadzenDataGrid TItem="Bond" @ref="@AgencyBondGrid" Data="@_agencyBonds" AllowGrouping="true" AllowSorting="true"
                AllowColumnResize="true" AllowColumnPicking="true" Density="Density.Compact" Style="height: 400px; border-radius: 10px;"
                GridLines="DataGridGridLines.Vertical" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" IsLoading="@IsLoading" Sort="@ShowLoading"
                Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading" @bind-Settings="@GridSettings"
                AllowColumnReorder="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Icon="settings" Click="SaveGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "saveSettings"))"
                          Visible="@_userSettingsChanged"/>
            <RadzenButton Icon="reset_settings" Click="ResetGridSettings"
                          MouseEnter="@(args => ShowTooltip(args, "resetSettings"))"
                          Visible="@_userSettingsLoaded"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="Bond" Filterable="true" FilterValue="@_statusFilter" FilterProperty="Status"
                              FilterOperator="FilterOperator.Contains" Resizable="true"
                              Title="Status" Property="Status" Width="125px" Type="typeof(List<string>)">
            <Template Context="bond">
                @{
                    if (bond.Status.Trim() == "Open")
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success"/>
                            <RadzenText Text="@bond.Status"/>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal">
                            <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger"/>
                            <RadzenText Text="@bond.Status"/>
                        </RadzenStack>
                    }
                }
            </Template>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_statusFilter" @ref="StatusFilterDropDown" Change="StatusFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.Select(b => b.Status).Distinct().ToList()"/>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Bond" Title="Bond No." Property="BondNumber" Width="125px" Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Account No." Property="AccountNumNavigation.AccountNum"
                              Width="140px" Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Account Name" Property="AccountNumNavigation.IdNavigation.FullName"
                              Width="150px" Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Bond Type" Property="BondType.BondType" Width="130px"
                              FilterValue="_bondTypeFilter" FilterProperty="BondType.BondType" Resizable="true"
                              FilterOperator="FilterOperator.Contains" Type="typeof(List<string>)">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_bondTypeFilter" @ref="BondTypeFilterDropDown"
                                Change="BondTypeFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.Select(b => b.BondType?.BondType).Distinct().ToList()"/>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Bond" Title="Begin Date" Property="Effective" FormatString="{0:d}" Width="150px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="End Date" Property="Expiration" FormatString="{0:d}" Width="150px"
                              SortOrder="SortOrder.Descending" Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="UW" Property="UnderWriter.IdNavigation.FullName" Width="175px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Class Code" Property="Siccode" FormatString="{0:d}" Width="125px"
                              Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Obligee" Property="Obligee.FullName" Width="200px" Resizable="true"/>
        <RadzenDataGridColumn TItem="Bond" Title="Class" Property="BondClass" Resizable="true"
                              Filterable="true" FilterValue="@_classFilter" FilterProperty="BondClass"
                              FilterOperator="FilterOperator.Contains" Type="typeof(List<string>)"
                              FormatString="{0:d}" Width="180px">
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@_classFilter" @ref="ClassFilterDropDown" Change="ClassFilterChange"
                                TValue="List<string>" Multiple="true" AllowClear="true"
                                Data="@_agencyBonds.OrderBy(b => b.BondClass).Select(b => b.BondClass).Distinct().ToList()">

                </RadzenDropDown>
            </FilterTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        No Records to Display
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
    </LoadingTemplate>
</RadzenDataGrid>


@code {
    [Parameter] public Guid AgencyId { get; set; }

    private List<Bond> _agencyBonds = [];
    private RadzenDataGrid<Bond> AgencyBondGrid { get; set; } = null!;
    private List<string>? _statusFilter;
    private List<string>? _classFilter;
    private List<string>? _bondTypeFilter;
    
    #region Grid User Settings

    private DataGridSettings? _dataGridSettings;
    private DataGridSettings? GridSettings
    {
        get => _dataGridSettings;
        set
        {
            if (_dataGridSettings == value)
                return;

            _dataGridSettings = value;
            _userSettingsChanged = true;
        }
    }

    private bool _userSettingsLoaded;
    private bool _userSettingsChanged;

    #endregion
    
    private ExportFormat _defaultExportFormat;

    private RadzenDropDown<List<string>> StatusFilterDropDown { get; set; } = null!;
    private RadzenDropDown<List<string>> ClassFilterDropDown { get; set; } = null!;
    private RadzenDropDown<List<string>> BondTypeFilterDropDown { get; set; } = null!;

    private IDataAccessResult<List<Bond>> _agencyBondsResult = null!;

    private LoadItem AgencyBondsLoad => AddEventNotify(new LoadItem
    {
        Key = $"AgencyBondGrid{AgencyId}",
        AsyncLoadTask = async () => _agencyBondsResult = await DataAccess.GetAgencyBonds(AgencyId),
        CacheLoadTask = cache => _agencyBondsResult = new DataAccessResult<List<Bond>>
        {
            Data = (List<Bond>)cache!
        },
        ResultVariable = () => _agencyBondsResult,
        AfterLoad = () => { _agencyBonds = _agencyBondsResult.Data!; }
    }, "agency bond grid");

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();

        await GetGridSettings();
        await LoadAgencyBonds();
    }

    private async Task LoadAgencyBonds()
    {
        if (AgencyId == Guid.Empty)
            return;

        await DataAccess.GetCacheOrLoadDataAsync(AgencyBondsLoad);
    }

    private async Task StatusFilterChange()
    {
        if (_statusFilter != null && !_statusFilter.Any())
        {
            _statusFilter = null;
        }

        await AgencyBondGrid.Reload();
    }

    private async Task ClassFilterChange()
    {
        if (_classFilter != null && !_classFilter.Any())
        {
            _classFilter = null;
        }

        await AgencyBondGrid.Reload();
    }

    private async Task BondTypeFilterChange()
    {
        if (_bondTypeFilter != null && !_bondTypeFilter.Any())
        {
            _bondTypeFilter = null;
        }

        await AgencyBondGrid.Reload();
    }

    #region Grid User Settings

    private async Task SaveGridSettings()
    {
        await ShowLoading();
        
        var userGridSettings = new GridSettings
        {
            DefaultExportFormat = _defaultExportFormat,
            Settings = GridSettings
        };

        var value = JsonConvert.SerializeObject(userGridSettings);
        var response = await DataAccess.SetUserSetting(UserSettingsKeyConstants.AgencyBondGrid, value);

        if (!response.Success)
        {
            NotifySaveError(response.Errors, "user settings");
            return;
        }

        _userSettingsLoaded = true;
        _userSettingsChanged = false;
        StateHasChanged();
    }

    private async Task GetGridSettings()
    {
        await ShowLoading();
        
        var response = await DataAccess.GetUserSetting(UserSettingsKeyConstants.AgencyBondGrid);
        if (!response.Success || response is { Success: true, Data: null })
        {
            if (!response.Success)
                NotifyLoadError(response.Errors, "user settings");

            _userSettingsLoaded = false;
            return;
        }

        var userGridSettings = JsonConvert.DeserializeObject<GridSettings>(response.Data!.Value);

        if (userGridSettings == null)
            return;

        _defaultExportFormat = userGridSettings.DefaultExportFormat;
        GridSettings = userGridSettings.Settings;
        _userSettingsLoaded = true;
        _userSettingsChanged = false;
    }

    private async Task ResetGridSettings()
    {
        await ShowLoading();
        
        GridSettings = null;
        _defaultExportFormat = ExportFormat.Excel;
        await AgencyBondGrid.ReloadSettings();

        await DataAccess.ResetUserSetting(UserSettingsKeyConstants.AgencyBondGrid);
        _userSettingsLoaded = false;
        _userSettingsChanged = false;
    }

    #endregion

    private void ShowTooltip(ElementReference element, string type)
    {
        var message = type switch
        {
            "saveSettings" => "Click to save the grid settings",
            "resetSettings" => "Click to reset the grid settings",
            _ => ""
        };

        var options = new TooltipOptions
        {
            Duration = 2000
        };
        TooltipService.Open(element, message, options);
    }
}
