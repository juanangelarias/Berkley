@using Blazorise.Animate;

@inherits SlidingComponent

@inject ThemeService ThemeService

<Theme />

<RadzenTabs Change="@HandleChangeDirection" TabPosition="TabPosition.Left" >
    <Tabs>
        <RadzenTabsItem Text="Licenses">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyLicenseGrid AgencyId="agencyId" />
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="POAs">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyPOAGrid AgencyID="agencyId" />
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Related Parties">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <RadzenDataGrid TItem="string" Data="@blankList"
                                Style="border-radius: 20px;" EmptyText="No records to display">
                    <Columns>
                        <RadzenDataGridColumn TItem="string" Title="Agency #" Width="100px" />
                        <RadzenDataGridColumn TItem="string" Title="Agency Name" />
                    </Columns>
                </RadzenDataGrid>
            </Animate>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public Guid agencyId { get; set; }
    List<string> blankList = new List<string>();

}
