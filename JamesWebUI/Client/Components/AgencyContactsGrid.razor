@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

<Theme />
<RenderModeBackground />

<RadzenDataGrid TItem="Agent" Data="@Agents" @ref="@AgentsGrid" Density="Density.Compact"
                Style="border-radius: 10px; height: 400px;" EmptyText="No records to display"
                SelectionMode="DataGridSelectionMode.Single" AllowRowSelectOnRowClick="true"
                AllowPaging="true" PageSize="10" AllowSorting="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.Excel))" Disabled="@_isLoading" />
            <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(_ => ExportLicenseGrid(ExportFormat.CSV))" Disabled="@_isLoading" />
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="agent">
        <RadzenDataGrid Data="agent.AgencyLicenses" TItem="AgencyLicense"
                        Style="height:300px;" AllowVirtualization="true"
                        AllowFiltering="true">
            <HeaderTemplate>
                <RadzenPanel Style="width: 100%">
                    <RadzenRow>
                        <RadzenColumn>
                            <RadzenText Text="Name" />
                        </RadzenColumn>
                        <RadzenColumn>
                            <RadzenText Text="@(agent.IdNavigation.GivenName + " " + agent.IdNavigation.MiddleInitial + " " + agent.IdNavigation.FamilyName )" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenPanel>
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="License #" Width="125px" Property="LicenseNumber">
                    <Template Context="license">
                        <RadzenText Text="@license.LicenseNumber" />
                    </Template>

                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="State" Width="100px">
                    <Template Context="license">
                        <RadzenText Text="@license.State" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="Resident" Width="125px">
                    <Template Context="license">
                        <RadzenCheckBox Value="@license.IsResident" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="No Aptmt" Width="125px">
                    <Template Context="license">
                        <RadzenCheckBox Value="@license.AppointingState" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AgencyLicense" Title="Insurer">
                    <Template Context="license">
                        <RadzenText Text="@license.Insurer.IdNavigation.FullName" />
                    </Template>
                    <EditTemplate Context="license">
                        <RadzenDropDown TValue="Guid" Data="AllInsurers" Style="width:95%"
                                        TextProperty="IdNavigation.FullName" ValueProperty="Id" @bind-Value="@license.InsurerId" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="Agent" Title="First Name" Property="IdNavigation.GivenName" Width="200px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.GivenName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="MI" Property="IdNavigation.MiddleInitial" Width="75px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.MiddleInitial" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="Last Name" Property="IdNavigation.FamilyName" Width="200px">
            <Template Context="agent">
                <RadzenText Text="@agent.IdNavigation.FamilyName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Agent" Title="NPN" Property="NationalProducerNumber">
            <Template Context="agent">
                <RadzenText Text="@agent.NationalProducerNumber" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>


@code {
    [Parameter, EditorRequired] public Guid AgencyId { get; set; }
    
    private List<Agent> Agents { get; set; } = [];
    private RadzenDataGrid<Agent> AgentsGrid { get; set; } = null!;
    private List<Insurer> AllInsurers { get; set; } = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _isLoading = false;
    }
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadData();
    }
    
    private async Task LoadData()
    {
        if(AgencyId == Guid.Empty)
            return;

        IDataAccessResult<List<Agent>> agentsResult = null!;
        var contactsLoad = AddEventNotify(new LoadItem
            {
                Key = $"AgencyContacts{AgencyId}",
                AsyncLoadTask = async () => agentsResult = await DataAccess.GetAgencyAgents(AgencyId),
                CacheLoadTask = cache => agentsResult = new DataAccessResult<List<Agent>>
                {
                    Data = (List<Agent>)cache!
                },
                ResultVariable = () => agentsResult,
                AfterLoad = async void () =>
                {
                    if (agentsResult.Success)
                        Agents = agentsResult.Data!;
                }
            }, $"AgencyContacts {AgencyId}");
        
        IDataAccessResult<List<Insurer>> insurersResult = null!;
        var insurersLoad = AddEventNotify(new LoadItem
        {
            Key = "Insurers",
            AsyncLoadTask = async () => insurersResult = await DataAccess.GetAllInsurers(),
            CacheLoadTask = cache => insurersResult = new DataAccessResult<List<Insurer>> { Data = (List<Insurer>)cache! },
            ResultVariable = () => insurersResult,
            AfterLoad = async void () =>
            {
                if (insurersResult.Success)
                    AllInsurers = insurersResult.Data!;
            }
        }, "Insurers");

        await DataCache.ParallelGetCacheOrDataAsync([contactsLoad, insurersLoad]);
    }

    private void ExportLicenseGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        //TODO: Determine substitutions
        substitutions.AddSubstitution("IdNavigation.GivenName", title: "Given Name");
        substitutions.AddSubstitution("IdNavigation.MiddleInitial", title: "Middle Initial");
        substitutions.AddSubstitution("IdNavigation.FamilyName", title: "Family Initial");
        substitutions.AddSubstitution("", "License.LicenseNumber", "License Number");
        substitutions.AddSubstitution("", "License.State");
        substitutions.AddSubstitution("", "License.IsResident", "Is Resident");
        substitutions.AddSubstitution("", "License.AppointingState", "Appointing State");
        substitutions.AddSubstitution("", "License.Insurer.IdNavigation.FullName", "Insurer");
        NavigationManager.NavigateTo(ExportDataGridUrl(AgentsGrid,
                $"/export/AgencyContacts/{AgencyId}", format, substitutions),
            true);
    }
}
