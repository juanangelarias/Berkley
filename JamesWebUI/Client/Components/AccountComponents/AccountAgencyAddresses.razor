@inject IAccountState AccountState

@inherits JamesLayoutComponentBase

@if(AccountState?.Agency?.Id != null)
{
    <LegalEntityAddressManager LegalEntityId="@(AccountState?.Agency?.Id ?? Guid.Empty)"
                               OnAddressChanged="OnAddressChanged"/>
}
else
{
    <RadzenText Text="No Agency is selected" TextStyle="TextStyle.DisplayH6" TextAlign="TextAlign.Center"/>
}

@code {

    private void OnAddressChanged(List<Address> addresses)
    {
        if (AccountState.Agency != null)
        {
            AccountState.Agency.MainAddress =
                addresses.FirstOrDefault(f => f.LegalEntityAddress?.Type.ToLower() == "main");
        }
    }
}