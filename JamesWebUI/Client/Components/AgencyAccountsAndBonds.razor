@using System.Globalization;
@using James.Data.Client.GraphQL;
@using James.Data.Client.GraphQL.Components;
@using StrawberryShake;
@using James.Shared;
@using Blazorise.Animate;

@inherits SlidingComponent

@inject ThemeService ThemeService
@inject JamesClient JamesClient

<Theme />

<RadzenTabs Change="@HandleChangeDirection" TabPosition="TabPosition.Left" >
    <Tabs>
        <RadzenTabsItem Text="Accounts">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyAccountsGrid AgencyNumber="@agencyToDisplay.AgencyNumber" />
            </Animate>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Bonds">
            <Animate Animation="Direction" Duration="TimeSpan.FromSeconds(0.5)">
                <AgencyBondsGrid AgencyId="@agencyToDisplay.Id" />
            </Animate>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    [Parameter] public Agency agencyToDisplay { get; set; } = new Agency();
    List<string> blankList = new List<string>();

}
