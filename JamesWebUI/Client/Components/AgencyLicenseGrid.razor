@using James.Shared
@using James.Shared.Imaging

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess
@inject ILoggingService Logging

<Theme />
<RenderModeBackground />
<style>
    .rz-grid-row {
        row-gap: 2px;
    }
</style>

<RadzenDataGrid TItem="AgencyLicense" @ref="@licenseGrid" Data="@agencyLicenses"
                Style="border-radius: 10px; height: 400px;" EmptyText="No records to display"
                AllowSorting="true" Density="Density.Compact" SelectionMode="DataGridSelectionMode.Multiple"
                AllowFiltering="true" FilterMode="FilterMode.Simple"
                AllowColumnPicking="true" AllowGrouping="true"
                RowUpdate="UpdateLicenseRow" EditMode="DataGridEditMode.Single" RowCreate="@OnLicenseCreate"
                IsLoading="@isLoading" Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="add" Text="New License" Variant="Variant.Text" Click="@InsertLicenseRow" />
            <RadzenButton Text="Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(args => ExportLicenseGrid(ExportFormat.Excel))" Disabled="@isLoading" />
            <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall"
                          Click="@(args => ExportLicenseGrid(ExportFormat.CSV))" Disabled="@isLoading" />
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="AgencyLicense" Filterable="false"
                              Title="Status" Property="IsActive" Width="90px">
            <Template Context="license">
                @{
                    if (license.IsActive)
                    {
                        <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Success" />
                    }
                    else
                    {
                        <RadzenIcon Icon="fiber_manual_record" IconColor="@Colors.Danger" />
                    }
                }
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="@license.IsActive" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Type="typeof(IEnumerable<String>)"
                              Filterable="true" FilterValue="@StateFilter" FilterProperty="State" FilterOperator="FilterOperator.Contains"
                              Title="State" Property="State" Width="100px" SortOrder="SortOrder.Ascending">
            <Template Context="license">
                <RadzenText Text="@license.State" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="string" @ref="stateDropDown" Data="AllStates" @bind-Value="license.State"
                                TextProperty="Name" ValueProperty="Code" Style="width:95%" />
            </EditTemplate>
            <FilterTemplate>
                <RadzenDropDown @bind-Value="@StateFilter" Change="StateFilterChange"
                                Style="width: 95%;" Multiple="true" AllowClear="true" TValue="List<String>"
                                Data="@agencyLicenses?.OrderBy(a => a.State).GroupBy(a => a.State).Select(a => a?.FirstOrDefault()?.State).ToList()" />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense"
                              Title="No Aptmt" Width="75px" Property="AppointingState">
            <Template Context="license">
                <RadzenCheckBox Value="license.AppointingState" ReadOnly="true" />
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox @bind-Value="license.AppointingState" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="License #" Property="LicenseNumber" Width="100px">
            <Template Context="license">
                <RadzenText Text="@license.LicenseNumber" />
            </Template>
            <EditTemplate Context="license">
                <RadzenTextBox @bind-Value="license.LicenseNumber" Style="width:95%" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense"
                              Title="Resident" Width="75px" Property="IsResident">
            <Template Context="license">
                <RadzenCheckBox TValue="bool" Value="license.IsResident" ReadOnly="true" />
            </Template>
            <EditTemplate Context="license">
                <RadzenCheckBox TValue="bool" @bind-Value="license.IsResident" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Filterable="false"
                              Title="Insurer" Property="Insurer" Width="200px">
            <Template Context="license">
                <RadzenText Text="@license.Insurer.IdNavigation.FullName" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDropDown TValue="Insurer" @ref="dropSelectInsurer" Data="AllInsurers" Style="width:95%"
                                TextProperty="IdNavigation.FullName" @bind-Value="@license.Insurer" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Appointment" Property="Appointment" Width="125px" FormatString="{0:d}">
            <Template Context="license">
                <RadzenText Text="@license.Appointment.ToString()" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Appointment" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="AgencyLicense" Title="Termination" Property="Termination" Width="125px" FormatString="{0:d}">
            <Template Context="license">
                <RadzenText Text="@license.Termination.ToString()" />
            </Template>
            <EditTemplate Context="license">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="@license.Termination" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Certificate" Width="60px">
            <Template Context="lic">
                <InlineImagingDocument DocumentShortName="License Certificate"
                                       DocumentCategory="ImagingDocumentCategory.Agency"
                                       DocumentId="@lic.ImagingId"
                                       DocumentType="AGALIC"
                                       ImagingId="@lic.Agency.AgencyNumber"
                                       UploadAction=@(guid=> CertificateUploaded(guid, lic.Id))
                                       UploadErrorAction=@(msg=>LogUploadError(msg, lic)) />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="75px" TItem="AgencyLicense" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="license">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => EditLicenseRow(license))" @onclick:stopPropagation="true">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteLicenseRow(license))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="license">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@((args) => SaveLicenseRow(license))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" class="my-1 ms-1" Click="@((args) => CancelLicenseEdit(license))">
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteLicenseRow(license))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyId { get; set; }

    private RadzenDataGrid<AgencyLicense> licenseGrid { get; set; }

    private List<AgencyLicense> agencyLicenses { get; set; } = new List<AgencyLicense>();

    private List<AgencyLicense> licensesToInsert = new List<AgencyLicense>();
    private List<AgencyLicense> licensesToUpdate = new List<AgencyLicense>();

    private RadzenDropDown<Insurer> dropSelectInsurer { get; set; }
    private RadzenDropDown<Guid> filterInsurerDropDown { get; set; }
    private RadzenDropDown<string> stateDropDown { get; set; }
    private RadzenDropDown<string> stateFilterDropDown { get; set; }


    //TODO: Remove this stuff once we figure out caching
    private static List<Insurer> AllInsurers { get; set; } = new();
    private static List<State> AllStates { get; set; } = new();

    private List<String> StateFilter = null;

    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (AllStates.Count == 0)
            await LoadStates();
        if (AllInsurers.Count == 0)
            await LoadInsurers();

        if (AgencyId != Guid.Empty)
        {
            await LoadLicenses();
        }
    }
    void Reset()
    {
        licensesToInsert.Clear();
        licensesToUpdate.Clear();
    }
    void Reset(AgencyLicense license)
    {
        licensesToInsert.Remove(license);
        licensesToUpdate.Remove(license);
    }

    private async Task LoadLicenses()
    {
        await ShowLoading();
        var result = await DataAccess.GetAgencyLicenses(AgencyId);
        if (result.Success)
        {
            if (result.Data != null)
            {
                agencyLicenses = result.Data;
            }
        }
        else
            //UNDONE: Add actual errors as data
            Logging.LogError("Error getting Agency Licenses in Agency License Grid");

        await licenseGrid.Reload();
    }
    private async Task LoadStates()
    {
        var result = await DataAccess.GetAllStates();
        if (result.Success == false)
            //UNDONE: Add actual errors as data
            Logging.LogError("Error getting all States in Agency License Grid");
        AllStates = result.Data;
    }
    private async Task LoadInsurers()
    {
        var result = await DataAccess.GetAllInsurers();
        if (result.Success == false)
            //UNDONE: Add actual errors as data
            Logging.LogError("Error getting all Insurers in Agency License Grid");
        AllInsurers = result.Data;
    }

    async Task InsertLicenseRow()
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Insert is done in OnLicenseCreate()
        await ShowLoading();
        var newLicense = new AgencyLicense() { Id = Guid.NewGuid() };
        licensesToInsert.Add(newLicense);
        await licenseGrid.InsertRow(newLicense);
    }
    async Task EditLicenseRow(AgencyLicense license)
    {
        await ShowLoading();
        Reset();
        licensesToUpdate.Add(license);
        await licenseGrid.EditRow(license);
    }
    async Task DeleteLicenseRow(AgencyLicense license)
    {
        await ShowLoading();
        Reset(license);
        var result = await DataAccess.DeleteLicense(license.Id);
        await LoadLicenses();
    }
    async Task SaveLicenseRow(AgencyLicense license)
    {
        //This is where we handle the status change of the grid (edit mode or not).
        //The actual Update/Insert is done in those methods.
        await ShowLoading();
        await licenseGrid.UpdateRow(license);
        await LoadLicenses();
    }
    async Task OnLicenseCreate(AgencyLicense license)
    {
        //This is where we handle row inserts.

        var result = await DataAccess.CreateLicense(
        license.Id,
        AgencyId,
        null,
        license.AppointingState,
        license.Comments,
        license.Appointment,
        license.Expiration,
        license.Termination,
        license.Insurer.Id,
        license.IsResident,
        license.LicenseNumber,
        license.State,
        license.IsActive
    );

        licensesToInsert.Remove(license);
        //await LoadLicenses();
        //TODO: Check for errors and notify.
    }
    async void CancelLicenseEdit(AgencyLicense license)
    {
        await ShowLoading();
        Reset(license);
        licenseGrid.CancelEditRow(license);
        await LoadLicenses();
    }
    async Task UpdateLicenseRow(AgencyLicense license)
    {
        Reset(license);
        //This is where we handle row Updates.
        var result = await DataAccess.SetAgencyLicense(license.Id,
                license.AgencyId,
                license.AgentId,
                license.AppointingState,
                license.Comments,
                license.Appointment,
                license.Expiration,
                license.Termination,
                license.InsurerId,
                license.IsResident,
                license.LicenseNumber,
                license.State,
                license.IsActive
            );
    }
    async Task StateFilterChange()
    {
        if (StateFilter != null && !StateFilter.Any())
        {
            StateFilter = null;
        }
        await licenseGrid.Reload();
    }
    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }

    private async Task CertificateUploaded(Guid? certificateId, Guid licenseId)
    {
        //Set the document link
        var saveResult = await DataAccess.SetAgencyLicenseDocumentLink(licenseId, certificateId);
        if (saveResult.Success)
            NotifySuccessfulSave("License certificate");
        else
            NotifySaveError(saveResult.Errors, "license certificate");
    }

    private void LogUploadError(string message, AgencyLicense license)
    {
        LoggingService.LogError("Upload failed",
            "Uploading a file to imaging returned an error",
            "Imaging",
            data: new Dictionary<string, string>
                {
                { "Error Message", message },
                { "AgencyNumber", license.Agency.AgencyNumber},
                { "License Id", license.Id.ToString()}
                    });
        NotifySaveError([message], "license certificate");
    }

    private void ExportLicenseGrid(ExportFormat format)
    {
        var substitutions = new ExportColumnSubstitutions();
        substitutions.AddSubstitution("Insurer", "Insurer.IdNavigation.FullName" );
        substitutions.AddSubstitution("IsActive", title: "Is Active");
        substitutions.AddSubstitution("IsResident", title: "Is Resident");
        substitutions.AddSubstitution("AppointingState", title: "Appointing State");
        NavigationManager.NavigateTo(ExportDataGridUrl(licenseGrid,
    $"/export/AgencyLicenses/{AgencyId}", format, substitutions),
    true);
    }
}
