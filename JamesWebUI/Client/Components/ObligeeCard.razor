@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenCard >
    <RadzenRow>
        <RadzenColumn>
            <RadzenText Text="@ObligeeToDisplay.ObligeeNum" />
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter] public Guid ObligeeId { get; set; }
    
    private Obligee ObligeeToDisplay { get; set; } = null!;
    private IDataAccessResult<Obligee?> _obligeeResult = null!;
    
    private LoadItem ObligeeLoad => AddEventNotify(new LoadItem
        {
            Key = $"Obligee{ObligeeId}",
            AsyncLoadTask = async () => _obligeeResult = await DataAccess.GetObligeeById(ObligeeId),
            CacheLoadTask = cache => _obligeeResult = new DataAccessResult<Obligee?> { Data = (Obligee)cache! },
            ResultVariable = () => _obligeeResult,
            AfterLoad = () => { ObligeeToDisplay = _obligeeResult.Data!; }
        }, "obligee");
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadObligee();
    }
    
    private async Task LoadObligee()
    {
        await DataAccess.GetCacheOrLoadDataAsync(ObligeeLoad);
    }
}
