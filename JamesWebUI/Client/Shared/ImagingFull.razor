        public string FileName { get; set; }
        public string Description { get; set; }
        public string DocumentType { get; set; }
        public DateTime DocumentDate { get; } = DateTime.Now;
    }

    private class ImagingTypeDocuments
    {
        public ImagingType Type { get; set; }
        public List<ImagingDocument> Documents { get; set; }
    }

    private class ImagingTabTypeDocuments
    {
        public string TabName { get; set; }
        public List<ImagingTypeDocuments> TypeDocuments { get; set; }
    }

    private async Task StartUpload(ImagingDocumentDetails args)
    {
        throw new NotImplementedException();
    }

    private async Task UploadFileChanged(UploadChangeEventArgs args)
    {
        var file = args.Files.SingleOrDefault();//TODO:Support multiple file selections
        if (null == file)
        {
            _waitingForFileSelection = true;
            _details.FileName = string.Empty;
            _details.Description = string.Empty;
            _details.DocumentType = string.Empty;
            return;
        }

        Debug.Assert(_uploadDD.HasValue, "upload control shows .HasValue==false");

        _waitingForFileSelection = false;
        _details.FileName = file.Name;

        StateHasChanged();
    }

    private async Task UploadErrorHandler(UploadErrorEventArgs arg)
    {
        uploadFailed = true;
        NotifySaveError([arg.Message], "uploaded file");
