@using James.Shared
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject IDataAccess DataAccess
@inject ILoggingService LoggingService

<Theme />

<RadzenDataGrid @ref="poaGrid" TItem="PowerOfAttorney" Data="powerOfAttorneys"
                AllowFiltering="true" FilterMode="FilterMode.Simple" Style="height: 500px;" Filter="@ShowLoading"
                AllowSorting="true">
    <Template Context="poa">
        <RadzenDataList TItem="PowerOfAttorneyDocumentStatus" Data="poa.PowerOfAttorneyDocumentStatuses"
        Style="max-height:400px; overflow:auto; width:100%" AllowVirtualization="true" WrapItems="false" AllowPaging="false">
            <Template Context="poaDocStatus">
                <PowerOfAttorneyDocumentStatusCard poaDocumentStatus="poaDocStatus" />
            </Template>
        </RadzenDataList>
    </Template>
    <Columns>
        <RadzenDataGridColumn Title="Status" Property="StatusNavigation.Status" />
        <RadzenDataGridColumn Title="Insurer" Property="Insurer.IdNavigation.FullName" Width="300px" Type="typeof(IEnumerable<String>)"
                              FilterValue="@InsurerFilter" FilterProperty="Insurer.IdNavigation.FullName" FilterOperator="FilterOperator.Contains">
            <FilterTemplate>
                <RadzenDropDown Change="InsurerFilterChange" @bind-Value="@InsurerFilter" AllowClear="true"
                                Multiple="true" TValue="List<String>" Data="@powerOfAttorneys?.OrderBy(p => p.Insurer.IdNavigation.FullName).GroupBy(p => p.Insurer.Id).Select(p => p?.FirstOrDefault()?.Insurer.IdNavigation.FullName).ToList()" />
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Limit" Property="Limit" FormatString="{0:c0}" Filterable="false" Width="175px" />
        <RadzenDataGridColumn Title="Ref #" Property="Serial" />
        <RadzenDataGridColumn Title="First Issue Date" Property="FirstIssued" FormatString="{0:d}" />
        <RadzenDataGridColumn Title="Current POA Date" Property="CurrentIssued" FormatString="{0:d}" SortOrder="SortOrder.Descending" />
        <RadzenDataGridColumn Title="POA">
            <Template>
                <RadzenButton Variant="Variant.Text" Icon="picture_as_pdf" Size="ButtonSize.ExtraSmall" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public Guid AgencyID { get; set; }
    private List<PowerOfAttorney> powerOfAttorneys { get; set; }
    private RadzenDataGrid<PowerOfAttorney> poaGrid { get; set; }
    private RadzenDropDown<Guid> filterInsurerDropDown { get; set; }
    private List<String> InsurerFilter = null;
    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await ShowLoading();
        await LoadPOAs();
    }
    private async Task LoadPOAs()
    {
        var result = await DataAccess.GetAgencyPoas(AgencyID);

        if (result.Success)
        {
            powerOfAttorneys = result.Data;
            await poaGrid.Reload();
        }
        else
        {
            //TODO:Add error details
            LoggingService.LogError("Error loading POAs in the AgencyPOAGrid");
        }
    }
    private async Task<List<Insurer>> GetInsurers()
    {
        var result = await DataAccess.GetAllInsurers();
        if (result.Success)
            return result.Data!.OrderBy(i => i.IdNavigation.FullName).ToList();
        else
        {
            //TODO:Add error details
            LoggingService.LogError("Error getting insurers in the AgencyPOAGrid");
            return [];
        }
    }
    private async Task LoadInsurerFilterDropDown()
    {
        filterInsurerDropDown.Data = await GetInsurers();
    }
    async Task InsurerFilterChange()
    {
        if (InsurerFilter != null && !InsurerFilter.Any())
        {
            InsurerFilter = null;
        }
        await poaGrid.Reload();
    }
    protected async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();

        isLoading = false;
    }
}
