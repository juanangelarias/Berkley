@page "/AgencySearch"

@using System.Globalization
@using JamesWebUI.Client.GraphQL;
@using JamesWebUI.Client.GraphQL.Components;
@using JamesWebUI.Client.Controls.Extensions;
@using StrawberryShake;

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject AccountClient AccountClient

<Theme />


<PageTitle>Agency Profile</PageTitle>

<RadzenLayout>
    <RadzenHeader>

    </RadzenHeader>
    <RadzenBody>
        <RadzenRow Gap="2" JustifyContent="JustifyContent.Right">
            <RadzenColumn Style="vertical-align: middle" Size="1">
                <RadzenLabel Text="Search by:" Component="txtSearch"  ></RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox Placeholder="Agency/Producer No." Name="txtSearch" Style="width: 100%"/>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenTextBox Placeholder="Name" Style="width: 100%" @ref="@txtAgencyNameSearch" Change="@OnAgencySearchChange" />
            </RadzenColumn>
            <RadzenColumn Style="vertical-align: middle">
                <RadzenButton Icon="search" Size="ButtonSize.Small" Click="SearchAgencies" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Create New Agency" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow RowGap="2">
            <RadzenColumn Size="1"/>
            <RadzenStack Orientation="Orientation.Horizontal">
                <StateRadzenDropDown />
                <DivisionRadzenDropDown />
                <BranchRadzenDropDown />
                <RadzenDropDown @rendermode="@InteractiveWebAssembly" Placeholder="Status" TValue="string" />
            </RadzenStack>
        </RadzenRow>
        <RadzenRow RowGap="2" JustifyContent="JustifyContent.Center">
            
                @{
                    if (!String.IsNullOrEmpty(txtAgencyNameSearch?.Value))
                    {
                    <RadzenColumn Size="10">
                        <UseSearchAgencies SearchString="@AgencySearchString" Context="agencyResults" Strategy="ExecutionStrategy.CacheFirst">
                    <ChildContent>
                        <RadzenDataGrid style="border-radius: 20px;" AllowSorting="true" Density="Density.Compact"
                        AllowVirtualization="true" AllowPaging="true" PageSize="10" PagerPosition="PagerPosition.Bottom"
                        AllowColumnReorder="true"
                        Data="@agencyResults.SearchAgencies" TItem="ISearchAgencies_SearchAgencies" >
                            <Columns>
                                <RadzenDataGridColumn Width="150px" Filterable="true" 
                                    TItem="ISearchAgencies_SearchAgencies" Property="AgencyNumber" Title="Agency #"/>
                                <RadzenDataGridColumn 
                                    TItem="ISearchAgencies_SearchAgencies" Property="IdNavigation.FullName" Title="Name" />
                                <RadzenDataGridColumn 
                                    TItem="ISearchAgencies_SearchAgencies" Title="City" >
                                    <Template Context="agency">
                                                @(agency?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address.City + ", " + agency?.IdNavigation?.LegalEntityAddresses?.FirstOrDefault(a => a.Type == "Main")?.Address.StateCode)
                                    </Template>    
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Width="150px"
                                    TItem="ISearchAgencies_SearchAgencies" Property="Branch" Title="Branch"/>
                                <RadzenDataGridColumn Width="200px"
                                    TItem="ISearchAgencies_SearchAgencies" Property="Status" Title="Status" >
                                    <Template Context="agency">
                                        @{
                                            if (agency.Status == "Active")
                                            {
                                                <RadzenIcon Icon="check_circle" IconColor="@Colors.Success"/>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" IconColor="@Colors.Danger" />
                                            }
                                        }
                                        @agency.Status
                                    </Template>    
                                </RadzenDataGridColumn>
                            </Columns>    
                        </RadzenDataGrid>
                    </ChildContent>
                    <LoadingContent>
                        Loading...
                    </LoadingContent>
                </UseSearchAgencies>
            </RadzenColumn>
                    }
                }

        </RadzenRow>
    </RadzenBody>
</RadzenLayout>


@code {
    string[] dropDownValues = { "Test1", "Test2", "Test3" };

    //DropDown Data
    private IReadOnlyList<ISearchAgencies_SearchAgencies> agencyResults;
    private RadzenTextBox txtAgencyNameSearch;
    private string AgencySearchString;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeService.Initialize(NavigationManager);
    }
    async Task SearchAgencies()
    {
        var results = await AccountClient.SearchAgencies.ExecuteAsync(txtAgencyNameSearch.Value);
        agencyResults = results.Data.SearchAgencies;
        //var test = agencyResults[0].br //TODO: Remove this test code
    }
    async Task OnAgencySearchChange(dynamic args)
    {
        AgencySearchString = args;
    }
}

