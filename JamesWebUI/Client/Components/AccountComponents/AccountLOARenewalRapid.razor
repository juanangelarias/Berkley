<RadzenCard class="rz-w-100">
    <RadzenRow JustifyContent="JustifyContent.SpaceAround">
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Criteria" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.Recommendation" Placeholder="Criteria" Name="criteria"
                                Change="@Changed" Rows="5" class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Criteria is required" Component="criteria" Popup="true"/>
                <RadzenLengthValidator Min="@_minimumNarrativeLength" 
                                       Text=@($"Criteria must be at least {_minimumNarrativeLength} characters")
                                       Component="criteria" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" SizeMD="6">
            <RadzenFormField Text="Financial Analysis" class="rz-w-100">
                <RadzenTextArea @bind-Value="@Data.FinancialAnalysis" Placeholder="Financial" Name="financial"
                                Change="@Changed" Rows="5" class="rz-w-100" ReadOnly="@IsReadOnly"/>
                <RadzenRequiredValidator Text="Financial Analysis is required" Component="financial" Popup="true"/>
                <RadzenLengthValidator Min="@_minimumNarrativeLength" 
                                       Text=@($"Financial Analysis must be at least {_minimumNarrativeLength} characters")
                                       Component="financial" Popup="true"/>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public LineOfAuthorityReason Data { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsReadOnly { get; set; }
    [Parameter, EditorRequired] public EventCallback<LineOfAuthorityReason> OnChanges { get; set; }

    private int _minimumNarrativeLength => AccountLOARenewalBusinessRules.GetMinimumNarrativeLength();
    
    private async Task Changed()
    {
        await OnChanges.InvokeAsync(Data);
    }

}
