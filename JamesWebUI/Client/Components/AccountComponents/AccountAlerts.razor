@code {
    [Parameter, EditorRequired] public required Guid AccountId { get; set; }
    [Parameter] public EventCallback<bool> OnAlertOrClaimExist { get; set; }
    
    private Dictionary<int, string> _periods = [];
    private int SelectedPeriod { get; set; }
    private List<AccountAlertDto> _alerts = [];
    private List<AccountAlertClaimDto> _claims = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var periods = (AlertPeriod[])Enum.GetValues(typeof(AlertPeriod));
        _periods = [];
        foreach (var period in periods)
        {
            _periods.Add((int)period, period.GetDisplayDescription());
        }

        SelectedPeriod = _periods.FirstOrDefault().Key;

        await OnAlertPeriodChange();
    }

    private void OnAlertGridRender(DataGridRenderEventArgs<AccountAlertDto> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Groups.Add(new GroupDescriptor { Property = "Type", SortOrder = SortOrder.Ascending });
            StateHasChanged();
        }
    }

    private async Task OnAlertPeriodChange()
    {
        AccountState.AlertPeriod = (AlertPeriod)SelectedPeriod;

        await AccountState.LoadAlerts();

        _alerts = AccountState.Alerts.Alerts.OrderBy(s=>s.Type).ToList();
        _claims = AccountState.Alerts.Claims;

        /*await _gridNotification.Reload();
        await _gridClaim.Reload();*/
        StateHasChanged();
    }

    private async Task OpenAlertDialog(AccountAlertDto alert)
    {
        var parameters = new Dictionary<string, object> { { "Alert", alert } };
        var options = new DialogOptions
        {
            Height = "335px",
            Width = "600px",
            ShowClose = false,
            Resizable = false
        };

        var result = await DialogService.OpenAsync<AccountAlertDialog>("Account Alert", parameters, options);

        if ((bool)result)
        {
            Navigation.NavigateTo(alert.Link);
        }
    }
}*@