@using James.Shared;
@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager

@inject IDataAccess DataAccess

<Theme />

<RadzenCard Style="width: 100%; padding: 0px;" Variant="Variant.Text">
    <RadzenRow Style="background: lightgrey;">
        <RadzenColumn Size="5">
            <RadzenText Text="Document Name" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenText Text="Date Requested" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenText Text="Date Received" />
        </RadzenColumn>
        <RadzenColumn Size="1">
            <RadzenButton Variant="Variant.Text" Icon="edit" Click="ToggleEditMode" Size="ButtonSize.ExtraSmall" Visible="!editMode" />
            <RadzenButton Variant="Variant.Text" Icon="save" Click="SaveChanges" Size="ButtonSize.ExtraSmall" Visible="editMode" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn Size="5">
            <RadzenText Text="@PoaDocumentStatus.DocumentType.Name" Visible="!editMode" Style="width: 95%" />
            <RadzenDropDown Multiple="false" Data="@docTypes" @bind-Value="@PoaDocumentStatus.DocumentType" TextProperty="Name" Visible="editMode" Style="width: 95%" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenText Text="@PoaDocumentStatus.Requested.ToString()" Visible="!editMode" />
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="@PoaDocumentStatus.Requested" Visible="editMode" AllowClear="true" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenText Text="@PoaDocumentStatus.Received.ToString()" Visible="!editMode" />
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="@PoaDocumentStatus.Received" Visible="editMode" AllowClear="true" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
        <RadzenColumn Size="12">
            <RadzenFormField AllowFloatingLabel="false" Text="Comments" Variant="Variant.Outlined" Style="width:95%">
                <ChildContent>
                    <RadzenTextBox @bind-Value="@PoaDocumentStatus.Comments" ReadOnly="!editMode" />
                </ChildContent>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>
@code {
    [Parameter] public required PowerOfAttorneyDocumentStatus PoaDocumentStatus { get; set; }
    private List<PowerOfAttorneyDocumentNameDm>? docTypes { get; set; } = null;

    private bool editMode { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadDocumentTypes();
    }

    private async Task LoadDocumentTypes()
    {
        if (null == docTypes || docTypes.Count==0)
        {
            var result = await DataAccess.GetPoaDocumentNames();
            List<PowerOfAttorneyDocumentNameDm> results = new List<PowerOfAttorneyDocumentNameDm>();
            if (result.Success)
                foreach (var docName in result.Data)
                {
                    results.Add(ThisToThat.ToEntityType<PowerOfAttorneyDocumentNameDm>(docName));
                }
            else
                LoggingService.LogError("Could not load POA document types.", string.Join("; ", result.Errors));

            docTypes = results;
        }
    }
    private async Task SaveChanges()
    {
        ArgumentNullException.ThrowIfNull(PoaDocumentStatus, nameof(PoaDocumentStatus));
        var result = await DataAccess.SetPowerOfAttorneyDocumentStatus(PoaDocumentStatus.Id,
                        PoaDocumentStatus.Requested?.ToDateTime(TimeOnly.Parse("12:00 AM")),
                        PoaDocumentStatus.Received?.ToDateTime(TimeOnly.Parse("12:00 AM")),
                        PoaDocumentStatus.DocumentTypeId,
                        PoaDocumentStatus.Comments);
        if (result.Success)
        {
            NotifySuccessfulSave();
            ToggleEditMode();
        }
        else
        {
            NotifySaveError(result.Errors);
            LoggingService.LogError("Could not save POA changes.", string.Join("; ", result.Errors));
        }

    }
    private void ToggleEditMode()
    {
        editMode = !editMode;
    }
}
