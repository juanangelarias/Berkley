@inherits JamesLayoutComponentBase

<RadzenRow>
    <RadzenColumn Size="6">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenFieldset Text="Bank Information">
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Bank" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay.Bank" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="1">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Reference Name" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay.BankReferenceName" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Average Cash Balance" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenNumeric Value="@AccountToDisplay.BankAverageBalance" Format="c0" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Phone No." AllowFloatingLabel="false" Style="Width:95%" >
                            @* <RadzenTextBox Value="@AccountToDisplay.BankPhone" /> *@
                            <RadzenText Text="Placeholder" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Last Contacted" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay.BankLastContacted.ToString()" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="CPA Information">
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="CPA Firm Name" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenText Text="@AccountToDisplay?.Cpafirm?.FullName" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="1">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Contact Person" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay?.Cpacontact?.FullName" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Phone" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenText Text="Placeholder" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Email" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenText Text="Placeholder" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="Attorney Information">
                <RadzenRow>
                    <RadzenColumn Size="9">
                        <JamesFormField Text="Attorney Name" AllowFloatingLabel="false" Style="width:95%" >
                            <RadzenTextBox Value="Placeholder" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="MH Rating" AllowFloatingLabel="false" Style="width:95%" >
                            <RadzenTextBox Value="Placeholder" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenStack Orientation="Orientation.Vertical">
            <RadzenFieldset Text="Bank Line of Credit">
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Amount" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenNumeric Format="c0" Value="@AccountToDisplay.BankLoc" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="1">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Expires" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenDatePicker ShowTime="false" TValue="DateOnly" Value="@AccountToDisplay.BankLocexpires" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Amount in Use" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenNumeric Format="c0" Value="@AccountToDisplay.BankLocused" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="When" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenDatePicker ShowTime="false" TValue="DateOnly" Value="@AccountToDisplay.BankLochighDate" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Most Used" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenNumeric Format="c0" Value="@AccountToDisplay.BankLochigh" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="11">
                        <JamesFormField Text="Security" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenText Text="@AccountToDisplay?.BankLocsecurity" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
            <RadzenFieldset Text="Law Firm Information">
                <RadzenRow>
                    <RadzenColumn Size="9">
                        <JamesFormField Text="Law Firm Name" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay?.LawFirm?.IdNavigation?.FullName" />
                        </JamesFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <JamesFormField Text="MH Rating" AllowFloatingLabel="false" Style="Width:95%" >
                            <RadzenTextBox Value="@AccountToDisplay?.LawFirm?.MartindaleHubbellRating" />
                        </JamesFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    @{
                        if (AccountToDisplay?.LawFirm?.Id != null)
                        {
                            <RadzenAccordion>
                                <Items>
                                    <RadzenAccordionItem Text="Contact Info" >
                                        <LegalEntityAddressManager LegalEntityId="@AccountToDisplay.LawFirm.Id" />
                                    </RadzenAccordionItem>
                                </Items>
                            </RadzenAccordion>
                        }
                    }
                </RadzenRow>
            </RadzenFieldset>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>


@code {
    [Parameter, EditorRequired] public Account AccountToDisplay { get; set; } = null!;
    private bool ExpandLawFirmDetails { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
}
