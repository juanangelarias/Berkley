@using System.Diagnostics

@inherits JamesLayoutComponentBase

@inject IDataAccess DataAccess

<RadzenTabs TabPosition="TabPosition.Left" @bind-SelectedIndex="@SelectedTab">
    <Tabs>
        @{
            if (AllAddresses.Any())
            {
                foreach (var a in AllAddresses)
                {
                    <RadzenTabsItem Text="@(a.LegalEntityAddress!.Type)">
                        <AddressDisplay @ref="_addressDisplays[a.LegalEntityAddress!.Type]" AddressId="a.Id"
                                        StateChanged="@(() => LoadAddresses())"
                                        AddSubscription="@(() => DataAccess.AddressModified(a.Id, async void (sra) =>
                                                         {
                                                             if (_addressDisplays[a.LegalEntityAddress.Type].EditorIdentifier == sra.Identifier) return;
                                                             await _addressDisplays[a.LegalEntityAddress.Type].SubscriptionUpdate(sra.Result);
                                                         }))"/>
                    </RadzenTabsItem>
                    //NOTE: The redundant specification of the AddressCreate below is needed to prevent the AddressCreate from being selected initially
                    if (a == AllAddresses.Last())
                    {
                        <RadzenTabsItem Icon="add" Text="Add Address">
                            <AddressCreate LegalEntityId="@LegalEntityId"
                                           AddressCreated="@AddressCreated"></AddressCreate>
                        </RadzenTabsItem>
                    }
                }
            }
            else
            {
                <RadzenTabsItem Icon="add" Text="Add Address">
                    <AddressCreate LegalEntityId="@LegalEntityId" AddressCreated="@AddressCreated"></AddressCreate>
                </RadzenTabsItem>
            }
        }
    </Tabs>
</RadzenTabs>


@code {

    [Parameter]
    public Guid LegalEntityId { get; set; }

    private List<Address> AllAddresses { get; set; } = [];
    private readonly Dictionary<string, AddressDisplay> _addressDisplays = [];
    private int SelectedTab { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (LegalEntityId != Guid.Empty)
            await LoadAddresses();
    }

    private IDataAccessResult<List<Address>> _addressesLoadResult = null!;
    private LoadItem AddressesLoadItem => AddEventNotify(
        new LoadItem
        {
            Key = $"Adds{LegalEntityId}",
            AsyncLoadTask = async () => _addressesLoadResult = await DataAccess.GetAllLegalEntityAddresses(LegalEntityId),
            CacheLoadTask = cache => _addressesLoadResult = new DataAccessResult<List<Address>> { Data = (List<Address>)cache! },
            ResultVariable = () => _addressesLoadResult,
            AfterLoad = async void () =>
            {
                Debug.Assert(_addressesLoadResult.Data != null);
                if (!_addressesLoadResult.Success) 
                    return;
                
                AllAddresses = _addressesLoadResult.Data;
                SelectedTab = 0;
            },
            AddSubscriptionTask = li =>
            {
                //NOTE: Subscriptions for the address editors are added via the AddressDisplay AddSubscription function
                li.Subscription = DataAccess.AddressCollectionModified(LegalEntityId, async void (_) =>
                {
                    DataCache.Clear("addresses");
                    await LoadAddresses();
                });
            }
        }, "addresses");

    private async Task LoadAddresses()
    {
        await DataCache.GetCacheOrLoadDataAsync(AddressesLoadItem);
    }
    
    private async Task AddressCreated(Guid addressToSelect)
    {
        await LoadAddresses();

        if (_addressesLoadResult.Success)
        {
            AllAddresses = _addressesLoadResult.Data!;

            var selected = AllAddresses.FirstOrDefault(a => a.Id == addressToSelect);
            SelectedTab = null != selected
                ? AllAddresses.IndexOf(selected)
                : 0;
        }
    }
}
