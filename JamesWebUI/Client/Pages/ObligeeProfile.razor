@page "/Obligee/{ObligeeNumber?}"

@inherits JamesLayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDataAccess DataAccess

@attribute [Authorize]

<RenderModeBackground></RenderModeBackground>
<Theme />
<PageTitle>BasisTNG - Obligee Profile</PageTitle>

<RadzenStack Orientation="Orientation.Vertical">
    <RadzenPanel Style="border-radius: 20px;">
        <RadzenRow>
            <RadzenColumn Size="3">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@ObligeeToDisplay.IdNavigation.FullName" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <ObligeeSearch />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenButton Text="Create Obligee" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="CreateObligeeClicked"/>
            </RadzenColumn>
        </RadzenRow>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px;">
        <RadzenRow>
            <RadzenColumn Size="6">
                <RadzenFieldset Text="General Info">
                    <RadzenRow>
                        <RadzenColumn Size="3">
                            <RadzenFormField Variant="Variant.Text" Text="Obligee No." AllowFloatingLabel="false" Style="width: 95%">
                                <RadzenTextBox Value="@ObligeeToDisplay.ObligeeNum" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn>
                            <RadzenFormField Variant="Variant.Text" Text="Name" AllowFloatingLabel="false" Style="width: 95%">
                                <RadzenTextBox Value="@ObligeeToDisplay.IdNavigation.FullName" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="6">
                            <RadzenFormField Variant="Variant.Text" Text="Type" AllowFloatingLabel="false" Style="width:95%">
                                <RadzenTextBox Value="@ObligeeToDisplay.Type" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn>
                            <RadzenToggleButton ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" ToggleIcon="check"
                                                @bind-Value="@ObligeeToDisplay.PrintStatusLetter" Text="Status Letters" Style="border-radius: 20px;" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenTabs>
                    <Tabs>
                        <RadzenTabsItem Text="Addresses">
                            <LegalEntityAddressManager LegalEntityId="@ObligeeToDisplay.Id" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Phone Numbers">
                            <LegalEntityPhoneNumberManager LegalEntityId="@ObligeeToDisplay.Id" />
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </RadzenColumn>
        </RadzenRow>
    </RadzenPanel>
    <RadzenPanel Style="border-radius: 20px;">
        <RadzenRow>
            <RadzenText Text="Bond Record" TextStyle="TextStyle.DisplayH5" />
        </RadzenRow>
        <RadzenRow>
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Primary">
                        <ObligeeBondRecord ObligeeId="@ObligeeToDisplay.Id" BondTypesToDisplay="ObligeeBondRecord.ObligeeBondTypes.Primary" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Secondary">
                        <ObligeeBondRecord ObligeeId="@ObligeeToDisplay.Id" BondTypesToDisplay="ObligeeBondRecord.ObligeeBondTypes.Secondary" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenRow>
    </RadzenPanel>
</RadzenStack>

@code {
    [Parameter] public string ObligeeNumber { get; set; } = "";
    private bool PossibleDuplicates { get; set; } = false;
    
    private IDataAccessResult<Obligee?> _obligeeResult = null!;
    private LoadItem ObligeeLoad => AddEventNotify(new LoadItem
        {
            Key = $"Obligee{ObligeeNumber}",
            AsyncLoadTask = async () =>_obligeeResult = await DataAccess.GetObligeeByObligeeNumber(ObligeeNumber),
            CacheLoadTask = cache => _obligeeResult = new DataAccessResult<Obligee>{Data = (Obligee?)cache}!,
            ResultVariable = () => _obligeeResult,
            AfterLoad = async void () =>
            {
                ObligeeToDisplay = _obligeeResult.Data!;
            }
        }, "obligee");

    public Obligee ObligeeToDisplay { get; set; } = new()
    {
        IdNavigation = new LegalEntity()
    };


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await LoadObligee();
    }

    private async Task LoadObligee()
    {
        if (string.IsNullOrWhiteSpace(ObligeeNumber))
            return;

        await DataCache.GetCacheOrLoadDataAsync(ObligeeLoad);
    }
    
    private async Task LoadPossibleDuplicates()
    {

    }

    void CreateObligeeClicked()
    {
        NavigationManager.NavigateTo("CreateObligee");
    }
}
