@page "/"
@page "/dashboard"

@using System.Globalization

@rendermode InteractiveWebAssembly
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService

<RadzenContextMenu/>
<Theme />

<PageTitle>Index</PageTitle>

<RadzenChart>
    <RadzenColumnSeries Data="@premium" CategoryProperty="Month" ValueProperty="Premium" Title="Actual">
        <ChildContent>
            <RadzenSeriesDataLabels Visible="true" >
                  
            </RadzenSeriesDataLabels>
        </ChildContent>
        <TooltipTemplate Context="data">
            Premium for <span>@data.Month</span>: <strong>@data.Premium.ToString("C0")</strong>
        </TooltipTemplate>    
    </RadzenColumnSeries>
    <RadzenColumnSeries Data="@budget" CategoryProperty="Month" ValueProperty="Premium" Title="Budget">
        <ChildContent>
            <RadzenSeriesDataLabels Visible="true" />
        </ChildContent>
        <TooltipTemplate Context="data">
            Budget for <span>@data.Month</span>: <strong>@data.Premium.ToString("C0")</strong>
        </TooltipTemplate>
    </RadzenColumnSeries>
    <RadzenColumnOptions Margin="0"/>
    <RadzenValueAxis Formatter="@FormatAsUSD"  >
        <RadzenAxisTitle Text="Premium in USD"/>    
    </RadzenValueAxis>
</RadzenChart>
<RadzenDropDown Class="rz-mx-0 rz-mx-lg-4" id="themes" style="width: 220px;"
                TValue="string" TextProperty="Text" ValueProperty="Value" Data="@ThemeService.Themes"
                Value="@ThemeService.CurrentTheme" Change="@ChangeTheme"
                @rendermode="@InteractiveWebAssembly">
    <ValueTemplate>
        @context.Text Theme
    </ValueTemplate>
    <Template>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <svg width="80" height="60" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" style="border-radius: 4px; outline: var(--rz-input-border); min-width: 80px;">
                <rect width="80" height="60" fill="@context.Base" />
                <rect x="0" y="4" width="16" height="56" fill="@context.Sidebar" />
                <rect x="24" y="17" width="48" height="32" rx="2" fill="@context.Content" />
                <rect x="43" y="41" width="12" height="4" rx="1" fill="@context.Secondary" />
                <rect x="28" y="21" width="16" height="2" rx="1" fill="@context.TitleText" />
                <rect x="28" y="27" width="40" height="2" rx="1" fill="@context.ContentText" />
                <rect x="28" y="31" width="40" height="2" rx="1" fill="@context.ContentText" />
                <rect x="28" y="35" width="16" height="2" rx="1" fill="@context.ContentText" />
                <rect x="28" y="41" width="12" height="4" rx="1" fill="@context.Primary" />
                <rect width="80" height="6" fill="@context.Header" />
            </svg>
            @context.Text
            @if (context.Premium)
            {
                <RadzenBadge title="To use it in your application you need an active Radzen Professional or Enterprise subscription.">PRO</RadzenBadge>
            }
        </RadzenStack>
    </Template>
</RadzenDropDown>
@code {
    class DataItem
    {
        public string Month { get; set; }
        public double Premium { get; set; }
    }

    DataItem[] premium = new DataItem[]
    {
        new DataItem {Month = "Jan", Premium=1000},
        new DataItem {Month = "Feb", Premium=900},
        new DataItem {Month = "Mar", Premium=1500},
        new DataItem {Month = "Apr", Premium=1600},
        new DataItem {Month = "May", Premium=1200},
        new DataItem {Month = "June", Premium=800}
    };
    DataItem[] budget = new DataItem[]
    {
        new DataItem {Month = "Jan", Premium=950},
        new DataItem {Month = "Feb", Premium=1000},
        new DataItem {Month = "Mar", Premium=1475},
        new DataItem {Month = "Apr", Premium=1740},
        new DataItem {Month = "May", Premium=1100},
        new DataItem {Month = "June", Premium=950}
    };


    string FormatAsUSD(object value)
    {
        return ((double)value).ToString("C0", CultureInfo.CreateSpecificCulture("en-US"));
    }
    protected override void OnInitialized()
    {
        ThemeService.Initialize(NavigationManager);
    }
    void ChangeTheme(object value)
    {
        var url = NavigationManager.GetUriWithQueryParameter("theme", $"{value}");

        NavigationManager.NavigateTo(url, true);
    }
}

