@inherits JamesLayoutComponentBase

<RadzenPanel Visible="!EditMode" Name="@(Name+"Display")">
    <RadzenRow>
        <RadzenColumn>
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenSwitch @bind-Value="@DetailedMode" Text="Detailed Mode" />
                <RadzenText Text="Detailed View" />
                <RadzenButton Icon="edit" Visible="!EditMode" Size="ButtonSize.Small" Variant="Variant.Text" Click="ToggleEditMode" />
                <RadzenButton Icon="delete" Visible="!EditMode" Size="ButtonSize.Small" Variant="Variant.Text" Click="DeleteAddress" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn>
            <RadzenFormField Variant="Variant.Text" Text="Address 1" Style="width:90%" AllowFloatingLabel="false">
                <RadzenTextBox @bind-Value="@_addressToDisplay.Address1" Name="Address1" ReadOnly="true" AutoComplete="false" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn>
            <RadzenFormField Variant="Variant.Text" Text="Address 2" Style="width:90%" AllowFloatingLabel="false">
                <RadzenTextBox @bind-Value="@_addressToDisplay.Address2" Name="Address2" ReadOnly="true" AutoComplete="false" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn>
            <RadzenFormField Variant="Variant.Text" Text="Address 3" Style="width:90%" AllowFloatingLabel="false" Visible="DetailedMode">
                <RadzenTextBox @bind-Value="@_addressToDisplay.Address3" Name="Address3" ReadOnly="true" AutoComplete="false" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenFormField Variant="Variant.Text" Text="City" AllowFloatingLabel="false" Style="width:90%">
                <RadzenTextBox @bind-Value="@_addressToDisplay.City" Name="City" ReadOnly="true" AutoComplete="false" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenFormField Variant="Variant.Text" Text="State" AllowFloatingLabel="false" Style="width:90%">
                <StateDropDown MultiSelect="false" @bind-SelectedStateCode="@_addressToDisplay.StateCode" Disabled="true" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenFormField Variant="Variant.Text" Text="Postal Code" AllowFloatingLabel="false" Style="width:90%">
                <RadzenTextBox @bind-Value="@_addressToDisplay.PostalCode" Name="PostalCode" ReadOnly="true" AutoComplete="false" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn>

        </RadzenColumn>
    </RadzenRow>
</RadzenPanel>
<RadzenPanel Visible="EditMode" Name="@(Name+"Edit")">
    <RadzenTemplateForm TItem="Address" Data="@_addressToDisplay"
                        Submit="@SubmitAddressChange">
        <RadzenRow>
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenSwitch @bind-Value="@DetailedMode" Text="Detailed Mode" />
                    <RadzenText Text="Detailed View" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn>
                <RadzenFormField Variant="Variant.Text" Text="Address 1" Style="width:90%" AllowFloatingLabel="false">
                    <RadzenTextBox @bind-Value="@_addressToDisplay.Address1" Name="Address1" AutoComplete="false" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn>
                <RadzenFormField Variant="Variant.Text" Text="Address 2" Style="width:90%" AllowFloatingLabel="false">
                    <RadzenTextBox @bind-Value="@_addressToDisplay.Address2" Name="Address2" AutoComplete="false" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn>
                <RadzenFormField Variant="Variant.Text" Text="Address 3" Style="width:90%" AllowFloatingLabel="false" Visible="DetailedMode">
                    <RadzenTextBox @bind-Value="@_addressToDisplay.Address3" Name="Address3" AutoComplete="false" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenFormField Variant="Variant.Text" Text="City" AllowFloatingLabel="false" Style="width:90%">
                    <RadzenTextBox @bind-Value="@_addressToDisplay.City" Name="City" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Variant="Variant.Text" Text="State" AllowFloatingLabel="false" Style="width:90%">
                    <StateDropDown MultiSelect="false" @bind-SelectedStateCode="@_addressToDisplay.StateCode" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Variant="Variant.Text" Text="Postal Code" AllowFloatingLabel="false" Style="width:90%">
                    <RadzenTextBox @bind-Value="@_addressToDisplay.PostalCode" Name="PostalCode" AutoComplete="false" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenStack JustifyContent="JustifyContent.End" AlignItems="AlignItems.End" Orientation="Orientation.Horizontal">
                    <RadzenButton Icon="save" Visible="EditMode" Size="ButtonSize.Small" Text="Save" ButtonType="ButtonType.Submit" />
                    <RadzenButton Icon="cancel" Visible="EditMode" Size="ButtonSize.Small" Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
</RadzenPanel>

@code {
    [Parameter, EditorRequired] public Address Address { get; set; }
    [Parameter] public string Name { get; set; } = "Address"; 
    [Parameter] public EventCallback<Guid> StateChanged { get; set; }
    [Parameter, EditorRequired] public required EventCallback<Address> AddressEdited { get; set; }
    [Parameter, EditorRequired] public required EventCallback<Guid> AddressDeleted { get; set; }

    
    public bool DetailedMode { get; private set; }
    public bool EditMode { get; private set; }
    private Address _addressToDisplay = null!;
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        
        _addressToDisplay = InitializeAddressToDisplay(Address);
    }

    private async Task SubmitAddressChange(Address newAddress)
    {
        EditMode = false;
        await AddressEdited.InvokeAsync(newAddress);

        Address = newAddress;
    }

    private void ToggleEditMode()
    {
        EditMode = !EditMode;
    }

    private async Task DeleteAddress()
    {
        var result = await DialogService.OpenAsync("Confirm Address Deletion", ds =>
            @<RadzenStack Orientation="Orientation.Vertical">
                <p>Are you sure you want to delete this address?</p>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Yes" Click="() => ds.Close(true)" Style="width:80px;"/>
                    <RadzenButton Text="No" Click="() => ds.Close(false)" Style="width:80px;"/>
                </RadzenStack>
            </RadzenStack>
        );
        if (result)
        {
            await AddressDeleted.InvokeAsync(Address.Id);
        }
    }

    private void Cancel()
    {
        _addressToDisplay = InitializeAddressToDisplay(Address);
        
        EditMode = false;
    }

    private Address InitializeAddressToDisplay(Address source)
    {
        return new Address
        {
            Id = source.Id,
            Address1 = source.Address1,
            Address2 = source.Address2,
            Address3 = source.Address3,
            City = source.City,
            StateCode = source.StateCode,
            PostalCode = source.PostalCode
        };
    }
}